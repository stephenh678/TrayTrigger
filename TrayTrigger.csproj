<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\app_icon.ico</ApplicationIcon>
    <AssemblyName>TrayTrigger</AssemblyName>
    <RootNamespace>TrayTrigger</RootNamespace>
    <Version>1.3.9</Version>
    <Authors>Steph</Authors>
    <Product>TrayTrigger</Product>
    <Description>Windows system tray game launcher with Steam integration, per-game performance profiles, live hardware telemetry, and verified one-click performance tweaks.</Description>
    <Copyright>Copyright (c) Steph</Copyright>
    <RepositoryUrl>https://github.com/stephenh678/TrayTrigger</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>true</PublishReadyToRun>
    <InvariantGlobalization>false</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="System.Management" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- The SDK's implicit glob would otherwise pull TrayTrigger.Tests' own .cs files into
         this project's build. See L-19. -->
    <Compile Remove="TrayTrigger.Tests\**" />
    <EmbeddedResource Remove="TrayTrigger.Tests\**" />
    <None Remove="TrayTrigger.Tests\**" />
    <!-- tools\IconGen is its own project (regenerates the app icon). -->
    <Compile Remove="tools\**" />
    <EmbeddedResource Remove="tools\**" />
    <None Remove="tools\**" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app_icon.ico" />
    <Resource Include="Assets\app_icon.png" />
    <Resource Include="Assets\LauncherLogos\steam.png" />
    <Resource Include="Assets\LauncherLogos\gog_galaxy.png" />
    <Resource Include="Assets\LauncherLogos\ea_app.png" />
    <Resource Include="Assets\LauncherLogos\epic_games.png" />
    <Resource Include="Assets\LauncherLogos\ubisoft_connect.png" />
    <Resource Include="Assets\LauncherLogos\local_games.png" />
    <!-- Not wired into any UI yet - kept available for a future platform integration. -->
    <Resource Include="Assets\LauncherLogos\amazon_games.png" />
    <Resource Include="Assets\LauncherLogos\battlenet.png" />
    <Resource Include="Assets\LauncherLogos\itchio.png" />
    <Resource Include="Assets\LauncherLogos\riot_client.png" />
    <Resource Include="Assets\LauncherLogos\rockstar_games.png" />
    <Resource Include="Assets\LauncherLogos\xbox.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- In-app "Learn more" help topics. Help\tweaks\hags.md becomes the embedded resource
         TrayTrigger.Help.tweaks.hags.md, addressed by HelpContentService as "tweaks/hags". -->
    <EmbeddedResource Include="Help\**\*.md" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the test project reach internal test seams (StorageService's folder-scoped
         constructor, LibraryViewModel.ConfirmBatchRemove) without making them public API. -->
    <InternalsVisibleTo Include="TrayTrigger.Tests" />
  </ItemGroup>

</Project>
