<Window x:Class="TrayTrigger.Views.QuickInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Edit Value"
        Height="230" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource BrushBgDark}"
        Foreground="{StaticResource BrushTextPrimary}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title & Prompt -->
            <RowDefinition Height="*"/>    <!-- Input control -->
            <RowDefinition Height="Auto"/> <!-- Buttons -->
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="HeadingTextBlock" Text="Quick Edit" FontSize="16" FontWeight="Normal" 
                       Foreground="{StaticResource BrushTextPrimary}" FontFamily="{StaticResource AppFont}"/>
            <TextBlock x:Name="PromptTextBlock" Text="Enter the new value:" FontSize="12" 
                       Foreground="{StaticResource BrushTextSecondary}" FontFamily="{StaticResource AppFont}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Either TextBox or Editable ComboBox -->
        <Grid Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,16">
            <TextBox x:Name="ValueTextBox" Style="{StaticResource ModernTextBox}" Visibility="Visible"/>
            <ComboBox x:Name="ValueComboBox" Style="{StaticResource ModernComboBox}" IsEditable="True" Visibility="Collapsed"/>
        </Grid>

        <DockPanel Grid.Row="2">
            <Button DockPanel.Dock="Right" Content="Save" Click="SaveButton_Click" 
                    Style="{StaticResource ModernAccentButton}" MinWidth="90" Margin="10,0,0,0"/>
            <Button DockPanel.Dock="Right" Content="Cancel" Click="CancelButton_Click" 
                    Style="{StaticResource ModernGhostButton}" MinWidth="75"/>
        </DockPanel>
    </Grid>
</Window>
