<Window x:Class="TrayTrigger.Views.QuickInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Edit Value"
        SizeToContent="Height" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BrushBackground}"
        Foreground="{DynamicResource BrushTextPrimary}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title & Prompt -->
            <RowDefinition Height="*"/>    <!-- Input control -->
            <RowDefinition Height="Auto"/> <!-- Buttons -->
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="HeadingTextBlock" Text="Quick Edit" FontSize="{DynamicResource FontSizeTitle}" FontWeight="Normal" 
                       Foreground="{DynamicResource BrushTextPrimary}" FontFamily="{DynamicResource AppFont}"/>
            <TextBlock x:Name="PromptTextBlock" Text="Enter the new value:" FontSize="{DynamicResource FontSizeBody}" 
                       Foreground="{DynamicResource BrushTextSecondary}" FontFamily="{DynamicResource AppFont}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Either TextBox or Editable ComboBox -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,16">
        <DockPanel>
            <!-- Only where a name is being picked or made (Change Category): puts the typed name in the list, selected. -->
            <Button x:Name="AddButton" DockPanel.Dock="Right" Content="_Add" Click="AddButton_Click" Visibility="Collapsed"
                    Style="{StaticResource ModernOutlineButton}" MinWidth="70" Margin="10,0,0,0"/>
            <Grid>
                <TextBox x:Name="ValueTextBox" Style="{StaticResource ModernTextBox}" Visibility="Visible"/>
                <ComboBox x:Name="ValueComboBox" Style="{StaticResource ModernComboBox}" IsEditable="True" Visibility="Collapsed"/>
            </Grid>
        </DockPanel>
        <!-- Change Category: the category the game has, as a chip like Collections shows. The x clears it. -->
        <Border x:Name="ChipBorder" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,12,0,0"
                Background="{DynamicResource BrushDialogCard}" BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="1" CornerRadius="{DynamicResource RadiusControl}" Padding="10,2,2,2">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ChipText" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeBody}"/>
                <Button x:Name="ChipRemove" Click="ChipRemove_Click" Style="{StaticResource ModernGhostButton}" Padding="8,2" Margin="4,0,0,0"
                        AutomationProperties.Name="Clear the category">
                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeBody}"/>
                </Button>
            </StackPanel>
        </Border>
        </StackPanel>

        <DockPanel Grid.Row="2">
            <Button DockPanel.Dock="Right" Content="_Save" Click="SaveButton_Click" IsDefault="True" 
                    Style="{StaticResource ModernAccentButton}" MinWidth="90" Margin="10,0,0,0"/>
            <Button DockPanel.Dock="Right" Content="_Cancel" Click="CancelButton_Click" IsCancel="True" 
                    Style="{StaticResource ModernGhostButton}" MinWidth="75"/>
        </DockPanel>
    </Grid>
</Window>
