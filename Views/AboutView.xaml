<UserControl x:Class="TrayTrigger.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:TrayTrigger.Views"
             xmlns:services="clr-namespace:TrayTrigger.Services"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1100">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Category Segmented Tabs -->
            <RowDefinition Height="*"/>    <!-- About Content ScrollViewer -->
        </Grid.RowDefinitions>

        <!-- 1. Header matching Settings, System, Library -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <!-- Right: Version & Status Indicator Badge -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding UpdateStatusIcon}" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="{StaticResource FontSizeBody}" 
                           Foreground="{Binding UpdateStatusBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBlock Text="{Binding UpdateStatusBadgeText}" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}" 
                           FontFamily="{StaticResource AppFont}" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Left: Title & Subtitle matching Settings -->
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="About" FontSize="{StaticResource FontSizeHeading}" Foreground="{DynamicResource BrushTextPrimary}" 
                           FontFamily="{StaticResource AppFont}" FontWeight="Normal"/>
                <TextBlock Text="Application overview, key features, keyboard shortcuts, and support links" 
                           FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}" 
                           FontFamily="{StaticResource AppFont}" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- 2. Category Segmented Tabs, with the card search beside them -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{DynamicResource BrushDialogCard}" BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="1" CornerRadius="{StaticResource RadiusControl}" Padding="3" HorizontalAlignment="Left"
                views:ScrollToTop.Target="{Binding ElementName=AboutScroll}">
            <StackPanel Orientation="Horizontal">
                <Button Content="All" Command="{Binding SelectAboutAllTabCommand}"
                        Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsAboutAllTab}"/>
                <Button Content="Overview" Command="{Binding SelectAboutOverviewTabCommand}" Margin="2,0,0,0"
                        Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsAboutOverviewTab}"/>
                <Button Content="Key Features" Command="{Binding SelectAboutFeaturesTabCommand}" Margin="2,0,0,0"
                        Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsAboutFeaturesTab}"/>
                <Button Content="Shortcuts" Command="{Binding SelectAboutShortcutsTabCommand}" Margin="2,0,0,0"
                        Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsAboutShortcutsTab}"/>
                <Button Content="Support &amp; Links" Command="{Binding SelectAboutSupportTabCommand}" Margin="2,0,0,0"
                        Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsAboutSupportTab}"/>
            </StackPanel>
        </Border>
        <!-- Card search (Views/CardSearch, Views/SearchBox), as on Settings: it searches the
             selected tab and the text stays as you switch tabs (MainViewModel.AboutSearchText). -->
        <views:SearchBox x:Name="AboutSearchBox" Grid.Column="1" HorizontalAlignment="Left" Margin="12,0,0,0"
                         Text="{Binding AboutSearchText}"/>
        </Grid>

        <!-- 3. About Content ScrollViewer -->
        <ScrollViewer x:Name="AboutScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14"
                      views:ScrollToTop.ResetOn="{Binding CurrentAboutSection}">
            <StackPanel x:Name="AboutCardsPanel" HorizontalAlignment="Stretch" Margin="0,0,12,0"
                        views:CardSearch.Query="{Binding AboutSearchText}"
                        views:CardSearch.Scope="{Binding CurrentAboutSection}">

                <!-- ============================================== -->
                <!-- CATEGORY 1: APPLICATION OVERVIEW               -->
                <!-- ============================================== -->
                <StackPanel Visibility="{Binding ShowAboutOverviewSection, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                    <!-- Section Header (shown in All view) -->
                    <Border Margin="0,2,0,8" views:CardSearch.IsHeader="True">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAboutAllTab}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="{StaticResource FontSizeBody}" 
                                       Foreground="{DynamicResource BrushAccentText}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="APPLICATION OVERVIEW" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource BrushAccentText}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Hero Identity Card -->
                    <Border CornerRadius="{StaticResource RadiusCard}" Background="{DynamicResource BrushSurface}" 
                            BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" 
                            Padding="18,16" Margin="0,0,0,10">
                        <DockPanel LastChildFill="True">
                            <Image Source="/Assets/app_icon.png" Width="52" Height="52"
                                   Margin="0,0,18,0" DockPanel.Dock="Left" VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>

                            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0">
                                <!-- GitHub lives under Support & Links; one button here is enough. -->
                                <Button Content="Check for Updates" Command="{Binding CheckForUpdatesCommand}"
                                        Style="{StaticResource ModernAccentButton}" Padding="12,5"/>
                            </StackPanel>

                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- The wordmark: "Trigger" in the logo's blue. Runs on one line, so no space creeps in. -->
                                    <TextBlock FontSize="{StaticResource FontSizeHeading}" FontWeight="SemiBold" FontFamily="{StaticResource AppFont}"
                                               Foreground="{DynamicResource BrushTextPrimary}"><Run Text="Tray"/><Run Text="Trigger" Foreground="{DynamicResource BrushBrand}"/></TextBlock>
                                    <Border Background="{DynamicResource BrushAccentWash}" CornerRadius="{StaticResource RadiusSmall}" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding AppVersionDisplay}" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushAccentText}" FontWeight="SemiBold"/>
                                    </Border>
                                    <Border Background="{DynamicResource BrushSurface}" CornerRadius="{StaticResource RadiusSmall}" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text=".NET 10.0" FontSize="{StaticResource FontSizeBadge}" Foreground="{DynamicResource BrushTextMuted}" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Per-game Windows tuning and launch automation, from the tray. Per-game changes revert when the game exits."
                                           Foreground="{DynamicResource BrushTextSecondary}" FontSize="{StaticResource FontSizeBody}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Environment strip: real values about this install (what a bug report
                         needs), replacing the old marketing labels. -->
                    <Border CornerRadius="{StaticResource RadiusCard}" Background="{DynamicResource BrushSurface}"
                            BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                            Padding="14,12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Column="0" Background="{DynamicResource BrushDialogCard}" CornerRadius="{StaticResource RadiusControl}" Padding="12,10" Margin="0,0,3,6">
                                <StackPanel>
                                    <TextBlock Text="WINDOWS" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding OsDisplay}" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource BrushDialogCard}" CornerRadius="{StaticResource RadiusControl}" Padding="12,10" Margin="0,0,3,0">
                                <StackPanel>
                                    <TextBlock Text="RUNTIME" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding RuntimeDisplay}" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource BrushDialogCard}" CornerRadius="{StaticResource RadiusControl}" Padding="12,10" Margin="3,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="LIBRARY" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding TotalGameCountDisplay}" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource BrushDialogCard}" CornerRadius="{StaticResource RadiusControl}" Padding="12,10" Margin="3,0,0,6">
                                <StackPanel>
                                    <TextBlock Text="DATA FOLDER" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding SettingsVM.StorageDirectoryDisplay}" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ============================================== -->
                <!-- CATEGORY 2: KEY FEATURES                       -->
                <!-- ============================================== -->
                <StackPanel Visibility="{Binding ShowAboutFeaturesSection, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                    <!-- Section Header (shown in All view) -->
                    <Border Margin="0,2,0,8" views:CardSearch.IsHeader="True">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAboutAllTab}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="{StaticResource FontSizeBody}" 
                                       Foreground="{DynamicResource BrushAccentText}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="KEY FEATURES" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource BrushAccentText}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Feature grid: thirteen tiles, most useful first - profile, library, tray, launcher control, tweaks, Stutter Check, scripts, DLSS, activity, tools, backup, hardware, then themes across the foot. -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 1: Performance Profiles -->
                        <Border Grid.Row="0" Grid.Column="0" CornerRadius="{StaticResource RadiusCard}" Background="{DynamicResource BrushSurface}"
                                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="14,12" Margin="0,0,5,10">
                            <DockPanel LastChildFill="True">
                                <Border Width="34" Height="34" CornerRadius="{StaticResource RadiusControl}" Background="{DynamicResource BrushSurface}" Margin="0,0,12,0" VerticalAlignment="Top">
                                    <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource FontSizeSubhead}"
                                               Foreground="{DynamicResource BrushAccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Top">
                                    <TextBlock Text="Performance Profiles" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                    <TextBlock Text="Give each game an Optimized or Aggressive tier: power plan, GPU preference, HDR, Do Not Disturb, process priority, timer resolution. Applied when the game launches, reverted to exactly what it found when it exits, and restored on the next start if anything crashes mid-session. CPU Cores keeps a game on the cores that suit it: performance cores on an Intel hybrid, the 3D V-Cache cores on a Ryzen X3D."
                                               FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- 2: Library -->
                        <Border Grid.Row="0" Grid.Column="1" CornerRadius="{StaticResource RadiusCard}" Background="{DynamicResource BrushSurface}"
                                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="14,12" Margin="5,0,0,10">
                            <DockPanel LastChildFill="True">
                                <Border Width="34" Height="34" CornerRadius="{StaticResource RadiusControl}" Background="{DynamicResource BrushSurface}" Margin="0,0,12,0" VerticalAlignment="Top">
                                    <TextBlock Text="&#xE753;" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource FontSizeSubhead}"
                                               Foreground="{DynamicResource BrushAccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Top">
                                    <TextBlock Text="Seven Launchers, One Library" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                    <TextBlock Text="A Fluent-style library built to look at home on Windows 11, in dark, light or a theme of your own: poster art, rounded cards, no menu bar. Scan for Games reads Steam, GOG, EA, Epic, Ubisoft Connect, Xbox / PC Game Pass and Battle.net's own install records, plus any folder you drop on the window. Real titles, Steam metadata and poster art, SteamGridDB and RAWG to fill the gaps, categories, filters, four views and batch editing. Games you uninstall stay, greyed out, with their playtime and settings kept."
                                               FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- 3: Tray launcher & hotkeys -->
                        <Border Grid.Row="1" Grid.Column="0" CornerRadius="{StaticResource RadiusCard}" Background="{DynamicResource BrushSurface}"
                                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="14,12" Margin="0,0,5,10">
                            <DockPanel LastChildFill="True">
                                <Border Width="34" Height="34" CornerRadius="{StaticResource RadiusControl}" Background="{DynamicResource BrushSurface}" Margin="0,0,12,0" VerticalAlignment="Top">
                                    <TextBlock Text="&#xE765;" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource FontSizeSubhead}"
                                               Foreground="{DynamicResource BrushAccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Top">
                                    <TextBlock Text="Tray Launcher &amp; Hotkeys" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                    <TextBlock Text="Lives in the tray: Now Playing, Recent, Favorites and every category one right-click or Ctrl+Alt+T away, with a search box that launches the top match on Enter. Hotkeys show the window, open the tray menu and suspend the game, and any game can have its own - recorded from the keys you press, and refused up front if another app already has it."
                                               FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- 4: Launcher Control -->
                        <Border Grid.Row="1" Grid.Column="1" CornerRadius="{StaticResource RadiusCard}" Background="{DynamicResource BrushSurface}"
                                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="14,12" Margin="5,0,0,10">
                            <DockPanel LastChildFill="True">
                                <Border Width="34" Height="34" CornerRadius="{StaticResource RadiusControl}" Background="{DynamicResource BrushSurface}" Margin="0,0,12,0" VerticalAlignment="Top">
                                    <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource FontSizeSubhead}"
                                               Foreground="{DynamicResource BrushAccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Top">
                                    <TextBlock Text="Launcher Control" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                    <TextBlock Text="Launch arguments and Run as Administrator per game. Close Steam, GOG Galaxy, EA, Epic, Ubisoft Connect, the Xbox app or Battle.net when the game exits, and start Steam, GOG Galaxy and Epic quietly so only the game appears. A second launch brings the running game forward instead of starting a duplicate; Suspend, Close Game and Force Close are one click away while it runs."
                                               FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- 5: Windows tweaks -->
                        <Border Grid.Row="2" Grid.Column="0" CornerRadius="{StaticResource RadiusCard}" Background="{DynamicResource BrushSurface}"
                                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="14,12" Margin="0,0,5,10">
                            <DockPanel LastChildFill="True">
                                <Border Width="34" Height="34" CornerRadius="{StaticResource RadiusControl}" Background="{DynamicResource BrushSurface}" Margin="0,0,12,0" VerticalAlignment="Top">
                                    <TextBlock Text="&#xE90F;" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource FontSizeSubhead}"
                                               Foreground="{DynamicResource BrushAccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Top">
                                    <TextBlock Text="Verified, Reversible Windows Tweaks" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                    <TextBlock Text="Twenty documented gaming settings, each showing Windows' real current state and each reverting to exactly what it found, plus a read-only Core Isolation check. Trade-off-heavy ones (Visual Effects, Nagle's Algorithm) stay off by default and clearly badged; Apply Performance Preset and Undo Preset can take a System Restore Point first."
                                               FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- 6: Stutter Check -->
                        <Border Grid.Row="2" Grid.Column="1" CornerRadius="{StaticResource RadiusCard}" Background="{DynamicResource BrushSurface}"
                                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="14,12" Margin="5,0,0,10">
                            <DockPanel LastChildFill="True">
                                <Border Width="34" Height="34" CornerRadius="{StaticResource RadiusControl}" Background="{DynamicResource BrushSurface}" Margin="0,0,12,0" VerticalAlignment="Top">
                                    <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource FontSizeSubhead}"
                                               Foreground="{DynamicResource BrushAccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Top">
                                    <TextBlock Text="Stutter Check" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                    <TextBlock Text="One click runs the checklist every stutter thread sends you through: overlays, apps holding video memory, refresh rate, RAM speed, drives, Resizable BAR, shader caches, the power plan and Search indexing. Each row says what it found and what to do. It only reports, never changes anything on its own, and never runs while a game is running."
                                               FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- 7: Scripts -->
                        <Border Grid.Row="3" Grid.Column="0" CornerRadius="{StaticResource RadiusCard}" Background="{DynamicResource BrushSurface}"
                                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="14,12" Margin="0,0,5,10">
                            <DockPanel LastChildFill="True">
                                <Border Width="34" Height="34" CornerRadius="{StaticResource RadiusControl}" Background="{DynamicResource BrushSurface}" Margin="0,0,12,0" VerticalAlignment="Top">
                                    <TextBlock Text="&#xE756;" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource FontSizeSubhead}"
                                               Foreground="{DynamicResource BrushAccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Top">
                                    <TextBlock Text="Pre-Launch &amp; Post-Exit Scripts" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                    <TextBlock Text="Attach your own .bat, .cmd, .ps1 or .exe to any game, or set defaults for all of them: close OneDrive, start SimHub for your racing games. Test Run buttons, per-game arguments, wait and cancel-on-failure, and real examples ship with the app."
                                               FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- 8: DLSS Override -->
                        <Border Grid.Row="3" Grid.Column="1" CornerRadius="{StaticResource RadiusCard}" Background="{DynamicResource BrushSurface}"
                                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="14,12" Margin="5,0,0,10">
                            <DockPanel LastChildFill="True">
                                <Border Width="34" Height="34" CornerRadius="{StaticResource RadiusControl}" Background="{DynamicResource BrushSurface}" Margin="0,0,12,0" VerticalAlignment="Top">
                                    <TextBlock Text="&#xE950;" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource FontSizeSubhead}"
                                               Foreground="{DynamicResource BrushAccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Top">
                                    <TextBlock Text="NVIDIA DLSS Override" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                    <TextBlock Text="Run a game on your GeForce driver&apos;s newer DLSS files instead of the ones it shipped with: Super Resolution, Ray Reconstruction and Frame Generation. Per game, with nothing in the game folder touched, and put back exactly as it was when you switch it off."
                                               FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- 9: Activity & History -->
                        <Border Grid.Row="4" Grid.Column="0" CornerRadius="{StaticResource RadiusCard}" Background="{DynamicResource BrushSurface}"
                                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="14,12" Margin="0,0,5,10">
                            <DockPanel LastChildFill="True">
                                <Border Width="34" Height="34" CornerRadius="{StaticResource RadiusControl}" Background="{DynamicResource BrushSurface}" Margin="0,0,12,0" VerticalAlignment="Top">
                                    <TextBlock Text="&#xEA8F;" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource FontSizeSubhead}"
                                               Foreground="{DynamicResource BrushAccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Top">
                                    <TextBlock Text="Activity &amp; History" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                    <TextBlock Text="The bell at the bottom of the sidebar: what TrayTrigger changed for your games and put back, anything that didn't go to plan, and a fix for a setting a profile couldn't put back. One notification after your last game."
                                               FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- 10: Tools -->
                        <Border Grid.Row="4" Grid.Column="1" CornerRadius="{StaticResource RadiusCard}" Background="{DynamicResource BrushSurface}"
                                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="14,12" Margin="5,0,0,10">
                            <DockPanel LastChildFill="True">
                                <Border Width="34" Height="34" CornerRadius="{StaticResource RadiusControl}" Background="{DynamicResource BrushSurface}" Margin="0,0,12,0" VerticalAlignment="Top">
                                    <TextBlock Text="&#xE90F;" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource FontSizeSubhead}"
                                               Foreground="{DynamicResource BrushAccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Top">
                                    <TextBlock Text="Tools" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                    <TextBlock Text="An optional page for the programs you use alongside games, like MSI Afterburner or DLSS Swapper: launch them from the tray menu or a hotkey, or have them start with your games and close when the last one exits."
                                               FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- 11: Backup and restore -->
                        <Border Grid.Row="5" Grid.Column="0" CornerRadius="{StaticResource RadiusCard}" Background="{DynamicResource BrushSurface}"
                                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="14,12" Margin="0,0,5,10">
                            <DockPanel LastChildFill="True">
                                <Border Width="34" Height="34" CornerRadius="{StaticResource RadiusControl}" Background="{DynamicResource BrushSurface}" Margin="0,0,12,0" VerticalAlignment="Top">
                                    <TextBlock Text="&#xE777;" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource FontSizeSubhead}"
                                               Foreground="{DynamicResource BrushAccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Top">
                                    <TextBlock Text="Backup &amp; Restore" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                    <TextBlock Text="Your library, settings, tools, scripts, themes and artwork in one .zip, to move to a new PC or undo a mistake. A restore finds games whose drive letter or folder changed, and backs up what you had first."
                                               FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- 12: Hardware monitoring -->
                        <Border Grid.Row="5" Grid.Column="1" CornerRadius="{StaticResource RadiusCard}" Background="{DynamicResource BrushSurface}"
                                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="14,12" Margin="5,0,0,10">
                            <DockPanel LastChildFill="True">
                                <Border Width="34" Height="34" CornerRadius="{StaticResource RadiusControl}" Background="{DynamicResource BrushSurface}" Margin="0,0,12,0" VerticalAlignment="Top">
                                    <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource FontSizeSubhead}"
                                               Foreground="{DynamicResource BrushAccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Top">
                                    <TextBlock Text="Hardware Monitoring" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                    <TextBlock Text="Live CPU and RAM load, plus GPU, VRAM, displays, drives, motherboard, BIOS, OS build and DirectX capability on the System page - so you can sanity-check specs before deciding which profile a game gets."
                                               FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- 13: Themes, across both columns so the last row is not half empty -->
                        <Border Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" CornerRadius="{StaticResource RadiusCard}" Background="{DynamicResource BrushSurface}"
                                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="14,12" Margin="0,0,0,10">
                            <DockPanel LastChildFill="True">
                                <Border Width="34" Height="34" CornerRadius="{StaticResource RadiusControl}" Background="{DynamicResource BrushSurface}" Margin="0,0,12,0" VerticalAlignment="Top">
                                    <TextBlock Text="&#xE790;" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource FontSizeSubhead}"
                                               Foreground="{DynamicResource BrushAccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Top">
                                    <TextBlock Text="Themes &amp; Backgrounds" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                    <TextBlock Text="Dark, Light, Green, Amber and Purple, or Auto to follow Windows&apos; light or dark mode (and its High Contrast colors), switched at once with no restart. Each theme has a background picture behind the pages, with the cards left solid so text stays readable; turn it off, or choose your own JPG or PNG. Make a theme of your own with New theme from this... (Edit theme... on one of yours): pick its colors with a color square or type a #RRGGBB, watch a preview, and save. The fine-tuning colors live in the theme file, which the app follows each time you save it. Settings &gt; General &gt; Appearance."

                                               FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- ============================================== -->
                <!-- CATEGORY 3: SHORTCUTS                          -->
                <!-- ============================================== -->
                <StackPanel Visibility="{Binding ShowAboutShortcutsSection, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                    <!-- Section Header (shown in All view) -->
                    <Border Margin="0,2,0,8" views:CardSearch.IsHeader="True">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAboutAllTab}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="{StaticResource FontSizeBody}" 
                                       Foreground="{DynamicResource BrushAccentText}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="SHORTCUTS" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource BrushAccentText}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border CornerRadius="{StaticResource RadiusCard}" Background="{DynamicResource BrushSurface}" 
                            BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" 
                            Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <DockPanel LastChildFill="True" Margin="0,0,0,12">
                                <Button DockPanel.Dock="Right" Content="Configure Hotkey..." 
                                        Command="{Binding NavigateToGeneralSettingsCommand}" 
                                        Style="{StaticResource ModernOutlineButton}" 
                                        VerticalAlignment="Center" Padding="11,5"/>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="Keyboard &amp; Mouse Controls" FontSize="{StaticResource FontSizeSubhead}" FontWeight="SemiBold" 
                                               Foreground="{DynamicResource BrushTextPrimary}"/>
                                    <TextBlock Text="What the keys and clicks do." 
                                               Foreground="{DynamicResource BrushTextMuted}" FontSize="{StaticResource FontSizeBody}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- Table Container -->
                            <Border Background="{DynamicResource BrushDialogCard}" CornerRadius="{StaticResource RadiusControl}" Padding="14,10">
                                <StackPanel>
                                    <!-- Row 1: Global Hotkey - shows the configured value, not a hard-coded Ctrl+Alt+G -->
                                    <DockPanel Margin="0,0,0,9">
                                        <StackPanel Orientation="Horizontal" Width="200" VerticalAlignment="Center">
                                            <Border Background="{DynamicResource BrushSurfaceHover}" BorderBrush="{DynamicResource BrushBorderStrong}" BorderThickness="1" CornerRadius="{StaticResource RadiusSmall}" Padding="7,2">
                                                <TextBlock Text="{Binding SettingsVM.GlobalManageHotkey}" FontSize="{StaticResource FontSizeBadge}" FontWeight="SemiBold" Foreground="{DynamicResource BrushAccentText}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Show or hide the TrayTrigger window from anywhere in Windows (change it in Settings > General)"
                                                   Foreground="{DynamicResource BrushTextSecondary}" FontSize="{StaticResource FontSizeBody}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </DockPanel>

                                    <!-- Row 1b: Tray menu hotkey - the configured value -->
                                    <DockPanel Margin="0,0,0,9">
                                        <StackPanel Orientation="Horizontal" Width="200" VerticalAlignment="Center">
                                            <Border Background="{DynamicResource BrushSurfaceHover}" BorderBrush="{DynamicResource BrushBorderStrong}" BorderThickness="1" CornerRadius="{StaticResource RadiusSmall}" Padding="7,2">
                                                <TextBlock Text="{Binding SettingsVM.TrayMenuHotkey}" FontSize="{StaticResource FontSizeBadge}" FontWeight="SemiBold" Foreground="{DynamicResource BrushAccentText}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Open the tray menu by the tray icon from anywhere in Windows, ready to search (change it in Settings > General)"
                                                   Foreground="{DynamicResource BrushTextSecondary}" FontSize="{StaticResource FontSizeBody}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </DockPanel>

                                    <!-- Row 1c: Suspend hotkey - the configured value -->
                                    <DockPanel Margin="0,0,0,9">
                                        <StackPanel Orientation="Horizontal" Width="200" VerticalAlignment="Center">
                                            <Border Background="{DynamicResource BrushSurfaceHover}" BorderBrush="{DynamicResource BrushBorderStrong}" BorderThickness="1" CornerRadius="{StaticResource RadiusSmall}" Padding="7,2">
                                                <TextBlock Text="{Binding SettingsVM.SuspendGameHotkey}" FontSize="{StaticResource FontSizeBadge}" FontWeight="SemiBold" Foreground="{DynamicResource BrushAccentText}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Suspend the game you're playing, or resume it - games with anti-cheat excepted (change it in Settings > General)"
                                                   Foreground="{DynamicResource BrushTextSecondary}" FontSize="{StaticResource FontSizeBody}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </DockPanel>

                                    <!-- Row 2: Tray Left-Click -->
                                    <DockPanel Margin="0,0,0,9">
                                        <StackPanel Orientation="Horizontal" Width="200" VerticalAlignment="Center">
                                            <Border Background="{DynamicResource BrushSurfaceHover}" BorderBrush="{DynamicResource BrushBorderStrong}" BorderThickness="1" CornerRadius="{StaticResource RadiusSmall}" Padding="6,2">
                                                <TextBlock Text="Left-Click" FontSize="{StaticResource FontSizeBadge}" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            </Border>
                                            <TextBlock Text=" Tray Icon" Foreground="{DynamicResource BrushTextMuted}" FontSize="{StaticResource FontSizeBody}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="Show or hide the TrayTrigger window. Double-click always opens it"
                                                   Foreground="{DynamicResource BrushTextSecondary}" FontSize="{StaticResource FontSizeBody}" VerticalAlignment="Center"/>
                                    </DockPanel>

                                    <!-- Row 3: Tray Right-Click -->
                                    <DockPanel Margin="0,0,0,9">
                                        <StackPanel Orientation="Horizontal" Width="200" VerticalAlignment="Center">
                                            <Border Background="{DynamicResource BrushSurfaceHover}" BorderBrush="{DynamicResource BrushBorderStrong}" BorderThickness="1" CornerRadius="{StaticResource RadiusSmall}" Padding="6,2">
                                                <TextBlock Text="Right-Click" FontSize="{StaticResource FontSizeBadge}" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            </Border>
                                            <TextBlock Text=" Tray Icon" Foreground="{DynamicResource BrushTextMuted}" FontSize="{StaticResource FontSizeBody}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="Quick-launch menu: a search box (type, then Enter launches the top match), Now Playing, Recent, Favorites, all games (grouped or flat), Scan for Games, Settings, Exit"
                                                   Foreground="{DynamicResource BrushTextSecondary}" FontSize="{StaticResource FontSizeBody}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </DockPanel>

                                    <!-- Row 4: Game Card Left-Click -->
                                    <DockPanel Margin="0,0,0,9">
                                        <StackPanel Orientation="Horizontal" Width="200" VerticalAlignment="Center">
                                            <Border Background="{DynamicResource BrushSurfaceHover}" BorderBrush="{DynamicResource BrushBorderStrong}" BorderThickness="1" CornerRadius="{StaticResource RadiusSmall}" Padding="6,2">
                                                <TextBlock Text="Left-Click" FontSize="{StaticResource FontSizeBadge}" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            </Border>
                                            <TextBlock Text=" Game Card" Foreground="{DynamicResource BrushTextMuted}" FontSize="{StaticResource FontSizeBody}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="Open Game Details (store data, playtime, poster). Keyboard: Enter on a focused card; Ctrl+Enter launches"
                                                   Foreground="{DynamicResource BrushTextSecondary}" FontSize="{StaticResource FontSizeBody}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </DockPanel>

                                    <!-- Row 4b: Select mode -->
                                    <DockPanel Margin="0,0,0,9">
                                        <StackPanel Orientation="Horizontal" Width="200" VerticalAlignment="Center">
                                            <Border Background="{DynamicResource BrushSurfaceHover}" BorderBrush="{DynamicResource BrushBorderStrong}" BorderThickness="1" CornerRadius="{StaticResource RadiusSmall}" Padding="6,2">
                                                <TextBlock Text="Ctrl+Click" FontSize="{StaticResource FontSizeBadge}" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            </Border>
                                            <TextBlock Text=" / " Foreground="{DynamicResource BrushTextMuted}" FontSize="{StaticResource FontSizeBody}" VerticalAlignment="Center"/>
                                            <Border Background="{DynamicResource BrushSurfaceHover}" BorderBrush="{DynamicResource BrushBorderStrong}" BorderThickness="1" CornerRadius="{StaticResource RadiusSmall}" Padding="6,2">
                                                <TextBlock Text="Ctrl+A" FontSize="{StaticResource FontSizeBadge}" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            </Border>
                                            <TextBlock Text=" Game Card" Foreground="{DynamicResource BrushTextMuted}" FontSize="{StaticResource FontSizeBody}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="Select several games (Shift+click for a range), then use the selection bar at the bottom, or right-click one of them for the batch menu: Favorite, Hide, Change Category, Performance Profile, Refresh, or Remove them together. Delete removes the selection; Esc or a click on empty space clears it"
                                                   Foreground="{DynamicResource BrushTextSecondary}" FontSize="{StaticResource FontSizeBody}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </DockPanel>

                                    <!-- Row 5: Game Card Right-Click -->
                                    <DockPanel Margin="0,0,0,9">
                                        <StackPanel Orientation="Horizontal" Width="200" VerticalAlignment="Center">
                                            <Border Background="{DynamicResource BrushSurfaceHover}" BorderBrush="{DynamicResource BrushBorderStrong}" BorderThickness="1" CornerRadius="{StaticResource RadiusSmall}" Padding="6,2">
                                                <TextBlock Text="Right-Click" FontSize="{StaticResource FontSizeBadge}" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            </Border>
                                            <TextBlock Text=" Game Card" Foreground="{DynamicResource BrushTextMuted}" FontSize="{StaticResource FontSizeBody}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="Play, Details, Favorite, Hide; Suspend, Close Game and Force Close while playing; DLSS Override, Performance Profile, CPU Cores and Launch Options; Edit, Steam links, Remove"
                                                   Foreground="{DynamicResource BrushTextSecondary}" FontSize="{StaticResource FontSizeBody}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </DockPanel>

                                    <!-- Row 6: Quick Search -->
                                    <DockPanel Margin="0,0,0,9">
                                        <StackPanel Orientation="Horizontal" Width="200" VerticalAlignment="Center">
                                            <Border Background="{DynamicResource BrushSurfaceHover}" BorderBrush="{DynamicResource BrushBorderStrong}" BorderThickness="1" CornerRadius="{StaticResource RadiusSmall}" Padding="6,2">
                                                <TextBlock Text="Ctrl+F" FontSize="{StaticResource FontSizeBadge}" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Focus the search box on any page that has one"
                                                   Foreground="{DynamicResource BrushTextSecondary}" FontSize="{StaticResource FontSizeBody}" VerticalAlignment="Center"/>
                                    </DockPanel>

                                    <!-- Row 6b: Edit Game's tabs -->
                                    <DockPanel Margin="0,0,0,9">
                                        <StackPanel Orientation="Horizontal" Width="200" VerticalAlignment="Center">
                                            <Border Background="{DynamicResource BrushSurfaceHover}" BorderBrush="{DynamicResource BrushBorderStrong}" BorderThickness="1" CornerRadius="{StaticResource RadiusSmall}" Padding="6,2">
                                                <TextBlock Text="Ctrl+Tab" FontSize="{StaticResource FontSizeBadge}" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Next tab in Edit Game (Ctrl+Shift+Tab goes back)"
                                                   Foreground="{DynamicResource BrushTextSecondary}" FontSize="{StaticResource FontSizeBody}" VerticalAlignment="Center"/>
                                    </DockPanel>

                                    <!-- Row 7: Escape -->
                                    <DockPanel>
                                        <StackPanel Orientation="Horizontal" Width="200" VerticalAlignment="Center">
                                            <Border Background="{DynamicResource BrushSurfaceHover}" BorderBrush="{DynamicResource BrushBorderStrong}" BorderThickness="1" CornerRadius="{StaticResource RadiusSmall}" Padding="8,2">
                                                <TextBlock Text="Esc" FontSize="{StaticResource FontSizeBadge}" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Clear the search and show everything again"
                                                   Foreground="{DynamicResource BrushTextSecondary}" FontSize="{StaticResource FontSizeBody}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============================================== -->
                <!-- CATEGORY 4: SUPPORT & LINKS                    -->
                <!-- ============================================== -->
                <StackPanel Visibility="{Binding ShowAboutSupportSection, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                    <!-- Section Header (shown in All view) -->
                    <Border Margin="0,2,0,8" views:CardSearch.IsHeader="True">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAboutAllTab}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="{StaticResource FontSizeBody}" 
                                       Foreground="{DynamicResource BrushAccentText}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="SUPPORT &amp; LINKS" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushAccentText}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 0: Help Topics index (every embedded Help/**.md, grouped by section) -->
                    <Border CornerRadius="{StaticResource RadiusCard}" Background="{DynamicResource BrushSurface}"
                            BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                            Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Help Topics" FontSize="{StaticResource FontSizeSubhead}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextPrimary}"/>
                            <TextBlock Text="The same explanations that sit behind every Learn more link, in one place."
                                       Foreground="{DynamicResource BrushTextMuted}" FontSize="{StaticResource FontSizeBody}" Margin="0,2,0,10" TextWrapping="Wrap"/>
                            <ItemsControl ItemsSource="{Binding HelpTopicIndex}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Text="{Binding Label}" FontSize="{StaticResource FontSizeBody}" FontWeight="Bold"
                                                       Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4"/>
                                            <ItemsControl ItemsSource="{Binding Topics}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource HelpLinkButton}" Content="{Binding Title}" FontSize="{StaticResource FontSizeBody}"
                                                                Margin="0,0,18,5"
                                                                Command="{x:Static services:HelpCommands.ShowTopic}"
                                                                CommandParameter="{Binding Id}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Card 1: Copy System Info for Bug Reports - what a stuck reader does next, before opening the log -->
                    <Border CornerRadius="{StaticResource RadiusCard}" Background="{DynamicResource BrushSurface}" 
                            BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" 
                            Padding="14,12" Margin="0,0,0,10">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Copy Diagnostic Info" Command="{Binding CopySystemInfoCommand}"
                                        Style="{StaticResource ModernOutlineButton}" Padding="12,5" Margin="0,0,6,0"
                                        ToolTip="Copies the full report as Markdown, ready to paste into a GitHub issue."/>
                                <Button Content="Save Report..." Command="{Binding SaveDiagnosticReportCommand}"
                                        Style="{StaticResource ModernOutlineButton}" Padding="12,5"
                                        ToolTip="Saves the same report as a file, for attaching instead of pasting."/>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="System Environment Report" FontSize="{StaticResource FontSizeSubhead}" FontWeight="SemiBold" 
                                           Foreground="{DynamicResource BrushTextPrimary}"/>
                                <TextBlock Text="Version, install type, Windows build, CPU, GPU, RAM, launcher integrations and whether each client is installed, library counts, the settings that matter to bugs, applied tweaks, any running session, and the last warnings from the log. API keys are never included." 
                                           Foreground="{DynamicResource BrushTextMuted}" FontSize="{StaticResource FontSizeBody}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <!-- Card 2: Centralized Diagnostics Link -->
                    <Border CornerRadius="{StaticResource RadiusCard}" Background="{DynamicResource BrushSurface}"
                            BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                            Padding="14,12" Margin="0,0,0,10">
                        <DockPanel LastChildFill="True">
                            <Button AutomationProperties.Name="Open Diagnostics &amp; Storage" DockPanel.Dock="Right"
                                    Command="{Binding OpenDiagnosticsSettingsCommand}"
                                    Style="{StaticResource ModernAccentButton}"
                                    VerticalAlignment="Center" Padding="12,5">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Open Diagnostics &amp; Storage" VerticalAlignment="Center"/>
                                    <TextBlock Text="&#xE72A;" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource FontSizeBody}" VerticalAlignment="Center" Margin="7,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Diagnostics &amp; Storage" FontSize="{StaticResource FontSizeSubhead}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushTextPrimary}"/>
                                <TextBlock Text="The debug log, verbose logging, data and artwork folders, and Reset Settings live under Settings > Diagnostics &amp; Storage."
                                           Foreground="{DynamicResource BrushTextMuted}" FontSize="{StaticResource FontSizeBody}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>


                    <!-- Card 3: Community & Issues -->
                    <Border CornerRadius="{StaticResource RadiusCard}" Background="{DynamicResource BrushSurface}" 
                            BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" 
                            Padding="14,12" Margin="0,0,0,10">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Report an Issue" Command="{Binding OpenGitHubIssuesCommand}" 
                                        Style="{StaticResource ModernOutlineButton}" VerticalAlignment="Center" Padding="11,5" Margin="0,0,6,0"/>
                                <Button Content="GitHub Repository" Command="{Binding OpenGitHubCommand}" 
                                        Style="{StaticResource ModernOutlineButton}" VerticalAlignment="Center" Padding="11,5"/>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Community &amp; Open Source" FontSize="{StaticResource FontSizeSubhead}" FontWeight="SemiBold" 
                                           Foreground="{DynamicResource BrushTextPrimary}"/>
                                <TextBlock Text="TrayTrigger is open source. Report a bug or suggest a feature on GitHub." 
                                           Foreground="{DynamicResource BrushTextMuted}" FontSize="{StaticResource FontSizeBody}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Card 4: the project's own pages, whatever the update repository is set to. -->
                    <Border CornerRadius="{StaticResource RadiusCard}" Background="{DynamicResource BrushSurface}"
                            BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                            Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Online" FontSize="{StaticResource FontSizeSubhead}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextPrimary}"/>
                            <TextBlock Text="The website, these help pages online, and where to ask a question or see what changed."
                                       Foreground="{DynamicResource BrushTextMuted}" FontSize="{StaticResource FontSizeBody}" Margin="0,2,0,8" TextWrapping="Wrap"/>
                            <WrapPanel>
                                <Button Content="Website" Command="{x:Static services:HelpCommands.OpenUrl}" CommandParameter="https://stephenh678.github.io/TrayTrigger/"
                                        Style="{StaticResource ModernOutlineButton}" Padding="11,5" Margin="0,0,6,6"/>
                                <Button Content="Online Help" Command="{x:Static services:HelpCommands.OpenUrl}" CommandParameter="https://github.com/stephenh678/TrayTrigger/wiki"
                                        Style="{StaticResource ModernOutlineButton}" Padding="11,5" Margin="0,0,6,6"/>
                                <Button Content="Ask a Question" Command="{x:Static services:HelpCommands.OpenUrl}" CommandParameter="https://github.com/stephenh678/TrayTrigger/discussions"
                                        Style="{StaticResource ModernOutlineButton}" Padding="11,5" Margin="0,0,6,6"/>
                                <Button Content="What&apos;s New" Command="{x:Static services:HelpCommands.OpenUrl}" CommandParameter="https://github.com/stephenh678/TrayTrigger/releases"
                                        Style="{StaticResource ModernOutlineButton}" Padding="11,5" Margin="0,0,6,6"/>
                                <Button Content="Security Policy" Command="{x:Static services:HelpCommands.OpenUrl}" CommandParameter="https://github.com/stephenh678/TrayTrigger/blob/main/SECURITY.md"
                                        Style="{StaticResource ModernOutlineButton}" Padding="11,5" Margin="0,0,6,6"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Card search found nothing. -->
        <views:SearchNoMatches Grid.Row="2" Host="{Binding ElementName=AboutCardsPanel}"/>
    </Grid>
</UserControl>
