<UserControl x:Class="TrayTrigger.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:TrayTrigger.Views"
             xmlns:services="clr-namespace:TrayTrigger.Services"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1100">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Category Segmented Tabs -->
            <RowDefinition Height="*"/>    <!-- About Content ScrollViewer -->
        </Grid.RowDefinitions>

        <!-- 1. Header matching Settings, System, Library -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <!-- Right: Version & Status Indicator Badge -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding UpdateStatusIcon}" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="12" 
                           Foreground="{Binding UpdateStatusBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBlock Text="{Binding UpdateStatusBadgeText}" FontSize="11.5" Foreground="{StaticResource BrushTextMuted}" 
                           FontFamily="{StaticResource AppFont}" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Left: Title & Subtitle matching Settings -->
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="About" FontSize="20" Foreground="{StaticResource BrushTextPrimary}" 
                           FontFamily="{StaticResource AppFont}" FontWeight="Normal"/>
                <TextBlock Text="Application overview, key features, keyboard shortcuts, and support links" 
                           FontSize="12" Foreground="{StaticResource BrushTextSecondary}" 
                           FontFamily="{StaticResource AppFont}" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- 2. Category Segmented Tabs, with the card search beside them -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#181820" BorderBrush="{StaticResource BrushBorderDark}"
                BorderThickness="1" CornerRadius="6" Padding="3" HorizontalAlignment="Left"
                views:ScrollToTop.Target="{Binding ElementName=AboutScroll}">
            <StackPanel Orientation="Horizontal">
                <Button Content="All" Command="{Binding SelectAboutAllTabCommand}"
                        Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsAboutAllTab}"/>
                <Button Content="Overview" Command="{Binding SelectAboutOverviewTabCommand}" Margin="2,0,0,0"
                        Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsAboutOverviewTab}"/>
                <Button Content="Key Features" Command="{Binding SelectAboutFeaturesTabCommand}" Margin="2,0,0,0"
                        Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsAboutFeaturesTab}"/>
                <Button Content="Shortcuts" Command="{Binding SelectAboutShortcutsTabCommand}" Margin="2,0,0,0"
                        Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsAboutShortcutsTab}"/>
                <Button Content="Support &amp; Links" Command="{Binding SelectAboutSupportTabCommand}" Margin="2,0,0,0"
                        Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsAboutSupportTab}"/>
            </StackPanel>
        </Border>
        <!-- Card search (Views/CardSearch, Views/SearchBox), as on Settings: it searches the
             selected tab and the text stays as you switch tabs (MainViewModel.AboutSearchText). -->
        <views:SearchBox x:Name="AboutSearchBox" Grid.Column="1" HorizontalAlignment="Left" Margin="12,0,0,0"
                         Text="{Binding AboutSearchText}"/>
        </Grid>

        <!-- 3. About Content ScrollViewer -->
        <ScrollViewer x:Name="AboutScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14"
                      views:ScrollToTop.ResetOn="{Binding CurrentAboutSection}">
            <StackPanel x:Name="AboutCardsPanel" HorizontalAlignment="Stretch" Margin="0,0,12,0"
                        views:CardSearch.Query="{Binding AboutSearchText}"
                        views:CardSearch.Scope="{Binding CurrentAboutSection}">

                <!-- ============================================== -->
                <!-- CATEGORY 1: APPLICATION OVERVIEW               -->
                <!-- ============================================== -->
                <StackPanel Visibility="{Binding ShowAboutOverviewSection, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                    <!-- Section Header (shown in All view) -->
                    <Border Margin="0,2,0,8" views:CardSearch.IsHeader="True">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAboutAllTab}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="12.5" 
                                       Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="APPLICATION OVERVIEW" FontSize="11.5" FontWeight="SemiBold" 
                                       Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Hero Identity Card -->
                    <Border CornerRadius="8" Background="{StaticResource BrushSurfaceDark}" 
                            BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" 
                            Padding="18,16" Margin="0,0,0,10">
                        <DockPanel LastChildFill="True">
                            <Image Source="/Assets/app_icon.png" Width="52" Height="52"
                                   Margin="0,0,18,0" DockPanel.Dock="Left" VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>

                            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0">
                                <!-- GitHub lives under Support & Links; one button here is enough. -->
                                <Button Content="Check for Updates" Command="{Binding CheckForUpdatesCommand}"
                                        Style="{StaticResource ModernAccentButton}" Padding="12,5"/>
                            </StackPanel>

                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- The wordmark: "Trigger" in the logo's blue. Runs on one line, so no space creeps in. -->
                                    <TextBlock FontSize="19" FontWeight="SemiBold" FontFamily="{StaticResource AppFont}"
                                               Foreground="{StaticResource BrushTextPrimary}"><Run Text="Tray"/><Run Text="Trigger" Foreground="{StaticResource BrushBrand}"/></TextBlock>
                                    <Border Background="#1C2E3D" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding AppVersionDisplay}" FontSize="11" Foreground="{StaticResource BrushAccentHover}" FontWeight="SemiBold"/>
                                    </Border>
                                    <Border Background="#1E2028" CornerRadius="4" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text=".NET 10.0" FontSize="10.5" Foreground="#85929E" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Per-game Windows tuning and launch automation, from the tray. Everything reverts when the game exits."
                                           Foreground="{StaticResource BrushTextSecondary}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Environment strip: real values about this install (what a bug report
                         needs), replacing the old marketing labels. -->
                    <Border CornerRadius="8" Background="{StaticResource BrushSurfaceDark}"
                            BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1"
                            Padding="14,12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#17171C" CornerRadius="6" Padding="12,10" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="WINDOWS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding OsDisplay}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="#17171C" CornerRadius="6" Padding="12,10" Margin="3,0,3,0">
                                <StackPanel>
                                    <TextBlock Text="RUNTIME" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding RuntimeDisplay}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="#17171C" CornerRadius="6" Padding="12,10" Margin="3,0,3,0">
                                <StackPanel>
                                    <TextBlock Text="LIBRARY" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding TotalGameCountDisplay}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="3" Background="#17171C" CornerRadius="6" Padding="12,10" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="DATA FOLDER" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding SettingsVM.StorageDirectoryDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ============================================== -->
                <!-- CATEGORY 2: KEY FEATURES                       -->
                <!-- ============================================== -->
                <StackPanel Visibility="{Binding ShowAboutFeaturesSection, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                    <!-- Section Header (shown in All view) -->
                    <Border Margin="0,2,0,8" views:CardSearch.IsHeader="True">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAboutAllTab}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="12.5" 
                                       Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="KEY FEATURES" FontSize="11.5" FontWeight="SemiBold" 
                                       Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Feature grid: seven tiles in the order the README presents the product and a
                         session runs - profile, scripts, launch, tweaks, tray, library, hardware. -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 1: Performance Profiles -->
                        <Border Grid.Row="0" Grid.Column="0" CornerRadius="8" Background="{StaticResource BrushSurfaceDark}"
                                BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" Padding="14,12" Margin="0,0,5,10">
                            <DockPanel LastChildFill="True">
                                <Border Width="34" Height="34" CornerRadius="6" Background="#20202A" Margin="0,0,12,0" VerticalAlignment="Top">
                                    <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                               Foreground="{StaticResource BrushAccentHover}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Performance Profiles" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                    <TextBlock Text="Give each game an Optimized or Aggressive tier: power plan, GPU preference, HDR, Do Not Disturb, process priority, timer resolution, CPU cores. Applied when the game launches, reverted to exactly what it found when it exits, and restored on the next start if anything crashes mid-session."
                                               FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- 2: Scripts -->
                        <Border Grid.Row="0" Grid.Column="1" CornerRadius="8" Background="{StaticResource BrushSurfaceDark}"
                                BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" Padding="14,12" Margin="5,0,0,10">
                            <DockPanel LastChildFill="True">
                                <Border Width="34" Height="34" CornerRadius="6" Background="#20202A" Margin="0,0,12,0" VerticalAlignment="Top">
                                    <TextBlock Text="&#xE756;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                               Foreground="{StaticResource BrushAccentHover}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Pre-Launch &amp; Post-Exit Scripts" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                    <TextBlock Text="Attach your own .bat, .cmd, .ps1 or .exe to any game, or set defaults for all of them: pause Wallpaper Engine, start the OBS replay buffer, close Discord, back up saves. Test Run buttons, per-game arguments, wait and cancel-on-failure, and five real examples ship with the app."
                                               FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- 3: Launcher Control -->
                        <Border Grid.Row="1" Grid.Column="0" CornerRadius="8" Background="{StaticResource BrushSurfaceDark}"
                                BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" Padding="14,12" Margin="0,0,5,10">
                            <DockPanel LastChildFill="True">
                                <Border Width="34" Height="34" CornerRadius="6" Background="#20202A" Margin="0,0,12,0" VerticalAlignment="Top">
                                    <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                               Foreground="{StaticResource BrushAccentHover}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Launcher Control" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                    <TextBlock Text="Launch arguments and Run as Administrator per game. Close Steam, GOG Galaxy, EA, Epic, Ubisoft Connect, the Xbox app or Battle.net when the game exits, and start Steam minimized so only the game appears. A second launch brings the running game forward instead of starting a duplicate; Close Game and Force Close are one click away while it runs."
                                               FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- 4: Windows tweaks -->
                        <Border Grid.Row="1" Grid.Column="1" CornerRadius="8" Background="{StaticResource BrushSurfaceDark}"
                                BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" Padding="14,12" Margin="5,0,0,10">
                            <DockPanel LastChildFill="True">
                                <Border Width="34" Height="34" CornerRadius="6" Background="#20202A" Margin="0,0,12,0" VerticalAlignment="Top">
                                    <TextBlock Text="&#xE90F;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                               Foreground="{StaticResource BrushAccentHover}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Verified, Reversible Windows Tweaks" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                    <TextBlock Text="Twenty documented gaming settings, each showing Windows' real current state and each reverting to exactly what it found. Trade-off-heavy ones (Visual Effects, Nagle's Algorithm) stay off by default and clearly badged; Apply Preset and Restore Previous Settings can take a System Restore Point first."
                                               FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- 5: Tray launcher & hotkeys -->
                        <Border Grid.Row="2" Grid.Column="0" CornerRadius="8" Background="{StaticResource BrushSurfaceDark}"
                                BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" Padding="14,12" Margin="0,0,5,10">
                            <DockPanel LastChildFill="True">
                                <Border Width="34" Height="34" CornerRadius="6" Background="#20202A" Margin="0,0,12,0" VerticalAlignment="Top">
                                    <TextBlock Text="&#xE765;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                               Foreground="{StaticResource BrushAccentHover}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Tray Launcher &amp; Hotkeys" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                    <TextBlock Text="Lives in the tray: Now Playing, Recent, Favorites and every category one right-click away, with a compact layout for a long library. A global hotkey shows the window, and any game can have its own launch hotkey - recorded from the keys you press, and refused up front if another app already has it."
                                               FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- 6: Library -->
                        <Border Grid.Row="2" Grid.Column="1" CornerRadius="8" Background="{StaticResource BrushSurfaceDark}"
                                BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" Padding="14,12" Margin="5,0,0,10">
                            <DockPanel LastChildFill="True">
                                <Border Width="34" Height="34" CornerRadius="6" Background="#20202A" Margin="0,0,12,0" VerticalAlignment="Top">
                                    <TextBlock Text="&#xE753;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                               Foreground="{StaticResource BrushAccentHover}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Seven Launchers, One Library" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                    <TextBlock Text="A dark, Fluent-style library built to look at home on Windows 11: poster art, rounded cards, no menu bar. Scan for Games reads Steam, GOG, EA, Epic, Ubisoft Connect, Xbox / PC Game Pass and Battle.net's own install records, plus any folder you drop on the window. Real titles, Steam metadata and poster art, SteamGridDB and RAWG to fill the gaps, categories, filters, three views and batch editing."
                                               FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- 7: Hardware monitoring, full width -->
                        <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" CornerRadius="8" Background="{StaticResource BrushSurfaceDark}"
                                BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" Padding="14,12" Margin="0,0,0,10">
                            <DockPanel LastChildFill="True">
                                <Border Width="34" Height="34" CornerRadius="6" Background="#20202A" Margin="0,0,12,0" VerticalAlignment="Top">
                                    <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                               Foreground="{StaticResource BrushAccentHover}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Hardware Monitoring" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                    <TextBlock Text="Live CPU and RAM load, plus GPU, VRAM, displays, drives, motherboard, BIOS, OS build and DirectX capability on the System page - so you can sanity-check specs before deciding which profile a game gets."
                                               FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- ============================================== -->
                <!-- CATEGORY 3: SHORTCUTS                          -->
                <!-- ============================================== -->
                <StackPanel Visibility="{Binding ShowAboutShortcutsSection, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                    <!-- Section Header (shown in All view) -->
                    <Border Margin="0,2,0,8" views:CardSearch.IsHeader="True">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAboutAllTab}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="12.5" 
                                       Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="SHORTCUTS" FontSize="11.5" FontWeight="SemiBold" 
                                       Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border CornerRadius="8" Background="{StaticResource BrushSurfaceDark}" 
                            BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" 
                            Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <DockPanel LastChildFill="True" Margin="0,0,0,12">
                                <Button DockPanel.Dock="Right" Content="Configure Hotkey..." 
                                        Command="{Binding NavigateToGeneralSettingsCommand}" 
                                        Style="{StaticResource ModernOutlineButton}" 
                                        VerticalAlignment="Center" Padding="11,5"/>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="Keyboard &amp; Mouse Controls" FontSize="13.5" FontWeight="SemiBold" 
                                               Foreground="{StaticResource BrushTextPrimary}"/>
                                    <TextBlock Text="Convenient hotkeys and mouse actions for lightning-fast library and tray management." 
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- Table Container -->
                            <Border Background="#17171C" CornerRadius="6" Padding="14,10">
                                <StackPanel>
                                    <!-- Row 1: Global Hotkey - shows the configured value, not a hard-coded Ctrl+Alt+G -->
                                    <DockPanel Margin="0,0,0,9">
                                        <StackPanel Orientation="Horizontal" Width="200" VerticalAlignment="Center">
                                            <Border Background="#252532" BorderBrush="#353545" BorderThickness="1" CornerRadius="4" Padding="7,2">
                                                <TextBlock Text="{Binding SettingsVM.GlobalManageHotkey}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushAccentHover}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Show or hide the TrayTrigger window from anywhere in Windows (change it in Settings > General)"
                                                   Foreground="{StaticResource BrushTextSecondary}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </DockPanel>

                                    <!-- Row 1b: Tray menu hotkey - the configured value -->
                                    <DockPanel Margin="0,0,0,9">
                                        <StackPanel Orientation="Horizontal" Width="200" VerticalAlignment="Center">
                                            <Border Background="{StaticResource BrushKeyCapBackground}" BorderBrush="{StaticResource BrushKeyCapBorder}" BorderThickness="1" CornerRadius="4" Padding="7,2">
                                                <TextBlock Text="{Binding SettingsVM.TrayMenuHotkey}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushAccentHover}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Open the tray menu by the tray icon from anywhere in Windows, ready to search (change it in Settings > General)"
                                                   Foreground="{StaticResource BrushTextSecondary}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </DockPanel>

                                    <!-- Row 2: Tray Left-Click -->
                                    <DockPanel Margin="0,0,0,9">
                                        <StackPanel Orientation="Horizontal" Width="200" VerticalAlignment="Center">
                                            <Border Background="#252532" BorderBrush="#353545" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="Left-Click" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                            </Border>
                                            <TextBlock Text=" Tray Icon" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="Show or hide the TrayTrigger window"
                                                   Foreground="{StaticResource BrushTextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                                    </DockPanel>

                                    <!-- Row 3: Tray Right-Click -->
                                    <DockPanel Margin="0,0,0,9">
                                        <StackPanel Orientation="Horizontal" Width="200" VerticalAlignment="Center">
                                            <Border Background="#252532" BorderBrush="#353545" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="Right-Click" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                            </Border>
                                            <TextBlock Text=" Tray Icon" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="Quick-launch menu: a search box (type, then Enter launches the top match), Now Playing, Recent, Favorites, all games (grouped or flat), Scan for Games, Settings, Exit"
                                                   Foreground="{StaticResource BrushTextSecondary}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </DockPanel>

                                    <!-- Row 4: Game Card Left-Click -->
                                    <DockPanel Margin="0,0,0,9">
                                        <StackPanel Orientation="Horizontal" Width="200" VerticalAlignment="Center">
                                            <Border Background="#252532" BorderBrush="#353545" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="Left-Click" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                            </Border>
                                            <TextBlock Text=" Game Card" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="Open Game Details (store data, playtime, box art). Keyboard: Enter on a focused card; Ctrl+Enter launches"
                                                   Foreground="{StaticResource BrushTextSecondary}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </DockPanel>

                                    <!-- Row 4b: Select mode -->
                                    <DockPanel Margin="0,0,0,9">
                                        <StackPanel Orientation="Horizontal" Width="200" VerticalAlignment="Center">
                                            <Border Background="#252532" BorderBrush="#353545" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="Ctrl+Click" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                            </Border>
                                            <TextBlock Text=" / " Foreground="{StaticResource BrushTextMuted}" FontSize="11" VerticalAlignment="Center"/>
                                            <Border Background="#252532" BorderBrush="#353545" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="Ctrl+A" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                            </Border>
                                            <TextBlock Text=" Game Card" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="Select several games (Shift+click for a range), then use the selection bar at the bottom, or right-click one of them for the batch menu: Favorite, Hide, Change Category, Performance Profile, Refresh, or Remove them together. Delete removes the selection; Esc or a click on empty space clears it"
                                                   Foreground="{StaticResource BrushTextSecondary}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </DockPanel>

                                    <!-- Row 5: Game Card Right-Click -->
                                    <DockPanel Margin="0,0,0,9">
                                        <StackPanel Orientation="Horizontal" Width="200" VerticalAlignment="Center">
                                            <Border Background="#252532" BorderBrush="#353545" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="Right-Click" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                            </Border>
                                            <TextBlock Text=" Game Card" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="Play, Details, Favorite, Hide, Close Game / Force Close while playing, edit shortcuts, Steam links, Remove"
                                                   Foreground="{StaticResource BrushTextSecondary}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </DockPanel>

                                    <!-- Row 6: Quick Search -->
                                    <DockPanel Margin="0,0,0,9">
                                        <StackPanel Orientation="Horizontal" Width="200" VerticalAlignment="Center">
                                            <Border Background="#252532" BorderBrush="#353545" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,3,0">
                                                <TextBlock Text="Ctrl" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                            </Border>
                                            <TextBlock Text="+" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                            <Border Background="#252532" BorderBrush="#353545" BorderThickness="1" CornerRadius="4" Padding="7,2">
                                                <TextBlock Text="F" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushAccentHover}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Focus the search box in the Games Library, Settings or About"
                                                   Foreground="{StaticResource BrushTextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                                    </DockPanel>

                                    <!-- Row 7: Escape -->
                                    <DockPanel>
                                        <StackPanel Orientation="Horizontal" Width="200" VerticalAlignment="Center">
                                            <Border Background="#252532" BorderBrush="#353545" BorderThickness="1" CornerRadius="4" Padding="8,2">
                                                <TextBlock Text="Esc" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Clear the search and show everything again"
                                                   Foreground="{StaticResource BrushTextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============================================== -->
                <!-- CATEGORY 4: SUPPORT & LINKS                    -->
                <!-- ============================================== -->
                <StackPanel Visibility="{Binding ShowAboutSupportSection, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                    <!-- Section Header (shown in All view) -->
                    <Border Margin="0,2,0,8" views:CardSearch.IsHeader="True">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAboutAllTab}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="12.5" 
                                       Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="SUPPORT &amp; LINKS" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 0: Help Topics index (every embedded Help/**.md, grouped by section) -->
                    <Border CornerRadius="8" Background="{StaticResource BrushSurfaceDark}"
                            BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1"
                            Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Help Topics" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextPrimary}"/>
                            <TextBlock Text="The same explanations that sit behind every Learn more link, in one place."
                                       Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,2,0,10" TextWrapping="Wrap"/>
                            <ItemsControl ItemsSource="{Binding HelpTopicIndex}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="Bold"
                                                       Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4"/>
                                            <ItemsControl ItemsSource="{Binding Topics}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource HelpLinkButton}" Content="{Binding Title}" FontSize="11.5"
                                                                Margin="0,0,18,5"
                                                                Command="{x:Static services:HelpCommands.ShowTopic}"
                                                                CommandParameter="{Binding Id}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Card 1: Copy System Info for Bug Reports - what a stuck reader does next, before opening the log -->
                    <Border CornerRadius="8" Background="{StaticResource BrushSurfaceDark}" 
                            BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" 
                            Padding="14,12" Margin="0,0,0,10">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Copy Diagnostic Info" Command="{Binding CopySystemInfoCommand}"
                                        Style="{StaticResource ModernOutlineButton}" Padding="12,5" Margin="0,0,6,0"
                                        ToolTip="Copies the full report as Markdown, ready to paste into a GitHub issue."/>
                                <Button Content="Save Report..." Command="{Binding SaveDiagnosticReportCommand}"
                                        Style="{StaticResource ModernOutlineButton}" Padding="12,5"
                                        ToolTip="Saves the same report as a file, for attaching instead of pasting."/>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="System Environment Report" FontSize="13.5" FontWeight="SemiBold" 
                                           Foreground="{StaticResource BrushTextPrimary}"/>
                                <TextBlock Text="Version, install type, Windows build, CPU, GPU, RAM, launcher integrations and whether each client is installed, library counts, the settings that matter to bugs, applied tweaks, any running session, and the last warnings from the log. API keys are never included." 
                                           Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <!-- Card 2: Centralized Diagnostics Link -->
                    <Border CornerRadius="8" Background="{StaticResource BrushSurfaceDark}"
                            BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1"
                            Padding="14,12" Margin="0,0,0,10">
                        <DockPanel LastChildFill="True">
                            <Button AutomationProperties.Name="Open Diagnostics &amp; Storage" DockPanel.Dock="Right"
                                    Command="{Binding OpenDiagnosticsSettingsCommand}"
                                    Style="{StaticResource ModernAccentButton}"
                                    VerticalAlignment="Center" Padding="12,5">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Open Diagnostics &amp; Storage" VerticalAlignment="Center"/>
                                    <TextBlock Text="&#xE72A;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" Margin="7,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Diagnostics &amp; Storage" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushTextPrimary}"/>
                                <TextBlock Text="The debug log, verbose logging, data and artwork folders, and Reset Settings live under Settings › Diagnostics &amp; Storage."
                                           Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>


                    <!-- Card 3: Community & Issues -->
                    <Border CornerRadius="8" Background="{StaticResource BrushSurfaceDark}" 
                            BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" 
                            Padding="14,12" Margin="0,0,0,10">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Report an Issue" Command="{Binding OpenGitHubIssuesCommand}" 
                                        Style="{StaticResource ModernOutlineButton}" VerticalAlignment="Center" Padding="11,5" Margin="0,0,6,0"/>
                                <Button Content="GitHub Repository" Command="{Binding OpenGitHubCommand}" 
                                        Style="{StaticResource ModernOutlineButton}" VerticalAlignment="Center" Padding="11,5"/>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Community &amp; Open Source" FontSize="13.5" FontWeight="SemiBold" 
                                           Foreground="{StaticResource BrushTextPrimary}"/>
                                <TextBlock Text="TrayTrigger is open source software. Submit bug reports, suggest features, or explore the documentation on GitHub." 
                                           Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Card search found nothing. -->
        <views:SearchNoMatches Grid.Row="2" Host="{Binding ElementName=AboutCardsPanel}"/>
    </Grid>
</UserControl>
