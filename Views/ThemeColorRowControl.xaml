<UserControl x:Class="TrayTrigger.Views.ThemeColorRowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:TrayTrigger.Views"
             Focusable="False">
    <!-- One color of the theme: a swatch that opens the picker, its name and what it colors, and a #RRGGBB box.
         The DataContext is a ThemeColorRow. -->
    <Grid Margin="0,5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ToggleButton x:Name="SwatchButton" Grid.Column="0" Width="30" Height="30" Margin="0,0,10,0" Cursor="Hand" VerticalAlignment="Center"
                      FocusVisualStyle="{StaticResource KeyboardFocusRing}"
                      AutomationProperties.Name="{Binding Label, StringFormat={}{0} color: open the picker}"
                      ToolTip="Pick a color">
            <!-- While the picker is open the click that closes it (anywhere outside, this swatch included) must not also reach the
                 swatch: it would check the button again and the picker would shut and open straight away. -->
            <ToggleButton.Style>
                <Style TargetType="ToggleButton">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsOpen, ElementName=PickerPopup}" Value="True">
                            <Setter Property="IsHitTestVisible" Value="False"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ToggleButton.Style>
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="swatch" CornerRadius="{StaticResource RadiusControl}" BorderThickness="1"
                            BorderBrush="{DynamicResource BrushBorderStrong}" Background="{Binding Swatch}"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="swatch" Property="BorderBrush" Value="{DynamicResource BrushTextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="swatch" Property="BorderBrush" Value="{DynamicResource BrushAccentHover}"/>
                            <Setter TargetName="swatch" Property="BorderThickness" Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
        </ToggleButton>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Label}" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                <!-- Marks a color that makes some text hard to read. An icon, and the reason on hover and to a screen reader: not color alone. -->
                <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource FontSizeBody}" Margin="6,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource BrushWarning}" ToolTip="{Binding ContrastNote}"
                           Visibility="{Binding HasContrastIssue, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
            <TextBlock Text="{Binding Description}" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}" TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <TextBox x:Name="HexBox" Grid.Column="2" Width="96" VerticalAlignment="Center" MaxLength="9"
                 Text="{Binding Hex, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.Name="{Binding Label, StringFormat={}{0} color as #RRGGBB}"
                 AutomationProperties.HelpText="{Binding ContrastNote}"
                 LostFocus="HexBox_LostFocus" KeyDown="HexBox_KeyDown">
            <TextBox.Style>
                <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasContrastIssue}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource BrushWarning}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBox.Style>
        </TextBox>

        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Error}" Margin="0,3,0,0" TextWrapping="Wrap"
                   FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushDanger}" AutomationProperties.LiveSetting="Polite"
                   Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>

        <!-- The picker opens under the swatch and closes when you click anywhere else or press Esc. -->
        <Popup x:Name="PickerPopup" PlacementTarget="{Binding ElementName=SwatchButton}" Placement="Bottom" VerticalOffset="6"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
               IsOpen="{Binding IsChecked, ElementName=SwatchButton, Mode=TwoWay}" Opened="PickerPopup_Opened">
            <Border Margin="0,0,8,8" Padding="12" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorderStrong}"
                    BorderThickness="1" CornerRadius="{StaticResource RadiusCard}" PreviewKeyDown="Picker_PreviewKeyDown">
                <views:ColorPickerPanel x:Name="Picker" Color="{Binding Color, Mode=TwoWay}" OriginalColor="{Binding Original}" Suggestions="{Binding Suggestions}"/>
            </Border>
        </Popup>
    </Grid>
</UserControl>
