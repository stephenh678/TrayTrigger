<Window x:Class="TrayTrigger.Views.GameEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Edit Game Configuration"
        Height="640" Width="550"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource BrushDialogBg}"
        Foreground="{StaticResource BrushTextPrimary}">

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Form Fields -->
            <RowDefinition Height="Auto"/> <!-- Action Buttons -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Edit Game Details" FontSize="17" Foreground="{StaticResource BrushTextPrimary}" 
                           FontFamily="{StaticResource AppFont}" FontWeight="Normal"/>
                <TextBlock Text="Configure game icon, launch arguments, hotkeys, and administrative elevation" 
                           FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" 
                           FontFamily="{StaticResource AppFont}" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- Form ScrollViewer -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0" Margin="0,0,0,12">
            <StackPanel>
                <!-- Visual Assets: Icon & Poster Artwork -->
                <Border Background="#16161B" BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" 
                        CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Game Icon (52x52) -->
                        <Grid Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="8" Width="50" Height="50" 
                                    Background="#202028" BorderBrush="#2C2C38" BorderThickness="1" 
                                    Margin="0,0,10,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image Source="{Binding IconPreview}" Width="42" Height="42" 
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Game Icon" FontSize="12" FontWeight="SemiBold" 
                                           Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,1"/>
                                <TextBlock Text="Executable &amp; tray icon" FontSize="10.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,5"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Change..." Command="{Binding BrowseIconCommand}" 
                                            Style="{StaticResource ModernOutlineButton}" Padding="8,3" FontSize="11" Margin="0,0,6,0"/>
                                    <Button Content="Reset" Command="{Binding ResetIconCommand}" 
                                            Style="{StaticResource ModernGhostButton}" Padding="6,3" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- Subtle Divider -->
                        <Rectangle Grid.Column="1" Width="1" Fill="#282835" Margin="10,2"/>

                        <!-- Right: Poster Artwork (Vertical 600x900) -->
                        <Grid Grid.Column="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="6" Width="44" Height="66" 
                                    Background="#202028" BorderBrush="#2C2C38" BorderThickness="1" 
                                    Margin="0,0,10,0" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True">
                                <Grid>
                                    <Image Source="{Binding CoverPreview}" Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock Text="POSTER" FontSize="8" FontWeight="SemiBold" Foreground="#66FFFFFF" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasCoverPreview}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Poster Artwork" FontSize="12" FontWeight="SemiBold" 
                                           Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,1"/>
                                <TextBlock Text="600×900 vertical poster" FontSize="10.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,5"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Change..." Command="{Binding BrowseCoverCommand}" 
                                            Style="{StaticResource ModernOutlineButton}" Padding="8,3" FontSize="11" Margin="0,0,6,0"/>
                                    <Button Content="Reset" Command="{Binding ResetCoverCommand}" 
                                            Style="{StaticResource ModernGhostButton}" Padding="6,3" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Title -->
                <DockPanel Margin="0,0,0,4">
                    <TextBlock Text="Game Title" FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" 
                               VerticalAlignment="Center" DockPanel.Dock="Left"/>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button Content="Search Online 🔍" Command="{Binding FetchOfficialNameOnlineCommand}" 
                                Style="{StaticResource ModernGhostButton}" Margin="0,0,6,0"
                                Padding="8,2" FontSize="10.5" ToolTip="Search Steam database for the official commercial title"/>
                        <Button Content="From .exe" Command="{Binding FetchNameFromExeCommand}" 
                                Style="{StaticResource ModernGhostButton}" 
                                Padding="8,2" FontSize="10.5" ToolTip="Extract clean title directly from executable metadata"/>
                    </StackPanel>
                </DockPanel>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Margin="0,0,0,10"/>

                <!-- Category -->
                <TextBlock Text="Category (choose or type new)" FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding ExistingCategories}" 
                          Text="{Binding Category, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                          IsEditable="True"
                          Style="{StaticResource ModernComboBox}" Margin="0,0,0,10"/>

                <!-- Executable Path -->
                <TextBlock Text="Executable or Target Path" FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding ExecutablePath, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource ModernTextBox}" Margin="0,0,8,0"/>
                    <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseExeCommand}" 
                            Style="{StaticResource ModernOutlineButton}"/>
                </Grid>

                <!-- Arguments -->
                <TextBlock Text="Launch Arguments" FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{StaticResource ModernTextBox}" Margin="0,0,0,10"/>

                <!-- Working Directory -->
                <TextBlock Text="Working Directory" FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource ModernTextBox}" Margin="0,0,8,0"/>
                    <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseWorkDirCommand}" 
                            Style="{StaticResource ModernOutlineButton}"/>
                </Grid>

                <!-- Hotkey -->
                <TextBlock Text="Global Hotkey (e.g. Ctrl+Alt+D, F10)" FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Hotkey, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{StaticResource ModernTextBox}" Margin="0,0,0,10"/>

                <!-- Run as Admin -->
                <CheckBox Content="Run as Administrator (UAC elevation)" IsChecked="{Binding RunAsAdmin}" 
                          Style="{StaticResource ModernCheckBox}" Margin="0,0,0,10"/>

                <!-- Steam Info if Steam Game -->
                <Border CornerRadius="6" Background="#16222E" BorderBrush="#1C3852" BorderThickness="1" 
                        Padding="12" Margin="0,4,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSteamGame}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="Steam Integrated Game" Foreground="{StaticResource BrushAccentHover}" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding SteamAppIdDisplay}" 
                                   Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,3,0,0"/>
                        <TextBlock Text="Launched directly through Steam protocol; playtime is managed by Steam." 
                                   Foreground="{StaticResource BrushTextMuted}" FontSize="10.5" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <DockPanel Grid.Row="2" LastChildFill="False">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="Cancel" Command="{Binding CancelCommand}" 
                        Style="{StaticResource ModernGhostButton}" Margin="0,0,8,0"/>
                <Button Content="Save Changes" Command="{Binding SaveCommand}" 
                        Style="{StaticResource ModernAccentButton}"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
