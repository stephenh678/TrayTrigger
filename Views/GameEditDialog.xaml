<Window x:Class="TrayTrigger.Views.GameEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:services="clr-namespace:TrayTrigger.Services"
        mc:Ignorable="d"
        Title="Edit Game Configuration"
        Height="660" Width="820"
        MinHeight="600" MinWidth="760"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource BrushDialogBg}"
        Foreground="{StaticResource BrushTextPrimary}"
        FontFamily="{StaticResource AppFont}">

    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Subtle Divider -->
            <RowDefinition Height="*"/>    <!-- 2-Column Body -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- ============================================================== -->
        <!-- HEADER                                                         -->
        <!-- ============================================================== -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12" VerticalAlignment="Center">
            <TextBlock Text="Edit Game Configuration" FontSize="18" FontWeight="SemiBold" 
                       Foreground="{StaticResource BrushTextPrimary}"/>
            <TextBlock Text="Artwork, title and store link, launch path and hotkey, per-game performance profile, scripts, and launcher options"
                       FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Divider -->
        <Rectangle Grid.Row="1" Height="1" Fill="{StaticResource BrushBorderDark}" Margin="0,0,0,14"/>

        <!-- ============================================================== -->
        <!-- TWO-COLUMN BODY                                                -->
        <!-- ============================================================== -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/> <!-- Left: Visual Artwork Assets -->
                <ColumnDefinition Width="*"/>   <!-- Right: Configuration Cards -->
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: VISUAL ARTWORK & ASSETS -->
            <Border Grid.Column="0" Background="#16161D" BorderBrush="{StaticResource BrushBorderDark}" 
                    BorderThickness="1" CornerRadius="8" Padding="14" VerticalAlignment="Stretch">
                <DockPanel LastChildFill="True">
                    <!-- Section: Poster Artwork -->
                    <StackPanel DockPanel.Dock="Top">
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="POSTER ARTWORK" FontSize="11" FontWeight="SemiBold" 
                                       Foreground="{StaticResource BrushTextSecondary}" DockPanel.Dock="Left"/>
                            <TextBlock Text="2:3 Ratio" FontSize="10" Foreground="{StaticResource BrushTextMuted}" 
                                       DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </DockPanel>

                        <!-- Poster Artwork Frame (170 x 255) -->
                        <Border Width="170" Height="255" CornerRadius="6" Background="#111116"
                                BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1"
                                HorizontalAlignment="Center">
                            <Border.Clip>
                                <RectangleGeometry Rect="0,0,168,253" RadiusX="5" RadiusY="5"/>
                            </Border.Clip>
                            <Grid>
                                <!-- Fallback / Empty Placeholder -->
                                <Border Background="#15151C" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasCoverPreview}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="🖼" FontSize="26" HorizontalAlignment="Center" Opacity="0.4" Margin="0,0,0,6"/>
                                        <TextBlock Text="NO POSTER" FontSize="11" FontWeight="SemiBold" 
                                                   Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="600 × 900" FontSize="9.5" Foreground="{StaticResource BrushTextMuted}" 
                                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Ambient Blurred Background Fill -->
                                <Image Source="{Binding CoverPreview}" Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="LowQuality">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasCoverPreview}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                    <Image.Effect>
                                        <BlurEffect Radius="24" RenderingBias="Performance"/>
                                    </Image.Effect>
                                </Image>
                                <Border Background="#550E0E14"/>

                                <!-- Crisp Centered Poster -->
                                <Image Source="{Binding CoverPreview}" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasCoverPreview}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                            </Grid>
                        </Border>

                        <!-- Poster Action Buttons -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Change..." Command="{Binding BrowseCoverCommand}"
                                    Style="{StaticResource ModernOutlineButton}" Padding="6,4" FontSize="11" Margin="0,0,4,0"/>
                            <Button Grid.Column="1" Content="Reset" Command="{Binding ResetCoverCommand}"
                                    Style="{StaticResource ModernGhostButton}" Padding="6,4" FontSize="11" Margin="0,0,4,0"/>
                            <Button Grid.Column="2" Command="{Binding RefreshPosterCommand}"
                                    Style="{StaticResource ModernGhostButton}" Padding="6,4" FontSize="11"
                                    ToolTip="Re-download the official poster for the linked Steam App ID"
                                    AutomationProperties.Name="Refresh poster">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="12"/>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- Divider -->
                    <Rectangle DockPanel.Dock="Top" Height="1" Fill="#242430" Margin="0,14,0,12"/>

                    <!-- Section: Game Icon -->
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="GAME ICON" FontSize="11" FontWeight="SemiBold" 
                                   Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,8"/>
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="48" Height="48" CornerRadius="6" 
                                    Background="#202028" BorderBrush="#2C2C38" BorderThickness="1"
                                    Margin="0,0,10,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image Source="{Binding IconPreview}" Width="36" Height="36" 
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Tray &amp; list icon" FontSize="10.5" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,5"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Change..." Command="{Binding BrowseIconCommand}" 
                                            Style="{StaticResource ModernOutlineButton}" Padding="6,3" FontSize="11" Margin="0,0,4,0"/>
                                    <Button Content="Reset" Command="{Binding ResetIconCommand}"
                                            Style="{StaticResource ModernGhostButton}" Padding="6,3" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- RIGHT COLUMN: CONFIGURATION CARDS (SCROLLABLE) -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="14,0,4,0">
                <StackPanel>

                    <!-- CARD 1: IDENTITY & STEAM ENRICHMENT -->
                    <Border Background="#16161D" BorderBrush="{StaticResource BrushBorderDark}" 
                            BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Identity &amp; Store Metadata" FontSize="12.5" FontWeight="SemiBold" 
                                       Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,10"/>

                            <!-- Game Title -->
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="Game Title" FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" 
                                           VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Button Content="Search Online 🔍" Command="{Binding FetchOfficialNameOnlineCommand}"
                                            Style="{StaticResource ModernGhostButton}" Margin="0,0,6,0"
                                            Padding="8,2" FontSize="10.5"/>
                                    <Button Content="From .exe" Command="{Binding FetchNameFromExeCommand}"
                                            Style="{StaticResource ModernGhostButton}"
                                            Padding="8,2" FontSize="10.5"/>
                                </StackPanel>
                            </DockPanel>
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource ModernTextBox}" Margin="0,0,0,10"/>

                            <!-- Category -->
                            <TextBlock Text="Category (choose existing or type a custom tag)" FontSize="11.5" 
                                       Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding ExistingCategories}"
                                      Text="{Binding Category, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True"
                                      Style="{StaticResource ModernComboBox}" Margin="0,0,0,12"/>

                            <!-- Steam App ID Search & Linking -->
                            <Border Background="#131B26" BorderBrush="#1C3852" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="Steam App ID (Metadata &amp; Poster Sync)" FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrushAccentHover}" DockPanel.Dock="Left"/>
                                        <TextBlock Text="Keeps local launch target" FontSize="10.5" Foreground="{StaticResource BrushTextMuted}"
                                                   DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                    <TextBlock Text="Enrich this game with high-res vertical box art, Steam reviews, specs, and news. Linking an App ID does not require Steam to run."
                                               FontSize="10.5" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding SteamAppId, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ModernTextBox}" Margin="0,0,8,0"/>
                                        <Button Grid.Column="1" Content="Fetch by ID" Command="{Binding FetchBySteamIdCommand}"
                                                Style="{StaticResource ModernOutlineButton}" Padding="12,4"/>
                                    </Grid>

                                    <!-- Launch through Steam: offered only while the entry has no launcher
                                         platform. Ticking it makes this a Steam-linked game and the launcher
                                         box below takes over (with "launch this executable directly"), so
                                         there is never more than one launch-route control on screen. -->
                                    <StackPanel Margin="0,2,0,6" Visibility="{Binding CanOfferSteamLaunch, Converter={StaticResource BoolToVis}}">
                                        <CheckBox Content="Launch through the Steam client (steam://rungameid/) instead of the executable"
                                                  IsChecked="{Binding IsSteamGame}"
                                                  Style="{StaticResource ModernCheckBox}"/>
                                        <TextBlock Text="Only for a game installed in your Steam library - keeps Steam's overlay, cloud saves, and playtime. Leave it off for a standalone game that merely shares a Steam listing."
                                                   FontSize="10.5" Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap" Margin="22,3,0,0"/>
                                    </StackPanel>

                                    <!-- Force Apply Steam Overlay Tag Option - pointless for a game that already
                                         launches through Steam (its card carries the badge anyway). -->
                                    <StackPanel Margin="0,2,0,2" Visibility="{Binding CanOfferSteamBadge, Converter={StaticResource BoolToVis}}">
                                        <CheckBox Content="Show the Steam badge on this game's card"
                                                  IsChecked="{Binding ForceSteamOverlayTag}"
                                                  Style="{StaticResource ModernCheckBox}"/>
                                        <TextBlock Text="Marks the library card with the Steam logo even though the game launches from its executable."
                                                   FontSize="10.5" Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap" Margin="22,3,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- CARD 2: LAUNCH & FILE PATHS -->
                    <Border Background="#16161D" BorderBrush="{StaticResource BrushBorderDark}" 
                            BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Launch Configuration &amp; Paths" FontSize="12.5" FontWeight="SemiBold" 
                                       Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,10"/>

                            <!-- Executable Path -->
                            <TextBlock Text="Executable / Shortcut Target" FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding ExecutablePath, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource ModernTextBox}" Margin="0,0,8,0"/>
                                <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseExeCommand}" 
                                        Style="{StaticResource ModernOutlineButton}"/>
                            </Grid>

                            <!-- Working Directory -->
                            <TextBlock Text="Working Directory" FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource ModernTextBox}" Margin="0,0,8,0"/>
                                <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseWorkDirCommand}" 
                                        Style="{StaticResource ModernOutlineButton}"/>
                            </Grid>

                            <!-- Launch Arguments -->
                            <TextBlock Text="Launch Arguments (optional command-line parameters)" FontSize="11.5"
                                       Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBox}"/>
                            <TextBlock Text="{Binding ArgumentsHint}" FontSize="10.5" Foreground="{StaticResource BrushTextMuted}"
                                       TextWrapping="Wrap" Margin="0,4,0,10"/>

                            <!-- Hotkey: a launch setting, so it lives with the launch path rather than
                                 under "privileges". -->
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <TextBlock Text="Global Launch Hotkey" FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}"/>
                                    <TextBlock Text="Press it anywhere in Windows to launch this game (e.g. Ctrl+Alt+D, F10). Leave blank for none." FontSize="10.5" Foreground="{StaticResource BrushTextMuted}"/>
                                </StackPanel>
                                <TextBox DockPanel.Dock="Right" Text="{Binding Hotkey, UpdateSourceTrigger=LostFocus}"
                                         Style="{StaticResource ModernTextBox}" Width="160" HorizontalAlignment="Right"
                                         Tag="Ctrl+Alt+…"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- CARD 2a: PERFORMANCE (session-scoped tweaks) - its own card so the profile
                         is explained where it is chosen instead of only on the System page. -->
                    <Border Background="#16161D" BorderBrush="{StaticResource BrushBorderDark}"
                            BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Performance" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,10"/>

                            <TextBlock Text="Performance Profile" FontSize="11.5"
                                       Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding PerformanceProfileOptions}"
                                      SelectedItem="{Binding PerformanceProfile}"
                                      Style="{StaticResource ModernComboBox}" Margin="0,0,0,4"/>
                            <TextBlock Text="Applied when this game launches and reverted when it exits. Off: nothing changes. Optimized: full-clock power plan and high-performance GPU preference. Aggressive: Optimized plus MMCSS scheduling, Above Normal priority, and a 0.5 ms timer. Which tweaks each tier includes is set under System &gt; Performance Profiles."
                                       FontSize="10.5" Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <Button Style="{StaticResource HelpLinkButton}" Content="How profiles work" Margin="0,0,0,12"
                                    Command="{x:Static services:HelpCommands.ShowTopic}" CommandParameter="profiles/overview"/>

                            <!-- CPU affinity (hybrid CPUs) - independent of the profile tier -->
                            <TextBlock Text="CPU Cores (hybrid Intel 12th gen+ / similar)" FontSize="11.5"
                                       Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding CpuAffinityOptions}"
                                      SelectedValue="{Binding CpuAffinity}" SelectedValuePath="Value" DisplayMemberPath="Label"
                                      Style="{StaticResource ModernComboBox}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding CpuAffinityHint}" FontSize="10.5" Foreground="{StaticResource BrushTextMuted}"
                                       TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <Button Style="{StaticResource HelpLinkButton}"
                                    Command="{x:Static services:HelpCommands.ShowTopic}" CommandParameter="profiles/cpu_affinity"/>
                        </StackPanel>
                    </Border>

                    <!-- Scripts stub: when the scripts feature is off, say so instead of silently
                         omitting the card, so the feature is discoverable from here. -->
                    <Border Background="#16161D" BorderBrush="{StaticResource BrushBorderDark}"
                            BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12"
                            Visibility="{Binding ShowScriptsStub, Converter={StaticResource BoolToVis}}">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Style="{StaticResource HelpLinkButton}" Content="What scripts can do" VerticalAlignment="Center" Margin="12,0,0,0"
                                    Command="{x:Static services:HelpCommands.ShowTopic}" CommandParameter="scripts/overview"/>
                            <TextBlock FontSize="10.5" Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap" VerticalAlignment="Center">
                                <Run Text="Pre-Launch &amp; Post-Exit Scripts" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}"/>
                                <Run Text=" are hidden. Turn them on under Settings › Launch &amp; Performance to run your own script before this game starts and after it exits."/>
                            </TextBlock>
                        </DockPanel>
                    </Border>

                    <!-- CARD 2b: PRE-LAUNCH / POST-EXIT SCRIPTS (opt-in via Settings > Launch &
                         Performance, or always shown for a game that already has a script) -->
                    <Border Background="#16161D" BorderBrush="{StaticResource BrushBorderDark}"
                            BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12"
                            Visibility="{Binding ShowScriptsCard, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Pre-Launch &amp; Post-Exit Scripts" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4"/>
                            <TextBlock Text="Run your own .bat, .cmd, .ps1, .exe, or .com before this game starts and after it exits. Hide this card under Settings › Launch &amp; Performance."
                                       FontSize="10.5" Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                            <!-- Pre-launch script -->
                            <TextBlock Text="Pre-Launch Script (runs just before the game starts)" FontSize="11.5"
                                       Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding PreLaunchScriptPath, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBox}" Margin="0,0,8,0"/>
                                <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowsePreLaunchScriptCommand}"
                                        Style="{StaticResource ModernOutlineButton}"/>
                            </Grid>

                            <!-- Post-exit script -->
                            <TextBlock Text="Post-Exit Script (runs after the game closes)" FontSize="11.5"
                                       Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding PostExitScriptPath, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBox}" Margin="0,0,8,0"/>
                                <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowsePostExitScriptCommand}"
                                        Style="{StaticResource ModernOutlineButton}"/>
                            </Grid>
                            <TextBlock Text="Post-exit runs for .exe launches, Steam games, and GOG / EA / Epic / Ubisoft games launched through their client. Only a bare launcher link (a dropped .url with no platform ID) has no exit signal and supports pre-launch only."
                                       FontSize="10.5" Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                            <Border Background="#3A2A12" BorderBrush="#8A6A2A" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,10"
                                    Visibility="{Binding ShowScriptsDisabledNotice, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Game scripts are turned off in Settings › Launch &amp; Performance, so these scripts will NOT run until that switch is back on."
                                           FontSize="10.5" Foreground="#FFD27F" TextWrapping="Wrap"/>
                            </Border>

                            <!-- Options stay greyed out until a script path is set, so an empty
                                 card doesn't read as "something is configured". -->
                            <CheckBox Content="Wait for the pre-launch script to finish before starting the game"
                                      IsChecked="{Binding WaitForPreLaunchScript}" IsEnabled="{Binding HasPreLaunchScript}"
                                      Style="{StaticResource ModernCheckBox}" Margin="0,0,0,6"/>
                            <DockPanel Margin="22,0,0,6" LastChildFill="True" IsEnabled="{Binding HasPreLaunchScript}">
                                <TextBox DockPanel.Dock="Left" Width="64" Text="{Binding PreLaunchScriptTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBox}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding PreLaunchTimeoutHint}" FontSize="10.5" Foreground="{StaticResource BrushTextMuted}"
                                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </DockPanel>
                            <CheckBox Content="Cancel the launch if the pre-launch script fails (non-zero exit code, timeout, or won't start)"
                                      IsChecked="{Binding AbortLaunchOnScriptFailure}" IsEnabled="{Binding HasPreLaunchScript}"
                                      Style="{StaticResource ModernCheckBox}" Margin="0,0,0,6"
                                      ToolTip="Use this when the script is a precondition - e.g. it must close another app or switch a device before the game may start. Turning it on also turns on waiting."/>
                            <CheckBox Content="Run scripts hidden (no console window)"
                                      IsChecked="{Binding RunScriptsHidden}" IsEnabled="{Binding HasAnyScript}"
                                      Style="{StaticResource ModernCheckBox}" Margin="0,0,0,6"/>
                            <CheckBox Content="Run scripts as Administrator (UAC prompt on every launch)"
                                      IsChecked="{Binding RunScriptsAsAdmin}" IsEnabled="{Binding HasAnyScript}"
                                      Style="{StaticResource ModernCheckBox}" Margin="0,0,0,8"/>

                            <TextBlock Text="Any script works as-is. Optionally, your script can read the game name and phase it was called for."
                                       FontSize="10.5" Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap"/>
                            <Button Style="{StaticResource HelpLinkButton}" Content="Script guide &amp; examples" Margin="0,4,0,0"
                                    Command="{x:Static services:HelpCommands.ShowTopic}" CommandParameter="scripts/overview"/>
                        </StackPanel>
                    </Border>

                    <!-- CARD 3: PRIVILEGES & LAUNCHER -->
                    <Border Background="#16161D" BorderBrush="{StaticResource BrushBorderDark}"
                            BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Privileges &amp; Launcher" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,10"/>

                            <!-- Run As Admin -->
                            <CheckBox Content="Run as Administrator (requests elevated UAC permissions)" 
                                      IsChecked="{Binding RunAsAdmin}" 
                                      Style="{StaticResource ModernCheckBox}" Margin="0,0,0,10"/>

                            <!-- Launcher platform (GOG / EA / Epic / Ubisoft / Steam): where the entry came
                                 from, the option to bypass the client so an edited exe actually runs, and
                                 a way out of the platform tag entirely. Hidden for plain Local games. -->
                            <Border Background="#1B1B24" BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1"
                                    CornerRadius="6" Padding="10,8" Margin="0,2,0,2"
                                    Visibility="{Binding HasPlatform, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding PlatformDescription}" FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                        <Button Content="Convert to Local game" Command="{Binding ConvertToLocalCommand}"
                                                Style="{StaticResource ModernGhostButton}" DockPanel.Dock="Right" Padding="8,3" FontSize="11"
                                                ToolTip="Drop the launcher tag and ID. The game will launch from its executable and show the Local badge; Scan for Games may offer the launcher's own record again."/>
                                    </DockPanel>
                                    <CheckBox Content="{Binding LaunchDirectlyLabel}" IsChecked="{Binding LaunchDirectly}"
                                              Style="{StaticResource ModernCheckBox}"/>
                                    <TextBlock Text="Off: starts through the launcher's client when it's installed (cloud saves, achievements, overlay). On: runs the executable above as-is - needed for an alternate exe such as a DX11 build or a mod launcher, since the client launch ignores the path."
                                               FontSize="10.5" Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap" Margin="22,3,0,0"/>
                                    <CheckBox Content="Close the launcher after this game exits" IsChecked="{Binding CloseLauncherOnExit}"
                                              Style="{StaticResource ModernCheckBox}" Margin="0,8,0,0"
                                              ToolTip="When the session ends, Steam is asked to shut down (steam.exe -shutdown) and the other clients (GOG Galaxy, EA App, Epic Games Launcher, Ubisoft Connect) are closed. Platform background services are left running."/>
                                    <TextBlock Text="Frees the memory and overlay hosts a client keeps resident after you stop playing. Off by default - leave it off if you keep the client open for downloads or chat."
                                               FontSize="10.5" Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap" Margin="22,3,0,0"/>
                                </StackPanel>
                            </Border>
                            <!-- The old standalone "Launch via Steam Client protocol" checkbox lived here.
                                 It duplicated the launcher box's "launch this executable directly" with the
                                 opposite polarity; the option now sits in the Steam App ID box (card 1)
                                 and only while the game has no launcher platform. -->
                        </StackPanel>
                    </Border>

                    <!-- CARD 4: HIDDEN -->
                    <Border Background="#16161D" BorderBrush="{StaticResource BrushBorderDark}"
                            BorderThickness="1" CornerRadius="8" Padding="14">
                        <StackPanel>
                            <TextBlock Text="Hidden" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,10"/>

                            <CheckBox Content="Hide this game from the library"
                                      IsChecked="{Binding IsHidden}"
                                      Style="{StaticResource ModernCheckBox}"/>
                            <TextBlock Text="Removed from the library grid and tray menu, but kept on record - Scan for Games and Add Folder will still recognize it and won't suggest it again. Unhide it anytime from the Library's &quot;Hidden&quot; filter tab or this game's right-click menu."
                                       FontSize="10.5" Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap" Margin="22,3,0,0"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ============================================================== -->
        <!-- FOOTER                                                         -->
        <!-- ============================================================== -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Status Feedback & Busy Indicator -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="⏳ " FontSize="12" Foreground="{StaticResource BrushAccentHover}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRefreshingMetadata}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding StatusMessage}" FontSize="11.5" 
                           Foreground="{StaticResource BrushAccentHover}" 
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Action Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Command="{Binding CancelCommand}" 
                        Style="{StaticResource ModernGhostButton}" MinWidth="85" Margin="0,0,8,0"/>
                <Button Content="Save Changes" Command="{Binding SaveCommand}" 
                        Style="{StaticResource ModernAccentButton}" MinWidth="110"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
