<UserControl x:Class="TrayTrigger.Views.SearchBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="160">
    <!-- A fixed 160 wide by default: the smallest that fits a "Search settings..." hint beside the
         clear x, and the same size at any window width on every page that has one beside its tabs.
         The Library and Tools search bars set Width="Auto" so theirs fills the bar. -->
    <Grid>
        <TextBox x:Name="Box" Style="{StaticResource ModernTextBox}" VerticalAlignment="Stretch"
                 VerticalContentAlignment="Center" Padding="9,5,28,5"/>
        <!-- The same clear x as the hotkey box: shown once there's text. -->
        <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"
                Click="OnClearClick" ToolTip="{Binding ClearText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                AutomationProperties.Name="{Binding ClearText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Content="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeBadge}"
                Background="Transparent" BorderThickness="0" Padding="6,4" Cursor="Hand" Focusable="False">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                        </Trigger>
                        <!-- Reads the box, not Text, so it shows with the first letter rather than
                             after the typing delay. -->
                        <DataTrigger Binding="{Binding Text, ElementName=Box}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <!-- The results list of a page's search (ResultsHost): under the box, over the page, and never
             taking the cursor from it - Up, Down, Enter and Escape are handled in the box. -->
        <Popup x:Name="Results" PlacementTarget="{Binding ElementName=Box}" Placement="Bottom" VerticalOffset="4"
               StaysOpen="True" AllowsTransparency="True" Focusable="False">
            <Border Background="{DynamicResource BrushDialogCard}" BorderBrush="{DynamicResource BrushBorderStrong}"
                    BorderThickness="1" CornerRadius="{DynamicResource RadiusCard}" Width="440" Padding="4" Margin="0,0,12,12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.4"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="NoResults" Text="No matches" Margin="10,8" TextWrapping="Wrap"
                               FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}"/>
                    <ScrollViewer x:Name="ResultsScroll" MaxHeight="420" VerticalScrollBarVisibility="Auto"
                                  AutomationProperties.Name="Search results">
                        <ItemsControl x:Name="ResultsList" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Click="OnResultClick" Tag="{Binding Hit}" Focusable="False" Cursor="Hand"
                                            HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding Hit.Title}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Row" Background="Transparent" CornerRadius="{DynamicResource RadiusControl}" Padding="10,7">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource BrushSurfaceHover}"/>
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource BrushSurfaceHover}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <StackPanel>
                                            <DockPanel LastChildFill="True">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Hit.TabLabel}" Margin="12,0,0,0"
                                                           FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushAccentText}"/>
                                                <TextBlock Style="{StaticResource StrongText}" Text="{Binding Hit.Title}" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Hit.Snippet}" TextWrapping="Wrap" MaxHeight="48" Margin="0,2,0,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Hit.Snippet}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock x:Name="MoreNote" Margin="10,6,10,4" TextWrapping="Wrap" Visibility="Collapsed"
                               FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
