<UserControl x:Class="TrayTrigger.Views.HotkeyRecorderBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" IsTabStop="True"
             GotKeyboardFocus="OnGotKeyboardFocus" LostKeyboardFocus="OnLostKeyboardFocus"
             PreviewKeyDown="OnPreviewKeyDown">
    <StackPanel>
        <!-- Looks like ModernTextBox (same fill, border, height) but never takes typed text: a
             hotkey is recorded from the keys actually pressed, so what is stored always parses
             and is spelled the same way everywhere. -->
        <Border x:Name="Box" Background="#17171B" BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1"
                CornerRadius="4" MinHeight="28" Padding="9,0" Cursor="Hand"
                MouseLeftButtonDown="OnBoxMouseLeftButtonDown">
            <DockPanel>
                <Button x:Name="ClearButton" DockPanel.Dock="Right" Click="OnClearClick" ToolTip="Clear"
                        Content="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="9"
                        Foreground="{StaticResource BrushTextMuted}" Background="Transparent" BorderThickness="0"
                        Padding="4,0" Margin="6,0,-4,0" Cursor="Hand" Focusable="False" Visibility="Collapsed">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <TextBlock x:Name="Display" VerticalAlignment="Center" FontFamily="{StaticResource AppFont}" FontSize="12"
                           Foreground="{StaticResource BrushTextMuted}" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
        <!-- Shown here unless the host sets ShowInlineMessage="False" and places its own TextBlock
             bound to Message / MessageBrush / HasMessage - a 160 px box wraps a sentence badly. -->
        <TextBlock x:Name="InlineMessage" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                   Foreground="{StaticResource BrushDanger}"/>
    </StackPanel>
</UserControl>
