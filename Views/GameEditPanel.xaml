<UserControl x:Class="TrayTrigger.Views.GameEditPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:services="clr-namespace:TrayTrigger.Services"
             xmlns:views="clr-namespace:TrayTrigger.Views"
             mc:Ignorable="d">
    <!-- The settings of one game: its artwork and the tabs of cards that edit it. Game Details hosts
         it on its Settings tab; the status line and Save / Cancel are Game Details' own bottom bar. -->
    <UserControl.Resources>
        <!-- A box Save can refuse: red-bordered while its message (its help text) is showing.
             HelpText can't be null, so its bindings turn a cleared message into "".
             Hover and keyboard focus still draw their own border over it. -->
        <Style x:Key="ValidatedTextBox" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushDanger}"/>
            <Style.Triggers>
                <Trigger Property="AutomationProperties.HelpText" Value="">
                    <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- A path box: a long path is cut off at the box's edge, so the whole of it is the tooltip. -->
        <Style x:Key="PathTextBox" TargetType="TextBox" BasedOn="{StaticResource ValidatedTextBox}">
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="ToolTipService.IsEnabled" Value="False"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Why Save refused the field above it, in the field's own place rather than only in the
             footer. Collapsed while there is nothing to say. The same text is the field's help
             text, which a screen reader reads when Save moves focus to it. -->
        <Style x:Key="FieldErrorText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushDanger}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AutomationProperties.LiveSetting" Value="Assertive"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- An artwork card: a picture, where it is used, where it came from, and the buttons. A dragged file lights its outline. -->
        <Style x:Key="ArtCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>
        <!-- The one status line under a picture's name: Automatic, or Custom with its file (in the accent). -->
        <Style x:Key="ArtStatus" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
            <Setter Property="Margin" Value="0,1,0,8"/>
        </Style>
        <Style x:Key="ArtUse" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </UserControl.Resources>

    <Grid>
            <!-- RIGHT COLUMN: TABS, THEN THE CONFIGURATION CARDS (SCROLLABLE) -->
            <DockPanel>
            <!-- All + one tab per card, as in Settings and System. Every card stays loaded and only
                 its visibility follows the tab, so edits, validation and bindings survive a switch.
                 Ctrl+Tab / Ctrl+Shift+Tab move between tabs (GameEditDialog.xaml.cs). -->
            <Border DockPanel.Dock="Top" Margin="14,0,4,10" Background="{DynamicResource BrushDialogCard}" BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="1" CornerRadius="{DynamicResource RadiusControl}" Padding="3" HorizontalAlignment="Left"
                    views:ScrollToTop.Target="{Binding ElementName=EditScroll}">
                <!-- A WrapPanel: six tabs outgrow the dialog at a large text size, and a second row beats a clipped last tab. -->
                <WrapPanel Orientation="Horizontal">
                    <Button Content="All" Command="{Binding SelectSectionCommand}" CommandParameter="All"
                            Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsAllSection}"/>
                    <Button Content="Identity &amp; Library" Command="{Binding SelectSectionCommand}" CommandParameter="Identity" Margin="2,0,0,0"
                            Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsIdentitySection}"/>
                    <Button Content="Artwork" Command="{Binding SelectSectionCommand}" CommandParameter="Artwork" Margin="2,0,0,0"
                            Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsArtworkSection}"/>
                    <Button Content="Launch" Command="{Binding SelectSectionCommand}" CommandParameter="Launch" Margin="2,0,0,0"
                            Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsLaunchSection}"/>
                    <Button Content="Performance" Command="{Binding SelectSectionCommand}" CommandParameter="Performance" Margin="2,0,0,0"
                            Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsPerformanceSection}"/>
                    <Button Content="Display &amp; Sound" Command="{Binding SelectSectionCommand}" CommandParameter="Display" Margin="2,0,0,0"
                            Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsDisplaySection}"/>
                    <Button Content="Scripts" Command="{Binding SelectSectionCommand}" CommandParameter="Scripts" Margin="2,0,0,0"
                            Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsScriptsSection}"/>
                </WrapPanel>
            </Border>
            <ScrollViewer x:Name="EditScroll" VerticalScrollBarVisibility="Auto" Padding="14,0,4,0"
                          views:ScrollToTop.ResetOn="{Binding SelectedSection}">
                <StackPanel>

                    <!-- CARD 1: IDENTITY & LIBRARY (title, category, hidden, store link) -->
                    <Border Background="{DynamicResource BrushDialogCard}" BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1" CornerRadius="{DynamicResource RadiusCard}" Padding="14" Margin="0,0,0,12"
                            Visibility="{Binding ShowIdentityCard, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Identity &amp; Library" FontSize="{DynamicResource FontSizeSubhead}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,10"/>

                            <!-- Game Title -->
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="Game Title" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}"
                                           VerticalAlignment="Center" DockPanel.Dock="Left"/>
                            </DockPanel>
                            <TextBox AutomationProperties.Name="Game title" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBox}" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Style="{StaticResource HelpLinkButton}" Content="How titles are detected" Margin="0,0,14,0"
                                        Command="{x:Static services:HelpCommands.ShowTopic}" CommandParameter="library/titles"/>
                                <Button Style="{StaticResource HelpLinkButton}" Content="How artwork is found"
                                        Command="{x:Static services:HelpCommands.ShowTopic}" CommandParameter="library/artwork"/>
                            </StackPanel>

                            <!-- Category -->
                            <TextBlock Text="Category (choose existing or type a custom tag)" FontSize="{DynamicResource FontSizeBody}"
                                       Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                            <ComboBox AutomationProperties.Name="Category" ItemsSource="{Binding ExistingCategories}"
                                      Text="{Binding Category, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True"
                                      Style="{StaticResource ModernComboBox}" Margin="0,0,0,10"/>

                            <!-- Hidden is a library-visibility flag like the category, so it lives here rather
                                 than in a card of its own at the bottom. -->
                            <CheckBox Content="Hide this game from the library"
                                      IsChecked="{Binding IsHidden}"
                                      Style="{StaticResource ModernCheckBox}"/>
                            <TextBlock Text="Left out of the library and the tray menu, and never suggested again by a scan. Unhide it from the Library's Hidden tab."
                                       FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}" TextWrapping="Wrap" Margin="22,3,0,12"/>

                            <!-- Force Apply Steam Overlay Tag Option - pointless for a game that already
                                 launches through Steam (its card carries the badge anyway). -->
                            <StackPanel Margin="0,2,0,2" Visibility="{Binding CanOfferSteamBadge, Converter={StaticResource BoolToVis}}">
                                <CheckBox Content="Use the Steam badge instead of the Local badge"
                                          IsChecked="{Binding ForceSteamOverlayTag}"
                                          Style="{StaticResource ModernCheckBox}"/>
                                <TextBlock Text="Cosmetic only, for a game with no launcher: shows the Steam logo on the library card in place of the Local badge. It doesn't change how the game launches."
                                           FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}" TextWrapping="Wrap" Margin="22,3,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ONLINE MATCH: which Steam listing this game is, and what a new match may replace. -->
                    <Border Background="{DynamicResource BrushDialogCard}" BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1" CornerRadius="{DynamicResource RadiusCard}" Padding="14" Margin="0,0,0,12"
                            Visibility="{Binding ShowIdentityCard, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Online match" FontSize="{DynamicResource FontSizeSubhead}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding MatchSummary}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}"
                                       TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <TextBlock Text="A match gives this game Steam's title, genre, poster, reviews, specs and news. It doesn't change how the game launches, and Steam doesn't need to be running."
                                       FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <TextBlock Text="A new match also updates" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                            <WrapPanel Margin="0,0,0,10">
                                <CheckBox Content="Title" IsChecked="{Binding UpdateTitleFromMatch}" Style="{StaticResource ModernCheckBox}" Margin="0,0,16,0"/>
                                <CheckBox Content="Genre" IsChecked="{Binding UpdateGenreFromMatch}" Style="{StaticResource ModernCheckBox}" Margin="0,0,16,0"/>
                                <CheckBox Content="Poster" IsChecked="{Binding UpdatePosterFromMatch}" Style="{StaticResource ModernCheckBox}"
                                          ToolTip="The banner and the icon follow the match only while they are Automatic."/>
                            </WrapPanel>
                            <WrapPanel>
                                <Button Content="Change match..." Command="{Binding ChangeMatchCommand}" Margin="0,0,8,4"
                                        Style="{StaticResource ModernOutlineButton}" Padding="12,5"/>
                                <Button Content="Enter an App ID" Command="{Binding EnterAppIdCommand}" Margin="0,0,8,4"
                                        Style="{StaticResource ModernGhostButton}" Padding="8,5"/>
                                <Button Content="Remove match" Command="{Binding RemoveMatchCommand}" Margin="0,0,8,4"
                                        Style="{StaticResource ModernGhostButton}" Padding="8,5"/>
                                <!-- Puts back the title, App ID, category and poster from before the last match change. -->
                                <Button Content="Undo" Command="{Binding UndoLookUpCommand}" Margin="0,0,8,4"
                                        Style="{StaticResource ModernGhostButton}" Padding="8,5" AutomationProperties.Name="Undo the match change"
                                        Visibility="{Binding CanUndoLookUp, Converter={StaticResource BoolToVis}}"
                                        ToolTip="Put back the title, Steam App ID, category and poster from before the last match change"/>
                            </WrapPanel>
                            <StackPanel Visibility="{Binding ShowAppIdEntry, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SteamAppIdBox" AutomationProperties.Name="Steam App ID" AutomationProperties.HelpText="{Binding SteamAppIdError, TargetNullValue=''}" Grid.Column="0" Text="{Binding SteamAppId, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ValidatedTextBox}" Margin="0,0,8,0"/>
                                    <Button Grid.Column="1" Content="Fetch by ID" Command="{Binding FetchBySteamIdCommand}"
                                            Style="{StaticResource ModernOutlineButton}" Padding="12,4"/>
                                </Grid>
                                <TextBlock Text="{Binding SteamAppIdError}" Style="{StaticResource FieldErrorText}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ARTWORK: the Banner on the left, the Poster and the Icon as compact rows on the right. Each is Automatic (found for the game) or
                         Custom (a file you chose, or dropped on it). The Banner keeps its shape as the window grows, so a wide window gets a bigger picture rather than empty cards. -->
                    <Border Background="{DynamicResource BrushDialogCard}" BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1" CornerRadius="{DynamicResource RadiusCard}" Padding="14" Margin="0,0,0,12"
                            Visibility="{Binding ShowArtworkCard, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right" Style="{StaticResource HelpLinkButton}" Content="How artwork is found" VerticalAlignment="Center"
                                        Command="{x:Static services:HelpCommands.ShowTopic}" CommandParameter="library/artwork"/>
                                <TextBlock Text="Artwork" FontSize="{DynamicResource FontSizeSubhead}" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{DynamicResource BrushTextPrimary}"/>
                            </DockPanel>
                            <TextBlock Text="Drop a picture on a preview to use it." Style="{StaticResource ArtUse}" Margin="0,0,0,10"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.45*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*" MinWidth="320"/>
                                </Grid.ColumnDefinitions>

                                <!-- Banner -->
                                <Border x:Name="BannerCard" Tag="Banner" Grid.Column="0" Style="{StaticResource ArtCard}"
                                        AllowDrop="True" DragEnter="OnArtDragEnter" DragOver="OnArtDragOver" DragLeave="OnArtDragLeave" Drop="OnArtDrop">
                                    <DockPanel>
                                      <StackPanel DockPanel.Dock="Top">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Banner" FontSize="{DynamicResource FontSizeSubhead}" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <TextBlock Text="Game Details" Style="{StaticResource ArtUse}" Margin="8,0,0,0" VerticalAlignment="Bottom"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding HeroChip}" TextTrimming="CharacterEllipsis" ToolTip="{Binding HeroChip}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource ArtStatus}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HeroIsCustom}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource BrushAccentText}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                      </StackPanel>
                                        <WrapPanel DockPanel.Dock="Bottom">
                                            <Button Content="Choose image..." Command="{Binding ChooseHeroCommand}" AutomationProperties.Name="Choose a banner"
                                                    Style="{StaticResource ModernOutlineButton}" Padding="12,4" Margin="0,0,6,0"/>
                                            <Button Content="Use automatic" Command="{Binding UseAutomaticHeroCommand}" AutomationProperties.Name="Use the automatic banner"
                                                    Style="{StaticResource ModernGhostButton}" Padding="8,4" Margin="0,0,2,0"/>
                                            <Button Command="{Binding FindHeroAgainCommand}" AutomationProperties.Name="Look for the banner again" ToolTip="Find again"
                                                    Style="{StaticResource ModernGhostButton}" Padding="8,4"
                                                    Visibility="{Binding HeroIsAutomatic, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeBody}"/>
                                            </Button>
                                        </WrapPanel>
                                        <Border MinHeight="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource RatioHeightConverter}, ConverterParameter='0.3229,118,260'}"
                                                CornerRadius="{DynamicResource RadiusControl}" ClipToBounds="True" Margin="0,0,0,10"
                                                Background="{DynamicResource BrushBackground}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                                            <Grid>
                                                <Border RenderOptions.BitmapScalingMode="HighQuality">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding HeroPreview}" Stretch="UniformToFill" AlignmentX="Right" AlignmentY="Top"/>
                                                    </Border.Background>
                                                </Border>
                                                <TextBlock Text="None found yet" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasHeroPreview}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <!-- Game Details shows the banner a little shorter than it is: the part below the line is cropped. -->
                                                <Border VerticalAlignment="Bottom" Height="26" Background="{DynamicResource BrushScrim}"
                                                        Visibility="{Binding HasHeroPreview, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="Cropped on Game Details" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                                                               FontSize="{DynamicResource FontSizeBadge}" Foreground="{DynamicResource BrushTextSecondary}"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DockPanel>
                                </Border>

                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <!-- Poster -->
                                    <Border x:Name="PosterCard" Tag="Poster" Grid.Row="0" Style="{StaticResource ArtCard}" Margin="0,0,0,12"
                                            AllowDrop="True" DragEnter="OnArtDragEnter" DragOver="OnArtDragOver" DragLeave="OnArtDragLeave" Drop="OnArtDrop">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Width="120" Height="180" CornerRadius="{DynamicResource RadiusControl}" ClipToBounds="True" Margin="0,0,12,0" VerticalAlignment="Top"
                                                    Background="{DynamicResource BrushBackground}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                                                <Image Source="{Binding CoverPreview}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Border>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Poster" FontSize="{DynamicResource FontSizeSubhead}" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                    <TextBlock Text="Library cards" Style="{StaticResource ArtUse}" Margin="8,0,0,0" VerticalAlignment="Bottom"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding PosterChip}" TextTrimming="CharacterEllipsis" ToolTip="{Binding PosterChip}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource ArtStatus}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PosterIsCustom}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource BrushAccentText}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                                <WrapPanel>
                                                    <Button Content="Choose..." Command="{Binding BrowseCoverCommand}" AutomationProperties.Name="Choose a poster"
                                                            Style="{StaticResource ModernOutlineButton}" Padding="10,4" Margin="0,0,6,4"/>
                                                    <Button Content="Use automatic" Command="{Binding UseAutomaticPosterCommand}" AutomationProperties.Name="Use the automatic poster"
                                                            Style="{StaticResource ModernGhostButton}" Padding="8,4" Margin="0,0,2,4"/>
                                                    <Button Command="{Binding FindPosterAgainCommand}" AutomationProperties.Name="Look for the poster again" ToolTip="Find again"
                                                            Style="{StaticResource ModernGhostButton}" Padding="8,4" Margin="0,0,0,4"
                                                            Visibility="{Binding PosterIsAutomatic, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeBody}"/>
                                                    </Button>
                                                </WrapPanel>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>

                                    <!-- Icon -->
                                    <Border x:Name="IconCard" Tag="Icon" Grid.Row="1" Style="{StaticResource ArtCard}"
                                            AllowDrop="True" DragEnter="OnArtDragEnter" DragOver="OnArtDragOver" DragLeave="OnArtDragLeave" Drop="OnArtDrop">
                                        <DockPanel>
                                            <Image DockPanel.Dock="Left" Source="{Binding IconPreview}" Width="64" Height="64" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Top"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Icon" FontSize="{DynamicResource FontSizeSubhead}" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                    <TextBlock Text="Tray and list" Style="{StaticResource ArtUse}" Margin="8,0,0,0" VerticalAlignment="Bottom"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding IconChip}" TextTrimming="CharacterEllipsis" ToolTip="{Binding IconChip}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource ArtStatus}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IconIsCustom}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource BrushAccentText}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                                <WrapPanel>
                                                    <Button Content="Choose..." Command="{Binding BrowseIconCommand}" AutomationProperties.Name="Choose an icon"
                                                            Style="{StaticResource ModernOutlineButton}" Padding="10,4" Margin="0,0,6,4"/>
                                                    <Button Content="Use automatic" Command="{Binding UseAutomaticIconCommand}" AutomationProperties.Name="Use the automatic icon"
                                                            Style="{StaticResource ModernGhostButton}" Padding="8,4" Margin="0,0,0,4"/>
                                                </WrapPanel>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- CARD 2: LAUNCH (route first, then target, advanced options, admin, hotkey) -->
                    <Border Background="{DynamicResource BrushDialogCard}" BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1" CornerRadius="{DynamicResource RadiusCard}" Padding="14" Margin="0,0,0,12"
                            Visibility="{Binding ShowLaunchCard, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="How it starts" FontSize="{DynamicResource FontSizeSubhead}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,2"/>
                            <Button Style="{StaticResource HelpLinkButton}" Content="How launching works" Margin="0,0,0,10"
                                    Command="{x:Static services:HelpCommands.ShowTopic}" CommandParameter="library/launch"/>

                            <!-- The route first: which client, if any, starts this game. Everything under it
                                 (target, folder, arguments, admin) is what TrayTrigger uses when it starts
                                 the exe itself, so a reader learns whether that applies before reading it.
                                 Collapsed for a plain Local game, whose card then starts at the target. -->
                            <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                                    CornerRadius="{DynamicResource RadiusControl}" Padding="10,8" Margin="0,0,0,12"
                                    Visibility="{Binding HasPlatform, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding PlatformDescription}" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                        <Button Content="Convert to Local game" Command="{Binding ConvertToLocalCommand}"
                                                Visibility="{Binding CanConvertToLocal, Converter={StaticResource BoolToVis}}"
                                                Style="{StaticResource ModernGhostButton}" DockPanel.Dock="Right" Padding="8,3" FontSize="{DynamicResource FontSizeBody}"/>
                                    </DockPanel>
                                    <!-- Hidden for Xbox / Game Pass entries (a GDK exe can't run outside its package) and Battle.net
                                         entries (the game needs the sign-in token only the client passes). -->
                                    <StackPanel Visibility="{Binding CanOfferLaunchDirectly, Converter={StaticResource BoolToVis}}">
                                        <CheckBox Content="{Binding LaunchDirectlyLabel}" IsChecked="{Binding LaunchDirectly}"
                                                  Style="{StaticResource ModernCheckBox}"/>
                                        <TextBlock Text="{Binding LaunchDirectlyHint}"
                                                   FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}" TextWrapping="Wrap" Margin="22,3,0,0"/>
                                    </StackPanel>
                                    <CheckBox Content="Close the launcher after this game exits" IsChecked="{Binding CloseLauncherOnExit}"
                                              Style="{StaticResource ModernCheckBox}" Margin="0,8,0,0"
                                              ToolTip="For Steam, this also starts the client minimized to the tray when TrayTrigger has to open it, so only the game appears."/>
                                    <TextBlock Text="Frees the memory a client keeps after you stop playing. Leave it off if you keep the client open for downloads or chat."
                                               FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}" TextWrapping="Wrap" Margin="22,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Convert to Local game was clicked and not yet saved: the platform box is gone, so
                                 say so here and keep the way back one click away. -->
                            <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                                    CornerRadius="{DynamicResource RadiusControl}" Padding="10,8" Margin="0,0,0,12"
                                    Visibility="{Binding IsConvertedToLocal, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding ConvertedNotice}" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                    <Button Grid.Column="1" Content="Undo" Command="{Binding UndoConvertToLocalCommand}"
                                            AutomationProperties.Name="Undo Convert to Local game"
                                            Style="{StaticResource ModernGhostButton}" Padding="8,3" FontSize="{DynamicResource FontSizeBody}"/>
                                </Grid>
                            </Border>

                            <!-- Launch through Steam: offered only while the entry has no launcher platform and
                                 has a Steam App ID. Ticking it makes this a Steam-linked game and the launcher
                                 box above takes over (with "launch this executable directly"), so there is
                                 never more than one launch-route control on screen. -->
                            <StackPanel Margin="0,0,0,12" Visibility="{Binding CanOfferSteamLaunch, Converter={StaticResource BoolToVis}}">
                                <CheckBox Content="Launch through the Steam client (steam://rungameid/) instead of the executable"
                                          IsChecked="{Binding IsSteamGame}"
                                          Style="{StaticResource ModernCheckBox}"/>
                                <TextBlock Text="Only for a game installed in your Steam library: keeps Steam's overlay, cloud saves and playtime."
                                           FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}" TextWrapping="Wrap" Margin="22,3,0,0"/>
                            </StackPanel>

                            <!-- Executable Path -->
                            <TextBlock Text="{Binding ExecutableLabel}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox AutomationProperties.Name="{Binding ExecutableLabel}" Grid.Column="0" Text="{Binding ExecutablePath, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource PathTextBox}" Margin="0,0,8,0"/>
                                <Button AutomationProperties.Name="Browse for the executable" Grid.Column="1" Content="Browse..." Command="{Binding BrowseExeCommand}"
                                        Style="{StaticResource ModernOutlineButton}"/>
                            </Grid>
                            <TextBlock Text="{Binding LinkTargetHint}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}" TextWrapping="Wrap" Margin="0,-6,0,10"
                                       Visibility="{Binding IsLinkTarget, Converter={StaticResource BoolToVis}}"/>

                        </StackPanel>
                    </Border>

                    <!-- RUN OPTIONS: what is passed to the exe and how it is run - the working folder, arguments, administrator and the hotkey -->
                    <Border Background="{DynamicResource BrushDialogCard}" BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1" CornerRadius="{DynamicResource RadiusCard}" Padding="14" Margin="0,0,0,12"
                            Visibility="{Binding ShowLaunchCard, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Run options" FontSize="{DynamicResource FontSizeSubhead}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,10"/>

                            <!-- Working folder and arguments are rarely needed, so they sit in an expander
                                 that starts open whenever either one has a value (UX-14g). -->
                            <StackPanel Margin="0,0,0,10">
                                    <!-- Working Directory -->
                                    <TextBlock Text="Working Directory" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox AutomationProperties.Name="Working directory" Grid.Column="0" Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource PathTextBox}" Margin="0,0,8,0"/>
                                        <Button AutomationProperties.Name="Browse for the working directory" Grid.Column="1" Content="Browse..." Command="{Binding BrowseWorkDirCommand}"
                                                Style="{StaticResource ModernOutlineButton}"/>
                                    </Grid>

                                    <!-- Launch Arguments -->
                                    <TextBlock Text="Launch Arguments (optional command-line parameters)" FontSize="{DynamicResource FontSizeBody}"
                                               Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                                    <TextBox AutomationProperties.Name="Launch arguments" Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ModernTextBox}"/>
                                    <TextBlock Text="{Binding ArgumentsHint}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}"
                                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- Run as Administrator lives here with the arguments: both apply only when
                                 TrayTrigger starts the exe itself, and are ignored when a client launches
                                 the game (see Help > How a game is launched). -->
                            <CheckBox Content="Run as Administrator (requests elevated UAC permissions)"
                                      IsChecked="{Binding RunAsAdmin}"
                                      Style="{StaticResource ModernCheckBox}" Margin="0,0,0,12"/>

                            <!-- Hotkey: a launch setting, so it lives with the launch path. -->
                            <!-- The box is docked first so it keeps its 160px; the label then fills what is
                                 left and wraps. Docking the label first let its one-line hint claim the whole
                                 row and push the box underneath it. -->
                            <StackPanel>
                                <DockPanel>
                                    <!-- Recorded from real key presses, and refused on the spot if another game, the
                                         window hotkey, or another app already has the combo. Its message is rendered
                                         below, across the whole row, rather than wrapped under the 160 px box. -->
                                    <views:HotkeyRecorderBox AutomationProperties.Name="Launch hotkey" x:Name="LaunchHotkeyBox" DockPanel.Dock="Right" Hotkey="{Binding Hotkey}" OwnerId="{Binding SourceGame.Id}"
                                                             ShowInlineMessage="False" Width="180" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Global Launch Hotkey" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}"/>
                                        <TextBlock Text="Click the box and press Ctrl, Alt or Shift plus a key, or F1-F24 alone. Works anywhere in Windows." FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Text="{Binding Message, ElementName=LaunchHotkeyBox}" Foreground="{Binding MessageBrush, ElementName=LaunchHotkeyBox}"
                                           Visibility="{Binding HasMessage, ElementName=LaunchHotkeyBox, Converter={StaticResource BoolToVis}}"
                                           FontSize="{DynamicResource FontSizeBody}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- CARD 3: PERFORMANCE (session-scoped tweaks) - its own card so the profile
                         is explained where it is chosen instead of only on the System page. -->
                    <Border Background="{DynamicResource BrushDialogCard}" BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1" CornerRadius="{DynamicResource RadiusCard}" Padding="14" Margin="0,0,0,12"
                            Visibility="{Binding ShowPerformanceCard, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Profile" FontSize="{DynamicResource FontSizeSubhead}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,10"/>

                            <TextBlock Text="Performance Profile" FontSize="{DynamicResource FontSizeBody}"
                                       Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                            <ComboBox AutomationProperties.Name="Performance profile" ItemsSource="{Binding PerformanceProfileOptions}"
                                      SelectedItem="{Binding PerformanceProfile}"
                                      Style="{StaticResource ModernComboBox}" Margin="0,0,0,4"/>
                            <TextBlock Text="Applied when this game launches and put back when it exits."
                                       FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <!-- What the chosen tier does for this game (UX-07), from the System page's
                                 Performance Profiles toggles: enabled tweaks only, one per line. -->
                            <ItemsControl ItemsSource="{Binding VisibleProfileSummaryLines}" Margin="0,0,0,2"
                                          AutomationProperties.Name="What this profile changes"
                                          Visibility="{Binding HasProfileSummary, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,1,0,0">
                                            <Run Text="&#x2022; " Foreground="{DynamicResource BrushTextMuted}"/><Run Text="{Binding Mode=OneWay}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- A long list (Aggressive's) shows its first lines, so CPU Cores and HDR stay in view. -->
                            <Button Style="{StaticResource HelpLinkButton}" Content="{Binding ProfileSummaryToggleText}" Margin="10,0,0,6"
                                    HorizontalAlignment="Left" Command="{Binding ToggleProfileSummaryCommand}"
                                    Visibility="{Binding CanExpandProfileSummary, Converter={StaticResource BoolToVis}}"/>
                            <Button Style="{StaticResource HelpLinkButton}" Content="How profiles work" Margin="0,4,0,12"
                                    Command="{x:Static services:HelpCommands.ShowTopic}" CommandParameter="profiles/overview"/>

                        </StackPanel>
                    </Border>

                    <!-- CORES AND HDR: per game, and independent of the profile tier -->
                    <Border Background="{DynamicResource BrushDialogCard}" BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1" CornerRadius="{DynamicResource RadiusCard}" Padding="14" Margin="0,0,0,12"
                            Visibility="{Binding ShowCoresAndHdrCard, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Cores and HDR" FontSize="{DynamicResource FontSizeSubhead}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,10"/>

                            <!-- CPU Cores - independent of the profile tier. Its options are worked out
                                 from this PC's CPU (hybrid Intel, Ryzen X3D, multi-CCD Ryzen); on a CPU
                                 with nothing to choose the whole block is left out. -->
                            <StackPanel Visibility="{Binding ShowCpuCores, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="CPU Cores" FontSize="{DynamicResource FontSizeBody}"
                                           Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                                <ComboBox AutomationProperties.Name="CPU cores" ItemsSource="{Binding CpuAffinityOptions}"
                                          SelectedValue="{Binding CpuAffinity}" SelectedValuePath="Value" DisplayMemberPath="Label"
                                          Style="{StaticResource ModernComboBox}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding CpuAffinityHint}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}"
                                           TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <DockPanel Margin="0,0,0,4" LastChildFill="True"
                                           Visibility="{Binding ShowCpuCoresDelay, Converter={StaticResource BoolToVis}}">
                                    <TextBox x:Name="CpuCoresDelayBox" AutomationProperties.Name="Seconds to wait before setting CPU cores" AutomationProperties.HelpText="{Binding CpuCoresDelayError, TargetNullValue=''}" DockPanel.Dock="Left" Width="64" TextAlignment="Center"
                                             Text="{Binding CpuCoresDelaySeconds, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ValidatedTextBox}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}" TextWrapping="Wrap" VerticalAlignment="Center"
                                               Text="seconds to wait after the game starts. Try 30 if an anti-cheat game refuses the change."/>
                                </DockPanel>
                                <TextBlock Text="{Binding CpuCoresDelayError}" Style="{StaticResource FieldErrorText}" Margin="0,0,0,6"/>
                                <Button AutomationProperties.Name="Learn more about CPU cores" Style="{StaticResource HelpLinkButton}"
                                        Command="{x:Static services:HelpCommands.ShowTopic}" CommandParameter="profiles/cpu_affinity"/>
                            </StackPanel>

                            <!-- HDR - per game, overriding the Optimized profile's Enable HDR switch.
                                 Left out on a PC with no HDR-capable display, unless the game already has a choice. -->
                            <StackPanel Visibility="{Binding ShowHdr, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="HDR" FontSize="{DynamicResource FontSizeBody}"
                                           Foreground="{DynamicResource BrushTextSecondary}" Margin="0,4,0,4"/>
                                <ComboBox AutomationProperties.Name="HDR" ItemsSource="{Binding HdrOptions}"
                                          SelectedValue="{Binding Hdr}" SelectedValuePath="Value" DisplayMemberPath="Label"
                                          Style="{StaticResource ModernComboBox}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding HdrHint}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}"
                                           TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <Button AutomationProperties.Name="Learn more about HDR" Style="{StaticResource HelpLinkButton}"
                                        Command="{x:Static services:HelpCommands.ShowTopic}" CommandParameter="profiles/hdr"/>
                            </StackPanel>

                            <!-- Auto HDR - per game, overriding the Optimized profile's Enable Auto HDR switch.
                                 Windows 11 only, with an HDR-capable display, unless the game already has a choice. -->
                            <StackPanel Visibility="{Binding ShowAutoHdr, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Auto HDR" FontSize="{DynamicResource FontSizeBody}"
                                           Foreground="{DynamicResource BrushTextSecondary}" Margin="0,4,0,4"/>
                                <ComboBox AutomationProperties.Name="Auto HDR" ItemsSource="{Binding HdrOptions}"
                                          SelectedValue="{Binding AutoHdr}" SelectedValuePath="Value" DisplayMemberPath="Label"
                                          Style="{StaticResource ModernComboBox}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding AutoHdrHint}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}"
                                           TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <Button AutomationProperties.Name="Learn more about Auto HDR" Style="{StaticResource HelpLinkButton}"
                                        Command="{x:Static services:HelpCommands.ShowTopic}" CommandParameter="profiles/auto_hdr"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- CARD 3b: DLSS OVERRIDE, after the Performance card: the profile is the main choice
                         on the Performance tab, and this card is NVIDIA-only. "DLSS Override", "DLSS Indicator" and the three
                         feature names are NVIDIA's own words, kept so a user who has seen them in
                         NVIDIA App recognises them and anyone else has an exact term to search.
                         The generic nouns around them - runtime, libraries, HUD - are not, and are
                         not used. Two versions, one switch, no per-feature breakdown: the override
                         covers all three features in one write, so a table of them was mechanism
                         on display. -->
                    <Border Background="{DynamicResource BrushDialogCard}" BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1" CornerRadius="{DynamicResource RadiusCard}" Padding="14" Margin="0,0,0,12"
                            Visibility="{Binding Dlss.IsVisible, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="NVIDIA DLSS Override" FontSize="{DynamicResource FontSizeSubhead}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- The other state, and the only other one: a game that ships no DLSS.
                                 One quiet line. A greyed-out switch and a description
                                 for something that cannot apply read as a fault, and most
                                 games ship no DLSS. -->
                            <TextBlock Text="{Binding Dlss.NotAvailableText}"
                                       FontSize="{DynamicResource FontSizeBody}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource BrushTextSecondary}"
                                       Visibility="{Binding Dlss.ShowNotAvailable, Converter={StaticResource BoolToVis}}"/>

                            <StackPanel Visibility="{Binding Dlss.ShowFullCard, Converter={StaticResource BoolToVis}}">
                                <TextBlock FontSize="{DynamicResource FontSizeBody}" TextWrapping="Wrap" Margin="0,0,0,10"
                                           Foreground="{DynamicResource BrushTextSecondary}"
                                           Text="Runs this game on the DLSS files installed with your GeForce driver, instead of the older ones inside the game. Nothing in the game folder changes."/>

                                <!-- The version pair rides the switch's own row, so before and after
                                     are read together without a sentence to join them. -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- NVIDIA App's own wording for this toggle: anyone who has seen it
                                         there recognises it, and anyone else has a term to search. -->
                                    <CheckBox Grid.Column="0" Content="Enable DLSS Override for this game"
                                              AutomationProperties.Name="Enable DLSS Override for this game"
                                              IsChecked="{Binding Dlss.OverrideEnabled}"
                                              IsEnabled="{Binding Dlss.CanToggleOverride}"
                                              Style="{StaticResource ModernCheckBox}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Dlss.VersionLine}"
                                               FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold" Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource BrushTextPrimary}"/>
                                </Grid>
                                <TextBlock Text="Applies to game-supported DLSS features: Super Resolution, Ray Reconstruction, and Frame Generation."
                                           FontSize="{DynamicResource FontSizeBody}" Margin="24,2,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource BrushTextSecondary}"/>

                                <!-- The one other thing the override writes: NVIDIA's recommended preset, or
                                     nothing so the game picks its own. The same two names DLSS Swapper uses. -->
                                <StackPanel Margin="24,10,0,0"
                                            Visibility="{Binding Dlss.CanEnable, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Preset" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold" Margin="0,0,0,4"
                                               Foreground="{DynamicResource BrushTextPrimary}"/>
                                    <ComboBox AutomationProperties.Name="DLSS preset" ItemsSource="{Binding Dlss.PresetOptions}"
                                              SelectedValue="{Binding Dlss.SelectedPreset}" SelectedValuePath="Value" DisplayMemberPath="Label"
                                              IsEnabled="{Binding Dlss.IsNotBusy}"
                                              Style="{StaticResource ModernComboBox}" HorizontalAlignment="Left" MinWidth="220" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding Dlss.PresetHint}" FontSize="{DynamicResource FontSizeBody}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource BrushTextSecondary}"/>
                                </StackPanel>

                                <!-- What actually loaded last time, on a line of its own. Says so until the
                                     game has been played, which is the only time it can be known; left
                                     out for a game with no DLSS, where there is nothing to load. -->
                                <TextBlock Text="{Binding Dlss.LastRunLine}"
                                           FontSize="{DynamicResource FontSizeBody}" Margin="24,8,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource BrushTextSecondary}"
                                           Visibility="{Binding Dlss.CanEnable, Converter={StaticResource BoolToVis}}"/>

                                <!-- Only when a change did not work. When it works, the switch says so. -->
                                <TextBlock Text="{Binding Dlss.Status}" FontSize="{DynamicResource FontSizeBody}" Margin="0,10,0,0"
                                           AutomationProperties.LiveSetting="Polite"
                                           Foreground="{DynamicResource BrushWarning}" TextWrapping="Wrap"
                                           Visibility="{Binding Dlss.HasStatus, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>

                            <Button AutomationProperties.Name="Learn more about NVIDIA DLSS Override" Style="{StaticResource HelpLinkButton}"
                                    Margin="0,8,0,0"
                                    Command="{x:Static services:HelpCommands.ShowTopic}" CommandParameter="dlss/override"/>

                        </StackPanel>
                    </Border>

                    <!-- CARD 3c: DISPLAY AND SOUND - everything to do with the screens and speakers a game runs on, in one card, on its own Display tab and after the Performance cards on All:
                         which monitor, its resolution and refresh rate, making it the main display, keeping the mouse on it,
                         dimming the others, the sound output and the microphone. The lists are always there and disabled, with a note
                         saying why, when there is nothing to choose between; the options that need two monitors show only with two. -->
                    <Border Background="{DynamicResource BrushDialogCard}" BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1" CornerRadius="{DynamicResource RadiusCard}" Padding="14" Margin="0,0,0,12"
                            Visibility="{Binding ShowDisplayCard, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Display" FontSize="{DynamicResource FontSizeSubhead}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,10"/>

                            <StackPanel>
                                <TextBlock Text="Monitor" FontSize="{DynamicResource FontSizeBody}"
                                           Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                                <DockPanel Margin="0,0,0,4" IsEnabled="{Binding ShowMonitorChoice}">
                                    <Button DockPanel.Dock="Right" Content="Identify" Margin="8,0,0,0" Padding="12,4"
                                            Style="{StaticResource ModernOutlineButton}"
                                            Command="{Binding IdentifyMonitorsCommand}"
                                            AutomationProperties.Name="Identify monitors"
                                            ToolTip="Shows a number on each monitor for a moment"/>
                                    <ComboBox AutomationProperties.Name="Monitor" ItemsSource="{Binding MonitorOptions}"
                                              SelectedItem="{Binding SelectedMonitor}" DisplayMemberPath="Label"
                                              Style="{StaticResource ModernComboBox}"/>
                                </DockPanel>
                                <TextBlock Text="{Binding MonitorNote}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}"
                                           Visibility="{Binding HasMonitorNote, Converter={StaticResource BoolToVis}}"
                                           TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <CheckBox Content="Make this monitor the main display while the game runs" IsChecked="{Binding MakeMainDisplay}"
                                          Visibility="{Binding ShowMakeMainDisplay, Converter={StaticResource BoolToVis}}"
                                          AutomationProperties.Name="Make this monitor the main display while the game runs"
                                          Foreground="{DynamicResource BrushTextPrimary}" Margin="0,6,0,4"/>
                                <TextBlock Visibility="{Binding ShowMakeMainDisplay, Converter={StaticResource BoolToVis}}"
                                           Text="The taskbar, open windows and desktop icons move to it, and back when the game ends. It changes Windows' own display layout for the time the game runs, which is why it is off unless you ask for it."
                                           FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}"
                                           TextWrapping="Wrap" Margin="0,0,0,8"/>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="Resolution and refresh rate" FontSize="{DynamicResource FontSizeBody}"
                                           Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                                <ComboBox AutomationProperties.Name="Resolution" ItemsSource="{Binding ResolutionOptions}"
                                          IsEnabled="{Binding ShowDisplay}"
                                          SelectedItem="{Binding SelectedResolution}" DisplayMemberPath="Label"
                                          Style="{StaticResource ModernComboBox}" Margin="0,0,0,4"/>
                                <ComboBox AutomationProperties.Name="Refresh rate" ItemsSource="{Binding RateOptions}"
                                          IsEnabled="{Binding ShowDisplay}"
                                          SelectedItem="{Binding SelectedRate}" DisplayMemberPath="Label"
                                          Style="{StaticResource ModernComboBox}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding DisplayHint}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}"
                                           Visibility="{Binding ShowDisplay, Converter={StaticResource BoolToVis}}"
                                           TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding DisplayNote}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}"
                                           Visibility="{Binding HasDisplayNote, Converter={StaticResource BoolToVis}}"
                                           TextWrapping="Wrap" Margin="0,0,0,6"/>
                            </StackPanel>

                        </StackPanel>
                    </Border>

                    <!-- SCREENS: what happens to the other monitors while the game runs; only with more than one -->
                    <Border Background="{DynamicResource BrushDialogCard}" BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1" CornerRadius="{DynamicResource RadiusCard}" Padding="14" Margin="0,0,0,12"
                            Visibility="{Binding ShowScreensCard, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Screens" FontSize="{DynamicResource FontSizeSubhead}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,6"/>

                            <StackPanel Visibility="{Binding ShowMouseLock, Converter={StaticResource BoolToVis}}">
                                <CheckBox Content="Keep the mouse on the game's screen" IsChecked="{Binding KeepMouseOnGameScreen}"
                                          AutomationProperties.Name="Keep the mouse on the game's screen"
                                          Foreground="{DynamicResource BrushTextPrimary}" Margin="0,6,0,4"/>
                                <TextBlock Text="While this game's window is in front, the mouse can't leave the screen it is on. Alt+Tab, the Windows key or anything else that takes the focus frees it, and it is freed when the game ends."
                                           FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}"
                                           TextWrapping="Wrap" Margin="0,0,0,6"/>
                            </StackPanel>

                            <StackPanel Visibility="{Binding ShowDim, Converter={StaticResource BoolToVis}}">
                                <CheckBox Content="Dim the other screens" IsChecked="{Binding DimOtherScreens}"
                                          AutomationProperties.Name="Dim the other screens"
                                          Foreground="{DynamicResource BrushTextPrimary}" Margin="0,6,0,4"/>
                                <TextBlock Text="While this game's window is in front, every other monitor is dimmed. Alt+Tab or the Windows key lifts it at once, and it is lifted when the game ends."
                                           FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}"
                                           TextWrapping="Wrap" Margin="0,0,0,6"/>
                            </StackPanel>

                        </StackPanel>
                    </Border>

                    <!-- SOUND: where the game's sound and the microphone go while it runs -->
                    <Border Background="{DynamicResource BrushDialogCard}" BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1" CornerRadius="{DynamicResource RadiusCard}" Padding="14" Margin="0,0,0,12"
                            Visibility="{Binding ShowDisplayCard, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Sound" FontSize="{DynamicResource FontSizeSubhead}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,2"/>

                            <StackPanel>
                                <TextBlock Text="Sound output" FontSize="{DynamicResource FontSizeBody}"
                                           Foreground="{DynamicResource BrushTextSecondary}" Margin="0,8,0,4"/>
                                <ComboBox AutomationProperties.Name="Sound output" ItemsSource="{Binding AudioOptions}"
                                          IsEnabled="{Binding ShowAudio}"
                                          SelectedItem="{Binding SelectedAudio}" DisplayMemberPath="Label"
                                          Style="{StaticResource ModernComboBox}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding AudioNote}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}"
                                           Visibility="{Binding HasAudioNote, Converter={StaticResource BoolToVis}}"
                                           TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBlock Visibility="{Binding ShowAudio, Converter={StaticResource BoolToVis}}" Text="Default leaves Windows' current device in use. Otherwise the game's sound plays through the device you pick while it runs, and goes back when it ends. A sound output chosen for this game in Windows' volume mixer overrides it."
                                           FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}"
                                           TextWrapping="Wrap" Margin="0,0,0,6"/>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="Microphone" FontSize="{DynamicResource FontSizeBody}"
                                           Foreground="{DynamicResource BrushTextSecondary}" Margin="0,8,0,4"/>
                                <ComboBox AutomationProperties.Name="Microphone" ItemsSource="{Binding MicrophoneOptions}"
                                          IsEnabled="{Binding ShowMicrophone}"
                                          SelectedItem="{Binding SelectedMicrophone}" DisplayMemberPath="Label"
                                          Style="{StaticResource ModernComboBox}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding MicrophoneNote}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}"
                                           Visibility="{Binding HasMicrophoneNote, Converter={StaticResource BoolToVis}}"
                                           TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBlock Visibility="{Binding ShowMicrophone, Converter={StaticResource BoolToVis}}" Text="Default leaves Windows' current microphone in use. Otherwise Windows uses the one you pick while the game runs, and goes back when it ends. A program set to use the Communications device, or a microphone chosen inside the game or the chat app, keeps its own."
                                           FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}"
                                           TextWrapping="Wrap" Margin="0,0,0,6"/>
                            </StackPanel>

                            <Button AutomationProperties.Name="Learn more about the display and sound settings" Style="{StaticResource HelpLinkButton}"
                                    Command="{x:Static services:HelpCommands.ShowTopic}" CommandParameter="profiles/display_mode"/>
                        </StackPanel>
                    </Border>

                    <!-- CARD 4: PRE-LAUNCH / POST-EXIT SCRIPTS (opt-in via Settings > Launch &
                         Performance, or always shown for a game that already has a script) -->
                    <Border Background="{DynamicResource BrushDialogCard}" BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1" CornerRadius="{DynamicResource RadiusCard}" Padding="14" Margin="0,0,0,12"
                            Visibility="{Binding ShowScriptsCardOnTab, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Scripts" FontSize="{DynamicResource FontSizeSubhead}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4"/>
                            <TextBlock Text="Run your own PowerShell script before this game starts and after it exits."
                                       FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                            <!-- Before any field: a script set up while scripts are off won't run, and that
                                 is worth knowing before the card is filled in, not after. -->
                            <Border Background="{DynamicResource BrushWarningWash}" BorderBrush="{DynamicResource BrushWarningBorder}"
                                    BorderThickness="1" CornerRadius="{DynamicResource RadiusControl}" Padding="10,6" Margin="0,0,0,12"
                                    Visibility="{Binding ShowScriptsDisabledNotice, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="Scripts are turned off in Settings › Launch &amp; Performance (Enable scripts), so these will NOT run until that switch is back on."
                                               FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushWarning}" TextWrapping="Wrap"/>
                                    <CheckBox Content="Enable scripts (every game, at once)" IsChecked="{Binding ScriptsEnabled}" Margin="0,6,0,0"
                                              Style="{StaticResource ModernCheckBox}"
                                              AutomationProperties.Name="Enable scripts"/>
                                </StackPanel>
                            </Border>

                            <!-- Pre-launch script -->
                            <TextBlock Text="Pre-Launch Script (runs just before the game starts)" FontSize="{DynamicResource FontSizeBody}"
                                       Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="PreLaunchScriptBox" AutomationProperties.Name="Pre-launch script path" AutomationProperties.HelpText="{Binding PreLaunchScriptError, TargetNullValue=''}"
                                         Grid.Column="0" Text="{Binding PreLaunchScriptPath, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource PathTextBox}" Margin="0,0,8,0"/>
                                <Button AutomationProperties.Name="Test the pre-launch script" Grid.Column="1" Content="Test" Command="{Binding TestPreLaunchScriptCommand}"
                                        Style="{StaticResource ModernOutlineButton}" Margin="0,0,8,0"
                                        ToolTip="Run this script now with the values in this dialog (hidden, not elevated, 30 s limit) and show its exit code and output"/>
                                <Button AutomationProperties.Name="Browse for a pre-launch script" Grid.Column="2" Content="Browse..." Command="{Binding BrowsePreLaunchScriptCommand}"
                                        Style="{StaticResource ModernOutlineButton}"/>
                            </Grid>
                            <TextBlock Text="{Binding PreLaunchScriptError}" Style="{StaticResource FieldErrorText}" Margin="0,-6,0,10"/>
                            <StackPanel Orientation="Horizontal" Margin="0,-6,0,8">
                                <Button Style="{StaticResource HelpLinkButton}" Content="New script..." Command="{Binding NewPreLaunchScriptCommand}"
                                        ToolTip="Create a new PowerShell script of your own from the blank template, in the scripts folder, and open it for editing"/>
                                <TextBlock Text="·" Foreground="{DynamicResource BrushTextMuted}" Margin="6,0" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource HelpLinkButton}" Content="Open in editor" Command="{Binding EditPreLaunchScriptCommand}"/>
                            </StackPanel>
                            <CheckBox Content="Use the same script for pre-launch and post-exit"
                                      IsChecked="{Binding UseSameScriptForBoth}"
                                      Style="{StaticResource ModernCheckBox}" Margin="0,0,0,12"
                                      ToolTip="For a script that handles both phases in one file, like the bundled examples"/>

                            <!-- Post-exit script -->
                            <TextBlock Text="Post-Exit Script (runs after the game closes)" FontSize="{DynamicResource FontSizeBody}"
                                       Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="PostExitScriptBox" AutomationProperties.Name="Post-exit script path" AutomationProperties.HelpText="{Binding PostExitScriptError, TargetNullValue=''}"
                                         Grid.Column="0" Text="{Binding PostExitScriptPath, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding CanEditPostExitScript}"
                                         Style="{StaticResource PathTextBox}" Margin="0,0,8,0"/>
                                <Button AutomationProperties.Name="Test the post-exit script" Grid.Column="1" Content="Test" Command="{Binding TestPostExitScriptCommand}"
                                        Style="{StaticResource ModernOutlineButton}" Margin="0,0,8,0"
                                        ToolTip="Run this script now as a post-exit run with playtime 0 (hidden, not elevated, 30 s limit) and show its exit code and output"/>
                                <Button AutomationProperties.Name="Browse for a post-exit script" Grid.Column="2" Content="Browse..." Command="{Binding BrowsePostExitScriptCommand}"
                                        IsEnabled="{Binding CanEditPostExitScript}"
                                        Style="{StaticResource ModernOutlineButton}"/>
                            </Grid>
                            <TextBlock Text="{Binding PostExitScriptError}" Style="{StaticResource FieldErrorText}" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Button Style="{StaticResource HelpLinkButton}" Content="New script..." Command="{Binding NewPostExitScriptCommand}"
                                        IsEnabled="{Binding CanEditPostExitScript}"
                                        ToolTip="Create a new PowerShell script of your own from the blank template, in the scripts folder, and open it for editing"/>
                                <TextBlock Text="·" Foreground="{DynamicResource BrushTextMuted}" Margin="6,0" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource HelpLinkButton}" Content="Open in editor" Command="{Binding EditPostExitScriptCommand}"/>
                            </StackPanel>
                            <TextBlock Text="Runs once TrayTrigger sees the game exit, which is every launch except a bare launcher link (a dropped .url with no platform ID)."
                                       FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                        </StackPanel>
                    </Border>

                    <!-- HOW THEY RUN: arguments and options, advanced and optional, so it starts shut unless the game already has a script. -->
                    <Border Background="{DynamicResource BrushDialogCard}" BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1" CornerRadius="{DynamicResource RadiusCard}" Padding="14" Margin="0,0,0,12"
                            Visibility="{Binding ShowScriptsCardOnTab, Converter={StaticResource BoolToVis}}">
                        <Expander Header="How the scripts run" Style="{StaticResource DisclosureExpander}"
                                  IsExpanded="{Binding ShowScriptRunOptions}">
                            <StackPanel Margin="0,8,0,0">

                            <!-- Script arguments: free text appended after the five positional
                                 arguments, so one generic script can be parameterised per game. -->
                            <TextBlock Text="Script Arguments (optional, passed to both scripts)" FontSize="{DynamicResource FontSizeBody}"
                                       Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                            <TextBox AutomationProperties.Name="Extra script arguments" Text="{Binding ScriptArguments, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBox}" IsEnabled="{Binding CanEditScriptArguments}" Margin="0,0,0,4"/>
                            <TextBlock Text="Passed after the five values TrayTrigger always sends, as $ScriptArgs in the template. Quote a value that contains spaces. The default scripts get them too, in place of the Default Script Arguments from Settings."
                                       FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <!-- The options, greyed out until a script path is set, so an empty card doesn't read as "something is configured". -->
                            <CheckBox Content="Wait for the pre-launch script to finish before starting the game"
                                      IsChecked="{Binding WaitForPreLaunchScript}" IsEnabled="{Binding HasPreLaunchScript}"
                                      Style="{StaticResource ModernCheckBox}" Margin="0,0,0,6"/>
                            <DockPanel Margin="22,0,0,6" LastChildFill="True" IsEnabled="{Binding HasPreLaunchScript}">
                                <TextBox x:Name="PreLaunchTimeoutBox" AutomationProperties.Name="Pre-launch script timeout in seconds" AutomationProperties.HelpText="{Binding PreLaunchTimeoutError, TargetNullValue=''}"
                                         DockPanel.Dock="Left" Width="64" TextAlignment="Center" Text="{Binding PreLaunchScriptTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ValidatedTextBox}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding PreLaunchTimeoutHint}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}"
                                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Text="{Binding PreLaunchTimeoutError}" Style="{StaticResource FieldErrorText}" Margin="22,0,0,6"/>
                            <CheckBox Content="Cancel the launch if the pre-launch script fails"
                                      ToolTip="Fails means a non-zero exit code, a timeout, or a script that won't start."
                                      IsChecked="{Binding AbortLaunchOnScriptFailure}" IsEnabled="{Binding HasPreLaunchScript}"
                                      Style="{StaticResource ModernCheckBox}" Margin="0,0,0,6"/>
                            <CheckBox Content="Run scripts hidden (no console window)"
                                      IsChecked="{Binding RunScriptsHidden}" IsEnabled="{Binding HasAnyScript}"
                                      Style="{StaticResource ModernCheckBox}" Margin="0,0,0,6"/>
                            <CheckBox Content="Run scripts as Administrator (UAC prompt on every launch)"
                                      IsChecked="{Binding RunScriptsAsAdmin}" IsEnabled="{Binding HasAnyScript}"
                                      Style="{StaticResource ModernCheckBox}" Margin="0,0,0,12"/>

                            <!-- Settings default scripts, as they apply to this game. Only shown
                                 when at least one default is configured. -->
                            <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                                    CornerRadius="{DynamicResource RadiusControl}" Padding="10,8" Margin="0,0,0,10"
                                    Visibility="{Binding HasDefaultScripts, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="Default Scripts from Settings" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding DefaultScriptsSummary}" FontSize="{DynamicResource FontSizeBody}"
                                               Foreground="{DynamicResource BrushTextMuted}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                    <CheckBox Content="Don't run the default scripts for this game"
                                              IsChecked="{Binding SkipDefaultScripts}"
                                              Style="{StaticResource ModernCheckBox}"/>
                                </StackPanel>
                            </Border>

                            <!-- Same pair of links, in the same place, as the scripts card in Settings. -->
                            <WrapPanel Orientation="Horizontal">
                                <Button Style="{StaticResource HelpLinkButton}" Content="Script guide &amp; examples"
                                        Command="{x:Static services:HelpCommands.ShowTopic}" CommandParameter="scripts/overview"/>
                                <TextBlock Text="·" Foreground="{DynamicResource BrushTextMuted}" Margin="6,0" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource HelpLinkButton}" Content="Writing your own"
                                        Command="{x:Static services:HelpCommands.ShowTopic}" CommandParameter="scripts/writing"/>
                                <TextBlock Text="·" Foreground="{DynamicResource BrushTextMuted}" Margin="6,0" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource HelpLinkButton}" Content="Open scripts folder" Command="{Binding OpenScriptsFolderCommand}"
                                        ToolTip="Example scripts to copy and adapt, and a README with a quick start and how to write your own"/>
                                <TextBlock Text="·" Foreground="{DynamicResource BrushTextMuted}" Margin="6,0" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource HelpLinkButton}" Content="Get more scripts"
                                        Command="{x:Static services:HelpCommands.OpenUrl}" CommandParameter="https://github.com/stephenh678/TrayTrigger-Scripts"
                                        ToolTip="The TrayTrigger-Scripts catalogue on GitHub: ready-made scripts to drop into the scripts folder, and where to share yours"/>
                            </WrapPanel>
                            </StackPanel>
                        </Expander>
                    </Border>

                    <!-- Scripts stub: when the scripts feature is off, say so instead of silently
                         omitting the card, so the feature is discoverable from here. -->
                    <Border Background="{DynamicResource BrushDialogCard}" BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1" CornerRadius="{DynamicResource RadiusCard}" Padding="14,10" Margin="0,0,0,12"
                            Visibility="{Binding ShowScriptsStubOnTab, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <DockPanel LastChildFill="True">
                                <Button DockPanel.Dock="Right" Style="{StaticResource HelpLinkButton}" Content="What scripts can do" VerticalAlignment="Center" Margin="12,0,0,0"
                                        Command="{x:Static services:HelpCommands.ShowTopic}" CommandParameter="scripts/overview"/>
                                <TextBlock FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}" TextWrapping="Wrap" VerticalAlignment="Center">
                                    <Run Text="Pre-Launch &amp; Post-Exit Scripts" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}"/>
                                    <Run Text=" are turned off, so your own script can't run before this game starts or after it exits."/>
                                </TextBlock>
                            </DockPanel>
                            <CheckBox Content="Enable scripts" IsChecked="{Binding ScriptsEnabled}" Margin="0,8,0,0"
                                      Style="{StaticResource ModernCheckBox}"
                                      AutomationProperties.Name="Enable scripts"/>
                            <TextBlock Text="The same switch as Settings › Launch &amp; Performance: one setting for every game, and it takes effect at once, even if you cancel your changes."
                                       FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}" TextWrapping="Wrap" Margin="22,3,0,0"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
            </DockPanel>
        </Grid>
</UserControl>
