<Window x:Class="TrayTrigger.Views.WhatsNewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TrayTrigger - What's New"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BrushSurface}"
        Foreground="{DynamicResource BrushTextPrimary}">

    <Border BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0">
        <Grid Margin="24,20,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" Source="pack://application:,,,/Assets/app_icon.png"
                       Width="48" Height="48" Stretch="Uniform" Margin="0,0,16,0" VerticalAlignment="Top"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="KickerText" Text="TrayTrigger updated" FontSize="{StaticResource FontSizeBody}"
                               Foreground="{DynamicResource BrushTextMuted}"/>
                    <TextBlock x:Name="TitleText" Text="What's new" FontSize="{StaticResource FontSizeTitle}" FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushTextPrimary}" Margin="0,2,0,0"/>
                    <TextBlock x:Name="SubtitleText" FontSize="{StaticResource FontSizeBody}"
                               Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="{DynamicResource BrushDialogCard}" BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="1" CornerRadius="{DynamicResource RadiusControl}" Padding="12,10" Margin="0,0,0,16">
                <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="NotesText" FontSize="{StaticResource FontSizeBody}"
                               Foreground="{DynamicResource BrushTextSecondary}"
                               TextWrapping="Wrap" LineHeight="18" FontFamily="{StaticResource AppFont}"
                               Margin="0,0,14,0"/>
                </ScrollViewer>
            </Border>

            <DockPanel Grid.Row="2" LastChildFill="False">
                <Button Content="Release notes on GitHub" Style="{StaticResource ModernOutlineButton}"
                        Padding="14,6" DockPanel.Dock="Left" Click="OnGitHubClick"/>
                <Button Content="Close" Style="{StaticResource ModernAccentButton}"
                        Padding="16,6" DockPanel.Dock="Right" IsDefault="True" IsCancel="True" Click="OnCloseClick"/>
            </DockPanel>
        </Grid>
    </Border>
</Window>
