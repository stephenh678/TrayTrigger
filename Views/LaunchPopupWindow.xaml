<!-- The launch popup (LaunchPopupCoordinator): a small card above the tray clock while a game
     launched from a hotkey or the tray menu starts with the TrayTrigger window hidden. Never
     activated (WS_EX_NOACTIVATE), kept out of Alt+Tab (WS_EX_TOOLWINDOW), and click-through
     while it only reports progress. Styled like the in-window launch toast. The outer margin
     leaves room for the drop shadow inside the transparent window. -->
<Window x:Class="TrayTrigger.Views.LaunchPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TrayTrigger launch"
        Width="320" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        Focusable="False" UseLayoutRounding="True" Opacity="0"
        FontFamily="{StaticResource AppFont}">

    <Border x:Name="Card" Margin="10,10,12,14" Padding="12,10,8,10" CornerRadius="8"
            Background="#24242E" BorderBrush="{StaticResource BrushAccent}" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.5" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border x:Name="IconTile" Grid.Row="0" Grid.Column="0" Width="34" Height="34" CornerRadius="6"
                    Background="#2F2F3E" Margin="0,0,10,0" VerticalAlignment="Center">
                <Grid>
                    <Image x:Name="GameIcon" Width="26" Height="26" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock x:Name="IconGlyph" Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" FontSize="16"
                               Foreground="{StaticResource BrushTextSecondary}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,4,0">
                <TextBlock x:Name="StatusText" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="NameText" FontSize="13" Foreground="{StaticResource BrushTextPrimary}"
                           TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
            </StackPanel>

            <Button x:Name="CloseButton" Grid.Row="0" Grid.Column="2" Content="&#xE711;"
                    FontFamily="{StaticResource IconFont}" FontSize="10" Padding="6,4" VerticalAlignment="Top"
                    Style="{StaticResource ModernGhostButton}" Focusable="False"
                    AutomationProperties.Name="Close" Click="OnCloseClick"/>

            <TextBlock x:Name="DetailText" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" FontSize="11"
                       Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,8,4,0"/>

            <Button x:Name="ActionButton" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" HorizontalAlignment="Left"
                    FontSize="11.5" Padding="6,3" Margin="-6,5,0,0" Focusable="False"
                    Foreground="{StaticResource BrushAccentHover}" Style="{StaticResource ModernGhostButton}"
                    Click="OnActionClick"/>

            <Grid x:Name="ProgressTrack" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Height="3"
                  Margin="0,10,4,0" Background="#2F2F3E" ClipToBounds="True">
                <Border x:Name="ProgressBar" Width="80" HorizontalAlignment="Left" CornerRadius="1.5"
                        Background="{StaticResource BrushAccent}">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="ProgressShift" X="-80"/>
                    </Border.RenderTransform>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
