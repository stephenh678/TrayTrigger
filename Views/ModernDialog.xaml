<Window x:Class="TrayTrigger.Views.ModernDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="TrayTrigger"
        Width="470" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource BrushDialogBg}"
        Foreground="{StaticResource BrushTextPrimary}">

    <Border BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="0,1,0,0">
        <Grid Margin="24,20,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Message Content Area -->
                <RowDefinition Height="Auto"/> <!-- Action Buttons -->
            </Grid.RowDefinitions>

            <!-- Main Content Area with Icon Badge and Text -->
            <Grid Grid.Row="0" Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Status / Type Icon Badge -->
                <Border x:Name="IconBadge" Grid.Column="0" Width="44" Height="44" CornerRadius="22" 
                        Background="#2E181B" BorderBrush="#781D22" BorderThickness="1.5" 
                        Margin="0,0,16,0" VerticalAlignment="Top" HorizontalAlignment="Center">
                    <TextBlock x:Name="IconGlyph" Text="🗑" FontSize="18" 
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Dialog Texts -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="PrimaryMessageText" 
                               Text="Are you sure you want to remove this item?" 
                               FontSize="14" FontWeight="SemiBold" 
                               Foreground="{StaticResource BrushTextPrimary}" 
                               TextWrapping="Wrap" LineHeight="20"/>

                    <TextBlock x:Name="DetailMessageText" 
                               Text="This will only remove the shortcut from TrayTrigger. Your installed game files will not be deleted." 
                               FontSize="12" 
                               Foreground="{StaticResource BrushTextSecondary}" 
                               TextWrapping="Wrap" LineHeight="17" 
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Action Buttons Footer -->
            <DockPanel Grid.Row="1" LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button x:Name="CancelBtn" Content="Cancel" 
                            Style="{StaticResource ModernGhostButton}" 
                            Padding="16,7" Margin="0,0,10,0" 
                            IsCancel="True" Click="OnCancelClick"/>

                    <Button x:Name="SecondaryBtn" Content="Minimize to Tray" 
                            Style="{StaticResource ModernOutlineButton}" 
                            Padding="16,7" Margin="0,0,10,0" 
                            Visibility="Collapsed" Click="OnSecondaryClick"/>
                    
                    <Button x:Name="ConfirmBtn" Content="Remove" 
                            Style="{StaticResource ModernDangerButton}" 
                            Padding="18,7" 
                            IsDefault="True" Click="OnConfirmClick"/>
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</Window>
