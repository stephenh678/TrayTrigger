<Window x:Class="TrayTrigger.Views.SteamImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TrayTrigger.ViewModels"
        mc:Ignorable="d"
        Title="Import Steam Games"
        Height="580" Width="680"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource BrushDialogBg}"
        Foreground="{StaticResource BrushTextPrimary}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Search & Bulk Selection -->
            <RowDefinition Height="*"/>    <!-- Games List -->
            <RowDefinition Height="Auto"/> <!-- Status & Action Buttons -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Import Steam Games" FontSize="18" Foreground="{StaticResource BrushTextPrimary}" 
                           FontFamily="{StaticResource AppFont}" FontWeight="Normal"/>
                <TextBlock Text="Scanned from your Steam libraries. Select games to add to TrayTrigger." 
                           FontSize="12" Foreground="{StaticResource BrushTextSecondary}" 
                           FontFamily="{StaticResource AppFont}" Margin="0,2,0,0"/>
            </StackPanel>
            <Button DockPanel.Dock="Right" Content="Rescan" Command="{Binding RefreshCommand}" 
                    Style="{StaticResource ModernGhostButton}" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Filter & Selection Bar -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" 
                     Style="{StaticResource ModernTextBox}" Margin="0,0,12,0"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Select All" Command="{Binding SelectAllCommand}" 
                        Style="{StaticResource ModernGhostButton}" Margin="0,0,6,0"/>
                <Button Content="Deselect All" Command="{Binding DeselectAllCommand}" 
                        Style="{StaticResource ModernGhostButton}"/>
            </StackPanel>
        </Grid>

        <!-- Games List -->
        <Border Grid.Row="2" CornerRadius="8" Background="{StaticResource BrushSurfaceDark}" 
                BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" Margin="0,0,0,16">
            <ListBox ItemsSource="{Binding FilteredGames}" 
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#222228"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{TemplateBinding Background}" 
                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}" 
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource BrushSurfaceHover}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:SteamImportItemViewModel}">
                        <DockPanel LastChildFill="True">
                            <!-- Checkbox -->
                            <CheckBox IsChecked="{Binding IsSelected}" 
                                      IsEnabled="{Binding IsAlreadyImported, Converter={x:Null}}" 
                                      VerticalAlignment="Center" Margin="0,0,12,0"
                                      DockPanel.Dock="Left">
                                <CheckBox.Style>
                                    <Style TargetType="CheckBox" BasedOn="{StaticResource ModernCheckBox}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAlreadyImported}" Value="True">
                                                <Setter Property="IsEnabled" Value="False"/>
                                                <Setter Property="Opacity" Value="0.4"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </CheckBox.Style>
                            </CheckBox>

                            <!-- Game Icon -->
                            <Border Width="36" Height="36" CornerRadius="6" Background="#22222A" 
                                    Margin="0,0,12,0" VerticalAlignment="Center" DockPanel.Dock="Left">
                                <Image Source="{Binding IconImage}" Width="32" Height="32" 
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>

                            <!-- Already imported badge -->
                            <Border DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAlreadyImported}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border Background="#203022" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="In Library" Foreground="#52C41A" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                            </Border>

                            <!-- Name and Install Path -->
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="13.5" 
                                           Foreground="{StaticResource BrushTextPrimary}" 
                                           FontFamily="{StaticResource AppFont}"/>
                                <TextBlock Text="{Binding InstallDir}" FontSize="11" 
                                           Foreground="{StaticResource BrushTextMuted}" 
                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Footer -->
        <DockPanel Grid.Row="3">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" 
                       Foreground="{StaticResource BrushTextSecondary}" 
                       VerticalAlignment="Center"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Command="{Binding CancelCommand}" 
                        Style="{StaticResource ModernGhostButton}" Margin="0,0,8,0"/>
                <Button Content="Import Selected" Command="{Binding ImportCommand}" 
                        Style="{StaticResource ModernAccentButton}"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
