<Window x:Class="TrayTrigger.Views.TraySearchFlyout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Search Games"
        Width="380" Height="450"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True">

    <Window.Resources>
        <!-- ListBoxItem Template with Dark Fluent Hover & Selection -->
        <Style x:Key="FlyoutListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" 
                                CornerRadius="7" Padding="{TemplateBinding Padding}" 
                                BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#252530"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#383848"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2B2B38"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Container with Drop Shadow & Fluent Border -->
    <Border Background="#17171C" BorderBrush="#2C2C38" BorderThickness="1" CornerRadius="10" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.55" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Search Header Input -->
                <RowDefinition Height="*"/>    <!-- Results List -->
                <RowDefinition Height="Auto"/> <!-- Bottom Helper Bar -->
            </Grid.RowDefinitions>

            <!-- 1. Search Bar -->
            <Border Grid.Row="0" Background="#202028" BorderBrush="#353545" BorderThickness="1" 
                    CornerRadius="7" Padding="10,6" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="🔍" FontSize="13" Foreground="{StaticResource BrushTextMuted}" 
                               VerticalAlignment="Center" Margin="0,0,8,0"/>

                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="PlaceholderTextBlock" Text="Type game name to launch..." 
                                   Foreground="{StaticResource BrushTextMuted}" FontSize="13" 
                                   FontFamily="{StaticResource AppFont}" IsHitTestVisible="False"
                                   VerticalAlignment="Center"/>
                        <TextBox x:Name="SearchTextBox" Background="Transparent" Foreground="{StaticResource BrushTextPrimary}" 
                                 BorderThickness="0" FontSize="13" FontFamily="{StaticResource AppFont}" 
                                 CaretBrush="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"
                                 TextChanged="SearchTextBox_TextChanged" PreviewKeyDown="SearchTextBox_PreviewKeyDown"/>
                    </Grid>

                    <Button x:Name="ClearButton" Grid.Column="2" Content="✕" 
                            Style="{StaticResource ModernGhostButton}" Padding="4,2" FontSize="11" 
                            Visibility="Collapsed" Click="ClearButton_Click" ToolTip="Clear search"/>
                </Grid>
            </Border>

            <!-- 2. Results List -->
            <Grid Grid.Row="1">
                <ListBox x:Name="ResultsListBox" 
                         Background="Transparent" BorderThickness="0" 
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ItemContainerStyle="{StaticResource FlyoutListBoxItemStyle}"
                         MouseDoubleClick="ResultsListBox_MouseDoubleClick"
                         KeyDown="ResultsListBox_KeyDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel LastChildFill="True">
                                <!-- Game Icon -->
                                <Border DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="6" 
                                        Background="#121214" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <Image Source="{Binding IconImage}" Width="24" Height="24" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>

                                <!-- Launch Arrow Glyph -->
                                <Border DockPanel.Dock="Right" Width="24" Height="24" CornerRadius="12" 
                                        Background="#22222C" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <TextBlock Text="▶" FontSize="10" Foreground="{StaticResource BrushAccentHover}" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1,0,0,0"/>
                                </Border>

                                <!-- Name & Info -->
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" 
                                               Foreground="{StaticResource BrushTextPrimary}" 
                                               FontFamily="{StaticResource AppFont}" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <Border Background="#252530" CornerRadius="3" Padding="5,1" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding Category}" FontSize="9.5" 
                                                       Foreground="{StaticResource BrushTextSecondary}" 
                                                       FontFamily="{StaticResource AppFont}"/>
                                        </Border>
                                        <TextBlock Text="{Binding LastPlayedDisplay}" FontSize="10" 
                                                   Foreground="{StaticResource BrushTextMuted}" 
                                                   FontFamily="{StaticResource AppFont}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Empty State -->
                <StackPanel x:Name="EmptyStatePanel" HorizontalAlignment="Center" VerticalAlignment="Center" 
                            Visibility="Collapsed" Margin="0,20,0,20">
                    <TextBlock Text="🎮" FontSize="26" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="No games found" FontSize="13" FontWeight="SemiBold" 
                               Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Try typing a different name or category" FontSize="11" 
                               Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>

            <!-- 3. Footer Helper -->
            <Border Grid.Row="2" Margin="0,10,0,0" Padding="0,8,0,0" BorderBrush="#252530" BorderThickness="0,1,0,0">
                <Grid>
                    <TextBlock Text="↑↓ navigate • Enter to launch • Esc to close" FontSize="10.5" 
                               Foreground="{StaticResource BrushTextMuted}" FontFamily="{StaticResource AppFont}" 
                               HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ResultCountText" Text="0 games" FontSize="10.5" 
                               Foreground="{StaticResource BrushTextMuted}" FontFamily="{StaticResource AppFont}" 
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
