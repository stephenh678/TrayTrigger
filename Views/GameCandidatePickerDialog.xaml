<Window x:Class="TrayTrigger.Views.GameCandidatePickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Choose Game Executable"
        Height="460" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource BrushDialogBg}"
        Foreground="{StaticResource BrushTextPrimary}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Candidates List -->
            <RowDefinition Height="Auto"/> <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Choose Game Executable" FontSize="18" Foreground="{StaticResource BrushTextPrimary}"
                           FontFamily="{StaticResource AppFont}" FontWeight="Normal"/>
                <TextBlock x:Name="SubtitleTextBlock" 
                           Text="Multiple candidates were found. Select the game's executable:" 
                           FontSize="12" Foreground="{StaticResource BrushTextSecondary}" 
                           FontFamily="{StaticResource AppFont}" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- List of Candidates -->
        <Border Grid.Row="1" CornerRadius="8" Background="{StaticResource BrushSurfaceDark}" 
                BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" Margin="0,0,0,16">
            <ListBox x:Name="CandidatesListBox" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="CandidatesListBox_MouseDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#222228"/>
                        <Setter Property="Padding" Value="12,10"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{TemplateBinding Background}" 
                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}" 
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#1C2E3D"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource BrushSurfaceHover}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel LastChildFill="True">
                            <Border CornerRadius="6" Background="#26262B" Width="36" Height="36" Margin="0,0,12,0" DockPanel.Dock="Left">
                                <Image Source="{Binding IconImage}" Width="28" Height="28" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>

                            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,0,0">
                                <TextBlock Text="{Binding DisplaySize}" FontSize="11" Foreground="{StaticResource BrushTextMuted}" 
                                           HorizontalAlignment="Right"/>
                                <Border Background="#1C2E3D" CornerRadius="4" Padding="5,1.5" Margin="0,3,0,0"
                                        HorizontalAlignment="Right"
                                        Visibility="{Binding IsRecommendedVisibility}">
                                    <TextBlock Text="RECOMMENDED" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource BrushAccentHover}"/>
                                </Border>
                            </StackPanel>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Candidate.Name}" FontSize="13.5" FontWeight="SemiBold" 
                                           Foreground="{StaticResource BrushTextPrimary}" FontFamily="{StaticResource AppFont}"/>
                                <TextBlock Text="{Binding DisplayPath}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" 
                                           FontFamily="{StaticResource AppFont}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Buttons -->
        <DockPanel Grid.Row="2">
            <Button DockPanel.Dock="Right" Content="Add Selected Game" Click="AddButton_Click" 
                    Style="{StaticResource ModernAccentButton}" MinWidth="130" Margin="10,0,0,0"/>
            <Button DockPanel.Dock="Right" Content="Cancel" Click="CancelButton_Click" 
                    Style="{StaticResource ModernGhostButton}" MinWidth="80"/>
        </DockPanel>
    </Grid>
</Window>
