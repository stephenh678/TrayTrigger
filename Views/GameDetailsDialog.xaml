<Window x:Class="TrayTrigger.Views.GameDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TrayTrigger.ViewModels"
        mc:Ignorable="d"
        Title="Game Details"
        Height="680" Width="820"
        MinHeight="560" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushDialogBg}"
        Foreground="{StaticResource BrushTextPrimary}"
        FontFamily="{StaticResource AppFont}">

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Hero / Poster & Meta -->
            <RowDefinition Height="Auto"/> <!-- Divider -->
            <RowDefinition Height="*"/>    <!-- Scrollable Details (Synopsis, Specs, News) -->
            <RowDefinition Height="Auto"/> <!-- Bottom Actions & Status -->
        </Grid.RowDefinitions>

        <!-- ============================================================== -->
        <!-- 1. TOP HERO SECTION: POSTER + METADATA                         -->
        <!-- ============================================================== -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/> <!-- Poster Art (170px) -->
                <ColumnDefinition Width="*"/>    <!-- Metadata, Scores & Actions -->
            </Grid.ColumnDefinitions>

            <!-- Poster Artwork Container -->
            <Border Grid.Column="0" Width="170" Height="255" CornerRadius="8"
                    Background="#141418" BorderBrush="{StaticResource BrushBorderDark}"
                    BorderThickness="1" Margin="0,0,20,0">
                <Border.Clip>
                    <RectangleGeometry Rect="0,0,168,253" RadiusX="7" RadiusY="7"/>
                </Border.Clip>
                <Grid>
                    <!-- Fallback Icon Tile if no poster -->
                    <Border Background="#181820" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Image Source="{Binding DisplayCoverImage}" Width="64" Height="64" Margin="0,0,0,8"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="No poster yet" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Ambient Blurred Background Fill (Fills entire poster box with matching game atmosphere;
                         RAWG's screenshot when that source is showing, else the poster itself) -->
                    <Image Source="{Binding AmbientImage}" Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="LowQuality">
                        <Image.Effect>
                            <BlurEffect Radius="24" RenderingBias="Performance"/>
                        </Image.Effect>
                    </Image>
                    <Border Background="#550D0D12"/>

                    <!-- Crisp Centered Artwork (Preserves 100% of the artwork, ZERO cropping of logos or text) -->
                    <Image Source="{Binding DisplayCoverImage}" Stretch="Uniform"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>
            </Border>

            <!-- Metadata Column -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Title & Genres -->
                    <RowDefinition Height="Auto"/> <!-- Dev, Pub & Release Date -->
                    <RowDefinition Height="Auto"/> <!-- Ratings & Sentiment Badges -->
                    <RowDefinition Height="*"/>    <!-- Play Mode Tags -->
                    <RowDefinition Height="Auto"/> <!-- Action Buttons -->
                </Grid.RowDefinitions>

                <!-- Title & Genre Pill -->
                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Left" Style="{StaticResource FavoriteToggleButton}" Command="{Binding ToggleFavoriteCommand}"
                            VerticalAlignment="Top" Margin="0,2,10,0"/>
                    <StackPanel>
                        <TextBlock Text="{Binding GameTitle}" FontSize="21" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushTextPrimary}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding GenresDisplay}" FontSize="12.5" Foreground="{StaticResource BrushAccentHover}"
                                   Margin="0,4,0,0" FontWeight="Medium"/>
                    </StackPanel>
                </DockPanel>

                <!-- Dev, Pub, Release Date, Playtime & Category -->
                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <DockPanel Margin="0,0,0,3" Visibility="{Binding HasDevelopers, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Developer:" Width="80" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                            <TextBlock Text="{Binding Developers}" FontSize="12" Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,3" Visibility="{Binding HasPublishers, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Publisher:" Width="80" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                            <TextBlock Text="{Binding Publishers}" FontSize="12" Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <DockPanel Visibility="{Binding HasReleaseDate, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Release Date:" Width="80" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                            <TextBlock Text="{Binding ReleaseDate}" FontSize="12" Foreground="{StaticResource BrushTextPrimary}"/>
                        </DockPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <DockPanel Margin="0,0,0,3">
                            <TextBlock Text="Playtime:" Width="75" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                            <TextBlock Text="{Binding PlaytimeDisplay}" FontSize="12" Foreground="{StaticResource BrushAccentHover}" FontWeight="Medium"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,3">
                            <TextBlock Text="Last Played:" Width="75" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                            <TextBlock Text="{Binding LastPlayedDisplay}" FontSize="12" Foreground="{StaticResource BrushTextPrimary}"/>
                        </DockPanel>
                        <DockPanel>
                            <TextBlock Text="Category:" Width="75" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                            <TextBlock Text="{Binding Category}" FontSize="12" Foreground="{StaticResource BrushTextPrimary}"/>
                        </DockPanel>
                    </StackPanel>
                </Grid>

                <!-- Scores & Sentiment Badges -->
                <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
                    <!-- Metacritic Score -->
                    <Border Background="#1F3325" BorderBrush="#2E5C3A" BorderThickness="1" CornerRadius="4" 
                            Padding="8,4" Margin="0,0,8,4" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasMetacritic}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding MetacriticScore}" FontWeight="Bold" FontSize="13" Foreground="#44D970" Margin="0,0,6,0"/>
                            <TextBlock Text="Metascore" FontSize="11" Foreground="#9EDBB3" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- RAWG community rating (RAWG source only; fills in where Metacritic is absent) -->
                    <Border Background="#1F3325" BorderBrush="#2E5C3A" BorderThickness="1" CornerRadius="4"
                            Padding="8,4" Margin="0,0,8,4" VerticalAlignment="Center"
                            Visibility="{Binding HasRawgRating, Converter={StaticResource BoolToVis}}"
                            ToolTip="Community rating on rawg.io">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE735;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                       Foreground="#44D970" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding RawgRatingDisplay}" FontSize="11.5" Foreground="#9EDBB3" FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- ESRB rating (RAWG source only) -->
                    <Border Background="#26242E" BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" CornerRadius="4"
                            Padding="8,4" Margin="0,0,8,4" VerticalAlignment="Center"
                            Visibility="{Binding HasEsrbRating, Converter={StaticResource BoolToVis}}"
                            ToolTip="ESRB age rating">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ESRB" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding EsrbRating}" FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Steam Review Summary -->
                    <Border Background="#1C2E3D" BorderBrush="{StaticResource BrushBorderAccent}" BorderThickness="1" CornerRadius="4"
                            Padding="8,4" Margin="0,0,8,4" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasReviewSummary}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8E1;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                       Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding ReviewSummary}" FontSize="11.5" Foreground="{StaticResource BrushAccentHover}" FontWeight="Medium"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- Play Mode Tags -->
                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,12" MaxHeight="60">
                    <ItemsControl ItemsSource="{Binding PlayModes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#252530" BorderBrush="{StaticResource BrushBorderDark}" 
                                        BorderThickness="1" CornerRadius="12" Padding="8,3" Margin="0,0,6,6">
                                    <TextBlock Text="{Binding}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Action Buttons: Primary & Constructive on Left, Destructive on Far Right -->
                <DockPanel Grid.Row="4" VerticalAlignment="Bottom" Margin="0,4,0,0" LastChildFill="False">
                    <!-- Destructive Action (Safely Isolated on Far Right) -->
                    <Button DockPanel.Dock="Right" Command="{Binding DeleteGameCommand}"
                            Style="{StaticResource ModernOutlineButton}" Foreground="#E06C75" BorderBrush="#66E06C75"
                            Padding="12,7" Margin="0,0,0,6" FontSize="12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Remove" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Primary & Constructive Actions (Left Aligned). MDL2 glyphs rather than
                         emoji so the buttons match the rest of the app on every Windows build. -->
                    <WrapPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <Button Command="{Binding LaunchGameCommand}"
                                Style="{StaticResource ModernAccentButton}" Padding="16,7" Margin="0,0,10,6"
                                FontWeight="SemiBold" FontSize="12.5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="12" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Launch Game" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenStorePageCommand}"
                                Visibility="{Binding HasStoreUrl, Converter={StaticResource BoolToVis}}"
                                Style="{StaticResource ModernOutlineButton}" Padding="13,7" Margin="0,0,10,6"
                                FontSize="12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="12" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Steam Store" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <!-- The game's own storefront per RAWG (Epic / GOG / Xbox...) while RAWG is showing. -->
                        <Button Command="{Binding OpenRawgStoreCommand}"
                                Visibility="{Binding HasRawgStore, Converter={StaticResource BoolToVis}}"
                                Style="{StaticResource ModernOutlineButton}" Padding="13,7" Margin="0,0,10,6"
                                FontSize="12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="12" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding RawgStoreLabel}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding EditGameCommand}"
                                Style="{StaticResource ModernOutlineButton}" Padding="13,7" Margin="0,0,10,6"
                                FontSize="12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="12" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Edit Properties" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </DockPanel>
            </Grid>
        </Grid>

        <!-- Divider -->
        <Separator Grid.Row="1" Background="#2A2A35" Margin="0,0,0,14"/>

        <!-- ============================================================== -->
        <!-- 2. SCROLLABLE DETAILS: SYNOPSIS, SPECS & NEWS                  -->
        <!-- ============================================================== -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,14">
            <StackPanel Margin="0,0,10,0">

                <!-- Info source row. The Steam | RAWG switch is only present when RAWG is enabled
                     with a key (CanToggleSource); otherwise every game simply shows Steam and the
                     row carries just the "Matched to" caption and Change match. The source choice
                     is remembered per game (GameEntry.PreferredMetadataSource) and drives the text
                     fields above and the synopsis below - never the category, art or sorting. -->
                <DockPanel Margin="0,0,0,10" LastChildFill="True">
                    <Border DockPanel.Dock="Left" Background="#181820" BorderBrush="{StaticResource BrushBorderDark}"
                            BorderThickness="1" CornerRadius="6" Padding="3" VerticalAlignment="Center" Margin="0,0,12,0"
                            Visibility="{Binding CanToggleSource, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding SelectSteamSourceCommand}" Content="Steam" Padding="12,4"
                                    Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsSteamActive}"
                                    ToolTip="Show this game's info from the Steam store"
                                    AutomationProperties.Name="Show Steam info"/>
                            <Button Command="{Binding SelectRawgSourceCommand}" Content="RAWG" Padding="12,4" Margin="2,0,0,0"
                                    Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsRawgActive}"
                                    ToolTip="Show this game's info from RAWG (rawg.io)"
                                    AutomationProperties.Name="Show RAWG info"/>
                        </StackPanel>
                    </Border>
                    <Button DockPanel.Dock="Right" Command="{Binding ChangeMatchCommand}"
                            Visibility="{Binding CanChangeMatch, Converter={StaticResource BoolToVis}}"
                            Style="{StaticResource ModernGhostButton}" Padding="8,4" FontSize="11.5" VerticalAlignment="Center"
                            Foreground="{StaticResource BrushAccentHover}"
                            ToolTip="{Binding ChangeMatchToolTip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Change match" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding MatchCaption}" FontSize="11.5" Foreground="{StaticResource BrushTextMuted}"
                               VerticalAlignment="Center" Margin="0,0,12,0" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding HasMatchCaption, Converter={StaticResource BoolToVis}}"/>
                </DockPanel>

                <!-- Loading State -->
                <StackPanel Margin="0,30,0,30" HorizontalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowLoading}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <ProgressBar IsIndeterminate="True" Width="200" Height="4" Margin="0,0,0,12" Foreground="{StaticResource BrushAccent}"/>
                    <TextBlock Text="{Binding LoadingMessage}"
                               FontSize="12.5" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- RAWG status notice (neutral, not an error): no match / bad key / offline -->
                <Border Background="#1A1F2B" BorderBrush="{StaticResource BrushBorderAccent}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,14"
                        Visibility="{Binding HasRawgStatus, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding RawgStatusMessage}" FontSize="12.5" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap"/>
                </Border>

                <!-- Error Notice -->
                <Border Background="#2E181B" BorderBrush="#781D22" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,14">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding ErrorMessage}" FontSize="12.5" Foreground="#FF9999" TextWrapping="Wrap"/>
                </Border>


                <!-- A. About / Synopsis Card -->
                <Border Background="#16161C" BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="ABOUT THE GAME" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushAccentHover}" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding ShortDescription}" FontSize="13" Foreground="{StaticResource BrushTextPrimary}"
                                   TextWrapping="Wrap" LineHeight="20"/>
                        <!-- Required RAWG attribution: an active link wherever RAWG data is shown. -->
                        <TextBlock Margin="0,10,0,0" FontSize="10.5" Foreground="{StaticResource BrushTextMuted}"
                                   Visibility="{Binding ShowRawgAttribution, Converter={StaticResource BoolToVis}}">
                            <Hyperlink Command="{Binding OpenRawgPageCommand}" Foreground="{StaticResource BrushTextSecondary}">Data from RAWG</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- B. PC System Requirements Card -->
                <Border Background="#16161C" BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,14">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasRequirements}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="PC SYSTEM REQUIREMENTS" FontSize="11" FontWeight="SemiBold" 
                                       Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                <Button Content="Minimum" Command="{Binding ShowMinReqsCommand}" 
                                        Style="{StaticResource ModernOutlineButton}" Padding="8,3" FontSize="11" Margin="0,0,6,0"/>
                                <Button Content="Recommended" Command="{Binding ShowRecReqsCommand}" 
                                        Style="{StaticResource ModernOutlineButton}" Padding="8,3" FontSize="11"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="{Binding CurrentRequirementsText}" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" 
                                   TextWrapping="Wrap" LineHeight="19" FontFamily="Consolas, Segoe UI"/>
                    </StackPanel>
                </Border>

                <!-- C. Latest Patch Notes & News Card -->
                <Border Background="#16161C" BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" CornerRadius="8" Padding="14,12">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasNews}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10" LastChildFill="True">
                            <!-- Link to the full Steam news hub for this app (all announcements, not just the latest 3) -->
                            <Button DockPanel.Dock="Right"
                                    Command="{Binding OpenNewsHubCommand}"
                                    Style="{StaticResource ModernGhostButton}"
                                    Padding="0" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"
                                    Foreground="{StaticResource BrushAccentHover}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="View All News on Steam" VerticalAlignment="Center"/>
                                    <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="10" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="LATEST DEVELOPER NEWS &amp; PATCH NOTES" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center"/>
                        </DockPanel>

                        <ItemsControl ItemsSource="{Binding NewsItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- News Title & Date -->
                                            <DockPanel Grid.Row="0" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding DateDisplay}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"
                                                           DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                <!-- PATCH badge: shown only when Steam tagged the post as patch notes -->
                                                <Border DockPanel.Dock="Left" Background="#1B2E1F" BorderBrush="#2E7D3A" BorderThickness="1"
                                                        CornerRadius="4" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center"
                                                        Visibility="{Binding IsPatchNotes, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="PATCH" FontSize="9.5" FontWeight="Bold" Foreground="#6FCF7F"/>
                                                </Border>
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                                           Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>

                                            <!-- News Snippet -->
                                            <TextBlock Grid.Row="1" Text="{Binding Snippet}" FontSize="12" 
                                                       Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,6"/>

                                            <!-- Read More Link -->
                                            <Button Grid.Row="2"
                                                    Command="{Binding DataContext.OpenNewsUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding Url}"
                                                    Style="{StaticResource ModernGhostButton}"
                                                    Padding="0" HorizontalAlignment="Left" FontSize="11"
                                                    Foreground="{StaticResource BrushAccentHover}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Read Full Notes" VerticalAlignment="Center"/>
                                                    <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="10" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ============================================================== -->
        <!-- 3. BOTTOM ACTIONS                                              -->
        <!-- ============================================================== -->
        <DockPanel Grid.Row="3">
            <TextBlock Text="{Binding Game.ExecutablePath}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" 
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="580"/>
            <Button Content="Close" Click="CloseButton_Click" IsCancel="True" Style="{StaticResource ModernOutlineButton}" 
                    Padding="18,6" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
        </DockPanel>
    </Grid>
</Window>
