<Window x:Class="TrayTrigger.Views.GameDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TrayTrigger.ViewModels"
        xmlns:services="clr-namespace:TrayTrigger.Services"
        mc:Ignorable="d"
        Title="Game Details"
        Height="680" Width="880"
        MinHeight="560" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushSurface}"
        Foreground="{DynamicResource BrushTextPrimary}"
        FontFamily="{DynamicResource AppFont}">

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Hero / Poster & Meta -->
            <RowDefinition Height="Auto"/> <!-- Divider -->
            <RowDefinition Height="*"/>    <!-- Scrollable Details (Synopsis, Specs, News) -->
            <RowDefinition Height="Auto"/> <!-- Bottom Actions & Status -->
        </Grid.RowDefinitions>

        <!-- ============================================================== -->
        <!-- 1. TOP HERO SECTION: POSTER + METADATA                         -->
        <!-- ============================================================== -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/> <!-- Poster Art (170px) -->
                <ColumnDefinition Width="*"/>    <!-- Metadata, Scores & Actions -->
            </Grid.ColumnDefinitions>

            <!-- Poster Artwork Container -->
            <Border Grid.Column="0" Width="170" Height="255" CornerRadius="{DynamicResource RadiusCard}"
                    Background="{DynamicResource BrushBackground}" BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="1" Margin="0,0,20,0">
                <Border.Clip>
                    <MultiBinding Converter="{StaticResource RoundedClipConverter}"><Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}"/><Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}"/><Binding Path="CornerRadius" RelativeSource="{RelativeSource Self}"/><Binding Path="BorderThickness" RelativeSource="{RelativeSource Self}"/></MultiBinding>
                </Border.Clip>
                <Grid>
                    <!-- Fallback Icon Tile if no poster -->
                    <Border Background="{DynamicResource BrushDialogCard}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Image Source="{Binding DisplayCoverImage}" Width="64" Height="64" Margin="0,0,0,8"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="No poster yet" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Ambient Blurred Background Fill (Fills entire poster box with matching game atmosphere;
                         RAWG's screenshot when that source is showing, else the poster itself) -->
                    <Image Source="{Binding AmbientImage}" Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="LowQuality">
                        <Image.Effect>
                            <BlurEffect Radius="24" RenderingBias="Performance"/>
                        </Image.Effect>
                    </Image>
                    <Border Background="{DynamicResource BrushScrim}"/>

                    <!-- Crisp Centered Artwork (Preserves 100% of the artwork, ZERO cropping of logos or text) -->
                    <Image Source="{Binding DisplayCoverImage}" Stretch="Uniform"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>
            </Border>

            <!-- Metadata Column -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Title & Genres -->
                    <RowDefinition Height="Auto"/> <!-- Dev, Pub & Release Date -->
                    <RowDefinition Height="Auto"/> <!-- Ratings & Sentiment Badges -->
                    <RowDefinition Height="*"/>    <!-- Play Mode Tags -->
                    <RowDefinition Height="Auto"/> <!-- Action Buttons -->
                </Grid.RowDefinitions>

                <!-- Title & Genre Pill -->
                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <Button AutomationProperties.Name="{Binding FavoriteButtonLabel}" DockPanel.Dock="Left" Style="{StaticResource FavoriteToggleButton}" Command="{Binding ToggleFavoriteCommand}"
                            VerticalAlignment="Top" Margin="0,2,10,0"/>
                    <StackPanel>
                        <TextBlock Text="{Binding GameTitle}" FontSize="{DynamicResource FontSizeHeading}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushTextPrimary}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding GenresDisplay}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushAccentText}"
                                   Margin="0,4,0,0" FontWeight="Medium"/>
                    </StackPanel>
                </DockPanel>

                <!-- Dev, Pub, Release Date, Playtime & Category -->
                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <DockPanel Margin="0,0,0,3" Visibility="{Binding HasDevelopers, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Developer:" Width="80" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}"/>
                            <TextBlock Text="{Binding Developers}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,3" Visibility="{Binding HasPublishers, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Publisher:" Width="80" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}"/>
                            <TextBlock Text="{Binding Publishers}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <DockPanel Visibility="{Binding HasReleaseDate, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Release Date:" Width="80" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}"/>
                            <TextBlock Text="{Binding ReleaseDate}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextPrimary}"/>
                        </DockPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <DockPanel Margin="0,0,0,3">
                            <TextBlock Text="Playtime:" Width="75" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}"/>
                            <TextBlock Text="{Binding PlaytimeDisplay}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextPrimary}" FontWeight="Medium"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,3">
                            <TextBlock Text="Last Played:" Width="75" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}"/>
                            <TextBlock Text="{Binding LastPlayedDisplay}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextPrimary}"/>
                        </DockPanel>
                        <DockPanel>
                            <TextBlock Text="Category:" Width="75" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}"/>
                            <TextBlock Text="{Binding Category}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextPrimary}"/>
                        </DockPanel>
                        <!-- The drive it loads from: a game on a hard drive loads slower than on an SSD. -->
                        <DockPanel Margin="0,3,0,0" Visibility="{Binding HasInstallDrive, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Installed on:" Width="75" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}"/>
                            <TextBlock Text="{Binding InstallDrive}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextPrimary}"/>
                        </DockPanel>
                    </StackPanel>
                </Grid>

                <!-- Scores & Sentiment Badges -->
                <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
                    <!-- Metacritic Score -->
                    <Border Background="{DynamicResource BrushSuccessWash}" BorderBrush="{DynamicResource BrushSuccessSolid}" BorderThickness="1" CornerRadius="{DynamicResource RadiusSmall}" 
                            Padding="8,4" Margin="0,0,8,4" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasMetacritic}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding MetacriticScore}" FontWeight="Bold" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushSuccessText}" Margin="0,0,6,0"/>
                            <TextBlock Text="Metascore" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushSuccessText}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- RAWG community rating (RAWG source only; fills in where Metacritic is absent) -->
                    <Border Background="{DynamicResource BrushSuccessWash}" BorderBrush="{DynamicResource BrushSuccessSolid}" BorderThickness="1" CornerRadius="{DynamicResource RadiusSmall}"
                            Padding="8,4" Margin="0,0,8,4" VerticalAlignment="Center"
                            Visibility="{Binding HasRawgRating, Converter={StaticResource BoolToVis}}"
                            ToolTip="Community rating on rawg.io">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE735;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeBody}"
                                       Foreground="{DynamicResource BrushSuccessText}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding RawgRatingDisplay}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushSuccessText}" FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- ESRB rating (RAWG source only) -->
                    <Border Background="{DynamicResource BrushSurfaceHover}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="{DynamicResource RadiusSmall}"
                            Padding="8,4" Margin="0,0,8,4" VerticalAlignment="Center"
                            Visibility="{Binding HasEsrbRating, Converter={StaticResource BoolToVis}}"
                            ToolTip="ESRB age rating">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ESRB" FontSize="{DynamicResource FontSizeBody}" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding EsrbRating}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}" FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Steam Review Summary -->
                    <Border Background="{DynamicResource BrushAccentWash}" BorderBrush="{DynamicResource BrushBorderAccent}" BorderThickness="1" CornerRadius="{DynamicResource RadiusSmall}"
                            Padding="8,4" Margin="0,0,8,4" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasReviewSummary}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8E1;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeBody}"
                                       Foreground="{DynamicResource BrushAccentText}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding ReviewSummary}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushAccentText}" FontWeight="Medium"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- Play Mode Tags, then the anti-cheat tag when the last launch saw one -->
                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,12" MaxHeight="60">
                    <ItemsControl ItemsSource="{Binding TagList}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BrushSurfaceHover}" BorderBrush="{DynamicResource BrushBorder}" 
                                        BorderThickness="1" CornerRadius="{DynamicResource RadiusCard}" Padding="8,3" Margin="0,0,6,6">
                                    <TextBlock Text="{Binding}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Action Buttons: Primary & Constructive on Left, Destructive on Far Right -->
                <DockPanel Grid.Row="4" VerticalAlignment="Bottom" Margin="0,4,0,0" LastChildFill="False">
                    <!-- Destructive Action (Safely Isolated on Far Right) -->
                    <Button AutomationProperties.Name="Remove from library" DockPanel.Dock="Right" Command="{Binding DeleteGameCommand}"
                            Style="{StaticResource ModernOutlineButton}" Foreground="{DynamicResource BrushDanger}" BorderBrush="{DynamicResource BrushDangerBorder}"
                            Padding="12,7" Margin="0,0,0,6" FontSize="{DynamicResource FontSizeBody}"
                            VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeBody}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Remove" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Primary & Constructive Actions (Left Aligned). MDL2 glyphs rather than
                         emoji so the buttons match the rest of the app on every Windows build. -->
                    <WrapPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <Button AutomationProperties.Name="Launch Game" Command="{Binding LaunchGameCommand}"
                                Style="{StaticResource ModernAccentButton}" Padding="16,7" Margin="0,0,10,6"
                                FontWeight="SemiBold" FontSize="{DynamicResource FontSizeBody}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeBody}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Launch Game" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <!-- While the game is playing: the card menu's two session actions (UX-14h). -->
                        <Button AutomationProperties.Name="Close Game" Command="{Binding CloseGameCommand}"
                                Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}"
                                Style="{StaticResource ModernOutlineButton}" Padding="13,7" Margin="0,0,10,6" FontSize="{DynamicResource FontSizeBody}"
                                ToolTip="Asks the game to quit, as its own close button does. Once it exits, TrayTrigger restores the Performance Profile and runs the post-exit script.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeBody}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Close Game" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.Name="Force Close Game" Command="{Binding ForceCloseCommand}"
                                Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}"
                                Style="{StaticResource ModernOutlineButton}" Padding="13,7" Margin="0,0,10,6" FontSize="{DynamicResource FontSizeBody}"
                                Foreground="{DynamicResource BrushDanger}"
                                ToolTip="Kills the game's process, then ends the session. Anything unsaved in the game is lost.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeBody}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Force Close" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.Name="Open the Steam store page" Command="{Binding OpenStorePageCommand}"
                                Visibility="{Binding ShowSteamStoreButton, Converter={StaticResource BoolToVis}}"
                                Style="{StaticResource ModernOutlineButton}" Padding="13,7" Margin="0,0,10,6"
                                FontSize="{DynamicResource FontSizeBody}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeBody}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Steam Store" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <!-- The RAWG counterpart of Steam Store while RAWG is showing: the game's
                             rawg.io page, i.e. where the data on screen came from. -->
                        <Button AutomationProperties.Name="Open the RAWG page" Command="{Binding OpenRawgPageCommand}"
                                Visibility="{Binding HasRawgPage, Converter={StaticResource BoolToVis}}"
                                Style="{StaticResource ModernOutlineButton}" Padding="13,7" Margin="0,0,10,6"
                                FontSize="{DynamicResource FontSizeBody}" ToolTip="Open this game's page on rawg.io">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeBody}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Open on RAWG" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <!-- Where to find a game's PC fixes (ultrawide, FOV, frame cap, save location).
                             Follows neither source: Steam App ID when there is one, else a name search. -->
                        <Button AutomationProperties.Name="Open the PCGamingWiki page" Command="{Binding OpenPcGamingWikiCommand}"
                                Visibility="{Binding HasPcGamingWikiPage, Converter={StaticResource BoolToVis}}"
                                Style="{StaticResource ModernOutlineButton}" Padding="13,7" Margin="0,0,10,6"
                                FontSize="{DynamicResource FontSizeBody}"
                                ToolTip="Open this game's page on PCGamingWiki: fixes, ultrawide and FOV support, frame cap and save location">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeBody}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="PCGamingWiki" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.Name="Edit game" Command="{Binding EditGameCommand}"
                                Style="{StaticResource ModernOutlineButton}" Padding="13,7" Margin="0,0,10,6"
                                FontSize="{DynamicResource FontSizeBody}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeBody}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Edit Properties" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </DockPanel>
            </Grid>
        </Grid>

        <!-- Divider -->
        <Separator Grid.Row="1" Background="{DynamicResource BrushSurfaceHover}" Margin="0,0,0,14"/>

        <!-- ============================================================== -->
        <!-- 2. SCROLLABLE DETAILS: SYNOPSIS, SPECS & NEWS                  -->
        <!-- ============================================================== -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,14">
            <StackPanel Margin="0,0,10,0">

                <!-- Info source row. The Steam | RAWG switch is only present when RAWG is enabled
                     with a key (CanToggleSource); otherwise every game simply shows Steam and the
                     row carries just the "Matched to" caption and Change match. The source choice
                     is remembered per game (GameEntry.PreferredMetadataSource) and drives the text
                     fields above and the synopsis below - never the category, art or sorting. -->
                <DockPanel Margin="0,0,0,10" LastChildFill="True">
                    <Border DockPanel.Dock="Left" Background="{DynamicResource BrushDialogCard}" BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1" CornerRadius="{DynamicResource RadiusControl}" Padding="3" VerticalAlignment="Center" Margin="0,0,12,0"
                            Visibility="{Binding CanToggleSource, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding SelectSteamSourceCommand}" Content="Steam" Padding="12,4"
                                    Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsSteamActive}"
                                    ToolTip="Show this game's info from the Steam store"
                                    AutomationProperties.Name="Show Steam info"/>
                            <Button Command="{Binding SelectRawgSourceCommand}" Content="RAWG" Padding="12,4" Margin="2,0,0,0"
                                    Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsRawgActive}"
                                    ToolTip="Show this game's info from RAWG (rawg.io)"
                                    AutomationProperties.Name="Show RAWG info"/>
                        </StackPanel>
                    </Border>
                    <Button AutomationProperties.Name="Change which game this matches" DockPanel.Dock="Right" Command="{Binding ChangeMatchCommand}"
                            Visibility="{Binding CanChangeMatch, Converter={StaticResource BoolToVis}}"
                            Style="{StaticResource ModernGhostButton}" Padding="8,4" FontSize="{DynamicResource FontSizeBody}" VerticalAlignment="Center"
                            Foreground="{DynamicResource BrushAccentText}"
                            ToolTip="{Binding ChangeMatchToolTip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeBody}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Change match" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button DockPanel.Dock="Right" Style="{StaticResource HelpLinkButton}" Content="Where this info comes from"
                            VerticalAlignment="Center" Margin="0,0,12,0"
                            Command="{x:Static services:HelpCommands.ShowTopic}" CommandParameter="library/game_info"/>
                    <!-- Cache age for the active source and a manual re-fetch. The window always
                         paints from the disk cache; "Refresh game info" in Settings decides when
                         it re-fetches on its own, and this link does it on demand. -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0"
                                Visibility="{Binding ShowFreshness, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding LastUpdatedCaption}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}"
                                   VerticalAlignment="Center"/>
                        <Button Command="{Binding RefreshNowCommand}"
                                Style="{StaticResource ModernGhostButton}" Padding="8,4" FontSize="{DynamicResource FontSizeBody}" VerticalAlignment="Center"
                                Foreground="{DynamicResource BrushAccentText}" Margin="2,0,0,0"
                                ToolTip="{Binding RefreshNowToolTip}" AutomationProperties.Name="Refresh game info now">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeBody}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>

                <!-- Loading State -->
                <StackPanel Margin="0,30,0,30" HorizontalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowLoading}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <ProgressBar IsIndeterminate="True" Width="200" Height="4" Margin="0,0,0,12" Foreground="{DynamicResource BrushAccent}"/>
                    <TextBlock Text="{Binding LoadingMessage}"
                               FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- RAWG status notice (neutral, not an error): no match / bad key / offline -->
                <Border Background="{DynamicResource BrushAccentWash}" BorderBrush="{DynamicResource BrushBorderAccent}" BorderThickness="1" CornerRadius="{DynamicResource RadiusControl}" Padding="12,10" Margin="0,0,0,14"
                        Visibility="{Binding HasRawgStatus, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding RawgStatusMessage}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap"/>
                </Border>

                <!-- Error Notice -->
                <Border Background="{DynamicResource BrushDangerWash}" BorderBrush="{DynamicResource BrushDangerBorder}" BorderThickness="1" CornerRadius="{DynamicResource RadiusControl}" Padding="12,10" Margin="0,0,0,14">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding ErrorMessage}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushDanger}" TextWrapping="Wrap"/>
                </Border>


                <!-- A. About / Synopsis Card -->
                <Border Background="{DynamicResource BrushDialogCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="{DynamicResource RadiusCard}" Padding="14,12" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="ABOUT THE GAME" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding ShortDescription}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextPrimary}"
                                   TextWrapping="Wrap" LineHeight="20"/>
                        <!-- Required RAWG attribution: an active link wherever RAWG data is shown. -->
                        <TextBlock Margin="0,10,0,0" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}"
                                   Visibility="{Binding ShowRawgAttribution, Converter={StaticResource BoolToVis}}">
                            <Hyperlink Command="{Binding OpenRawgPageCommand}" Foreground="{DynamicResource BrushTextSecondary}">Data from RAWG</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- B. PC System Requirements Card -->
                <Border Background="{DynamicResource BrushDialogCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="{DynamicResource RadiusCard}" Padding="14,12" Margin="0,0,0,14">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasRequirements}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="PC SYSTEM REQUIREMENTS" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                <Button Content="Minimum" Command="{Binding ShowMinReqsCommand}" 
                                        Style="{StaticResource ModernOutlineButton}" Padding="8,3" FontSize="{DynamicResource FontSizeBody}" Margin="0,0,6,0"/>
                                <Button Content="Recommended" Command="{Binding ShowRecReqsCommand}" 
                                        Style="{StaticResource ModernOutlineButton}" Padding="8,3" FontSize="{DynamicResource FontSizeBody}"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="{Binding CurrentRequirementsText}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}" 
                                   TextWrapping="Wrap" LineHeight="19" FontFamily="{StaticResource MonoFont}"/>
                    </StackPanel>
                </Border>

                <!-- C. Latest Patch Notes & News Card -->
                <Border Background="{DynamicResource BrushDialogCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="{DynamicResource RadiusCard}" Padding="14,12">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasNews}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10" LastChildFill="True">
                            <!-- Link to the full Steam news hub for this app (all announcements, not just the latest 3) -->
                            <Button AutomationProperties.Name="Open all news" DockPanel.Dock="Right"
                                    Command="{Binding OpenNewsHubCommand}"
                                    Style="{StaticResource ModernGhostButton}"
                                    Padding="0" FontSize="{DynamicResource FontSizeBody}" VerticalAlignment="Center" Margin="12,0,0,0"
                                    Foreground="{DynamicResource BrushAccentText}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="View All News on Steam" VerticalAlignment="Center"/>
                                    <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeBadge}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="LATEST DEVELOPER NEWS &amp; PATCH NOTES" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushAccentText}" VerticalAlignment="Center"/>
                        </DockPanel>

                        <ItemsControl ItemsSource="{Binding NewsItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- News Title & Date -->
                                            <DockPanel Grid.Row="0" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding DateDisplay}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}"
                                                           DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                <!-- PATCH badge: shown only when Steam tagged the post as patch notes -->
                                                <Border DockPanel.Dock="Left" Background="{DynamicResource BrushSuccessWash}" BorderBrush="{DynamicResource BrushSuccessSolid}" BorderThickness="1"
                                                        CornerRadius="{DynamicResource RadiusSmall}" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center"
                                                        Visibility="{Binding IsPatchNotes, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="PATCH" FontSize="{DynamicResource FontSizeBadge}" FontWeight="Bold" Foreground="{DynamicResource BrushSuccessText}"/>
                                                </Border>
                                                <TextBlock Text="{Binding Title}" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>

                                            <!-- News Snippet -->
                                            <TextBlock Grid.Row="1" Text="{Binding Snippet}" FontSize="{DynamicResource FontSizeBody}" 
                                                       Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,6"/>

                                            <!-- Read More Link -->
                                            <Button AutomationProperties.Name="{Binding Title, StringFormat='Read: {0}'}" Grid.Row="2"
                                                    Command="{Binding DataContext.OpenNewsUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding Url}"
                                                    Style="{StaticResource ModernGhostButton}"
                                                    Padding="0" HorizontalAlignment="Left" FontSize="{DynamicResource FontSizeBody}"
                                                    Foreground="{DynamicResource BrushAccentText}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Read Full Notes" VerticalAlignment="Center"/>
                                                    <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeBadge}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ============================================================== -->
        <!-- 3. BOTTOM ACTIONS                                              -->
        <!-- ============================================================== -->
        <DockPanel Grid.Row="3">
            <TextBlock Text="{Binding Game.ExecutablePath}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}" 
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="580"/>
            <Button Content="_Close" Click="CloseButton_Click" IsCancel="True" Style="{StaticResource ModernOutlineButton}" 
                    Padding="18,6" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
        </DockPanel>
    </Grid>
</Window>
