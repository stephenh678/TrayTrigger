<Window x:Class="TrayTrigger.Views.GameDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TrayTrigger.ViewModels"
        xmlns:views="clr-namespace:TrayTrigger.Views"
        xmlns:services="clr-namespace:TrayTrigger.Services"
        mc:Ignorable="d"
        Title="Game Details"
        Height="860" Width="960"
        MinHeight="660" MinWidth="800"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushSurface}"
        Foreground="{DynamicResource BrushTextPrimary}"
        FontFamily="{DynamicResource AppFont}">

    <Window.Resources>
        <!-- The Settings tab: Game Details' own editor for the game, loaded only once the tab is opened. -->
        <DataTemplate DataType="{x:Type vm:GameEditViewModel}">
            <views:GameEditPanel/>
        </DataTemplate>

        <!-- The hero's layers: the banner and the fades over it show once there is a banner; the blurred poster until then. -->
        <Style x:Key="HeroBannerLayer" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasHeroImage}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HeroFallbackLayer" TargetType="Border">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasHeroImage}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A tab as a word with a line under it while it is the one on show (Tag is true): quieter than a boxed segmented control. -->
        <Style x:Key="UnderlineTabButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusRing}"/>
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSubhead}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Tag" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="line" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="2,8,2,8" Margin="0,0,0,-1" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                                <Setter TargetName="line" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <!-- The tab on show says so to a screen reader too, since a Button has no selected state of its own. -->
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="AutomationProperties.ItemStatus" Value="selected"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A figure in the header: a small label over a value. -->
        <Style x:Key="HeroFigureLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
        </Style>
        <Style x:Key="HeroFigureValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSubhead}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        </Style>
        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="Width" Value="96"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
        </Style>
        <Style x:Key="DetailValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Hero: the game, its figures and Play -->
            <RowDefinition Height="Auto"/> <!-- Tabs: Overview | Settings -->
            <RowDefinition Height="*"/>    <!-- The tab on show -->
            <RowDefinition Height="Auto"/> <!-- Bottom bar -->
        </Grid.RowDefinitions>

        <!-- ============================================================== -->
        <!-- 1. HERO: THE GAME'S ART BEHIND ITS NAME, FIGURES AND ACTIONS   -->
        <!-- The same on both tabs, so the top of the page never moves when you switch. -->
        <!-- ============================================================== -->
        <Border Grid.Row="0" Margin="0,0,0,12" CornerRadius="{DynamicResource RadiusCard}" BorderThickness="1"
                BorderBrush="{DynamicResource BrushBorder}" Background="{DynamicResource BrushBackground}"
                MinHeight="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource RatioHeightConverter}, ConverterParameter='0.24,210,260'}">
            <!-- A little taller as the window gets wider (the art is cropped from the bottom, under the fade), between 210 and 260: a wider window
                 grows the hero a little rather than cropping the art to a strip. -->
            <Border.Clip>
                <MultiBinding Converter="{StaticResource RoundedClipConverter}"><Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}"/><Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}"/><Binding Path="CornerRadius" RelativeSource="{RelativeSource Self}"/><Binding Path="BorderThickness" RelativeSource="{RelativeSource Self}"/></MultiBinding>
            </Border.Clip>
            <Grid>
                <!-- Until the game's banner is found (or when there is none): its atmosphere, the blurred poster
                     (RAWG's screenshot when that source is showing). A brush, not an Image: a picture would size
                     the hero to itself, and a brush takes no room. -->
                <Border Style="{StaticResource HeroFallbackLayer}">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding AmbientImage}" Stretch="UniformToFill"/>
                    </Border.Background>
                    <Border.Effect>
                        <BlurEffect Radius="28" RenderingBias="Performance"/>
                    </Border.Effect>
                </Border>
                <Border Style="{StaticResource HeroFallbackLayer}" Background="{DynamicResource BrushScrim}"/>

                <!-- The game's banner, from Steam or SteamGridDB, kept sharp and to the right -->
                <Border Style="{StaticResource HeroBannerLayer}">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding HeroImage}" Stretch="UniformToFill" AlignmentX="Right" AlignmentY="Top"/>
                    </Border.Background>
                </Border>
                <!-- The page's own background fades in from the left and up from the bottom, so the name, the buttons and the figures stay readable on any art and any theme. -->
                <Border Style="{StaticResource HeroBannerLayer}" Background="{DynamicResource BrushBackground}" Opacity="0.96">
                    <Border.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Color="{DynamicResource ColorMask}" Offset="0"/>
                            <GradientStop Color="{DynamicResource ColorMask}" Offset="0.2"/>
                            <GradientStop Color="Transparent" Offset="0.85"/>
                        </LinearGradientBrush>
                    </Border.OpacityMask>
                </Border>
                <Border Style="{StaticResource HeroBannerLayer}" Background="{DynamicResource BrushBackground}" Opacity="0.9">
                    <Border.OpacityMask>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Color="Transparent" Offset="0.3"/>
                            <GradientStop Color="{DynamicResource ColorMask}" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.OpacityMask>
                </Border>

                <Grid Margin="20,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Hero poster -->
                        <ColumnDefinition Width="*"/>    <!-- Name, actions, figures -->
                    </Grid.ColumnDefinitions>

                    <!-- The poster stands in for the banner until there is one. -->
            <!-- Poster Artwork Container -->
            <Border x:Name="HeroPoster" Style="{StaticResource HeroFallbackLayer}" Grid.Column="0" Width="140" Height="210" CornerRadius="{DynamicResource RadiusCard}"
                    Background="{DynamicResource BrushBackground}" BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="1" Margin="0,0,20,0">
                <Border.Clip>
                    <MultiBinding Converter="{StaticResource RoundedClipConverter}"><Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}"/><Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}"/><Binding Path="CornerRadius" RelativeSource="{RelativeSource Self}"/><Binding Path="BorderThickness" RelativeSource="{RelativeSource Self}"/></MultiBinding>
                </Border.Clip>
                <Grid>
                    <!-- Fallback Icon Tile if no poster -->
                    <Border Background="{DynamicResource BrushDialogCard}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Image Source="{Binding DisplayCoverImage}" Width="64" Height="64" Margin="0,0,0,8"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="No poster yet" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Ambient Blurred Background Fill (Fills entire poster box with matching game atmosphere;
                         RAWG's screenshot when that source is showing, else the poster itself) -->
                    <Image Source="{Binding AmbientImage}" Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="LowQuality">
                        <Image.Effect>
                            <BlurEffect Radius="24" RenderingBias="Performance"/>
                        </Image.Effect>
                    </Image>
                    <Border Background="{DynamicResource BrushScrim}"/>

                    <!-- Crisp Centered Artwork (Preserves 100% of the artwork, ZERO cropping of logos or text) -->
                    <Image Source="{Binding DisplayCoverImage}" Stretch="Uniform"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>
            </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                        <!-- Name -->
                        <TextBlock Text="{Binding GameTitle}" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="{DynamicResource FontSizeDisplay}"
                                   Foreground="{DynamicResource BrushTextPrimary}" ToolTip="{Binding GameTitle}"/>

                        <!-- The store and the genres, as one quiet line: the name and Play are what the eye should find. -->
                        <TextBlock Text="{Binding HeroMetaLine}" Margin="0,2,0,0" FontSize="{DynamicResource FontSizeBody}"
                                   Foreground="{DynamicResource BrushTextSecondary}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding HeroMetaLine}"/>

                        <!-- Actions, and the figures TrayTrigger records for the game -->
                        <DockPanel Margin="0,12,0,0" LastChildFill="True">
                            <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Bottom" Margin="16,0,0,0">
                                <StackPanel Margin="22,0,0,0">
                                    <TextBlock Text="Played" Style="{StaticResource HeroFigureLabel}"/>
                                    <TextBlock Text="{Binding PlayedStat}" Style="{StaticResource HeroFigureValue}"/>
                                </StackPanel>
                                <StackPanel Margin="22,0,0,0">
                                    <TextBlock Text="Last played" Style="{StaticResource HeroFigureLabel}"/>
                                    <TextBlock Text="{Binding LastPlayedStat}" Style="{StaticResource HeroFigureValue}"/>
                                </StackPanel>
                                <StackPanel Margin="22,0,0,0">
                                    <TextBlock Text="Profile" Style="{StaticResource HeroFigureLabel}"/>
                                    <TextBlock Text="{Binding ProfileStat}" Style="{StaticResource HeroFigureValue}"/>
                                </StackPanel>
                            </WrapPanel>

                            <WrapPanel Orientation="Horizontal">
                                <Button AutomationProperties.Name="Play" Command="{Binding LaunchGameCommand}"
                                        Style="{StaticResource ModernAccentButton}" Padding="22,8" Margin="0,0,10,6"
                                        FontWeight="SemiBold" FontSize="{DynamicResource FontSizeSubhead}"
                                        ToolTip="Launch this game">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeBody}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Play" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <!-- While the game is playing: the card menu's two session actions (UX-14h). -->
                                <Button AutomationProperties.Name="Close Game" Command="{Binding CloseGameCommand}"
                                        Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}"
                                        Style="{StaticResource ModernOutlineButton}" Padding="13,8" Margin="0,0,10,6" FontSize="{DynamicResource FontSizeBody}"
                                        ToolTip="Asks the game to quit, as its own close button does. Once it exits, TrayTrigger restores the Performance Profile and runs the post-exit script.">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeBody}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Close Game" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button AutomationProperties.Name="Force Close Game" Command="{Binding ForceCloseCommand}"
                                        Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}"
                                        Style="{StaticResource ModernOutlineButton}" Padding="13,8" Margin="0,0,10,6" FontSize="{DynamicResource FontSizeBody}"
                                        Foreground="{DynamicResource BrushDanger}"
                                        ToolTip="Kills the game's process, then ends the session. Anything unsaved in the game is lost.">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeBody}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Force Close" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button AutomationProperties.Name="{Binding FavoriteButtonLabel}" Style="{StaticResource FavoriteToggleButton}" Command="{Binding ToggleFavoriteCommand}"
                                        Margin="0,0,10,6" VerticalAlignment="Center"/>
                                <!-- Store pages and Remove: the actions a player reaches for rarely. -->
                                <Button x:Name="MoreButton" AutomationProperties.Name="More actions" Click="OpenMenu_Click"
                                        Style="{StaticResource ModernOutlineButton}" Padding="12,8" Margin="0,0,0,6" FontSize="{DynamicResource FontSizeBody}"
                                        ToolTip="Store pages, and Remove from library">
                                    <TextBlock Text="&#xE712;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeBody}" VerticalAlignment="Center"/>
                                    <Button.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="Open the Steam store page" Command="{Binding OpenStorePageCommand}"
                                                      Visibility="{Binding ShowSteamStoreButton, Converter={StaticResource BoolToVis}}"/>
                                            <MenuItem Header="Open this game on RAWG" Command="{Binding OpenRawgPageCommand}"
                                                      Visibility="{Binding HasRawgPage, Converter={StaticResource BoolToVis}}"/>
                                            <MenuItem Header="Open the PCGamingWiki page" Command="{Binding OpenPcGamingWikiCommand}"
                                                      Visibility="{Binding HasPcGamingWikiPage, Converter={StaticResource BoolToVis}}"/>
                                            <Separator/>
                                            <MenuItem Header="Remove from library" Command="{Binding DeleteGameCommand}" Foreground="{DynamicResource BrushDanger}"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </WrapPanel>
                        </DockPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ============================================================== -->
        <!-- 2. TABS                                                        -->
        <!-- ============================================================== -->
        <Border Grid.Row="1" Margin="0,0,0,14" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1"
                Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <Button Content="Overview" Command="{Binding SelectTabCommand}" CommandParameter="Overview"
                        Style="{StaticResource UnderlineTabButton}" Tag="{Binding IsOverviewTab}"/>
                <Button Content="Settings" Command="{Binding SelectTabCommand}" CommandParameter="Settings" Margin="22,0,0,0"
                        Style="{StaticResource UnderlineTabButton}" Tag="{Binding IsSettingsTab}"/>
            </StackPanel>
        </Border>

        <!-- ============================================================== -->
        <!-- 3. THE TAB ON SHOW                                             -->
        <!-- ============================================================== -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <!-- OVERVIEW: what is known about the game, and what TrayTrigger does for it -->
            <ScrollViewer x:Name="DetailsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsOverviewTab, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="0,0,10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <!-- Loading State -->
                <StackPanel Margin="0,30,0,30" HorizontalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowLoading}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <ProgressBar IsIndeterminate="True" Width="200" Height="4" Margin="0,0,0,12" Foreground="{DynamicResource BrushAccent}"/>
                    <TextBlock Text="{Binding LoadingMessage}"
                               FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- RAWG status notice (neutral, not an error): no match / bad key / offline -->
                <Border Background="{DynamicResource BrushAccentWash}" BorderBrush="{DynamicResource BrushBorderAccent}" BorderThickness="1" CornerRadius="{DynamicResource RadiusControl}" Padding="12,10" Margin="0,0,0,14"
                        Visibility="{Binding HasRawgStatus, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding RawgStatusMessage}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap"/>
                </Border>

                <!-- Error Notice -->
                <Border Background="{DynamicResource BrushDangerWash}" BorderBrush="{DynamicResource BrushDangerBorder}" BorderThickness="1" CornerRadius="{DynamicResource RadiusControl}" Padding="12,10" Margin="0,0,0,14">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding ErrorMessage}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushDanger}" TextWrapping="Wrap"/>
                </Border>


                <!-- A. About / Synopsis Card -->
                <Border Background="{DynamicResource BrushDialogCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="{DynamicResource RadiusCard}" Padding="14,12" Margin="0,0,0,14">
                    <StackPanel>
                        <!-- The words below come from Steam, or from RAWG when a key is set: where they came from, how fresh they are and how to
                             change that are said here, in the card they are about, and not in a row of their own. -->
                        <DockPanel Margin="0,0,0,6" LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding LastUpdatedCaption}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}"
                                           VerticalAlignment="Center" Margin="0,0,6,0" TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding ShowFreshness, Converter={StaticResource BoolToVis}}"/>
                                <Button x:Name="SourceButton" AutomationProperties.Name="Where this info comes from" Click="OpenMenu_Click"
                                        Style="{StaticResource ModernGhostButton}" Padding="6,3" FontSize="{DynamicResource FontSizeBody}"
                                        Foreground="{DynamicResource BrushAccentText}" ToolTip="Where this info comes from, how fresh it is, and how to change it">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding SourceName}" VerticalAlignment="Center"/>
                                        <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeBadge}" VerticalAlignment="Center" Margin="5,1,0,0"/>
                                    </StackPanel>
                                    <Button.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="Steam" IsChecked="{Binding IsSteamActive, Mode=OneWay}" Command="{Binding SelectSteamSourceCommand}"
                                                      Visibility="{Binding CanToggleSource, Converter={StaticResource BoolToVis}}"/>
                                            <MenuItem Header="RAWG" IsChecked="{Binding IsRawgActive, Mode=OneWay}" Command="{Binding SelectRawgSourceCommand}"
                                                      Visibility="{Binding CanToggleSource, Converter={StaticResource BoolToVis}}"/>
                                            <MenuItem Header="RAWG needs a key in Settings" IsEnabled="False">
                                                <MenuItem.Style>
                                                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CanToggleSource}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </MenuItem.Style>
                                            </MenuItem>
                                            <Separator/>
                                            <MenuItem Header="Refresh now" Command="{Binding RefreshNowCommand}" ToolTip="{Binding RefreshNowToolTip}"
                                                      Visibility="{Binding ShowFreshness, Converter={StaticResource BoolToVis}}"/>
                                            <MenuItem Header="Change match..." Command="{Binding ChangeMatchCommand}" ToolTip="{Binding ChangeMatchToolTip}"/>
                                            <MenuItem Header="Where this info comes from" Command="{x:Static services:HelpCommands.ShowTopic}" CommandParameter="library/game_info"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="ABOUT THE GAME" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Text="{Binding ShortDescription}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextPrimary}"
                                   TextWrapping="Wrap" LineHeight="20"/>
                        <!-- Required RAWG attribution: an active link wherever RAWG data is shown. -->
                        <TextBlock Margin="0,10,0,0" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}"
                                   Visibility="{Binding ShowRawgAttribution, Converter={StaticResource BoolToVis}}">
                            <Hyperlink Command="{Binding OpenRawgPageCommand}" Foreground="{DynamicResource BrushTextSecondary}">Data from RAWG</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- B. PC System Requirements Card -->
                <Border Background="{DynamicResource BrushDialogCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="{DynamicResource RadiusCard}" Padding="14,12" Margin="0,0,0,14">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasRequirements}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="PC SYSTEM REQUIREMENTS" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                <Button Content="Minimum" Command="{Binding ShowMinReqsCommand}" 
                                        Style="{StaticResource ModernOutlineButton}" Padding="8,3" FontSize="{DynamicResource FontSizeBody}" Margin="0,0,6,0"/>
                                <Button Content="Recommended" Command="{Binding ShowRecReqsCommand}" 
                                        Style="{StaticResource ModernOutlineButton}" Padding="8,3" FontSize="{DynamicResource FontSizeBody}"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="{Binding CurrentRequirementsText}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}" 
                                   TextWrapping="Wrap" LineHeight="19" FontFamily="{StaticResource MonoFont}"/>
                    </StackPanel>
                </Border>

                <!-- C. Latest Patch Notes & News Card -->
                <Border Background="{DynamicResource BrushDialogCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="{DynamicResource RadiusCard}" Padding="14,12">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasNews}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10" LastChildFill="True">
                            <!-- Link to the full Steam news hub for this app (all announcements, not just the latest 3) -->
                            <Button AutomationProperties.Name="Open all news" DockPanel.Dock="Right"
                                    Command="{Binding OpenNewsHubCommand}"
                                    Style="{StaticResource ModernGhostButton}"
                                    Padding="0" FontSize="{DynamicResource FontSizeBody}" VerticalAlignment="Center" Margin="12,0,0,0"
                                    Foreground="{DynamicResource BrushAccentText}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="View All News on Steam" VerticalAlignment="Center"/>
                                    <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeBadge}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="LATEST DEVELOPER NEWS &amp; PATCH NOTES" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushAccentText}" VerticalAlignment="Center"/>
                        </DockPanel>

                        <ItemsControl ItemsSource="{Binding NewsItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- News Title & Date -->
                                            <DockPanel Grid.Row="0" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding DateDisplay}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}"
                                                           DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                <!-- PATCH badge: shown only when Steam tagged the post as patch notes -->
                                                <Border DockPanel.Dock="Left" Background="{DynamicResource BrushSuccessWash}" BorderBrush="{DynamicResource BrushSuccessSolid}" BorderThickness="1"
                                                        CornerRadius="{DynamicResource RadiusSmall}" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center"
                                                        Visibility="{Binding IsPatchNotes, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="PATCH" FontSize="{DynamicResource FontSizeBadge}" FontWeight="Bold" Foreground="{DynamicResource BrushSuccessText}"/>
                                                </Border>
                                                <TextBlock Text="{Binding Title}" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource BrushTextPrimary}" TextWrapping="Wrap"/>
                                            </DockPanel>

                                            <!-- News Snippet -->
                                            <TextBlock Grid.Row="1" Text="{Binding Snippet}" FontSize="{DynamicResource FontSizeBody}" 
                                                       Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,6"/>

                                            <!-- Read More Link -->
                                            <Button AutomationProperties.Name="{Binding Title, StringFormat='Read: {0}'}" Grid.Row="2"
                                                    Command="{Binding DataContext.OpenNewsUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding Url}"
                                                    Style="{StaticResource ModernGhostButton}"
                                                    Padding="0" HorizontalAlignment="Left" FontSize="{DynamicResource FontSizeBody}"
                                                    Foreground="{DynamicResource BrushAccentText}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Read Full Notes" VerticalAlignment="Center"/>
                                                    <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeBadge}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <!-- Details: who made it, when, where it lives, how it was received -->
                        <Border Background="{DynamicResource BrushDialogCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                                CornerRadius="{DynamicResource RadiusCard}" Padding="14,12" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="DETAILS" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,8"/>
                                <DockPanel Margin="0,0,0,4" Visibility="{Binding HasDevelopers, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Developer" Style="{StaticResource DetailLabel}"/>
                                    <TextBlock Text="{Binding Developers}" Style="{StaticResource DetailValue}" ToolTip="{Binding Developers}"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,4" Visibility="{Binding HasPublishers, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Publisher" Style="{StaticResource DetailLabel}"/>
                                    <TextBlock Text="{Binding Publishers}" Style="{StaticResource DetailValue}" ToolTip="{Binding Publishers}"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,4" Visibility="{Binding HasReleaseDate, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Release date" Style="{StaticResource DetailLabel}"/>
                                    <TextBlock Text="{Binding ReleaseDate}" Style="{StaticResource DetailValue}"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="Category" Style="{StaticResource DetailLabel}"/>
                                    <TextBlock Text="{Binding Category}" Style="{StaticResource DetailValue}"/>
                                </DockPanel>
                                <!-- The drive it loads from: a game on a hard drive loads slower than on an SSD. -->
                                <DockPanel Margin="0,0,0,4" Visibility="{Binding HasInstallDrive, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Installed on" Style="{StaticResource DetailLabel}"/>
                                    <TextBlock Text="{Binding InstallDrive}" Style="{StaticResource DetailValue}"/>
                                </DockPanel>
                <WrapPanel Orientation="Horizontal" Margin="0,4,0,8">
                    <!-- Metacritic Score -->
                    <Border Background="{DynamicResource BrushSuccessWash}" BorderBrush="{DynamicResource BrushSuccessSolid}" BorderThickness="1" CornerRadius="{DynamicResource RadiusSmall}" 
                            Padding="8,4" Margin="0,0,8,4" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasMetacritic}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding MetacriticScore}" FontWeight="Bold" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushSuccessText}" Margin="0,0,6,0"/>
                            <TextBlock Text="Metascore" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushSuccessText}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- RAWG community rating (RAWG source only; fills in where Metacritic is absent) -->
                    <Border Background="{DynamicResource BrushSuccessWash}" BorderBrush="{DynamicResource BrushSuccessSolid}" BorderThickness="1" CornerRadius="{DynamicResource RadiusSmall}"
                            Padding="8,4" Margin="0,0,8,4" VerticalAlignment="Center"
                            Visibility="{Binding HasRawgRating, Converter={StaticResource BoolToVis}}"
                            ToolTip="Community rating on rawg.io">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE735;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeBody}"
                                       Foreground="{DynamicResource BrushSuccessText}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding RawgRatingDisplay}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushSuccessText}" FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- ESRB rating (RAWG source only) -->
                    <Border Background="{DynamicResource BrushSurfaceHover}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="{DynamicResource RadiusSmall}"
                            Padding="8,4" Margin="0,0,8,4" VerticalAlignment="Center"
                            Visibility="{Binding HasEsrbRating, Converter={StaticResource BoolToVis}}"
                            ToolTip="ESRB age rating">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ESRB" FontSize="{DynamicResource FontSizeBody}" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding EsrbRating}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}" FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Steam Review Summary -->
                    <Border Background="{DynamicResource BrushAccentWash}" BorderBrush="{DynamicResource BrushBorderAccent}" BorderThickness="1" CornerRadius="{DynamicResource RadiusSmall}"
                            Padding="8,4" Margin="0,0,8,4" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasReviewSummary}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8E1;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeBody}"
                                       Foreground="{DynamicResource BrushAccentText}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding ReviewSummary}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushAccentText}" FontWeight="Medium"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,0" MaxHeight="90">
                    <ItemsControl ItemsSource="{Binding TagList}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BrushSurfaceHover}" BorderBrush="{DynamicResource BrushBorder}" 
                                        BorderThickness="1" CornerRadius="{DynamicResource RadiusCard}" Padding="8,3" Margin="0,0,6,6">
                                    <TextBlock Text="{Binding}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <!-- Your setup: what TrayTrigger changes for this game, each with a way to the settings that do it -->
                        <ItemsControl ItemsSource="{Binding SetupCards}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BrushDialogCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                                            CornerRadius="{DynamicResource RadiusCard}" Padding="14,12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" CornerRadius="{DynamicResource RadiusSmall}" Padding="8,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource BrushSurfaceHover}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ChipIsOn}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource BrushAccentWash}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Chip}" FontSize="{DynamicResource FontSizeBody}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ChipIsOn}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource BrushAccentText}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                                <TextBlock Text="{Binding Title}" FontSize="{DynamicResource FontSizeSubhead}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Summary}" FontSize="{DynamicResource FontSizeBody}" TextWrapping="Wrap" Margin="0,6,0,6"
                                                       Foreground="{DynamicResource BrushTextSecondary}"/>
                                            <Button Content="{Binding LinkText}" HorizontalAlignment="Left" Style="{StaticResource ModernGhostButton}" Padding="0" FontSize="{DynamicResource FontSizeBody}"
                                                    Foreground="{DynamicResource BrushAccentText}"
                                                    Command="{Binding DataContext.EditSectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding Section}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- SETTINGS: the same cards Edit Properties used to open in a window of its own -->
            <ContentControl Content="{Binding EditViewModel}" IsTabStop="False"
                            Visibility="{Binding IsSettingsTab, Converter={StaticResource BoolToVis}}"/>
        </Grid>

        <!-- ============================================================== -->
        <!-- 4. BOTTOM BAR                                                  -->
        <!-- The game's path on the Overview; on Settings the editor's status and Save / Cancel. -->
        <!-- ============================================================== -->
        <DockPanel Grid.Row="3">
            <Button Content="_Close" Click="CloseButton_Click" IsCancel="True" Style="{StaticResource ModernOutlineButton}"
                    Padding="18,6" DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="12,0,0,0"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding IsSettingsTab, Converter={StaticResource BoolToVis}}">
                <Button Content="Cancel" Command="{Binding EditViewModel.CancelCommand}"
                        ToolTip="Throw away the changes and start again from the saved settings"
                        Style="{StaticResource ModernGhostButton}" MinWidth="85" Margin="0,0,8,0"/>
                <!-- The default button only while the Settings tab is on show, so Enter on the Overview never saves. -->
                <Button Content="_Save Changes" Command="{Binding EditViewModel.SaveCommand}"
                        IsDefault="{Binding IsVisible, RelativeSource={RelativeSource Self}, Mode=OneWay}"
                        Style="{StaticResource ModernAccentButton}" MinWidth="110"/>
            </StackPanel>
            <Grid>
                <TextBlock Text="{Binding Game.ExecutablePath}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Game.ExecutablePath}" Visibility="{Binding IsOverviewTab, Converter={StaticResource BoolToVis}}"/>
                <!-- Status: a busy bar while a look-up or a script test runs, and the editor's message in the accent, or in the problem colour when it is a failure. -->
                <DockPanel VerticalAlignment="Center" Margin="0,0,16,0" LastChildFill="True"
                           Visibility="{Binding IsSettingsTab, Converter={StaticResource BoolToVis}}">
                    <ProgressBar DockPanel.Dock="Left" IsIndeterminate="True" Width="36" Height="3" Margin="0,0,10,0"
                                 VerticalAlignment="Center" BorderThickness="0"
                                 Foreground="{DynamicResource BrushAccent}" Background="{DynamicResource BrushBorder}"
                                 AutomationProperties.Name="Working"
                                 Visibility="{Binding EditViewModel.IsBusy, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding EditViewModel.StatusMessage}" FontSize="{DynamicResource FontSizeBody}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36" VerticalAlignment="Center"
                               AutomationProperties.LiveSetting="Polite"
                               ToolTip="{Binding EditViewModel.StatusMessage}" ToolTipService.IsEnabled="{Binding EditViewModel.HasStatusMessage}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource BrushAccentText}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EditViewModel.StatusIsProblem}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource BrushDanger}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DockPanel>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
