<UserControl x:Class="TrayTrigger.Views.ToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TrayTrigger.ViewModels"
             AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver" PreviewKeyDown="OnPreviewKeyDown" KeyDown="OnKeyDown"
             Background="Transparent">

    <!-- The Tools page. Follows the Games Library's look (header, segmented category tabs, search / sort /
         view bar, cards, empty states) with only the parts tools use: no filters, posters, playtime or
         game actions. Drops anywhere on the page add tools, never games. -->
    <UserControl.Resources>
        <ContextMenu x:Key="ToolItemContextMenu">
            <MenuItem Header="Launch" Command="{Binding LaunchCommand}" FontWeight="SemiBold"/>
            <Separator/>
            <MenuItem Header="{Binding FavoriteMenuLabel}" Command="{Binding ToggleFavoriteCommand}"/>
            <!-- A Store app has neither: it can't be elevated, and its files belong to Windows. -->
            <MenuItem Header="Run as Administrator" IsCheckable="True" IsChecked="{Binding RunAsAdmin, Mode=OneWay}" Command="{Binding ToggleRunAsAdminCommand}"
                      Visibility="{Binding IsProgram, Converter={StaticResource BoolToVis}}"/>
            <MenuItem Header="Open File Location" Command="{Binding OpenFolderCommand}"
                      Visibility="{Binding IsProgram, Converter={StaticResource BoolToVis}}"/>
            <Separator/>
            <MenuItem Header="Edit Tool..." Command="{Binding EditCommand}"/>
            <MenuItem Header="Rename..." Command="{Binding RenameCommand}"/>
            <MenuItem Header="Change Category..." Command="{Binding ChangeCategoryCommand}"/>
            <MenuItem Header="Change Icon..." Command="{Binding ChangeIconCommand}"/>
            <Separator/>
            <MenuItem Header="Remove from Tools" Command="{Binding RemoveCommand}" Foreground="{StaticResource BrushDanger}"/>
        </ContextMenu>

        <!-- Right-click on a multi-selection (Ctrl+click, Shift+click, Ctrl+A): applies to every selected tool. -->
        <ContextMenu x:Key="ToolBatchContextMenu">
            <MenuItem Header="{Binding SelectionSummary}" Style="{StaticResource MenuSectionHeaderStyle}"/>
            <Separator/>
            <MenuItem Header="{Binding BatchFavoriteLabel}" Command="{Binding BatchFavoriteCommand}"/>
            <MenuItem Header="Change Category..." Command="{Binding BatchChangeCategoryCommand}"/>
            <MenuItem Header="Run as Administrator" IsCheckable="True" IsChecked="{Binding BatchAllRunAsAdmin, Mode=OneWay}" Command="{Binding BatchRunAsAdminCommand}"
                      IsEnabled="{Binding BatchCanRunAsAdmin}"/>
            <Separator/>
            <MenuItem Header="Remove from Tools" Command="{Binding BatchRemoveCommand}" Foreground="{StaticResource BrushDanger}"/>
        </ContextMenu>

        <!-- The same star as the game cards: outline, gold when a favorite or hovered. -->
        <ControlTemplate x:Key="ToolStarTemplate" TargetType="Button">
            <Border Background="Transparent">
                <TextBlock x:Name="StarGlyph" Text="&#xE734;" FontFamily="{StaticResource IconFont}"
                           FontSize="12" Foreground="#99FFFFFF"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                    <Setter TargetName="StarGlyph" Property="Text" Value="&#xE735;"/>
                    <Setter TargetName="StarGlyph" Property="Foreground" Value="#FFD700"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="StarGlyph" Property="Foreground" Value="#FFD700"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="ToolCardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BrushSurfaceDark}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorderDark}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BrushSurfaceHover}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource BrushBorderLight}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToolMissingBadge" TargetType="Border">
            <Setter Property="Background" Value="#E64A1E14"/>
            <Setter Property="BorderBrush" Value="#E65100"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="5,1"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Shown in place of an icon the tool doesn't have. -->
        <Style x:Key="ToolFallbackGlyph" TargetType="TextBlock">
            <Setter Property="Text" Value="&#xE90F;"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets, Segoe Fluent Icons"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasIcon}" Value="False">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <ItemsPanelTemplate x:Key="ToolsWrapPanel">
            <WrapPanel Orientation="Horizontal"/>
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="ToolsStackPanel">
            <VirtualizingStackPanel/>
        </ItemsPanelTemplate>

        <!-- VIEW 1: LARGE ICONS (64 px) -->
        <DataTemplate x:Key="LargeToolTemplate" DataType="{x:Type vm:ToolCardViewModel}">
            <Border Style="{StaticResource ToolCardBorder}" CornerRadius="8" Width="124" Height="136" Margin="6"
                    AutomationProperties.Name="{Binding Name}"
                    ContextMenu="{StaticResource ToolItemContextMenu}" ContextMenuOpening="OnCardContextMenuOpening">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftDoubleClick" Command="{Binding LaunchCommand}"/>
                </Border.InputBindings>
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" LastChildFill="False">
                        <Button DockPanel.Dock="Left" Template="{StaticResource ToolStarTemplate}" Command="{Binding ToggleFavoriteCommand}"
                                Width="16" Height="16" Cursor="Hand" AutomationProperties.Name="{Binding FavoriteMenuLabel}"/>
                        <TextBlock DockPanel.Dock="Right" Text="&#xEA18;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="11"
                                   Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"
                                   Visibility="{Binding RunAsAdmin, Converter={StaticResource BoolToVis}}"/>
                    </DockPanel>
                    <Grid Grid.Row="1" Width="64" Height="64" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="{Binding IconImage}" Width="64" Height="64" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Style="{StaticResource ToolFallbackGlyph}" FontSize="32"/>
                    </Grid>
                    <StackPanel Grid.Row="2">
                        <TextBlock Text="{Binding Name}" FontSize="12" FontFamily="{StaticResource AppFont}"
                                   Foreground="{StaticResource BrushTextPrimary}" TextAlignment="Center"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="32"/>
                        <Border Style="{StaticResource ToolMissingBadge}" HorizontalAlignment="Center" Margin="0,3,0,0">
                            <TextBlock Text="MISSING" FontSize="9" FontWeight="SemiBold" Foreground="#FFB074" FontFamily="{StaticResource AppFont}"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- VIEW 2: SMALL ICONS (32 px) -->
        <DataTemplate x:Key="SmallToolTemplate" DataType="{x:Type vm:ToolCardViewModel}">
            <Border Style="{StaticResource ToolCardBorder}" CornerRadius="6" Width="232" Height="50" Margin="4" Padding="8,0"
                    AutomationProperties.Name="{Binding Name}"
                    ContextMenu="{StaticResource ToolItemContextMenu}" ContextMenuOpening="OnCardContextMenuOpening">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftDoubleClick" Command="{Binding LaunchCommand}"/>
                </Border.InputBindings>
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Width="32" Height="32">
                        <Image Source="{Binding IconImage}" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Style="{StaticResource ToolFallbackGlyph}" FontSize="18"/>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="12.5" FontFamily="{StaticResource AppFont}"
                                   Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                        <Border Style="{StaticResource ToolMissingBadge}" HorizontalAlignment="Left" Margin="0,2,0,0">
                            <TextBlock Text="MISSING" FontSize="9" FontWeight="SemiBold" Foreground="#FFB074" FontFamily="{StaticResource AppFont}"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xEA18;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="11" Margin="0,0,6,0"
                                   Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"
                                   Visibility="{Binding RunAsAdmin, Converter={StaticResource BoolToVis}}"/>
                        <Button Template="{StaticResource ToolStarTemplate}" Command="{Binding ToggleFavoriteCommand}"
                                Width="16" Height="16" Cursor="Hand" AutomationProperties.Name="{Binding FavoriteMenuLabel}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- VIEW 3: LIST -->
        <DataTemplate x:Key="ListToolTemplate" DataType="{x:Type vm:ToolCardViewModel}">
            <Border Style="{StaticResource ToolCardBorder}" CornerRadius="6" Height="46" Margin="0,2,16,3" Padding="10,0"
                    AutomationProperties.Name="{Binding Name}"
                    ContextMenu="{StaticResource ToolItemContextMenu}" ContextMenuOpening="OnCardContextMenuOpening">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftDoubleClick" Command="{Binding LaunchCommand}"/>
                </Border.InputBindings>
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="30" Height="30" CornerRadius="4" Background="#222228"
                            HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Grid>
                            <Image Source="{Binding IconImage}" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Style="{StaticResource ToolFallbackGlyph}" FontSize="14"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Template="{StaticResource ToolStarTemplate}" Command="{Binding ToggleFavoriteCommand}" Margin="0,0,6,0"
                                Width="16" Height="16" Cursor="Hand" AutomationProperties.Name="{Binding FavoriteMenuLabel}"/>
                        <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" FontFamily="{StaticResource AppFont}"
                                   Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <TextBlock Text="&#xEA18;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="11" Margin="8,0,0,0"
                                   Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"
                                   Visibility="{Binding RunAsAdmin, Converter={StaticResource BoolToVis}}"/>
                        <Border Style="{StaticResource ToolMissingBadge}" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="MISSING" FontSize="9" FontWeight="SemiBold" Foreground="#FFB074" FontFamily="{StaticResource AppFont}"/>
                        </Border>
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="{Binding Category}" FontSize="12" FontFamily="{StaticResource AppFont}"
                               Foreground="{StaticResource BrushTextSecondary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="{Binding LaunchDisplay}" FontSize="11.5" FontFamily="{StaticResource AppFont}"
                               Foreground="{StaticResource BrushTextMuted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="4" Text="{Binding HotkeyDisplay}" FontSize="11.5" FontFamily="{StaticResource AppFont}"
                               Foreground="{StaticResource BrushTextSecondary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Category Tabs & Add -->
            <RowDefinition Height="Auto"/> <!-- Search, Sort & View Mode Bar -->
            <RowDefinition Height="*"/>    <!-- Tools -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#xE90F;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="12"
                           Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBlock Text="{Binding ToolCountDisplay, Mode=OneWay}" FontSize="11.5" Foreground="{StaticResource BrushTextMuted}"
                           FontFamily="{StaticResource AppFont}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Tools" FontSize="20" Foreground="{StaticResource BrushTextPrimary}"
                           FontFamily="{StaticResource AppFont}" FontWeight="Normal"/>
                <TextBlock Text="Launch the programs you use alongside your games, like DLSS Swapper, Vortex or MSI Afterburner"
                           FontSize="12" Foreground="{StaticResource BrushTextSecondary}"
                           FontFamily="{StaticResource AppFont}" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- 2. Category Tabs & Add Tool -->
        <DockPanel Grid.Row="1" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding OpenAppsFolderCommand}" Style="{StaticResource ModernOutlineButton}" Margin="0,0,8,0"
                        ToolTip="Opens Windows' list of every app in the Start menu (shell:AppsFolder). Drag an app from it onto this page to add it, Microsoft Store apps included.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="11" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Browse Apps" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding AddToolCommand}" Style="{StaticResource ModernAccentButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="11" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Add Tool" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <Border Background="#181820" BorderBrush="{StaticResource BrushBorderDark}"
                    BorderThickness="1" CornerRadius="6" Padding="3" Margin="0,0,16,0"
                    HorizontalAlignment="Left" VerticalAlignment="Center">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
                    <ItemsControl ItemsSource="{Binding CategoryTabs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding SelectCommand}"
                                        Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsSelected}"
                                        Margin="0,0,2,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE735;" FontFamily="{StaticResource IconFont}"
                                                   FontSize="13" Foreground="#FFD700" Margin="0,0,5,0" VerticalAlignment="Center"
                                                   Visibility="{Binding IsFavoritesTab, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </DockPanel>

        <!-- 3. Search, Sort & View Mode Bar -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="ToolsSearchTextBox" Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource ModernTextBox}" Margin="0,0,10,0"
                     Tag="Search tools by name, category, or path..."/>

            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding SortOptions}"
                      SelectedItem="{Binding SelectedSortOption, Mode=TwoWay}"
                      Style="{StaticResource ModernComboBox}" Margin="0,0,10,0"/>

            <Border Grid.Column="2" Background="#181820" BorderBrush="{StaticResource BrushBorderDark}"
                    BorderThickness="1" CornerRadius="6" Padding="3">
                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding SetViewModeCommand}" CommandParameter="Large Icons"
                            Width="32" Height="30" Padding="0" Cursor="Hand"
                            Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsLargeIconsView}"
                            AutomationProperties.Name="Large icons view">
                        <TextBlock Text="&#xE8A9;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="14"
                                   Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Command="{Binding SetViewModeCommand}" CommandParameter="Small Icons"
                            Width="32" Height="30" Padding="0" Cursor="Hand" Margin="2,0,0,0"
                            Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsSmallIconsView}"
                            AutomationProperties.Name="Small icons view">
                        <TextBlock Text="&#xE80A;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="13"
                                   Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Command="{Binding SetViewModeCommand}" CommandParameter="List"
                            Width="32" Height="30" Padding="0" Cursor="Hand" Margin="2,0,0,0"
                            Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsListView}"
                            AutomationProperties.Name="List view">
                        <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="13"
                                   Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 4. Tools -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- List header, pinned above the rows -->
            <Border Grid.Row="0" Background="#16161C" BorderBrush="{StaticResource BrushBorderDark}"
                    BorderThickness="0,0,0,1" Padding="12,8" Margin="0,0,16,6" CornerRadius="4"
                    Visibility="{Binding ShowListHeader, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="TOOL" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextMuted}" FontFamily="{StaticResource AppFont}"/>
                    <TextBlock Grid.Column="2" Text="CATEGORY" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextMuted}" FontFamily="{StaticResource AppFont}"/>
                    <TextBlock Grid.Column="3" Text="PROGRAM" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextMuted}" FontFamily="{StaticResource AppFont}"/>
                    <TextBlock Grid.Column="4" Text="HOTKEY" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextMuted}" FontFamily="{StaticResource AppFont}"/>
                </Grid>
            </Border>

            <ListBox Grid.Row="1" x:Name="ToolsList"
                     ItemsSource="{Binding FilteredTools}"
                     SelectionMode="Extended" SelectionChanged="OnToolsSelectionChanged"
                     KeyboardNavigation.TabNavigation="Once"
                     Background="Transparent" BorderThickness="0" Padding="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusRing}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <!-- One list, its panel and card template swapped per view. -->
                <ListBox.Style>
                    <Style TargetType="ListBox">
                        <Setter Property="ItemTemplate" Value="{StaticResource LargeToolTemplate}"/>
                        <Setter Property="ItemsPanel" Value="{StaticResource ToolsWrapPanel}"/>
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSmallIconsView}" Value="True">
                                <Setter Property="ItemTemplate" Value="{StaticResource SmallToolTemplate}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsListView}" Value="True">
                                <Setter Property="ItemTemplate" Value="{StaticResource ListToolTemplate}"/>
                                <Setter Property="ItemsPanel" Value="{StaticResource ToolsStackPanel}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsFilteredEmpty}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.Style>
            </ListBox>

            <!-- Empty: no tools yet. The whole page is the drop target. -->
            <Border Grid.Row="1" Margin="0,20,0,20" CornerRadius="10"
                    BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1.5" Background="#161619"
                    Visibility="{Binding ShowEmptyLibrary, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE90F;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="40"
                               Foreground="{StaticResource BrushAccentHover}" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                    <TextBlock Text="No tools yet" FontSize="16" Foreground="{StaticResource BrushTextPrimary}"
                               FontFamily="{StaticResource AppFont}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Drop a program (.exe), a script (.bat, .cmd, .ps1) or a shortcut anywhere on this page, or use Add Tool. For a Microsoft Store app, use Browse Apps and drag the app here. Nothing is scanned: a tool is just a saved shortcut you can launch from here, the tray or a hotkey."
                               FontSize="13" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" MaxWidth="520" TextAlignment="Center"
                               FontFamily="{StaticResource AppFont}" HorizontalAlignment="Center" Margin="0,6,0,18"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Command="{Binding OpenAppsFolderCommand}" Style="{StaticResource ModernOutlineButton}" Margin="0,0,8,0"
                                ToolTip="Opens Windows' list of every app in the Start menu (shell:AppsFolder). Drag an app from it onto this page to add it, Microsoft Store apps included.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="11" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Browse Apps" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding AddToolCommand}" Style="{StaticResource ModernAccentButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="11" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Add Tool" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Favorites tab with nothing starred -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding ShowFavoritesEmpty, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="&#xE734;" FontFamily="{StaticResource IconFont}" FontSize="40"
                           Foreground="#FFD700" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock Text="No favorites yet" FontSize="16" Foreground="{StaticResource BrushTextPrimary}"
                           FontFamily="{StaticResource AppFont}" HorizontalAlignment="Center"/>
                <TextBlock Text="Click the star on any tool to add it to your Favorites."
                           FontSize="13" Foreground="{StaticResource BrushTextSecondary}"
                           FontFamily="{StaticResource AppFont}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>

            <!-- Tools exist, but this search / tab shows none -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding ShowNoMatches, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="36"
                           Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock Text="No tools match" FontSize="16" Foreground="{StaticResource BrushTextPrimary}"
                           FontFamily="{StaticResource AppFont}" HorizontalAlignment="Center"/>
                <TextBlock Text="Nothing in this tab matches your search. Press Esc to clear the search, or pick another tab."
                           FontSize="13" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" MaxWidth="520" TextAlignment="Center"
                           FontFamily="{StaticResource AppFont}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
        </Grid>

        <!-- 5. Status Bar -->
        <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" FontSize="11.5" Foreground="{StaticResource BrushTextMuted}"
                   FontFamily="{StaticResource AppFont}" TextTrimming="CharacterEllipsis" Margin="2,8,0,0"/>
    </Grid>
</UserControl>
