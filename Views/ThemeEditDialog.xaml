<Window x:Class="TrayTrigger.Views.ThemeEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TrayTrigger.Views"
        Title="{Binding WindowTitle}"
        Height="780" Width="940"
        MinHeight="560" MinWidth="820"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource BrushSurface}"
        Foreground="{DynamicResource BrushTextPrimary}"
        FontFamily="{StaticResource AppFont}">

    <Window.Resources>
        <!-- The small heading at the top of each card. -->
        <Style x:Key="CardLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="DialogCardBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BrushDialogCard}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <!-- The States strip in the preview: the shape of a small button, a row, and the caption under each. The colors are set where they are used. -->
        <Style x:Key="StateChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="StateRow" TargetType="Border">
            <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="StateCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="PreviewBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Divider -->
            <RowDefinition Height="*"/>    <!-- Cards -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{Binding HeadingText}" FontSize="{StaticResource FontSizeHeading}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource BrushTextPrimary}"/>
            <TextBlock Text="{Binding Subtitle}" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0"/>
        </StackPanel>

        <Rectangle Grid.Row="1" Height="1" Fill="{DynamicResource BrushBorder}" Margin="0,0,0,14"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
            <Grid Margin="0,0,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: the name, and the picture -->
                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource DialogCardBorder}">
                        <StackPanel>
                            <TextBlock Text="NAME" Style="{StaticResource CardLabel}"/>
                            <TextBox AutomationProperties.Name="Theme name" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" MaxLength="60"/>
                            <TextBlock Text="Starts from" Margin="0,12,0,4" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}"/>
                            <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusCard}" Padding="3" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Dark" Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsDark}" Click="StartFromDark_Click" AutomationProperties.Name="Start from Dark"/>
                                    <Button Content="Light" Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsLight}" Click="StartFromLight_Click" Margin="2,0,0,0" AutomationProperties.Name="Start from Light"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Changing it restarts the colors from Dark or Light."
                                       TextWrapping="Wrap" Margin="0,6,0,0" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource DialogCardBorder}">
                        <StackPanel>
                            <TextBlock Text="BACKGROUND PICTURE" Style="{StaticResource CardLabel}"/>
                            <Border Height="130" CornerRadius="{StaticResource RadiusControl}" Background="{DynamicResource BrushBackground}"
                                    BorderBrush="{DynamicResource BrushBorderStrong}" BorderThickness="1" ClipToBounds="True">
                                <Grid>
                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"
                                           HorizontalAlignment="{Binding ThumbnailHorizontal}" VerticalAlignment="{Binding ThumbnailVertical}"
                                           AutomationProperties.Name="The background picture"/>
                                    <!-- The picture as the app shows it: dimmed by the Background color being edited, as much as the strength leaves. -->
                                    <Border Background="{Binding Background.Swatch}" Opacity="{Binding ThumbnailTint}" IsHitTestVisible="False"
                                            Visibility="{Binding HasPicture, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="No picture" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasPicture}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Change..." Command="{Binding ChoosePictureCommand}" Style="{StaticResource ModernOutlineButton}" Padding="12,4" Margin="0,0,8,0"
                                        ToolTip="Choose a JPG or PNG, at least 1280 x 720. It is copied beside your theme file when you save."/>
                                <Button Content="Remove" Command="{Binding RemovePictureCommand}" Style="{StaticResource ModernGhostButton}" Padding="10,4"/>
                            </StackPanel>
                            <Grid Margin="0,12,0,0" IsEnabled="{Binding HasPicture}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Strength" VerticalAlignment="Center" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,10,0"/>
                                <Slider Grid.Column="1" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                        Value="{Binding Strength, Mode=TwoWay}" Style="{StaticResource ThemeSliderStyle}" VerticalAlignment="Center"
                                        AutomationProperties.Name="How strongly the picture shows"/>
                                <TextBlock Grid.Column="2" Text="{Binding StrengthText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushTextPrimary}"/>
                            </Grid>
                            <Grid Margin="0,10,0,0" IsEnabled="{Binding HasPicture}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Keep in view" VerticalAlignment="Center" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,10,0"
                                           ToolTip="When the window is a different shape from the picture, the edges that do not fit are cropped. This is the part that always stays."/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Positions}" SelectedValue="{Binding Position}" SelectedValuePath="Id" DisplayMemberPath="Label"
                                          Style="{StaticResource ModernComboBox}" HorizontalAlignment="Left" MinWidth="120"
                                          AutomationProperties.Name="Which part of the picture stays in view"/>
                            </Grid>
                            <TextBlock Text="{Binding PictureInfo}" TextWrapping="Wrap" Margin="0,10,0,0"
                                       FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- RIGHT: the colors, and what they look like -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource DialogCardBorder}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="MAIN COLORS" Style="{StaticResource CardLabel}"/>
                                <TextBlock Text="Click a swatch to pick, or type or paste #RRGGBB" HorizontalAlignment="Right"
                                           FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <views:ThemeColorRowControl DataContext="{Binding Background}"/>
                                    <views:ThemeColorRowControl DataContext="{Binding Surface}"/>
                                    <views:ThemeColorRowControl DataContext="{Binding Text}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <views:ThemeColorRowControl DataContext="{Binding Accent}"/>
                                    <views:ThemeColorRowControl DataContext="{Binding Danger}"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="OPTIONAL" Style="{StaticResource CardLabel}" Margin="0,12,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <views:ThemeColorRowControl Grid.Column="0" DataContext="{Binding Warning}"/>
                                <views:ThemeColorRowControl Grid.Column="2" DataContext="{Binding Success}"/>
                            </Grid>

                            <TextBlock Text="{Binding HandSetNote}" TextWrapping="Wrap" Margin="0,10,0,0"
                                       FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}"
                                       Visibility="{Binding HasHandSetNote, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource DialogCardBorder}" Margin="0">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="PREVIEW" Style="{StaticResource CardLabel}"/>
                                <TextBlock Text="Shows the colors above. The app changes when you save." HorizontalAlignment="Right"
                                           FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}"/>
                            </Grid>

                            <!-- Its own set of colors, filled in from the editor, so nothing else on screen changes. -->
                            <Border x:Name="PreviewHost" Background="{DynamicResource BrushBackground}" BorderBrush="{DynamicResource BrushBorder}"
                                    BorderThickness="1" CornerRadius="{StaticResource RadiusCard}" Padding="12"
                                    Focusable="False"
                                    AutomationProperties.Name="Preview of the colors">
                                <StackPanel>
                                    <DockPanel LastChildFill="False">
                                        <Button DockPanel.Dock="Right" Content="Add Game" Style="{StaticResource ModernAccentButton}" Focusable="False" IsTabStop="False"/>
                                        <Button DockPanel.Dock="Right" Content="Add Folder" Style="{StaticResource ModernOutlineButton}" Margin="0,0,8,0" Focusable="False" IsTabStop="False"/>
                                        <Border DockPanel.Dock="Left" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                                                CornerRadius="{StaticResource RadiusCard}" Padding="3">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Background="{DynamicResource BrushAccent}" CornerRadius="{StaticResource RadiusSmall}" Padding="12,4">
                                                    <TextBlock Text="All Games" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushTextOnSolid}"/>
                                                </Border>
                                                <TextBlock Text="Favorites" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}" Margin="12,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Action" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </DockPanel>

                                    <!-- The preview answers the mouse: the buttons use the app's own styles, and this card has the row hover. -->
                                    <Border BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusCard}" Padding="12,10" Margin="0,10,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource BrushSurfaceHover}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="Destroy All Humans! - Clone Carnage" FontSize="{StaticResource FontSizeSubhead}" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <TextBlock Text="Second-level text, like a description" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0"/>
                                            <TextBlock Text="Quiet text, like a hint or a caption" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <TextBlock Text="A link" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushAccentText}" VerticalAlignment="Center"/>
                                                <Border Style="{StaticResource PreviewBadge}" Background="{DynamicResource BrushSuccessWash}" Margin="14,0,0,0">
                                                    <TextBlock Text="PLAYING" FontSize="{StaticResource FontSizeBadge}" FontWeight="Bold" Foreground="{DynamicResource BrushSuccessText}"/>
                                                </Border>
                                                <Border Style="{StaticResource PreviewBadge}" Background="{DynamicResource BrushWarningWash}">
                                                    <TextBlock Text="NOT INSTALLED" FontSize="{StaticResource FontSizeBadge}" FontWeight="Bold" Foreground="{DynamicResource BrushWarning}"/>
                                                </Border>
                                                <Border Style="{StaticResource PreviewBadge}" Background="{DynamicResource BrushDangerWash}">
                                                    <TextBlock Text="MISSING" FontSize="{StaticResource FontSizeBadge}" FontWeight="Bold" Foreground="{DynamicResource BrushDanger}"/>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- The looks a control takes on that cannot all be shown at once with a mouse: side by side, so the
                                         colors can be compared, and so a keyboard user sees them too. -->
                                    <TextBlock Text="STATES" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,14,0,6"/>
                                    <UniformGrid Columns="3">
                                        <StackPanel Margin="0,0,8,8">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Style="{StaticResource StateChip}" Background="{DynamicResource BrushAccent}" BorderBrush="{DynamicResource BrushAccent}">
                                                    <TextBlock Text="Normal" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushTextOnSolid}"/>
                                                </Border>
                                                <Border Style="{StaticResource StateChip}" Background="{DynamicResource BrushAccentHover}" BorderBrush="{DynamicResource BrushAccentHover}">
                                                    <TextBlock Text="Hover" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushTextOnSolid}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="Main button" Style="{StaticResource StateCaption}"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,8,8">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Style="{StaticResource StateChip}" Background="{DynamicResource BrushAccentPressed}" BorderBrush="{DynamicResource BrushAccentPressed}">
                                                    <TextBlock Text="Pressed" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushTextOnSolid}"/>
                                                </Border>
                                                <Border Style="{StaticResource StateChip}" Background="{DynamicResource BrushSurfaceHover}" BorderBrush="{DynamicResource BrushBorderStrong}">
                                                    <TextBlock Text="Hover" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="Pressed, outline button hover" Style="{StaticResource StateCaption}"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal">
                                                <Border BorderThickness="2" BorderBrush="{DynamicResource BrushAccentHover}" CornerRadius="{StaticResource RadiusControl}" Padding="2" Margin="0,0,10,0">
                                                    <Border Style="{StaticResource StateChip}" Margin="0" Background="{DynamicResource BrushAccent}" BorderBrush="{DynamicResource BrushAccent}">
                                                        <TextBlock Text="Focus" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushTextOnSolid}"/>
                                                    </Border>
                                                </Border>
                                                <TextBlock Text="Disabled" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushTextDisabled}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="Keyboard focus, disabled" Style="{StaticResource StateCaption}"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,8,0">
                                            <Border Style="{StaticResource StateRow}" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}">
                                                <TextBlock Text="Row" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            </Border>
                                            <TextBlock Text="Normal" Style="{StaticResource StateCaption}"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,8,0">
                                            <Border Style="{StaticResource StateRow}" Background="{DynamicResource BrushSurfaceHover}" BorderBrush="{DynamicResource BrushBorder}">
                                                <TextBlock Text="Row" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            </Border>
                                            <TextBlock Text="Mouse over" Style="{StaticResource StateCaption}"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <Border Style="{StaticResource StateRow}" Background="{DynamicResource BrushAccentWash}" BorderBrush="{DynamicResource BrushBorderAccent}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushAccentText}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Row" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Text="Selected" Style="{StaticResource StateCaption}"/>
                                        </StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- FOOTER -->
        <DockPanel Grid.Row="3" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="_Cancel" Command="{Binding CancelCommand}" IsCancel="True"
                        Style="{StaticResource ModernOutlineButton}" Margin="0,0,10,0" MinWidth="90"/>
                <Button Content="_Save Changes" Command="{Binding SaveCommand}" IsDefault="True"
                        Style="{StaticResource ModernAccentButton}" MinWidth="120"/>
            </StackPanel>
            <Button DockPanel.Dock="Left" Content="Open file" Command="{Binding OpenFileCommand}" Style="{StaticResource ModernOutlineButton}" Margin="0,0,14,0"
                    Visibility="{Binding CanOpenFile, Converter={StaticResource BoolToVis}}"
                    ToolTip="Show the theme file in Explorer, to change the colors this window does not cover"/>
            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Text="{Binding ValidationMessage}" Foreground="{DynamicResource BrushDanger}" FontSize="{StaticResource FontSizeBody}" TextWrapping="Wrap"
                           Visibility="{Binding HasValidationMessage, Converter={StaticResource BoolToVis}}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock FontFamily="{StaticResource IconFont}" FontSize="{StaticResource FontSizeSubhead}" VerticalAlignment="Center" Margin="0,0,6,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="&#xE7BA;"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushWarning}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ContrastOk}" Value="True">
                                        <Setter Property="Text" Value="&#xE73E;"/>
                                        <Setter Property="Foreground" Value="{DynamicResource BrushSuccessText}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Column="1" Text="{Binding ContrastLine}" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}"
                               TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
                </Grid>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
