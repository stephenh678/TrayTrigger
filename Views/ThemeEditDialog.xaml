<Window x:Class="TrayTrigger.Views.ThemeEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TrayTrigger.Views"
        Title="{Binding WindowTitle}"
        Height="792" Width="940"
        MinHeight="560" MinWidth="820"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource BrushSurface}"
        Foreground="{DynamicResource BrushTextPrimary}"
        FontFamily="{DynamicResource AppFont}">

    <Window.Resources>
        <!-- The small heading at the top of each card. -->
        <Style x:Key="CardLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="DialogCardBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BrushDialogCard}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <!-- The States strip in the preview: the shape of a small button, a row, and the caption under each. The colors are set where they are used. -->
        <Style x:Key="StateChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="StateRow" TargetType="Border">
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="StateCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="PreviewBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
        <!-- A small caption above a group in the preview. -->
        <Style x:Key="PreviewHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
            <Setter Property="Margin" Value="0,16,0,6"/>
        </Style>
        <!-- A game card in the preview, the library's own: 184 x 276, the cover cut to the poster's corners, the top and bottom shades,
             the category and the name and playtime at the foot. Its corners are the preview's own RadiusCard, RadiusPoster and inner edges. -->
        <DataTemplate x:Key="PreviewPosterCard">
            <StackPanel Margin="0,0,10,0">
                <Border x:Name="Card" Width="184" Height="276" BorderThickness="1" BorderBrush="{DynamicResource BrushBorder}"
                        Tag="{DynamicResource RadiusPoster}">
                    <!-- As in the library: no fill behind the art, and an outline that follows the poster's shape. -->
                    <Border.CornerRadius>
                        <MultiBinding Converter="{StaticResource PosterCardRadiusConverter}">
                            <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}"/>
                            <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}"/>
                            <Binding Path="Tag" RelativeSource="{RelativeSource Self}"/>
                            <Binding Path="BorderThickness" RelativeSource="{RelativeSource Self}"/>
                        </MultiBinding>
                    </Border.CornerRadius>
                    <Grid x:Name="ArtArea">
                        <Border x:Name="ArtClipBorder" CornerRadius="{DynamicResource RadiusPoster}">
                            <Border.Clip>
                                <MultiBinding Converter="{StaticResource RoundedClipConverter}">
                                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}"/>
                                    <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}"/>
                                    <Binding Path="CornerRadius" RelativeSource="{RelativeSource Self}"/>
                                    <Binding Path="BorderThickness" RelativeSource="{RelativeSource Self}"/>
                                </MultiBinding>
                            </Border.Clip>
                            <Grid>
                                <Border Background="{Binding ArtBrush}"/>
                                <Image Source="{Binding Cover}" Stretch="UniformToFill" Opacity="0.45" RenderOptions.BitmapScalingMode="LowQuality"/>
                                <Border Background="{DynamicResource BrushScrim}"/>
                                <Image Source="{Binding Cover}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                        </Border>
                        <Border VerticalAlignment="Top" Height="48">
                            <Border.Clip>
                                <MultiBinding Converter="{StaticResource PosterShadeClipConverter}">
                                    <Binding Path="ActualWidth" ElementName="ArtArea"/>
                                    <Binding Path="ActualHeight" ElementName="ArtArea"/>
                                    <Binding Path="CornerRadius" ElementName="ArtClipBorder"/>
                                    <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}"/>
                                </MultiBinding>
                            </Border.Clip>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="{DynamicResource ColorRaw990D0D12}" Offset="0.0"/>
                                    <GradientStop Color="{DynamicResource ColorRaw000D0D12}" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <!-- As in the library: the launcher's logo, then the category pill. -->
                        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left" Orientation="Horizontal" Margin="10,10,0,0">
                            <Image Source="pack://application:,,,/Assets/LauncherLogos/local_games.png" Height="22.5" Stretch="Uniform" VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <Border Background="{DynamicResource BrushScrim}" BorderBrush="{DynamicResource BrushOverlayLine}" BorderThickness="1"
                                    CornerRadius="{DynamicResource RadiusSmall}" Padding="6,2" Height="19" Margin="5,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Category}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushArtTextSecondary}" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                        <Grid VerticalAlignment="Bottom">
                            <Border>
                                <Border.Clip>
                                    <MultiBinding Converter="{StaticResource PosterShadeClipConverter}" ConverterParameter="bottom">
                                        <Binding Path="ActualWidth" ElementName="ArtArea"/>
                                        <Binding Path="ActualHeight" ElementName="ArtArea"/>
                                        <Binding Path="CornerRadius" ElementName="ArtClipBorder"/>
                                        <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}"/>
                                    </MultiBinding>
                                </Border.Clip>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="{DynamicResource ColorRaw00111114}" Offset="0.0"/>
                                        <GradientStop Color="{DynamicResource ColorRaw88111114}" Offset="0.25"/>
                                        <GradientStop Color="{DynamicResource ColorRawE6111114}" Offset="0.65"/>
                                        <GradientStop Color="{DynamicResource ColorRawF8111114}" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <StackPanel Margin="11,18,11,9">
                                <TextBlock Text="{Binding Name}" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushArtText}" TextTrimming="CharacterEllipsis"/>
                                <Grid Margin="0,3,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding PlaytimeDisplay}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushArtTextSecondary}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{Binding LastPlayedDisplay}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushArtTextMuted}"
                                               HorizontalAlignment="Right" TextAlignment="Right" TextTrimming="CharacterEllipsis" Margin="0"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
                <TextBlock Text="{Binding Caption}" Style="{StaticResource StateCaption}"/>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsHover}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                    <Setter TargetName="Card" Property="BorderThickness" Value="2"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- A shape in the Corners lists: its picture, drawn with its own corners, and its name. -->
        <DataTemplate x:Key="ShapeItem">
            <StackPanel Orientation="Horizontal">
                <Border Width="28" Height="20" Margin="0,0,8,0" BorderThickness="1.5" BorderBrush="{DynamicResource BrushTextPrimary}"
                        Background="{DynamicResource BrushAccentWash}" CornerRadius="{Binding Preview}"
                        Visibility="{Binding HasPicture, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
        <!-- The app's drop-down with its list in two columns, so fifteen shapes need little height. -->
        <Style x:Key="ShapeComboBox" TargetType="ComboBox" BasedOn="{StaticResource ModernComboBox}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="toggleButton" Style="{StaticResource ComboBoxToggleButton}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="{TemplateBinding Padding}" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom">
                                <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                                        CornerRadius="{DynamicResource RadiusSmall}" Padding="3" Margin="0,3,0,0" MinWidth="300">
                                    <ScrollViewer MaxHeight="300" SnapsToDevicePixels="True">
                                        <UniformGrid IsItemsHost="True" Columns="2" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A row under Customize that follows the choice above it is drawn quieter; once it has its own setting it is drawn normally. -->
        <Style x:Key="CornerRowStyle" TargetType="Grid">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasOwnSetting}" Value="False">
                    <Setter Property="Opacity" Value="0.6"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CornerNumber" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsExtreme}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource BrushWarning}"/>
                </DataTrigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource BrushTextDisabled}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <!-- The live preview slides out to the right: the window gets wider by this much, and the editor keeps its size. -->
            <ColumnDefinition x:Name="PreviewColumn" Width="0"/>
        </Grid.ColumnDefinitions>

        <!-- THE EDITOR -->
        <Grid Grid.Column="0" Margin="22,18,22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Divider -->
                <RowDefinition Height="*"/>    <!-- Cards -->
                <RowDefinition Height="Auto"/> <!-- Footer -->
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <StackPanel HorizontalAlignment="Left" Margin="0,0,380,0">
                    <TextBlock Text="{Binding HeadingText}" FontSize="{DynamicResource FontSizeHeading}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource BrushTextPrimary}"/>
                    <TextBlock Text="{Binding Subtitle}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Content="Undo randomize" Command="{Binding UndoRandomizeCommand}" Style="{StaticResource HelpLinkButton}" VerticalAlignment="Center" Margin="0,0,12,0"
                            Visibility="{Binding CanUndoRandomize, Converter={StaticResource BoolToVis}}"
                            ToolTip="Put back everything from before the last Randomize" AutomationProperties.Name="Undo randomize"/>
                    <Button Command="{Binding RandomizeCommand}" Style="{StaticResource ModernOutlineButton}" Padding="12,4"
                            ToolTip="Try a random look as a starting point: colors, corners, text size, font and picture strength. The text stays easy to read, and you can still change everything."
                            AutomationProperties.Name="Randomize the look of the theme">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B1;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="Randomize" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Rectangle Width="1" Height="20" Fill="{DynamicResource BrushBorderStrong}" Margin="12,0,12,0"/>
                    <Button Content="{Binding PreviewTabText}" Command="{Binding TogglePreviewCommand}" Style="{StaticResource ModernOutlineButton}" Padding="12,4"
                            ToolTip="Show or hide the live preview, which opens to the right of this window"
                            AutomationProperties.Name="Show or hide the live preview"/>
                </StackPanel>
            </Grid>

            <Rectangle Grid.Row="1" Height="1" Fill="{DynamicResource BrushBorder}" Margin="0,0,0,14"/>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
                <Grid Margin="0,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: the name, and the picture -->
                    <StackPanel Grid.Column="0">
                        <Border Style="{StaticResource DialogCardBorder}">
                            <StackPanel>
                                <TextBlock Text="NAME" Style="{StaticResource CardLabel}"/>
                                <TextBox AutomationProperties.Name="Theme name" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" MaxLength="60"/>
                                <TextBlock Text="Starts from" Margin="0,12,0,4" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}"/>
                                <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                                        CornerRadius="{DynamicResource RadiusCard}" Padding="3" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Dark" Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsDark}" Click="StartFromDark_Click" AutomationProperties.Name="Start from Dark"/>
                                        <Button Content="Light" Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsLight}" Click="StartFromLight_Click" Margin="2,0,0,0" AutomationProperties.Name="Start from Light"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Changing it restarts the colors from Dark or Light."
                                           TextWrapping="Wrap" Margin="0,6,0,0" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource DialogCardBorder}">
                            <StackPanel>
                                <TextBlock Text="BACKGROUND PICTURE" Style="{StaticResource CardLabel}"/>
                                <Border Height="110" CornerRadius="{DynamicResource RadiusControl}" Background="{DynamicResource BrushBackground}"
                                        BorderBrush="{DynamicResource BrushBorderStrong}" BorderThickness="1" ClipToBounds="True">
                                    <Grid>
                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"
                                               HorizontalAlignment="{Binding ThumbnailHorizontal}" VerticalAlignment="{Binding ThumbnailVertical}"
                                               AutomationProperties.Name="The background picture"/>
                                        <!-- The picture as the app shows it: dimmed by the Background color being edited, as much as the strength leaves. -->
                                        <Border Background="{Binding Background.Swatch}" Opacity="{Binding ThumbnailTint}" IsHitTestVisible="False"
                                                Visibility="{Binding HasPicture, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Text="No picture" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasPicture}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="Change..." Command="{Binding ChoosePictureCommand}" Style="{StaticResource ModernOutlineButton}" Padding="12,4" Margin="0,0,8,0"
                                            ToolTip="Choose a JPG or PNG, at least 1280 x 720. It is copied beside your theme file when you save."/>
                                    <Button Content="Remove" Command="{Binding RemovePictureCommand}" Style="{StaticResource ModernGhostButton}" Padding="10,4"/>
                                </StackPanel>
                                <Grid Margin="0,10,0,0" IsEnabled="{Binding HasPicture}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Strength" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,10,0"/>
                                    <Slider Grid.Column="1" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                            Value="{Binding Strength, Mode=TwoWay}" Style="{StaticResource ThemeSliderStyle}" VerticalAlignment="Center"
                                            AutomationProperties.Name="How strongly the picture shows"/>
                                    <TextBlock Grid.Column="2" Text="{Binding StrengthText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextPrimary}"/>
                                </Grid>
                                <Grid Margin="0,8,0,0" IsEnabled="{Binding HasPicture}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Keep in view" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,10,0"
                                               ToolTip="When the window is a different shape from the picture, the edges that do not fit are cropped. This is the part that always stays."/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Positions}" SelectedValue="{Binding Position}" SelectedValuePath="Id" DisplayMemberPath="Label"
                                              Style="{StaticResource ModernComboBox}" HorizontalAlignment="Left" MinWidth="110"
                                              AutomationProperties.Name="Which part of the picture stays in view"/>
                                </Grid>
                                <TextBlock Text="{Binding PictureInfo}" TextWrapping="Wrap" Margin="0,8,0,0"
                                           FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}"/>
                            </StackPanel>
                        </Border>

                        <!-- Font and text size: both are the theme's own or follow Settings. Each has its own "From Settings" box, and the card's
                             Reset puts both back to following Settings. The slider waits a moment after it stops before the preview changes. -->
                        <Border Style="{StaticResource DialogCardBorder}" Margin="0">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="FONT AND TEXT SIZE" Style="{StaticResource CardLabel}"/>
                                    <Button Content="Reset" Command="{Binding ResetTypeCommand}" Style="{StaticResource HelpLinkButton}"
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            ToolTip="Both follow the font and the size from Settings again"
                                            Visibility="{Binding CanResetType, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                                <Grid Margin="0,2,0,0">
                                    <TextBlock Text="Font" VerticalAlignment="Center"
                                               FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}"/>
                                    <CheckBox Content="From Settings" IsChecked="{Binding UseSettingsFont}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                              AutomationProperties.Name="Use the font from Settings"
                                              Style="{StaticResource ModernCheckBox}" FontSize="{DynamicResource FontSizeBody}"
                                              ToolTip="{Binding FontFollowNote}"/>
                                </Grid>
                                <ComboBox IsEnabled="{Binding HasOwnFont}" ItemsSource="{Binding Fonts}" SelectedItem="{Binding Font}"
                                          Style="{StaticResource ModernComboBox}" Margin="0,6,0,0"
                                          AutomationProperties.Name="Font">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontFamily="{Binding}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <Grid Margin="0,14,0,0">
                                    <TextBlock Text="Text size" VerticalAlignment="Center"
                                               FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}"/>
                                    <CheckBox Content="From Settings" IsChecked="{Binding UseSettingsTextSize}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                              AutomationProperties.Name="Use the text size from Settings"
                                              Style="{StaticResource ModernCheckBox}" FontSize="{DynamicResource FontSizeBody}"
                                              ToolTip="{Binding TextSizeFollowNote}"/>
                                </Grid>
                                <Grid IsEnabled="{Binding HasOwnTextSize}" Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Minimum="{Binding MinTextSize, Mode=OneTime}" Maximum="{Binding MaxTextSize, Mode=OneTime}"
                                            SmallChange="1" LargeChange="5" TickFrequency="1" IsSnapToTickEnabled="True"
                                            Value="{Binding TextSize, Mode=TwoWay, Delay=120}"
                                            Style="{StaticResource ThemeSliderStyle}" VerticalAlignment="Center"
                                            AutomationProperties.Name="Text size, in percent"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBox MinWidth="56" TextAlignment="Center" Style="{StaticResource ModernTextBox}" Padding="6,0"
                                                 AutomationProperties.Name="Text size in percent"
                                                 Text="{Binding TextSize, UpdateSourceTrigger=LostFocus}" MaxLength="3"/>
                                        <TextBlock Text="%" Margin="4,0,0,0" VerticalAlignment="Center"
                                                   FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Applies while this theme is on. Where the font is not installed, the font from Settings is used."
                                           TextWrapping="Wrap" Margin="0,10,0,0"
                                           FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}"/>
                                <views:NoteBar Kind="Warning" Text="{Binding TextSizeWarning}" Margin="0,8,0,0"
                                       Visibility="{Binding TextSizeIsLarge, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- RIGHT: the colors, and the corners -->
                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource DialogCardBorder}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="MAIN COLORS" Style="{StaticResource CardLabel}"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <Button Content="Randomize" Command="{Binding RandomizeColorsCommand}" Style="{StaticResource HelpLinkButton}"
                                                ToolTip="Try a random set of main colors. The text stays easy to read." AutomationProperties.Name="Randomize the colors"/>
                                        <Button Content="Reset" Command="{Binding ResetColorsCommand}" Style="{StaticResource HelpLinkButton}" Margin="12,0,0,0"
                                                Visibility="{Binding ColorsDiffer, Converter={StaticResource BoolToVis}}"
                                                ToolTip="Put the main colors back to how they were when this window opened" AutomationProperties.Name="Reset the colors"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Click a swatch to pick, or type or paste #RRGGBB" Margin="0,0,0,6" FontSize="{DynamicResource FontSizeBody}"
                                           Foreground="{DynamicResource BrushTextMuted}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <views:ThemeColorRowControl DataContext="{Binding Background}"/>
                                        <views:ThemeColorRowControl DataContext="{Binding Surface}"/>
                                        <views:ThemeColorRowControl DataContext="{Binding Text}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <views:ThemeColorRowControl DataContext="{Binding Accent}"/>
                                        <views:ThemeColorRowControl DataContext="{Binding Danger}"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="OPTIONAL" Style="{StaticResource CardLabel}" Margin="0,12,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <views:ThemeColorRowControl Grid.Column="0" DataContext="{Binding Warning}"/>
                                    <views:ThemeColorRowControl Grid.Column="2" DataContext="{Binding Success}"/>
                                </Grid>

                                <TextBlock Text="{Binding HandSetNote}" TextWrapping="Wrap" Margin="0,10,0,0"
                                           FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}"
                                           Visibility="{Binding HasHandSetNote, Converter={StaticResource BoolToVis}}"/>

                                <!-- A warning only, shown when some text may be hard to read; no all-clear is claimed. Same look as the corner warning. -->
                                <views:NoteBar Kind="Warning" Text="{Binding ContrastLine}" Margin="0,8,0,0"
                                       Visibility="{Binding HasContrastLine, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Border>

                        <!-- The corner shapes: one shape and roundness for the theme, and under Customize one for each kind of corner. -->
                        <Border Style="{StaticResource DialogCardBorder}" Margin="0">
                            <StackPanel DataContext="{Binding Corners}">
                                <Grid>
                                    <TextBlock Text="CORNERS" Style="{StaticResource CardLabel}"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <Button Content="Randomize" Command="{Binding DataContext.RandomizeCornersCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource HelpLinkButton}"
                                                ToolTip="Try a random shape and size for the corners" AutomationProperties.Name="Randomize the corners"/>
                                        <Button Content="Reset" Command="{Binding ResetCommand}" Style="{StaticResource HelpLinkButton}" Margin="12,0,0,0"
                                                Visibility="{Binding DiffersFromDefault, Converter={StaticResource BoolToVis}}"
                                                ToolTip="Put every corner back to the app's own" AutomationProperties.Name="Reset the corners"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Default for every kind of corner" Margin="0,0,0,6" FontSize="{DynamicResource FontSizeBody}"
                                           Foreground="{DynamicResource BrushTextMuted}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="28"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{Binding Shapes}" SelectedItem="{Binding Shape}" ItemTemplate="{StaticResource ShapeItem}"
                                              Style="{StaticResource ShapeComboBox}" AutomationProperties.Name="Corner shape"/>
                                    <TextBlock Grid.Column="1" Text="Roundness" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeBody}"
                                               Foreground="{DynamicResource BrushTextSecondary}" Margin="16,0,10,0"/>
                                    <Slider Grid.Column="2" Minimum="0" Maximum="16" SmallChange="1" LargeChange="2" TickFrequency="1" IsSnapToTickEnabled="True"
                                            IsEnabled="{Binding RoundnessEnabled}" Value="{Binding Roundness, Mode=TwoWay}" Style="{StaticResource ThemeSliderStyle}" VerticalAlignment="Center"
                                            AutomationProperties.Name="How round the corners are"/>
                                    <TextBlock Grid.Column="3" Text="{Binding RoundnessText}" IsEnabled="{Binding RoundnessEnabled}" Style="{StaticResource CornerNumber}"/>
                                </Grid>
                                <Button Content="{Binding CustomizeText}" Command="{Binding ToggleCustomizeCommand}" Style="{StaticResource HelpLinkButton}" Margin="0,10,0,0"
                                        AutomationProperties.Name="Choose a shape and size for each kind of corner"/>
                                <StackPanel Visibility="{Binding ShowCustomize, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl ItemsSource="{Binding Rows}" IsTabStop="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,8,0,0" Style="{StaticResource CornerRowStyle}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="64"/>
                                                        <ColumnDefinition Width="190"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="28"/>
                                                        <ColumnDefinition Width="26"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}"/>
                                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedShape}" ItemTemplate="{StaticResource ShapeItem}"
                                                              Style="{StaticResource ShapeComboBox}" AutomationProperties.Name="{Binding Label, StringFormat={}{0} shape}"/>
                                                    <Slider Grid.Column="2" Margin="14,0,8,0" Minimum="0" Maximum="16" SmallChange="1" LargeChange="2" TickFrequency="1" IsSnapToTickEnabled="True"
                                                            IsEnabled="{Binding SizeEnabled}" Value="{Binding Step, Mode=TwoWay}" Style="{StaticResource ThemeSliderStyle}" VerticalAlignment="Center"
                                                            AutomationProperties.Name="{Binding Label, StringFormat={}{0} roundness}"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding StepText}" IsEnabled="{Binding SizeEnabled}" Style="{StaticResource CornerNumber}"/>
                                                    <Button Grid.Column="4" Content="&#xE72C;" FontFamily="{StaticResource IconFont}" Style="{StaticResource ModernGhostButton}" Padding="4"
                                                            MinHeight="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            Command="{Binding ResetCommand}" Visibility="{Binding HasOwnSetting, Converter={StaticResource BoolToVis}}"
                                                            ToolTip="Put this row back to Default" AutomationProperties.Name="{Binding Label, StringFormat=Put {0} back to Default}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock TextWrapping="Wrap" Margin="0,10,0,0" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}"
                                               Text="Changing the shape above sets every row to that shape, and moving the roundness above makes every row rounder or squarer by the same amount. A row you change after that keeps its own. Posters follow the cards, one pixel less round, unless you change them. Past 8 is extreme."/>
                                </StackPanel>
                                <views:NoteBar Kind="Warning" Text="These corners may clip text and art. Lower the roundness to fix it." Margin="0,8,0,0"
                                       Visibility="{Binding AnyExtreme, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- FOOTER -->
            <DockPanel Grid.Row="3" LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="_Cancel" Command="{Binding CancelCommand}" IsCancel="True"
                            Style="{StaticResource ModernOutlineButton}" Margin="0,0,10,0" MinWidth="90"/>
                    <Button Content="_Save Changes" Command="{Binding SaveCommand}" IsDefault="True" Click="SaveButton_Click"
                            Style="{StaticResource ModernAccentButton}" MinWidth="120"/>
                </StackPanel>
                <Button DockPanel.Dock="Left" Content="Open file" Command="{Binding OpenFileCommand}" Style="{StaticResource ModernOutlineButton}" Margin="0,0,14,0"
                        Visibility="{Binding CanOpenFile, Converter={StaticResource BoolToVis}}"
                        ToolTip="Show the theme file in Explorer, to change the colors this window does not cover"/>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding ValidationMessage}" Foreground="{DynamicResource BrushDanger}" FontSize="{DynamicResource FontSizeBody}" TextWrapping="Wrap"
                               Visibility="{Binding HasValidationMessage, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </DockPanel>
        </Grid>

        <!-- THE LIVE PREVIEW: a panel on the window's right edge, shown when the tab above is pressed. -->
        <Border x:Name="PreviewPanel" Grid.Column="1" Visibility="Collapsed" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1,0,0,0" Padding="18,18,22,18">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock Text="LIVE PREVIEW" Style="{StaticResource CardLabel}" Margin="0,0,0,4"/>
                    <TextBlock Text="Shows your colors, corners, text size and font. The app changes when you save." TextWrapping="Wrap"
                               FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}"/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <!-- Its own set of colors and corners, filled in from the editor, so nothing else on screen changes. -->
                    <Border x:Name="PreviewHost" Background="{DynamicResource BrushBackground}" BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1" CornerRadius="{DynamicResource RadiusCard}" Padding="14"
                            Focusable="False" Margin="0,0,6,0"
                            AutomationProperties.Name="Preview of the colors and corners">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <Button DockPanel.Dock="Right" Content="Add Game" Style="{StaticResource ModernAccentButton}" Focusable="False" IsTabStop="False"/>
                                <Button DockPanel.Dock="Right" Content="Add Folder" Style="{StaticResource ModernOutlineButton}" Margin="0,0,8,0" Focusable="False" IsTabStop="False"/>
                                <!-- The library's own tab strip: same container and the app's own SegmentedTabButton. -->
                                <Border DockPanel.Dock="Left" Background="{DynamicResource BrushDialogCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                                        CornerRadius="{DynamicResource RadiusControl}" Padding="3" Height="{StaticResource TabStripHeight}">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="All Games" Style="{StaticResource SegmentedTabButton}" Tag="True" Focusable="False" IsTabStop="False"/>
                                        <Button Content="Favorites" Style="{StaticResource SegmentedTabButton}" Tag="False" Margin="2,0,0,0" Focusable="False" IsTabStop="False"/>
                                        <Button Content="Action" Style="{StaticResource SegmentedTabButton}" Tag="False" Margin="2,0,0,0" Focusable="False" IsTabStop="False"/>
                                    </StackPanel>
                                </Border>
                            </DockPanel>

                            <!-- The preview answers the mouse: the buttons use the app's own styles, and this card has the row hover. -->
                            <Border BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                                    CornerRadius="{DynamicResource RadiusCard}" Padding="12,10" Margin="0,10,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource BrushSurfaceHover}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="{Binding Samples[0].Name, FallbackValue='Cyberpunk 2077'}" FontSize="{DynamicResource FontSizeSubhead}" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                    <TextBlock Text="Second-level text, like a description" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0"/>
                                    <TextBlock Text="Quiet text, like a hint or a caption" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="A link" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushAccentText}" VerticalAlignment="Center"/>
                                        <!-- The library's own badges: Playing, and the two readings of "isn't there" (Missing, Not installed). -->
                                        <Border Background="{DynamicResource BrushSuccessWash}" BorderBrush="{DynamicResource BrushSuccessSolid}" BorderThickness="1" CornerRadius="{DynamicResource RadiusSmall}" Padding="4,0" Margin="14,0,0,0">
                                            <TextBlock Text="▶ PLAYING" FontSize="{DynamicResource FontSizeBadge}" FontWeight="SemiBold" Foreground="{DynamicResource BrushSuccessText}"/>
                                        </Border>
                                        <Border Background="{DynamicResource BrushWarningWash}" BorderBrush="{DynamicResource BrushWarningBorder}" BorderThickness="1" CornerRadius="{DynamicResource RadiusSmall}" Padding="6,2" Margin="8,0,0,0">
                                            <TextBlock Text="MISSING" FontSize="{DynamicResource FontSizeBadge}" FontWeight="SemiBold" Foreground="{DynamicResource BrushWarning}"/>
                                        </Border>
                                        <Border Background="{DynamicResource BrushSurfaceHover}" BorderBrush="{DynamicResource BrushBorderStrong}" BorderThickness="1" CornerRadius="{DynamicResource RadiusSmall}" Padding="6,2" Margin="8,0,0,0">
                                            <TextBlock Text="NOT INSTALLED" FontSize="{DynamicResource FontSizeBadge}" FontWeight="SemiBold" Foreground="{DynamicResource BrushInfoText}"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Game cards at the library's own size: a card at rest, one under the mouse and one selected. -->
                            <TextBlock Text="GAME CARDS" Style="{StaticResource PreviewHeading}"/>
                            <ItemsControl ItemsSource="{Binding Samples}" ItemTemplate="{StaticResource PreviewPosterCard}" Focusable="False" IsTabStop="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <TextBlock Text="IN A DIALOG" Style="{StaticResource PreviewHeading}"/>
                            <Border Background="{DynamicResource BrushDialogCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                                    CornerRadius="{DynamicResource RadiusCard}" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="A card inside a dialog, with a text box" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}"/>
                                    <TextBox Text="Text you type" IsReadOnly="True" Focusable="False" IsTabStop="False" Style="{StaticResource ModernTextBox}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- The looks a control takes on that cannot all be shown at once with a mouse: side by side, so the
                                 colors can be compared, and so a keyboard user sees them too. -->
                            <TextBlock Text="STATES" Style="{StaticResource PreviewHeading}"/>
                            <UniformGrid Columns="3">
                                <StackPanel Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource StateChip}" Background="{DynamicResource BrushAccent}" BorderBrush="{DynamicResource BrushAccent}">
                                            <TextBlock Text="Normal" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextOnSolid}"/>
                                        </Border>
                                        <Border Style="{StaticResource StateChip}" Background="{DynamicResource BrushAccentHover}" BorderBrush="{DynamicResource BrushAccentHover}">
                                            <TextBlock Text="Hover" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextOnSolid}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Main button" Style="{StaticResource StateCaption}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource StateChip}" Background="{DynamicResource BrushAccentPressed}" BorderBrush="{DynamicResource BrushAccentPressed}">
                                            <TextBlock Text="Pressed" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextOnSolid}"/>
                                        </Border>
                                        <Border Style="{StaticResource StateChip}" Background="{DynamicResource BrushSurfaceHover}" BorderBrush="{DynamicResource BrushAccent}">
                                            <TextBlock Text="Hover" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextPrimary}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Pressed, outline button hover" Style="{StaticResource StateCaption}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <Border BorderThickness="2" BorderBrush="{DynamicResource BrushAccentHover}" CornerRadius="{DynamicResource RadiusControl}" Padding="2" Margin="0,0,10,0">
                                            <Border Style="{StaticResource StateChip}" Margin="0" Background="{DynamicResource BrushAccent}" BorderBrush="{DynamicResource BrushAccent}">
                                                <TextBlock Text="Focus" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextOnSolid}"/>
                                            </Border>
                                        </Border>
                                        <TextBlock Text="Disabled" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextDisabled}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="Keyboard focus, disabled" Style="{StaticResource StateCaption}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,8,0">
                                    <Border Style="{StaticResource StateRow}" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}">
                                        <TextBlock Text="Row" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextPrimary}"/>
                                    </Border>
                                    <TextBlock Text="Normal" Style="{StaticResource StateCaption}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,8,0">
                                    <Border Style="{StaticResource StateRow}" Background="{DynamicResource BrushSurfaceHover}" BorderBrush="{DynamicResource BrushBorder}">
                                        <TextBlock Text="Row" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextPrimary}"/>
                                    </Border>
                                    <TextBlock Text="Mouse over" Style="{StaticResource StateCaption}"/>
                                </StackPanel>
                                <StackPanel>
                                    <Border Style="{StaticResource StateRow}" Background="{DynamicResource BrushAccentWash}" BorderBrush="{DynamicResource BrushBorderAccent}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushAccentText}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Row" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextPrimary}"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="Selected" Style="{StaticResource StateCaption}"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
