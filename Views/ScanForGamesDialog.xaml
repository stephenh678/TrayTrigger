<Window x:Class="TrayTrigger.Views.ScanForGamesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TrayTrigger.ViewModels"
        mc:Ignorable="d"
        Title="New Games Found"
        Height="580" Width="680"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource BrushDialogBg}"
        Foreground="{StaticResource BrushTextPrimary}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Search & Bulk Selection -->
            <RowDefinition Height="*"/>    <!-- Results List -->
            <RowDefinition Height="Auto"/> <!-- Status & Action Buttons -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="New Games Found" FontSize="18" Foreground="{StaticResource BrushTextPrimary}"
                       FontFamily="{StaticResource AppFont}" FontWeight="Normal"/>
            <TextBlock Text="{Binding SubtitleText}"
                       FontSize="12" Foreground="{StaticResource BrushTextSecondary}"
                       FontFamily="{StaticResource AppFont}" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Filter & Selection Bar -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource ModernTextBox}" Margin="0,0,12,0"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Select All" Command="{Binding SelectAllCommand}"
                        Style="{StaticResource ModernGhostButton}" Margin="0,0,6,0"/>
                <Button Content="Deselect All" Command="{Binding DeselectAllCommand}"
                        Style="{StaticResource ModernGhostButton}"/>
            </StackPanel>
        </Grid>

        <!-- Results List -->
        <Border Grid.Row="2" CornerRadius="8" Background="{StaticResource BrushSurfaceDark}"
                BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" Margin="0,0,0,16">
            <ListBox ItemsSource="{Binding FilteredResults}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#222228"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource BrushSurfaceHover}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ScannedGameItemViewModel}">
                        <DockPanel LastChildFill="True">
                            <!-- Checkbox -->
                            <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,12,0"
                                      Style="{StaticResource ModernCheckBox}" DockPanel.Dock="Left"/>

                            <!-- Game Icon -->
                            <Border Width="36" Height="36" CornerRadius="6" Background="#22222A"
                                    Margin="0,0,12,0" VerticalAlignment="Center" DockPanel.Dock="Left">
                                <Image Source="{Binding IconImage}" Width="32" Height="32"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>

                            <!-- Source badge -->
                            <Border DockPanel.Dock="Right" Background="#22222A" CornerRadius="3" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SourceLabel}" FontSize="9.5" FontWeight="Bold" Foreground="#9A9AB0"/>
                            </Border>

                            <!-- Ignore -->
                            <Button DockPanel.Dock="Right" Content="Ignore" Command="{Binding IgnoreCommand}"
                                    Style="{StaticResource ModernGhostButton}" FontSize="10.5" Padding="6,2" Margin="10,0,0,0"
                                    VerticalAlignment="Center" ToolTip="Never suggest this game again in Add Folder or Scan for Games"/>

                            <!-- Name and Install Path -->
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="13.5"
                                           Foreground="{StaticResource BrushTextPrimary}"
                                           FontFamily="{StaticResource AppFont}"/>
                                <TextBlock Text="{Binding PathDisplay}" FontSize="11"
                                           Foreground="{StaticResource BrushTextMuted}"
                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Footer -->
        <DockPanel Grid.Row="3">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Command="{Binding CancelCommand}"
                        Style="{StaticResource ModernGhostButton}" Margin="0,0,8,0"/>
                <Button Content="Install Selected" Command="{Binding ImportCommand}"
                        Style="{StaticResource ModernAccentButton}"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
