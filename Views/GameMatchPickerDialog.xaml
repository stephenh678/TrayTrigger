<Window x:Class="TrayTrigger.Views.GameMatchPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Change Match"
        Height="480" Width="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource BrushDialogBg}"
        Foreground="{StaticResource BrushTextPrimary}"
        FontFamily="{StaticResource AppFont}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Search box -->
            <RowDefinition Height="*"/>    <!-- Results -->
            <RowDefinition Height="Auto"/> <!-- Attribution -->
            <RowDefinition Height="Auto"/> <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="TitleTextBlock" FontSize="18" Foreground="{StaticResource BrushTextPrimary}" FontWeight="Normal"/>
            <TextBlock x:Name="SubtitleTextBlock" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Search -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchTextBox" Grid.Column="0" Style="{StaticResource ModernTextBox}" Margin="0,0,8,0"
                     Tag="Search by title..." KeyDown="SearchTextBox_KeyDown"/>
            <Button x:Name="SearchButton" Grid.Column="1" Content="Search" Click="SearchButton_Click"
                    Style="{StaticResource ModernOutlineButton}" Padding="14,5" MinWidth="80"/>
        </Grid>

        <!-- Results -->
        <Border Grid.Row="2" CornerRadius="8" Background="{StaticResource BrushSurfaceDark}"
                BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" Margin="0,0,0,10">
            <Grid>
                <ListBox x:Name="ResultsListBox" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="ResultsListBox_MouseDoubleClick"
                         SelectionChanged="ResultsListBox_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#222228"/>
                            <Setter Property="Padding" Value="12,9"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#1C2E3D"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{StaticResource BrushSurfaceHover}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Right" Background="#1C2E3D" CornerRadius="4" Padding="5,1.5" Margin="10,0,0,0"
                                        VerticalAlignment="Center" Visibility="{Binding CurrentVisibility}">
                                    <TextBlock Text="CURRENT" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource BrushAccentHover}"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Hit.Name}" FontSize="13.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Hit.Subtitle}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Empty / loading overlay -->
                <TextBlock x:Name="EmptyTextBlock" FontSize="12.5" Foreground="{StaticResource BrushTextSecondary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                           Margin="24" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- Attribution (RAWG's terms need an active link wherever their data shows; Steam needs none) -->
        <TextBlock x:Name="AttributionTextBlock" Grid.Row="3" FontSize="10.5" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,12" Visibility="Collapsed">
            <Hyperlink x:Name="AttributionLink" Click="AttributionLink_Click" Foreground="{StaticResource BrushTextSecondary}"><Run x:Name="AttributionRun"/></Hyperlink>
        </TextBlock>

        <!-- Buttons -->
        <DockPanel Grid.Row="4">
            <Button x:Name="UseButton" DockPanel.Dock="Right" Content="Use Selected" Click="UseButton_Click" IsEnabled="False"
                    Style="{StaticResource ModernAccentButton}" MinWidth="120" Margin="10,0,0,0"/>
            <Button DockPanel.Dock="Right" Content="Cancel" Click="CancelButton_Click"
                    Style="{StaticResource ModernGhostButton}" MinWidth="80"/>
        </DockPanel>
    </Grid>
</Window>
