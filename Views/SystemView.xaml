<UserControl x:Class="TrayTrigger.Views.SystemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TrayTrigger.ViewModels"
             xmlns:services="clr-namespace:TrayTrigger.Services"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1100"
             Background="Transparent">

    <UserControl.Resources>
        <!-- Standard Settings-Style Card -->
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BrushSurfaceDark}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorderDark}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Reusable Settings-Style Tweak Row Item Template -->
        <DataTemplate x:Key="TweakItemTemplate" DataType="{x:Type vm:SystemTweakViewModel}">
            <Border BorderBrush="#252530" BorderThickness="0,0,0,1" Padding="0,6,0,10" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" 
                                       Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                            <Border Background="{Binding StatusBadgeColor}" CornerRadius="3" Padding="6,1.5" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusBadgeText}" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </Border>
                            <Border Background="#2A2A3A" CornerRadius="3" Padding="6,1.5" Margin="6,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding IsOptIn, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="OPT-IN" FontSize="9" FontWeight="Bold" Foreground="#B8B8CC"/>
                            </Border>
                            <Border Background="#3D2F14" CornerRadius="3" Padding="6,1.5" Margin="6,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding RequiresReboot, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="⟳ RESTART" FontSize="9" FontWeight="Bold" Foreground="#E8B84E"/>
                            </Border>
                            <Border Background="#2B2340" CornerRadius="3" Padding="6,1.5" Margin="6,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEA18;" FontFamily="{StaticResource IconFont}" FontSize="9" Foreground="#B9A6F0" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                    <TextBlock Text="ADMIN" FontSize="9" FontWeight="Bold" Foreground="#B9A6F0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding ShortDescription}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"
                                   Margin="0,3,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding UnavailableReason}" FontSize="10.5" Foreground="#E8B84E"
                                   Margin="0,3,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding ShowUnavailableReason, Converter={StaticResource BoolToVis}}"/>
                        <!-- The "why" and trade-offs live in Help/tweaks/<id>.md, opened here. -->
                        <Button Style="{StaticResource HelpLinkButton}" Margin="0,4,0,0"
                                Command="{x:Static services:HelpCommands.ShowTopic}"
                                CommandParameter="{Binding HelpTopicId}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{Binding CustomActionLabel}" Command="{Binding CustomActionCommand}"
                                Visibility="{Binding HasCustomAction, Converter={StaticResource BoolToVis}}"
                                Style="{StaticResource ModernOutlineButton}" Margin="0,0,6,0" Padding="10,4" FontSize="11.5"/>
                        <Button Content="{Binding ActionButtonText}" Command="{Binding ToggleCommand}"
                                Visibility="{Binding CanToggle, Converter={StaticResource BoolToVis}}"
                                IsEnabled="{Binding CanExecuteToggle}"
                                Style="{StaticResource ModernOutlineButton}" Padding="10,4" FontSize="11.5"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ProfileTweakToggleTemplate" DataType="{x:Type vm:ProfileTweakToggleViewModel}">
            <Border BorderBrush="#252530" BorderThickness="0,0,0,1" Padding="0,6,0,10" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <!-- The longer rationale lives in the Learn more topic. -->
                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                            <Border Background="{Binding StatusBadgeColor}" CornerRadius="3" Padding="6,1.5" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusBadgeText}" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </Border>
                            <Border Background="#2A2A3A" CornerRadius="3" Padding="6,1.5" Margin="6,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding IsOptIn, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="OPT-IN" FontSize="9" FontWeight="Bold" Foreground="#B8B8CC"/>
                            </Border>
                            <Border Background="#2B2340" CornerRadius="3" Padding="6,1.5" Margin="6,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEA18;" FontFamily="{StaticResource IconFont}" FontSize="9" Foreground="#B9A6F0" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                    <TextBlock Text="ADMIN" FontSize="9" FontWeight="Bold" Foreground="#B9A6F0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding ShortDescription}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"
                                   Margin="0,3,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Note}" FontSize="10.5" Foreground="#E8B84E"
                                   Margin="0,3,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}"/>
                        <Button Style="{StaticResource HelpLinkButton}" Margin="0,4,0,0"
                                Command="{x:Static services:HelpCommands.ShowTopic}"
                                CommandParameter="{Binding HelpTopicId}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="{Binding ActionButtonText}" Command="{Binding ToggleCommand}"
                            Style="{StaticResource ModernOutlineButton}" Padding="10,4" FontSize="11.5" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Category Tabs -->
            <RowDefinition Height="*"/>    <!-- Main Content -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- 1. HEADER -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <!-- Right: Live Telemetry Indicator -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="12" 
                           Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBlock Text="Live Hardware Telemetry" FontSize="11.5" Foreground="{StaticResource BrushTextMuted}" 
                           FontFamily="{StaticResource AppFont}" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Left: Title & Subtitle matching Settings -->
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="System &amp; Performance" FontSize="20" Foreground="{StaticResource BrushTextPrimary}" 
                           FontFamily="{StaticResource AppFont}" FontWeight="Normal"/>
                <TextBlock Text="Hardware telemetry, gaming specifications, and verified performance optimizations"
                           FontSize="12" Foreground="{StaticResource BrushTextSecondary}" 
                           FontFamily="{StaticResource AppFont}" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- 2. CATEGORY SEGMENTED TABS -->
        <Border Grid.Row="1" Background="#181820" BorderBrush="{StaticResource BrushBorderDark}" 
                BorderThickness="1" CornerRadius="6" Padding="3" HorizontalAlignment="Left" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Button Content="All" Command="{Binding SelectAllTabCommand}"
                        Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsAllTab}"/>
                <Button Content="Hardware Specs" Command="{Binding SelectSpecsTabCommand}" Margin="2,0,0,0"
                        Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsSpecsTab}"/>
                <Button Content="Performance Tweaks" Command="{Binding SelectTweaksTabCommand}" Margin="2,0,0,0"
                        Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsTweaksTab}"/>
                <Button Content="Performance Profiles" Command="{Binding SelectGameProfilesTabCommand}" Margin="2,0,0,0"
                        Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsGameProfilesTab}"/>
            </StackPanel>
        </Border>

        <!-- 3. CONTENT AREA -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,14">
            <StackPanel HorizontalAlignment="Stretch" Margin="0,0,12,0">

                <!-- ========================================================== -->
                <!-- CATEGORY 1: HARDWARE SPECS                                 -->
                <!-- ========================================================== -->
                <StackPanel Visibility="{Binding ShowSpecsSection, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                    <!-- Section Header (shown in All view) -->
                    <Border Margin="0,2,0,8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAllTab}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE770;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="12.5" 
                                       Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="HARDWARE TELEMETRY &amp; SPECS" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Section toolbar: the refresh for the whole specs section lives here, not in
                         the last card. Shown while loading too, so the placeholder card below has
                         the same header as the loaded state. -->
                    <DockPanel LastChildFill="False" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Refresh Specs" Command="{Binding RefreshSpecsCommand}"
                                IsEnabled="{Binding IsSpecsLoaded}"
                                Style="{StaticResource ModernOutlineButton}" Padding="10,3" VerticalAlignment="Center"/>
                        <TextBlock DockPanel.Dock="Left" Text="{Binding SpecsRefreshedDisplay}" FontSize="11"
                                   Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- Loading placeholder: shown instead of the spec cards, which would otherwise
                         paint "Unknown GPU / 0 GB / 0 x 0 @ 0Hz" for the first second or two. -->
                    <Border Style="{StaticResource SettingsCard}" Visibility="{Binding IsLoadingSpecs, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="14"
                                       Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Detecting hardware…" FontSize="12.5" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Visibility="{Binding IsSpecsLoaded, Converter={StaticResource BoolToVis}}">

                    <!-- 1. Graphics Card (GPU) -->
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <DockPanel LastChildFill="True" Margin="0,0,0,4">
                                <Border DockPanel.Dock="Right" Background="#16161B" BorderBrush="#252530" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PrimaryGpu.VramGigabytes, Mode=OneWay, StringFormat='{}{0:0.#} GB VRAM'}" FontSize="11" FontWeight="SemiBold" Foreground="#4EC9B0"/>
                                </Border>
                                <TextBlock Text="Graphics Card (GPU)" FontSize="13.5" FontWeight="SemiBold" 
                                           Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Text="{Binding PrimaryGpu.ModelName}" FontSize="12.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4"/>
                            <DockPanel>
                                <TextBlock FontSize="11" Foreground="{StaticResource BrushTextMuted}">
                                    <Run Text="{Binding PrimaryGpu.DriverVersion, Mode=OneWay, StringFormat='Driver: {0}'}"/>
                                    <Run Text="{Binding PrimaryGpu.DriverDate, Mode=OneWay, StringFormat=' ({0})'}"/>
                                </TextBlock>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- 2. Displays & Refresh Rate -->
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <DockPanel LastChildFill="True" Margin="0,0,0,4">
                                <Border DockPanel.Dock="Right" Background="#16161B" BorderBrush="#252530" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PrimaryDisplay.RefreshRateHz, Mode=OneWay, StringFormat='{}{0} Hz'}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushAccentHover}"/>
                                </Border>
                                <TextBlock Text="Displays &amp; Refresh Rate" FontSize="13.5" FontWeight="SemiBold" 
                                           Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Text="{Binding PrimaryDisplay.ResolutionDisplay, Mode=OneWay, StringFormat='Primary Display: {0}'}" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4"/>
                            <ItemsControl ItemsSource="{Binding SecondaryDisplays}" Visibility="{Binding HasMultipleDisplays, Converter={StaticResource BoolToVis}}" Margin="0,2,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ResolutionDisplay, StringFormat='• Additional: {0}'}" FontSize="11" 
                                                   Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,0"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 3. Processor (CPU) -->
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <DockPanel LastChildFill="True" Margin="0,0,0,4">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Cpu.CurrentUsagePercent, Mode=OneWay, StringFormat='Load: {0}%'}" 
                                           FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center"/>
                                <TextBlock Text="Processor (CPU)" FontSize="13.5" FontWeight="SemiBold" 
                                           Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Text="{Binding Cpu.ModelName}" FontSize="12.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4"/>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock FontSize="11" Foreground="{StaticResource BrushTextMuted}">
                                    <Run Text="{Binding Cpu.PhysicalCores, Mode=OneWay, StringFormat='{}{0} Cores, '}"/>
                                    <Run Text="{Binding Cpu.LogicalProcessors, Mode=OneWay, StringFormat='{}{0} Threads, '}"/>
                                    <Run Text="{Binding Cpu.ClockSpeedDisplay, Mode=OneWay}"/>
                                </TextBlock>
                            </DockPanel>
                            <ProgressBar Value="{Binding Cpu.CurrentUsagePercent, Mode=OneWay}" Maximum="100" Height="6" 
                                         Background="#16161B" Foreground="{StaticResource BrushAccent}" BorderThickness="0"/>
                        </StackPanel>
                    </Border>

                    <!-- 4. System Memory (RAM) -->
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <DockPanel LastChildFill="True" Margin="0,0,0,4">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Ram.UsagePercent, Mode=OneWay, StringFormat='Used: {0}%'}" 
                                           FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center"/>
                                <TextBlock Text="System Memory (RAM)" FontSize="13.5" FontWeight="SemiBold" 
                                           Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock FontSize="12" Foreground="{StaticResource BrushTextSecondary}">
                                    <Run Text="{Binding Ram.UsedGigabytes, Mode=OneWay, StringFormat='{}{0:0.#} GB in use'}"/>
                                    <Run Text="{Binding Ram.AvailableGigabytes, Mode=OneWay, StringFormat=' ({0:0.#} GB free of '}"/>
                                    <Run Text="{Binding Ram.TotalGigabytes, Mode=OneWay, StringFormat='{}{0:0.#} GB)'}"/>
                                </TextBlock>
                            </DockPanel>
                            <TextBlock Text="{Binding Ram.SpeedDisplay, Mode=OneWay}" FontSize="11" Foreground="{StaticResource BrushTextMuted}"
                                       Visibility="{Binding Ram.HasSpeedInfo, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8"/>
                            <ProgressBar Value="{Binding Ram.UsagePercent, Mode=OneWay}" Maximum="100" Height="6"
                                         Background="#16161B" Foreground="{StaticResource BrushAccent}" BorderThickness="0"/>
                        </StackPanel>
                    </Border>

                    <!-- 5. Storage & Gaming Drives -->
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock Text="Storage &amp; Gaming Drives" FontSize="13.5" FontWeight="SemiBold" 
                                       Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4"/>
                            <TextBlock Text="Fixed drive volumes, available storage capacity, and disk usage." 
                                       FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <ItemsControl ItemsSource="{Binding Drives}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,8">
                                            <DockPanel LastChildFill="True" Margin="0,0,0,4">
                                                <TextBlock HorizontalAlignment="Right" DockPanel.Dock="Right" FontSize="11" Foreground="{StaticResource BrushTextSecondary}">
                                                    <Run Text="{Binding FreeGigabytes, Mode=OneWay, StringFormat='{}{0:0.#} GB free'}"/>
                                                    <Run Text="{Binding TotalGigabytes, Mode=OneWay, StringFormat=' of {0:0.#} GB'}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource BrushTextPrimary}" DockPanel.Dock="Left"/>
                                                <Border Background="#16161B" BorderBrush="#252530" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="6,0,0,0"
                                                        HorizontalAlignment="Left" DockPanel.Dock="Left"
                                                        Visibility="{Binding HasMediaTypeInfo, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding MediaTypeDisplay}" FontSize="10" FontWeight="SemiBold" Foreground="#4EC9B0"/>
                                                </Border>
                                            </DockPanel>
                                            <ProgressBar Value="{Binding UsagePercent, Mode=OneWay}" Maximum="100" Height="6"
                                                         Background="#16161B" Foreground="{StaticResource BrushAccent}" BorderThickness="0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 6. Network & Latency -->
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <DockPanel LastChildFill="True" Margin="0,0,0,4">
                                <Border DockPanel.Dock="Right" Background="#16161B" BorderBrush="#252530" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Network.PingDisplay, Mode=OneWay, StringFormat='Ping: {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushAccentHover}"/>
                                </Border>
                                <TextBlock Text="Network &amp; Latency" FontSize="13.5" FontWeight="SemiBold" 
                                           Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Text="{Binding Network.ConnectionType, Mode=OneWay, StringFormat='Connection: {0}'}" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding Network.AdapterName, Mode=OneWay, StringFormat='Adapter: {0}'}" FontSize="11" Foreground="{StaticResource BrushTextMuted}"/>
                        </StackPanel>
                    </Border>

                    <!-- 7. Operating System & Power -->
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock Text="Operating System &amp; Power" FontSize="13.5" FontWeight="SemiBold" 
                                       Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding Os.FullOsTitle}" FontSize="12.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding Os.MotherboardDisplay, Mode=OneWay}" FontSize="11" Foreground="{StaticResource BrushTextMuted}"
                                       Visibility="{Binding Os.HasMotherboardInfo, Converter={StaticResource BoolToVis}}" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding Os.UptimeDisplay, Mode=OneWay}" FontSize="11" Foreground="{StaticResource BrushTextMuted}"
                                       Visibility="{Binding Os.HasUptimeInfo, Converter={StaticResource BoolToVis}}" Margin="0,0,0,2"/>
                            <DockPanel Margin="0,0,0,2">
                                <TextBlock FontSize="11" Foreground="{StaticResource BrushTextMuted}">
                                    <Run Text="{Binding Os.ActivePowerPlan, Mode=OneWay, StringFormat='Power Plan: {0} • '}"/>
                                    <Run Text="{Binding Power.StatusText, Mode=OneWay, StringFormat='Power Status: {0}'}"/>
                                </TextBlock>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    </StackPanel>

                    <!-- 8. Windows Gaming Utilities -->
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <DockPanel LastChildFill="True" Margin="0,0,0,4">
                                <TextBlock Text="Windows Gaming Utilities" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Text="Quick access to native Windows diagnostic and hardware management tools." 
                                       FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <WrapPanel>
                                <Button Content="Task Manager" Command="{Binding OpenTaskManagerCommand}" 
                                        Style="{StaticResource ModernOutlineButton}" Margin="0,0,8,6" Padding="10,4"/>
                                <Button Content="Graphics Settings" Command="{Binding OpenGraphicsSettingsCommand}" 
                                        Style="{StaticResource ModernOutlineButton}" Margin="0,0,8,6" Padding="10,4"/>
                                <Button Content="Device Manager" Command="{Binding OpenDeviceManagerCommand}" 
                                        Style="{StaticResource ModernOutlineButton}" Margin="0,0,8,6" Padding="10,4"/>
                                <Button Content="DirectX Diagnostic (DxDiag)" Command="{Binding OpenDxDiagCommand}" 
                                        Style="{StaticResource ModernOutlineButton}" Margin="0,0,8,6" Padding="10,4"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- ========================================================== -->
                <!-- CATEGORY 2: PERFORMANCE TWEAKS                             -->
                <!-- ========================================================== -->
                <StackPanel Visibility="{Binding ShowTweaksSection, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                    <!-- Section Header (shown in All view) -->
                    <Border Margin="0,2,0,8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAllTab}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="12.5" 
                                       Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="PERFORMANCE TWEAKS &amp; OPTIMIZATIONS" FontSize="11.5" FontWeight="SemiBold" 
                                       Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Preset & Optimization Overview Card -->
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <DockPanel LastChildFill="True" Margin="0,0,0,8">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Apply Performance Preset" Command="{Binding ApplyRecommendedPresetCommand}"
                                            IsEnabled="{Binding CanRunBulkAction}"
                                            Style="{StaticResource ModernAccentButton}" Margin="0,0,6,0" Padding="12,5"/>
                                    <Button Content="Reset Defaults" Command="{Binding ResetDefaultsCommand}"
                                            IsEnabled="{Binding CanRunBulkAction}"
                                            Style="{StaticResource ModernOutlineButton}" Margin="0,0,6,0" Padding="10,5"/>
                                    <Button Content="Refresh" Command="{Binding RefreshTweaksCommand}"
                                            IsEnabled="{Binding CanRunBulkAction}"
                                            Style="{StaticResource ModernOutlineButton}" Padding="10,5"/>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Performance Optimization Status" FontSize="13.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                        <!-- The badge is a link: it opens the setting it reports instead of only
                                             pointing at it in a tooltip. -->
                                        <Button Command="{Binding DataContext.OpenPerformanceSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Background="{Binding RestorePointBadgeColor}" BorderThickness="0" Padding="6,1.5" Margin="8,0,0,0"
                                                VerticalAlignment="Center" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <TextBlock Text="{Binding RestorePointBadgeText}" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"/>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock Text="{Binding TweaksOptimizationScoreDisplay}" FontSize="12"
                                               Foreground="{StaticResource BrushAccentHover}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DockPanel>

                            <Border Background="#16161B" CornerRadius="6" Padding="8" Margin="0,4,0,0">
                                <StackPanel>
                                    <DockPanel LastChildFill="False">
                                        <TextBlock Text="&#xE82F;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="#CCA84E"
                                                   VerticalAlignment="Center" Margin="0,0,7,0" DockPanel.Dock="Left"/>
                                        <TextBlock Text="Documented Windows settings only - no registry cleaners. What the badges on each tweak mean:"
                                                   Foreground="#CCA84E" FontSize="10.5" TextWrapping="Wrap" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                        <Button Style="{StaticResource HelpLinkButton}" Content="How tweaks work" Margin="12,0,0,0"
                                                VerticalAlignment="Center" DockPanel.Dock="Right"
                                                Command="{x:Static services:HelpCommands.ShowTopic}" CommandParameter="tweaks/overview"/>
                                    </DockPanel>
                                    <!-- Badge legend. The samples reuse the exact badge styles from the tweak rows
                                         so they read as the same thing; there are no hover tooltips anywhere in
                                         the app, so this is where the badges are defined. -->
                                    <WrapPanel Margin="18,6,0,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,2,20,2">
                                            <Border Background="#2A2A3A" CornerRadius="3" Padding="6,1.5" VerticalAlignment="Center">
                                                <TextBlock Text="OPT-IN" FontSize="9" FontWeight="Bold" Foreground="#B8B8CC"/>
                                            </Border>
                                            <TextBlock Text="off by default: a trade-off, not a sure win - read Learn more first"
                                                       FontSize="10.5" Foreground="{StaticResource BrushTextSecondary}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,20,2">
                                            <Border Background="#3D2F14" CornerRadius="3" Padding="6,1.5" VerticalAlignment="Center">
                                                <TextBlock Text="⟳ RESTART" FontSize="9" FontWeight="Bold" Foreground="#E8B84E"/>
                                            </Border>
                                            <TextBlock Text="takes effect after Windows restarts"
                                                       FontSize="10.5" Foreground="{StaticResource BrushTextSecondary}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,20,2">
                                            <Border Background="#2B2340" CornerRadius="3" Padding="6,1.5" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xEA18;" FontFamily="{StaticResource IconFont}" FontSize="9" Foreground="#B9A6F0" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                    <TextBlock Text="ADMIN" FontSize="9" FontWeight="Bold" Foreground="#B9A6F0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Text="needs TrayTrigger run as administrator"
                                                       FontSize="10.5" Foreground="{StaticResource BrushTextSecondary}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,20,2">
                                            <Border Background="#238636" CornerRadius="3" Padding="6,1.5" VerticalAlignment="Center">
                                                <TextBlock Text="RESTORE POINT" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"/>
                                            </Border>
                                            <TextBlock Text="whether a Windows restore point is created before a tweak applies - click the badge above to change it"
                                                       FontSize="10.5" Foreground="{StaticResource BrushTextSecondary}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 1. Input & Display Latency -->
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock Text="Input &amp; Display Latency" FontSize="13.5" FontWeight="SemiBold" 
                                       Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,2"/>
                            <TextBlock Text="How Windows presents games and reads the mouse: GPU scheduling, flip-model and VRR for windowed games, Auto HDR, pointer precision, and the accessibility shortcuts that steal focus mid-game."
                                       FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <ItemsControl ItemsSource="{Binding InputAndDisplayTweaks}" ItemTemplate="{StaticResource TweakItemTemplate}"/>
                        </StackPanel>
                    </Border>

                    <!-- 2. CPU & Thread Scheduling Priority -->
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock Text="CPU &amp; Scheduling Priority" FontSize="13.5" FontWeight="SemiBold" 
                                       Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,2"/>
                            <TextBlock Text="How much CPU the game gets: Game Mode, the system timer, foreground scheduling, the always-on power plan, and desktop effects the compositor pays for."
                                       FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <ItemsControl ItemsSource="{Binding CpuAndPowerTweaks}" ItemTemplate="{StaticResource TweakItemTemplate}"/>
                        </StackPanel>
                    </Border>

                    <!-- 3. Network & Background Telemetry -->
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock Text="Network &amp; Background Telemetry" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,2"/>
                            <TextBlock Text="What runs behind the game: network packet throttling and Nagle, update seeding, Game Bar capture and overlay, telemetry sweeps, and driver replacement by Windows Update."
                                       FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <ItemsControl ItemsSource="{Binding NetworkAndBackgroundTweaks}" ItemTemplate="{StaticResource TweakItemTemplate}"/>
                        </StackPanel>
                    </Border>

                    <!-- 4. Security & System Virtualization -->
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock Text="Security &amp; Virtualization (HVCI)" FontSize="13.5" FontWeight="SemiBold" 
                                       Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,2"/>
                            <TextBlock Text="Status only. Memory Integrity is a real security boundary with a documented cost in some games - the switch stays in Windows Security."
                                       FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <ItemsControl ItemsSource="{Binding SecurityAndAdvancedTweaks}" ItemTemplate="{StaticResource TweakItemTemplate}"/>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- ========================================================== -->
                <!-- CATEGORY 3: PERFORMANCE PROFILES                          -->
                <!-- ========================================================== -->
                <StackPanel Visibility="{Binding ShowGameProfilesSection, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                    <!-- Section Header (shown in All view) -->
                    <Border Margin="0,2,0,8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAllTab}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="12.5"
                                       Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="GAME-LEVEL PERFORMANCE PROFILES" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock Text="Game-Level Performance Profiles" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,2"/>
                            <TextBlock Text="Assigned per game in Edit Game. Applied at launch, reverted at exit. Changing a tweak here affects every game on that profile."
                                       FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,4" TextWrapping="Wrap"/>
                            <Button Style="{StaticResource HelpLinkButton}" Content="How profiles work"
                                    Command="{x:Static services:HelpCommands.ShowTopic}" CommandParameter="profiles/overview"/>
                        </StackPanel>
                    </Border>

                    <!-- Optimized Profile -->
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock Text="Optimized" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,2"/>
                            <TextBlock Text="Balanced tweaks that are safe to apply to any game."
                                       FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <ItemsControl ItemsSource="{Binding OptimizedProfileTweaks}" ItemTemplate="{StaticResource ProfileTweakToggleTemplate}"/>
                        </StackPanel>
                    </Border>

                    <!-- Aggressive Profile -->
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock Text="Aggressive" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,2"/>
                            <TextBlock Text="Always applies every Optimized tweak above too - only the additional tweaks it adds on top are listed here."
                                       FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <ItemsControl ItemsSource="{Binding AggressiveProfileTweaks}" ItemTemplate="{StaticResource ProfileTweakToggleTemplate}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Floating Non-Blocking Busy Toast (shown while Apply Preset / Reset Defaults runs) -->
        <Border Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18"
                Background="#24242E" BorderBrush="{StaticResource BrushAccent}" BorderThickness="1.5"
                CornerRadius="8" Padding="16,10" Panel.ZIndex="100">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.5" Color="#000000"/>
            </Border.Effect>
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsApplyingTweaks}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="14" Height="14" Margin="0,0,10,0" VerticalAlignment="Center">
                    <Border.RenderTransform>
                        <RotateTransform CenterX="7" CenterY="7"/>
                    </Border.RenderTransform>
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Border.Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="(Border.RenderTransform).(RotateTransform.Angle)"
                                                     From="0" To="360" Duration="0:0:0.9"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>
                    <Path Data="M7,0 A7,7 0 0 1 14,7" Stroke="{StaticResource BrushAccentHover}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Border>
                <TextBlock Text="{Binding BusyToastMessage}" Foreground="{StaticResource BrushTextPrimary}"
                           FontSize="13" FontFamily="{StaticResource AppFont}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 4. STATUS BAR -->
        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusMessage}" FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" 
                       FontFamily="{StaticResource AppFont}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="Low-risk gaming optimizations" FontSize="11" Foreground="{StaticResource BrushTextMuted}"/>
            </StackPanel>
        </DockPanel>

    </Grid>
</UserControl>
