<UserControl x:Class="TrayTrigger.Views.SystemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TrayTrigger.ViewModels"
             xmlns:services="clr-namespace:TrayTrigger.Services"
             xmlns:views="clr-namespace:TrayTrigger.Views"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1100"
             Background="Transparent">

    <UserControl.Resources>
        <!-- Standard Settings-Style Card -->
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}"/>
            <Setter Property="Padding" Value="{StaticResource CardPadding}"/>
            <Setter Property="Margin" Value="{StaticResource CardGap}"/>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- One tweak row: its name, a tag only for what the switch can't say (NOT APPLIED, N/A, or ON/OFF on a
             status-only row), the description with Learn more at its end, what applying it asks of you as a quiet
             line, and at the right any extra button and the on/off switch. Which set it belongs to (preset or
             opt-in) is the sub-heading it sits under. -->
        <DataTemplate x:Key="TweakItemTemplate" DataType="{x:Type vm:SystemTweakViewModel}">
            <Border BorderBrush="{DynamicResource BrushSurfaceHover}" BorderThickness="0,0,0,1" Padding="0,6,0,10" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource StrongText}" Text="{Binding Name}"
                                       AutomationProperties.Name="{Binding AccessibleStatus}" VerticalAlignment="Center"/>
                            <Border Background="{Binding StatusBadgeColor}" CornerRadius="{DynamicResource RadiusSmall}" Padding="6,1.5" Margin="8,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding ShowStatusBadge, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource BadgeText}" Text="{Binding StatusBadgeText}" Foreground="{Binding StatusBadgeForeground}"/>
                            </Border>
                        </StackPanel>
                        <!-- The "why" and trade-offs live in Help/tweaks/<id>.md, opened by the link at the end. -->
                        <TextBlock FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}"
                                   Margin="0,3,0,0" TextWrapping="Wrap">
                            <Run Text="{Binding ShortDescription, Mode=OneWay}"/>
                            <Hyperlink Style="{StaticResource InlineHelpLink}" CommandParameter="{Binding HelpTopicId}"
                                       AutomationProperties.Name="{Binding Name, StringFormat='Learn more about {0}'}">Learn more</Hyperlink>
                        </TextBlock>
                        <TextBlock Text="{Binding RequirementsText}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}"
                                   Margin="0,3,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding HasRequirements, Converter={StaticResource BoolToVis}}"
                                   ToolTip="Administrator permission: it writes a machine-wide value, so Windows asks first. Restart: Windows only picks up the new value after one."/>
                        <TextBlock Text="{Binding UnavailableReason}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushWarning}"
                                   Margin="0,3,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding ShowUnavailableReason, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{Binding CustomActionLabel}" Command="{Binding CustomActionCommand}"
                                Visibility="{Binding HasCustomAction, Converter={StaticResource BoolToVis}}"
                                Style="{StaticResource ModernOutlineButton}" Margin="0,0,6,0" Padding="10,4" FontSize="{DynamicResource FontSizeBody}">
                            <AutomationProperties.Name>
                                <MultiBinding StringFormat="{}{0}: {1}">
                                    <Binding Path="CustomActionLabel"/>
                                    <Binding Path="AccessibleStatus"/>
                                </MultiBinding>
                            </AutomationProperties.Name>
                        </Button>
                        <!-- The switch is the row's state: on = TrayTrigger's value, off = what it found. -->
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding SwitchOn, Mode=TwoWay}" Tag="{Binding SwitchText}"
                                  Visibility="{Binding CanToggle, Converter={StaticResource BoolToVis}}"
                                  IsEnabled="{Binding CanExecuteToggle}" VerticalAlignment="Center" Margin="4,0,0,0"
                                  AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding RequirementsText}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- One Stutter Check row that needs attention: title, badge, what to do, one button. -->
        <DataTemplate x:Key="StutterRowTemplate" DataType="{x:Type vm:StutterCheckRowViewModel}">
            <Border BorderBrush="{DynamicResource BrushSurfaceHover}" BorderThickness="0,1,0,0" Padding="0,8,0,8" Opacity="{Binding RowOpacity}"
                    AutomationProperties.Name="{Binding AccessibleName}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                        <WrapPanel>
                            <TextBlock Style="{StaticResource StrongText}" Text="{Binding Title}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            <Border Background="{Binding BadgeBackground}" CornerRadius="{DynamicResource RadiusSmall}" Padding="6,1.5" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource BadgeText}" Text="{Binding BadgeText}" Foreground="{Binding BadgeForeground}"/>
                            </Border>
                        </WrapPanel>
                        <TextBlock Text="{Binding Detail}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}"
                                   Margin="0,3,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button Content="{Binding ActionLabel}" Command="{Binding ActionCommand}"
                                Visibility="{Binding IsPrimaryAction, Converter={StaticResource BoolToVis}}"
                                Style="{StaticResource ModernAccentButton}" Padding="12,4" FontSize="{DynamicResource FontSizeBody}"/>
                        <Button Content="{Binding ActionLabel}" Command="{Binding ActionCommand}"
                                Visibility="{Binding IsSecondaryAction, Converter={StaticResource BoolToVis}}"
                                Style="{StaticResource ModernOutlineButton}" Padding="10,4" FontSize="{DynamicResource FontSizeBody}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- One profile tweak, laid out as a Performance Tweaks row: its name, the description with Learn more at its
             end, what it asks of you, and at the right the same switch (on = the profile applies it). It edits the
             profile only: nothing changes on the PC until a game on this profile starts. -->
        <DataTemplate x:Key="ProfileTweakToggleTemplate" DataType="{x:Type vm:ProfileTweakToggleViewModel}">
            <Border BorderBrush="{DynamicResource BrushSurfaceHover}" BorderThickness="0,0,0,1" Padding="0,6,0,10" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource StrongText}" Text="{Binding Name}"
                                   AutomationProperties.Name="{Binding AccessibleStatus}"/>
                        <TextBlock FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}"
                                   Margin="0,3,0,0" TextWrapping="Wrap">
                            <Run Text="{Binding ShortDescription, Mode=OneWay}"/>
                            <Hyperlink Style="{StaticResource InlineHelpLink}" CommandParameter="{Binding HelpTopicId}"
                                       AutomationProperties.Name="{Binding Name, StringFormat='Learn more about {0}'}">Learn more</Hyperlink>
                        </TextBlock>
                        <TextBlock Text="{Binding RequirementsText}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}"
                                   Margin="0,3,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding HasRequirements, Converter={StaticResource BoolToVis}}"
                                   ToolTip="It writes a machine-wide value, so Windows asks for administrator permission when the game starts and when it closes."/>
                        <TextBlock Text="{Binding Note}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushWarning}"
                                   Margin="0,3,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsEnabled, Mode=TwoWay}" Tag="{Binding SwitchText}"
                              VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding RequirementsText}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Category Tabs -->
            <RowDefinition Height="*"/>    <!-- Main Content -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- 1. HEADER -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <!-- Right: Live Telemetry Indicator - only where the live readings are (Hardware Specs) -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="{Binding ShowSpecsSection, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeBody}"
                           Foreground="{DynamicResource BrushAccentText}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBlock Text="Live Hardware Telemetry" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}"
                           FontFamily="{DynamicResource AppFont}" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Left: Title & Subtitle matching Settings -->
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="System &amp; Performance" FontSize="{DynamicResource FontSizeHeading}" Foreground="{DynamicResource BrushTextPrimary}" 
                           FontFamily="{DynamicResource AppFont}" FontWeight="Normal"/>
                <TextBlock Text="Hardware specs, always-on performance tweaks, and per-game performance profiles"
                           FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}" 
                           FontFamily="{DynamicResource AppFont}" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- 2. CATEGORY SEGMENTED TABS, with the card search beside them -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{DynamicResource BrushDialogCard}" BorderBrush="{DynamicResource BrushBorder}" 
                BorderThickness="1" CornerRadius="{DynamicResource RadiusControl}" Padding="3" Height="{StaticResource TabStripHeight}" HorizontalAlignment="Left" VerticalAlignment="Center"
                views:ScrollToTop.Target="{Binding ElementName=ContentScroll}">
            <StackPanel Orientation="Horizontal">
                <Button Content="Hardware Specs" Command="{Binding SelectSpecsTabCommand}"
                        Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsSpecsTab}"/>
                <Button Content="Stutter Check" Command="{Binding SelectStutterTabCommand}" Margin="2,0,0,0"
                        Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsStutterTab}"/>
                <Button Content="Performance Tweaks" Command="{Binding SelectTweaksTabCommand}" Margin="2,0,0,0"
                        Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsTweaksTab}"/>
                <Button Content="Performance Profiles" Command="{Binding SelectGameProfilesTabCommand}" Margin="2,0,0,0"
                        Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsGameProfilesTab}"/>
            </StackPanel>
        </Border>
        <!-- Card search (Views/CardSearch, Views/SearchBox), as on Settings and About: a dropdown of matching
             cards from every tab, and the text stays as you switch tabs (SystemViewModel.SystemSearchText). -->
        <views:SearchBox x:Name="SystemSearchBox" Grid.Column="1" HorizontalAlignment="Left" Margin="12,0,0,0"
                         Text="{Binding SystemSearchText}" Placeholder="Search system..." ResultsHost="{Binding ElementName=SystemCardsPanel}"
                         NoResultsHint="Search everything (Ctrl+K) looks in every page."/>
        </Grid>

        <!-- 3. CONTENT AREA -->
        <ScrollViewer x:Name="ContentScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,14"
                      views:ScrollToTop.ResetOn="{Binding CurrentSubSection}">
            <StackPanel x:Name="SystemCardsPanel" HorizontalAlignment="Stretch" Margin="0,0,12,0"
                        views:CardSearch.Query="{Binding SystemSearchText}"
                        views:CardSearch.GoTo="{Binding GoToSystemTabCommand}"
                        views:CardSearch.Scope="{Binding SearchScope}">

                <!-- ========================================================== -->
                <!-- CATEGORY 1: HARDWARE SPECS                                 -->
                <!-- ========================================================== -->
                <!-- Hardware Specs: live readings in tiles across the top, then the spec cards two to a row (one to a row in a
                     narrow window), Storage and the Windows tools across the whole width. SpecGridPanel lays it out; the
                     cards stay its direct children, so the card search still sees each one. -->
                <views:SpecGridPanel Visibility="{Binding ShowSpecsSection, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12"
                            views:CardSearch.Tab="{x:Static vm:SystemSubSection.HardwareSpecs}" views:CardSearch.TabLabel="Hardware Specs">
                    <!-- Section header, on every tab: the section's own Refresh lives at its right end. -->
                    <Border Margin="0,2,0,8" views:CardSearch.IsHeader="True" views:SpecGridPanel.IsWide="True">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Style="{StaticResource HelpLinkButton}" Content="&#x21BB; Refresh"
                                    Command="{Binding RefreshSpecsCommand}" IsEnabled="{Binding CanRefreshSpecs}"
                                    AutomationProperties.Name="Refresh hardware specs" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE770;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeBody}"
                                           Foreground="{DynamicResource BrushAccentText}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="HARDWARE SPECS" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SpecsRefreshedDisplay, StringFormat='·  {0}'}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}"
                                           VerticalAlignment="Center" Margin="8,0,0,0"
                                           Visibility="{Binding HasSpecs, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Loading placeholder: shown instead of the spec cards, which would otherwise
                         paint "Unknown GPU / 0 GB / 0 x 0 @ 0Hz" for the first second or two. Marked as a
                         header so the card search skips it: it has nothing to find. -->
                    <Border Style="{StaticResource SettingsCard}" Visibility="{Binding IsLoadingSpecs, Converter={StaticResource BoolToVis}}"
                            views:CardSearch.IsHeader="True" views:SpecGridPanel.IsWide="True">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeSubhead}"
                                       Foreground="{DynamicResource BrushAccentText}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Detecting hardware..." FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>


                    <!-- The live readings, together where they're easy to compare: the first GPU's load, the CPU's, memory in
                         use and ping. The cards below hold the details. Not a search result: the cards say the same. -->
                    <Grid Visibility="{Binding IsSpecsLoaded, Converter={StaticResource BoolToVis}}" Margin="{StaticResource CardGap}"
                          views:CardSearch.IsHeader="True" views:SpecGridPanel.IsWide="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                                    CornerRadius="{DynamicResource RadiusCard}" Padding="{StaticResource CardPadding}" Margin="0,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="GPU load" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}"/>
                                    <TextBlock Text="{Binding PrimaryGpuCard.LoadDisplay, Mode=OneWay, FallbackValue=–}" FontSize="{DynamicResource FontSizeHeading}" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,2,0,0"/>
                                    <ProgressBar Value="{Binding PrimaryGpuCard.LoadPercent, Mode=OneWay, FallbackValue=0}" Maximum="100" Height="5" Margin="0,6,0,0"
                                                 Background="{DynamicResource BrushDialogCard}" Foreground="{DynamicResource BrushAccent}" BorderThickness="0"/>
                                    <TextBlock Text="{Binding PrimaryGpuCard.Name, Mode=OneWay}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                                    CornerRadius="{DynamicResource RadiusCard}" Padding="{StaticResource CardPadding}" Margin="5,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="CPU load" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}"/>
                                    <TextBlock Text="{Binding Cpu.CurrentUsagePercent, Mode=OneWay, StringFormat='{}{0}%'}" FontSize="{DynamicResource FontSizeHeading}" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,2,0,0"/>
                                    <ProgressBar Value="{Binding Cpu.CurrentUsagePercent, Mode=OneWay}" Maximum="100" Height="5" Margin="0,6,0,0"
                                                 Background="{DynamicResource BrushDialogCard}" Foreground="{DynamicResource BrushAccent}" BorderThickness="0"/>
                                    <TextBlock Text="{Binding Cpu.ModelName, Mode=OneWay}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                                    CornerRadius="{DynamicResource RadiusCard}" Padding="{StaticResource CardPadding}" Margin="5,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="Memory in use" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}"/>
                                    <TextBlock Text="{Binding Ram.UsagePercent, Mode=OneWay, StringFormat='{}{0}%'}" FontSize="{DynamicResource FontSizeHeading}" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,2,0,0"/>
                                    <ProgressBar Value="{Binding Ram.UsagePercent, Mode=OneWay}" Maximum="100" Height="5" Margin="0,6,0,0"
                                                 Background="{DynamicResource BrushDialogCard}" Foreground="{DynamicResource BrushAccent}" BorderThickness="0"/>
                                    <TextBlock FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0">
                                        <Run Text="{Binding Ram.UsedGigabytes, Mode=OneWay, StringFormat='{}{0:0.#}'}"/><Run Text="{Binding Ram.TotalGigabytes, Mode=OneWay, StringFormat=' of {0:0.#} GB'}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="3" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                                    CornerRadius="{DynamicResource RadiusCard}" Padding="{StaticResource CardPadding}" Margin="5,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Ping" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}"/>
                                    <TextBlock Text="{Binding Network.PingDisplay, Mode=OneWay}" FontSize="{DynamicResource FontSizeHeading}" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding Network.ConnectionType, Mode=OneWay}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                    </Grid>

                    <!-- Each spec card carries its own IsSpecsLoaded rule instead of sharing a wrapper
                         panel, so the card search sees them as separate cards. -->

                    <!-- 1. Graphics: every GPU, dedicated first (GpuCardViewModel). A laptop, or a desktop
                         with the processor's own graphics on, has two, and which a game lands on matters.
                         The pill is the live load once the GPU counters have two readings, the VRAM size
                         until then. NVIDIA's driver check asks NVIDIA's site only when clicked; AMD and
                         Intel publish nothing to ask, so theirs opens their driver page. -->
                    <Border Style="{StaticResource SettingsCard}" Visibility="{Binding IsSpecsLoaded, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeSubhead}"
                                           Foreground="{DynamicResource BrushAccentText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Graphics" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding GpuCards}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,12">
                                            <DockPanel LastChildFill="True" Margin="0,0,0,3">
                                                <!-- Each GPU's own load, only with two or more: the tile at the top shows the first. -->
                                                <Grid DockPanel.Dock="Right" VerticalAlignment="Center"
                                                      Visibility="{Binding DataContext.HasSeveralGpus, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVis}}">
                                                    <Border Style="{StaticResource SpecLivePill}"
                                                            Visibility="{Binding IsLive, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding PillText}"/>
                                                    </Border>
                                                    <Border Style="{StaticResource SpecStaticPill}"
                                                            Visibility="{Binding IsNotLive, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding PillText}"/>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Style="{StaticResource CardLabel}" Text="{Binding Name}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <Border Style="{StaticResource SpecStaticPill}" Padding="5,1" Margin="6,0,0,0"
                                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding KindLabel}" FontSize="{DynamicResource FontSizeBadge}"/>
                                                </Border>
                                            </DockPanel>
                                            <TextBlock Text="{Binding DetailLine}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,2" TextWrapping="Wrap"/>
                                            <!-- The checks it passes, with a tick; a failed one is the amber line below instead. -->
                                            <TextBlock FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,2" TextWrapping="Wrap"
                                                       Visibility="{Binding HasPassedChecks, Converter={StaticResource BoolToVis}}">
                                                <Run Text="&#x2713; " Foreground="{DynamicResource BrushSuccessText}"/><Run Text="{Binding PassedChecks, Mode=OneWay}"/>
                                            </TextBlock>
                                            <!-- Fewer PCIe lanes than the card supports: the wrong slot, or one sharing
                                                 its lanes with an M.2 drive. Width only - the speed drops at idle. -->
                                            <TextBlock Text="{Binding PcieWarning}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushWarning}"
                                                       TextWrapping="Wrap" Margin="0,2,0,4"
                                                       Visibility="{Binding IsPcieNarrowed, Converter={StaticResource BoolToVis}}"/>
                                            <!-- Resizable BAR off: a BIOS switch, worth a few percent in games that use it. -->
                                            <TextBlock Text="{Binding ResizableBarWarning}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushWarning}"
                                                       TextWrapping="Wrap" Margin="0,2,0,4"
                                                       Visibility="{Binding IsResizableBarOff, Converter={StaticResource BoolToVis}}"/>
                                            <DockPanel LastChildFill="True">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                                            Visibility="{Binding HasDriverCheck, Converter={StaticResource BoolToVis}}">
                                                    <Button Content="Get Driver" Command="{Binding GetDriverCommand}"
                                                            Visibility="{Binding ShowGetDriver, Converter={StaticResource BoolToVis}}"
                                                            Style="{StaticResource ModernAccentButton}" Padding="10,3" Margin="0,0,6,0"/>
                                                    <Button Content="{Binding CheckButtonText}" Command="{Binding CheckDriverCommand}"
                                                            ToolTip="{Binding CheckButtonToolTip}"
                                                            Style="{StaticResource ModernOutlineButton}" Padding="10,3"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding DriverLine}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}"
                                                           VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding CheckMessage}" FontSize="{DynamicResource FontSizeBody}" TextWrapping="Wrap" Margin="0,5,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasCheckMessage}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding CheckState}" Value="UpToDate">
                                                                <Setter Property="Foreground" Value="{DynamicResource BrushSuccessText}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding CheckState}" Value="NewerAvailable">
                                                                <Setter Property="Foreground" Value="{DynamicResource BrushWarning}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 2. Displays: each screen by the monitor's own name, its mode, HDR, and a warning
                         when it runs below the fastest refresh rate it offers at that resolution - the
                         display's counterpart of the XMP/EXPO note on the memory card. -->
                    <Border Style="{StaticResource SettingsCard}" Visibility="{Binding IsSpecsLoaded, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="&#xE7F8;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeSubhead}"
                                           Foreground="{DynamicResource BrushAccentText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Displays" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Displays}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource CardLabel}" Text="{Binding Title}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding ModeDisplay}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}"
                                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                <Border Style="{StaticResource SpecStaticPill}" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                        Visibility="{Binding HasHdr, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding HdrDisplay}" FontSize="{DynamicResource FontSizeBadge}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding DeviceName}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}" Margin="0,1,0,0"/>
                                            <TextBlock FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" TextWrapping="Wrap"
                                                       Visibility="{Binding IsAtFastestRefresh, Converter={StaticResource BoolToVis}}">
                                                <Run Text="&#x2713; " Foreground="{DynamicResource BrushSuccessText}"/><Run Text="{Binding FastestRefreshNote, Mode=OneWay}"/>
                                            </TextBlock>
                                            <DockPanel Margin="0,4,0,0" LastChildFill="True"
                                                       Visibility="{Binding IsBelowMaxRefresh, Converter={StaticResource BoolToVis}}">
                                                <Button DockPanel.Dock="Right" Content="Display Settings..."
                                                        Command="{Binding DataContext.OpenAdvancedDisplaySettingsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        Style="{StaticResource ModernOutlineButton}" Padding="10,3" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                <TextBlock Text="{Binding RefreshWarning}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushWarning}"
                                                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 3. Processor (CPU) -->
                    <Border Style="{StaticResource SettingsCard}" Visibility="{Binding IsSpecsLoaded, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="&#xE950;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeSubhead}"
                                           Foreground="{DynamicResource BrushAccentText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Processor" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Cpu.ModelName}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}" TextWrapping="Wrap">
                                    <Run Text="{Binding Cpu.PhysicalCores, Mode=OneWay, StringFormat='{}{0} Cores,'}"/>
                                    <Run Text="{Binding Cpu.LogicalProcessors, Mode=OneWay, StringFormat='{}{0} Threads,'}"/>
                                    <Run Text="{Binding Cpu.ClockSpeedDisplay, Mode=OneWay}"/>
                                </TextBlock>
                            </DockPanel>
                            <!-- What Edit Game's CPU Cores choice works from: P/E cores, or which CCD has the 3D V-Cache. -->
                            <TextBlock Text="{Binding CpuCoreLayoutDisplay, Mode=OneWay}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}"
                                       TextWrapping="Wrap" Margin="0,-4,0,2"
                                       Visibility="{Binding HasCpuCoreLayout, Converter={StaticResource BoolToVis}}"/>
                            <Button Style="{StaticResource HelpLinkButton}" Content="About CPU Cores" Margin="0,0,0,8" HorizontalAlignment="Left"
                                    Visibility="{Binding HasCpuCoreLayout, Converter={StaticResource BoolToVis}}"
                                    Command="{x:Static services:HelpCommands.ShowTopic}" CommandParameter="profiles/cpu_affinity"/>
                        </StackPanel>
                    </Border>

                    <!-- 4. System Memory (RAM) -->
                    <Border Style="{StaticResource SettingsCard}" Visibility="{Binding IsSpecsLoaded, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="&#xE964;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeSubhead}"
                                           Foreground="{DynamicResource BrushAccentText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Memory" VerticalAlignment="Center"/>
                            </StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap">
                                    <Run Text="{Binding Ram.UsedGigabytes, Mode=OneWay, StringFormat='{}{0:0.#} GB in use'}"/>
                                    <Run Text="{Binding Ram.AvailableGigabytes, Mode=OneWay, StringFormat='({0:0.#} GB free of'}"/>
                                    <Run Text="{Binding Ram.TotalGigabytes, Mode=OneWay, StringFormat='{}{0:0.#} GB)'}"/>
                                </TextBlock>
                            </DockPanel>
                            <TextBlock Text="{Binding Ram.SpeedDisplay, Mode=OneWay}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}"
                                       Visibility="{Binding Ram.HasSpeedInfo, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8"/>
                        </StackPanel>
                    </Border>

                    <!-- 5. Storage, across the whole width: its per-drive bars need the room. -->
                    <Border Style="{StaticResource SettingsCard}" Visibility="{Binding IsSpecsLoaded, Converter={StaticResource BoolToVis}}"
                            views:SpecGridPanel.IsWide="True">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="&#xEDA2;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeSubhead}"
                                           Foreground="{DynamicResource BrushAccentText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Storage" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Drives}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,8">
                                            <DockPanel LastChildFill="True" Margin="0,0,0,4">
                                                <TextBlock HorizontalAlignment="Right" DockPanel.Dock="Right" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}">
                                                    <Run Text="{Binding FreeGigabytes, Mode=OneWay, StringFormat='{}{0:0.#} GB free'}"/>
                                                    <Run Text="{Binding TotalGigabytes, Mode=OneWay, StringFormat=' of {0:0.#} GB'}"/>
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource StrongText}" Text="{Binding DisplayName}" DockPanel.Dock="Left"/>
                                                <Border Style="{StaticResource SpecStaticPill}" Padding="5,1" Margin="6,0,0,0"
                                                        HorizontalAlignment="Left" DockPanel.Dock="Left"
                                                        Visibility="{Binding HasMediaTypeInfo, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding MediaTypeDisplay}" FontSize="{DynamicResource FontSizeBadge}"/>
                                                </Border>
                                                <!-- How many library games are installed here. -->
                                                <TextBlock Text="{Binding GameCountDisplay}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}"
                                                           Margin="8,0,0,0" VerticalAlignment="Center" DockPanel.Dock="Left"
                                                           Visibility="{Binding HasGameCount, Converter={StaticResource BoolToVis}}"/>
                                            </DockPanel>
                                            <ProgressBar Value="{Binding UsagePercent, Mode=OneWay}" Maximum="100" Height="6"
                                                         Background="{DynamicResource BrushDialogCard}" BorderThickness="0">
                                                <ProgressBar.Style>
                                                    <Style TargetType="ProgressBar">
                                                        <Setter Property="Foreground" Value="{DynamicResource BrushAccent}"/>
                                                        <Style.Triggers>
                                                            <!-- Over 90% full: warning colour, and it says so to a screen reader. -->
                                                            <DataTrigger Binding="{Binding IsNearlyFull}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource BrushWarning}"/>
                                                                <Setter Property="AutomationProperties.HelpText" Value="Nearly full"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ProgressBar.Style>
                                            </ProgressBar>
                                            <TextBlock Text="{Binding HddGamesNote}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}"
                                                       TextWrapping="Wrap" Margin="0,4,0,0"
                                                       Visibility="{Binding HasGamesOnHdd, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 6. Network & Latency -->
                    <Border Style="{StaticResource SettingsCard}" Visibility="{Binding IsSpecsLoaded, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeSubhead}"
                                           Foreground="{DynamicResource BrushAccentText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Network" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Network.ConnectionType, Mode=OneWay, StringFormat='Connection: {0}'}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding Network.AdapterName, Mode=OneWay, StringFormat='Adapter: {0}'}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}"/>
                        </StackPanel>
                    </Border>

                    <!-- 7. Operating System & Power -->
                    <Border Style="{StaticResource SettingsCard}" Visibility="{Binding IsSpecsLoaded, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="&#xE770;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeSubhead}"
                                           Foreground="{DynamicResource BrushAccentText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Windows &amp; Power" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Os.FullOsTitle}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Os.MotherboardDisplay, Mode=OneWay}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}"
                                       Visibility="{Binding Os.HasMotherboardInfo, Converter={StaticResource BoolToVis}}" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding Os.UptimeDisplay, Mode=OneWay}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}"
                                       Visibility="{Binding Os.HasUptimeInfo, Converter={StaticResource BoolToVis}}" Margin="0,0,0,2"/>
                            <DockPanel Margin="0,0,0,2">
                                <TextBlock FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}" TextWrapping="Wrap">
                                    <Run Text="{Binding Os.ActivePowerPlan, Mode=OneWay, StringFormat='Power Plan: {0} • '}"/>
                                    <Run Text="{Binding Power.StatusText, Mode=OneWay, StringFormat='Power Status: {0}'}"/>
                                </TextBlock>
                            </DockPanel>
                        </StackPanel>
                    </Border>


                    <!-- 8. Windows tools, across the whole width. Hidden with the spec cards while they load: alone under
                         "Detecting hardware..." it read as one more spec. -->
                    <Border Style="{StaticResource SettingsCard}" Visibility="{Binding IsSpecsLoaded, Converter={StaticResource BoolToVis}}"
                            views:SpecGridPanel.IsWide="True">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <TextBlock Text="&#xE90F;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeSubhead}"
                                           Foreground="{DynamicResource BrushAccentText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Windows Tools" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Windows' own diagnostic and hardware tools, one click away."
                                       FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <WrapPanel>
                                <Button Content="Task Manager" Command="{Binding OpenTaskManagerCommand}"
                                        Style="{StaticResource ModernOutlineButton}" Margin="0,0,8,6" Padding="10,4"/>
                                <Button Content="Startup Apps" Command="{Binding OpenStartupAppsCommand}"
                                        Style="{StaticResource ModernOutlineButton}" Margin="0,0,8,6" Padding="10,4"
                                        ToolTip="Opens Settings &gt; Apps &gt; Startup: what starts with Windows."/>
                                <Button Content="Graphics Settings" Command="{Binding OpenGraphicsSettingsCommand}"
                                        Style="{StaticResource ModernOutlineButton}" Margin="0,0,8,6" Padding="10,4"/>
                                <Button Content="Device Manager" Command="{Binding OpenDeviceManagerCommand}"
                                        Style="{StaticResource ModernOutlineButton}" Margin="0,0,8,6" Padding="10,4"/>
                                <Button Content="DirectX Diagnostic (DxDiag)" Command="{Binding OpenDxDiagCommand}"
                                        Style="{StaticResource ModernOutlineButton}" Margin="0,0,8,6" Padding="10,4"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                </views:SpecGridPanel>

                <!-- Stutter Check has its own tab, between Hardware Specs and the tweaks. -->
                <StackPanel Visibility="{Binding ShowStutterSection, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12"
                            views:CardSearch.Tab="{x:Static vm:SystemSubSection.StutterCheck}" views:CardSearch.TabLabel="Stutter Check">
                    <!-- Section header, on every tab, like the others. It only reports, so it says so. -->
                    <Border Margin="0,2,0,8" views:CardSearch.IsHeader="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeBody}"
                                       Foreground="{DynamicResource BrushAccentText}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="STUTTER CHECK" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                            <TextBlock Text="·  Checks this PC, changes nothing" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <!-- Stutter Check: the verdict. It only reports; Fix it applies a tweak from the Performance Tweaks tab. -->
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Top">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Stutter Check"/>
                                    <TextBlock Text="The things stutter threads tell you to check, checked for you: overlays, other apps' use of the GPU, your display, memory and drives, Windows services, and the tweaks that matter for stutter."
                                               FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                                    <Button Content="{Binding StutterRunButtonText}" Command="{Binding RunStutterCheckCommand}"
                                            Style="{StaticResource ModernAccentButton}" Margin="0,0,6,0" Padding="12,5"
                                            AutomationProperties.Name="Run Stutter Check"/>
                                    <Button Content="Copy Results" Command="{Binding CopyStutterResultsCommand}"
                                            Visibility="{Binding HasStutterReport, Converter={StaticResource BoolToVis}}"
                                            Style="{StaticResource ModernOutlineButton}" Padding="10,5"/>
                                </StackPanel>
                            </Grid>

                            <!-- Before the first result: the same ring-and-heading row the result uses, so
                                 the result lands in the same space instead of pushing the cards below down. -->
                            <DockPanel Margin="0,10,0,6" LastChildFill="True"
                                       Visibility="{Binding ShowStutterIntro, Converter={StaticResource BoolToVis}}">
                                <Grid DockPanel.Dock="Left" Width="46" Height="46" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <Ellipse Stroke="{DynamicResource BrushBorderStrong}" StrokeThickness="3" StrokeDashArray="3 2"/>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="&#x2026;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource CardLabel}" Text="{Binding StutterIntroText}"/>
                                    <TextBlock Text="{Binding StutterIntroSubline}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}"
                                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DockPanel>

                            <StackPanel Visibility="{Binding HasStutterReport, Converter={StaticResource BoolToVis}}">
                                <DockPanel Margin="0,10,0,6" LastChildFill="True">
                                    <Grid DockPanel.Dock="Left" Width="46" Height="46" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <Ellipse Stroke="{Binding StutterRingColor}" StrokeThickness="3"/>
                                        <TextBlock Style="{StaticResource StrongText}" Text="{Binding StutterRingText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource StrongText}" Text="{Binding StutterSummary}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding StutterSubline}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}"
                                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding StutterRows}" ItemTemplate="{StaticResource StutterRowTemplate}"/>
                                <!-- The checks that passed, always shown, two columns so twelve of them take six lines. -->
                                <Border BorderBrush="{DynamicResource BrushSurfaceHover}" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,2,0,0"
                                        Visibility="{Binding HasStutterFine, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding StutterFineHeading}" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold" Foreground="{DynamicResource BrushSuccessText}"/>
                                        <ItemsControl ItemsSource="{Binding StutterFineTitles}" Margin="0,4,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="2"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,1,12,1" TextWrapping="Wrap">
                                                        <Run Text="&#x2713; " Foreground="{DynamicResource BrushSuccessText}"/><Run Text="{Binding Mode=OneWay}"/>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Fix it applies a TrayTrigger tweak you can undo on the Performance Tweaks tab. Here's how opens the help page for that app. Results are included in Copy Diagnostic Info."
                                           FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                            <Button Style="{StaticResource HelpLinkButton}" Content="How Stutter Check works" Margin="0,6,0,0" HorizontalAlignment="Left"
                                    Command="{x:Static services:HelpCommands.ShowTopic}" CommandParameter="tweaks/stutter_check"/>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- ========================================================== -->
                <!-- CATEGORY 2: PERFORMANCE TWEAKS                             -->
                <!-- ========================================================== -->
                <StackPanel Visibility="{Binding ShowTweaksSection, Converter={StaticResource BoolToVis}}"
                            views:CardSearch.Tab="{x:Static vm:SystemSubSection.PerformanceTweaks}" views:CardSearch.TabLabel="Performance Tweaks">
                    <!-- Section header, on every tab. Refresh here re-reads every tweak and re-runs Stutter Check. -->
                    <Border Margin="0,2,0,8" views:CardSearch.IsHeader="True">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Style="{StaticResource HelpLinkButton}" Content="&#x21BB; Refresh"
                                    Command="{Binding RunStutterCheckCommand}"
                                    AutomationProperties.Name="Refresh tweaks and re-run Stutter Check" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9E9;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeBody}"
                                           Foreground="{DynamicResource BrushAccentText}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="PERFORMANCE TWEAKS" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                                <TextBlock Text="·  Always on, system-wide" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}"
                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                </StackPanel>

                <StackPanel Visibility="{Binding ShowTweaksSection, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12"
                            views:CardSearch.Tab="{x:Static vm:SystemSubSection.PerformanceTweaks}" views:CardSearch.TabLabel="Performance Tweaks">
                    <!-- Performance Preset: the recommended tweaks below, applied and undone together -->
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <!-- The heading first and the buttons after it, so the card search names the card by its heading. -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Top">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Performance Preset"/>
                                    <TextBlock Text="{Binding PresetLeadText}"
                                               FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                                    <Button Content="Apply Performance Preset" Command="{Binding ApplyRecommendedPresetCommand}"
                                            IsEnabled="{Binding CanRunBulkAction}"
                                            Style="{StaticResource ModernAccentButton}" Margin="0,0,6,0" Padding="12,5"/>
                                    <Button Content="Put Back Preset" Command="{Binding ResetDefaultsCommand}"
                                            IsEnabled="{Binding CanRunBulkAction}"
                                            Style="{StaticResource ModernOutlineButton}" Padding="10,5"/>
                                </StackPanel>
                            </Grid>
                            <DockPanel Margin="0,10,0,6" LastChildFill="True">
                                <Grid DockPanel.Dock="Left" Width="46" Height="46" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <Ellipse Stroke="{Binding PresetRingColor}" StrokeThickness="3"/>
                                    <TextBlock Style="{StaticResource StrongText}" Text="{Binding PresetRingText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource StrongText}" Text="{Binding PresetScoreDisplay}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding PresetNotAppliedLine}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}"
                                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding PresetNotCountedLine}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}"
                                               TextWrapping="Wrap" Margin="0,2,0,0"
                                               Visibility="{Binding HasPresetNotCounted, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- The safety option for the two buttons above, beside them (it was under Settings until 2.0.0). -->
                            <CheckBox Content="Create a System Restore point before Apply Performance Preset or Put Back Preset"
                                      IsChecked="{Binding CreateRestorePointBeforeTweaks}" Margin="0,8,0,0"
                                      Style="{StaticResource ModernCheckBox}" FontSize="{DynamicResource FontSizeBody}"/>
                            <TextBlock Margin="24,3,0,8" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextMuted}" FontSize="{DynamicResource FontSizeBody}">
                                <Run Text="A Windows rollback point in case a bulk change causes problems. Recommended on."/>
                                <Hyperlink Style="{StaticResource InlineHelpLink}" CommandParameter="tweaks/restore_point">About restore points</Hyperlink>
                            </TextBlock>

                            <!-- No legend here on purpose: the switches, the tags (NOT APPLIED, N/A) and the two
                                 sub-headings each group has are defined in the "How tweaks work" help topic this links to. -->
                            <!-- The link follows the sentence it belongs to, like the other cards' Learn more links. -->
                            <views:NoteBar Kind="Tip" Background="{DynamicResource BrushDialogCard}" Margin="0,4,0,0"
                                           Text="System-wide, always on until you put them back. Documented Windows settings only - no registry cleaners.">
                                <views:NoteBar.Link>
                                    <Button Style="{StaticResource HelpLinkButton}" Content="How tweaks work" Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Command="{x:Static services:HelpCommands.ShowTopic}" CommandParameter="tweaks/overview"/>
                                </views:NoteBar.Link>
                            </views:NoteBar>
                        </StackPanel>
                    </Border>

                    <!-- 1. Display & Input -->
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <Border Style="{StaticResource CardHeaderBand}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource CardHeaderIcon}" Text="&#xE7F4;"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource CardHeaderTitle}" Text="Display &amp; Input"/>
                                        <TextBlock Style="{StaticResource CardHeaderDescription}" Text="How Windows presents games and reads the mouse."/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Style="{StaticResource CardHeaderCount}" Text="{Binding InputAndDisplaySummary}"/>
                                </Grid>
                            </Border>
                            <WrapPanel Visibility="{Binding HasInputAndDisplayPreset, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource CardSubLabel}" Text="IN THE PERFORMANCE PRESET"/>
                                <TextBlock Text="·  Apply Performance Preset turns these on" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}" Margin="8,4,0,6"/>
                            </WrapPanel>
                            <ItemsControl ItemsSource="{Binding InputAndDisplayPreset}" ItemTemplate="{StaticResource TweakItemTemplate}"/>
                            <WrapPanel Visibility="{Binding HasInputAndDisplayOptIn, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource CardSubLabel}" Text="OPT-IN"/>
                                <TextBlock Text="·  A real trade-off, so off until you turn it on" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}" Margin="8,4,0,6"/>
                            </WrapPanel>
                            <ItemsControl ItemsSource="{Binding InputAndDisplayOptIn}" ItemTemplate="{StaticResource TweakItemTemplate}"/>
                        </StackPanel>
                    </Border>

                    <!-- 2. CPU & Scheduling Priority -->
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <Border Style="{StaticResource CardHeaderBand}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource CardHeaderIcon}" Text="&#xE950;"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource CardHeaderTitle}" Text="CPU &amp; Scheduling Priority"/>
                                        <TextBlock Style="{StaticResource CardHeaderDescription}" Text="How much CPU the game gets."/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Style="{StaticResource CardHeaderCount}" Text="{Binding CpuAndPowerSummary}"/>
                                </Grid>
                            </Border>
                            <WrapPanel Visibility="{Binding HasCpuAndPowerPreset, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource CardSubLabel}" Text="IN THE PERFORMANCE PRESET"/>
                                <TextBlock Text="·  Apply Performance Preset turns these on" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}" Margin="8,4,0,6"/>
                            </WrapPanel>
                            <ItemsControl ItemsSource="{Binding CpuAndPowerPreset}" ItemTemplate="{StaticResource TweakItemTemplate}"/>
                            <WrapPanel Visibility="{Binding HasCpuAndPowerOptIn, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource CardSubLabel}" Text="OPT-IN"/>
                                <TextBlock Text="·  A real trade-off, so off until you turn it on" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}" Margin="8,4,0,6"/>
                            </WrapPanel>
                            <ItemsControl ItemsSource="{Binding CpuAndPowerOptIn}" ItemTemplate="{StaticResource TweakItemTemplate}"/>
                        </StackPanel>
                    </Border>

                    <!-- 3. Network & Background Activity -->
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <Border Style="{StaticResource CardHeaderBand}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource CardHeaderIcon}" Text="&#xE774;"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource CardHeaderTitle}" Text="Network &amp; Background Activity"/>
                                        <TextBlock Style="{StaticResource CardHeaderDescription}" Text="What runs behind the game."/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Style="{StaticResource CardHeaderCount}" Text="{Binding NetworkAndBackgroundSummary}"/>
                                </Grid>
                            </Border>
                            <WrapPanel Visibility="{Binding HasNetworkAndBackgroundPreset, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource CardSubLabel}" Text="IN THE PERFORMANCE PRESET"/>
                                <TextBlock Text="·  Apply Performance Preset turns these on" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}" Margin="8,4,0,6"/>
                            </WrapPanel>
                            <ItemsControl ItemsSource="{Binding NetworkAndBackgroundPreset}" ItemTemplate="{StaticResource TweakItemTemplate}"/>
                            <WrapPanel Visibility="{Binding HasNetworkAndBackgroundOptIn, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource CardSubLabel}" Text="OPT-IN"/>
                                <TextBlock Text="·  A real trade-off, so off until you turn it on" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}" Margin="8,4,0,6"/>
                            </WrapPanel>
                            <ItemsControl ItemsSource="{Binding NetworkAndBackgroundOptIn}" ItemTemplate="{StaticResource TweakItemTemplate}"/>
                        </StackPanel>
                    </Border>

                    <!-- 4. Security (status only) -->
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <Border Style="{StaticResource CardHeaderBand}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource CardHeaderIcon}" Text="&#xEA18;"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource CardHeaderTitle}" Text="Security (status only)"/>
                                        <TextBlock Style="{StaticResource CardHeaderDescription}" Text="Memory Integrity is a real security boundary with a documented cost in some games - the switch stays in Windows Security."/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <ItemsControl ItemsSource="{Binding SecurityAndAdvancedTweaks}" ItemTemplate="{StaticResource TweakItemTemplate}"/>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- ========================================================== -->
                <!-- CATEGORY 3: PERFORMANCE PROFILES                          -->
                <!-- ========================================================== -->
                <StackPanel Visibility="{Binding ShowGameProfilesSection, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12"
                            views:CardSearch.Tab="{x:Static vm:SystemSubSection.GameProfiles}" views:CardSearch.TabLabel="Performance Profiles">
                    <!-- Section header, on every tab. -->
                    <Border Margin="0,2,0,8" views:CardSearch.IsHeader="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeBody}"
                                       Foreground="{DynamicResource BrushAccentText}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="PERFORMANCE PROFILES" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                            <TextBlock Text="·  Per game, while it runs" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- How profiles apply. No title: the section heading (or on its own, the tab) already
                         says Performance Profiles. -->
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4" TextWrapping="Wrap">
                                <Run Text="Assigned per game in Edit Game. Applied at launch, reverted at exit. Changing a tweak here affects every game on that profile."/>
                                <Hyperlink Style="{StaticResource InlineHelpLink}" CommandParameter="profiles/overview">How profiles work</Hyperlink>
                            </TextBlock>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="New games start on" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextPrimary}"/>
                                    <TextBlock Text="The profile a game gets when it's added to the library. Games already there keep theirs: change one in Edit Game, or several at once from their right-click menu."
                                               FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1" AutomationProperties.Name="Profile for new games"
                                          ItemsSource="{Binding NewGameProfileOptions}" SelectedItem="{Binding NewGameProfile}"
                                          Style="{StaticResource ModernComboBox}" Width="140" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="With its default tweaks, Aggressive asks for administrator permission when each game starts and again when it closes."
                                       Visibility="{Binding NewGameProfileIsAggressive, Converter={StaticResource BoolToVis}}"
                                       FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushWarning}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Optimized Profile -->
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <Border Style="{StaticResource CardHeaderBand}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource CardHeaderIcon}" Text="&#xE7FC;"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource CardHeaderTitle}" Text="Optimized Profile"/>
                                        <TextBlock Style="{StaticResource CardHeaderDescription}" Text="Balanced tweaks that are safe to apply to any game."/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Style="{StaticResource CardHeaderCount}" Text="{Binding OptimizedProfileSummary}"/>
                                </Grid>
                            </Border>
                            <ItemsControl ItemsSource="{Binding OptimizedProfileDefaults}" ItemTemplate="{StaticResource ProfileTweakToggleTemplate}"/>
                            <WrapPanel Visibility="{Binding HasOptimizedProfileOptIns, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource CardSubLabel}" Text="OPT-IN"/>
                                <TextBlock Text="·  A real trade-off, so off until you turn it on" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}" Margin="8,4,0,6"/>
                            </WrapPanel>
                            <ItemsControl ItemsSource="{Binding OptimizedProfileOptIns}" ItemTemplate="{StaticResource ProfileTweakToggleTemplate}"/>
                        </StackPanel>
                    </Border>
                    <!-- Aggressive Profile -->
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <Border Style="{StaticResource CardHeaderBand}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource CardHeaderIcon}" Text="&#xE945;"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource CardHeaderTitle}" Text="Aggressive Profile (adds to Optimized)"/>
                                        <TextBlock Style="{StaticResource CardHeaderDescription}" Text="Everything in Optimized, plus the tweaks below."/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Style="{StaticResource CardHeaderCount}" Text="{Binding AggressiveProfileSummary}"/>
                                </Grid>
                            </Border>
                            <ItemsControl ItemsSource="{Binding AggressiveProfileDefaults}" ItemTemplate="{StaticResource ProfileTweakToggleTemplate}"/>
                            <WrapPanel Visibility="{Binding HasAggressiveProfileOptIns, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource CardSubLabel}" Text="OPT-IN"/>
                                <TextBlock Text="·  A real trade-off, so off until you turn it on" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}" Margin="8,4,0,6"/>
                            </WrapPanel>
                            <ItemsControl ItemsSource="{Binding AggressiveProfileOptIns}" ItemTemplate="{StaticResource ProfileTweakToggleTemplate}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Floating Non-Blocking Busy Toast (shown while Apply Preset / Put Back Preset runs) -->
        <Border Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18"
                Background="{DynamicResource BrushSurfaceHover}" BorderBrush="{DynamicResource BrushAccent}" BorderThickness="1.5"
                CornerRadius="{DynamicResource RadiusCard}" Padding="16,10" Panel.ZIndex="100">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.5" Color="{DynamicResource ColorFloatingShadow}"/>
            </Border.Effect>
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsApplyingTweaks}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="14" Height="14" Margin="0,0,10,0" VerticalAlignment="Center">
                    <Border.RenderTransform>
                        <RotateTransform CenterX="7" CenterY="7"/>
                    </Border.RenderTransform>
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Border.Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="(Border.RenderTransform).(RotateTransform.Angle)"
                                                     From="0" To="360" Duration="0:0:0.9"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>
                    <Path Data="M7,0 A7,7 0 0 1 14,7" Stroke="{DynamicResource BrushAccentHover}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Border>
                <TextBlock Text="{Binding BusyToastMessage}" Foreground="{DynamicResource BrushTextPrimary}"
                           FontSize="{DynamicResource FontSizeBody}" FontFamily="{DynamicResource AppFont}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 4. STATUS BAR -->
        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusMessage}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}" 
                       FontFamily="{DynamicResource AppFont}" VerticalAlignment="Center"/>
        </DockPanel>

    </Grid>
</UserControl>
