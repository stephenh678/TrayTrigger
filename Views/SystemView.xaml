<UserControl x:Class="TrayTrigger.Views.SystemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TrayTrigger.ViewModels"
             xmlns:services="clr-namespace:TrayTrigger.Services"
             xmlns:views="clr-namespace:TrayTrigger.Views"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1100"
             Background="Transparent">

    <UserControl.Resources>
        <!-- Standard Settings-Style Card -->
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BrushSurfaceDark}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorderDark}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Reusable Settings-Style Tweak Row Item Template -->
        <DataTemplate x:Key="TweakItemTemplate" DataType="{x:Type vm:SystemTweakViewModel}">
            <Border BorderBrush="#252530" BorderThickness="0,0,0,1" Padding="0,6,0,10" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" 
                                       AutomationProperties.Name="{Binding AccessibleStatus}"
                                       Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                            <Border Background="{Binding StatusBadgeColor}" CornerRadius="3" Padding="6,1.5" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusBadgeText}" FontSize="9" FontWeight="Bold" Foreground="{Binding StatusBadgeForeground}"/>
                            </Border>
                            <!-- Every row says which set it is in: PRESET or OPT-IN. A muted blue, so it
                                 doesn't compete with the green and amber status badges. -->
                            <Border Background="#1E2A3A" CornerRadius="3" Padding="6,1.5" Margin="6,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVis}}"
                                    ToolTip="Part of the Performance Preset: Apply Performance Preset turns it on, Undo Preset puts it back.">
                                <TextBlock Text="PRESET" FontSize="9" FontWeight="Bold" Foreground="#8FB8E8"/>
                            </Border>
                            <Border Background="#2A2A3A" CornerRadius="3" Padding="6,1.5" Margin="6,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding IsOptIn, Converter={StaticResource BoolToVis}}"
                                    ToolTip="Has a real trade-off, so it stays off until you turn it on yourself.">
                                <TextBlock Text="OPT-IN" FontSize="9" FontWeight="Bold" Foreground="#B8B8CC"/>
                            </Border>
                            <Border Background="#3D2F14" CornerRadius="3" Padding="6,1.5" Margin="6,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding RequiresReboot, Converter={StaticResource BoolToVis}}"
                                    ToolTip="Windows only picks up the new value after a restart.">
                                <TextBlock Text="⟳ RESTART" FontSize="9" FontWeight="Bold" Foreground="#E8B84E"/>
                            </Border>
                            <Border Background="#2B2340" CornerRadius="3" Padding="6,1.5" Margin="6,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolToVis}}"
                                    ToolTip="Writes a machine-wide value, so Windows asks for administrator permission.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEA18;" FontFamily="{StaticResource IconFont}" FontSize="9" Foreground="#B9A6F0" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                    <TextBlock Text="ADMIN" FontSize="9" FontWeight="Bold" Foreground="#B9A6F0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding ShortDescription}" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"
                                   Margin="0,3,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding UnavailableReason}" FontSize="11" Foreground="#E8B84E"
                                   Margin="0,3,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding ShowUnavailableReason, Converter={StaticResource BoolToVis}}"/>
                        <!-- The "why" and trade-offs live in Help/tweaks/<id>.md, opened here. -->
                        <Button Style="{StaticResource HelpLinkButton}" Margin="0,4,0,0"
                                Command="{x:Static services:HelpCommands.ShowTopic}"
                                CommandParameter="{Binding HelpTopicId}"
                                AutomationProperties.Name="{Binding Name, StringFormat='Learn more about {0}'}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{Binding CustomActionLabel}" Command="{Binding CustomActionCommand}"
                                Visibility="{Binding HasCustomAction, Converter={StaticResource BoolToVis}}"
                                Style="{StaticResource ModernOutlineButton}" Margin="0,0,6,0" Padding="10,4" FontSize="11.5">
                            <AutomationProperties.Name>
                                <MultiBinding StringFormat="{}{0}: {1}">
                                    <Binding Path="CustomActionLabel"/>
                                    <Binding Path="AccessibleStatus"/>
                                </MultiBinding>
                            </AutomationProperties.Name>
                        </Button>
                        <Button Content="{Binding ActionButtonText}" Command="{Binding ToggleCommand}"
                                Visibility="{Binding CanToggle, Converter={StaticResource BoolToVis}}"
                                IsEnabled="{Binding CanExecuteToggle}"
                                Style="{StaticResource ModernOutlineButton}" Padding="10,4" FontSize="11.5">
                            <AutomationProperties.Name>
                                <MultiBinding StringFormat="{}{0}: {1}">
                                    <Binding Path="ActionButtonText"/>
                                    <Binding Path="AccessibleStatus"/>
                                </MultiBinding>
                            </AutomationProperties.Name>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- One Stutter Check row that needs attention: title, badge, what to do, one button. -->
        <DataTemplate x:Key="StutterRowTemplate" DataType="{x:Type vm:StutterCheckRowViewModel}">
            <Border BorderBrush="#252530" BorderThickness="0,1,0,0" Padding="0,8,0,8" Opacity="{Binding RowOpacity}"
                    AutomationProperties.Name="{Binding AccessibleName}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                        <WrapPanel>
                            <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                            <Border Background="{Binding BadgeBackground}" CornerRadius="3" Padding="6,1.5" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding BadgeText}" FontSize="9" FontWeight="Bold" Foreground="{Binding BadgeForeground}"/>
                            </Border>
                        </WrapPanel>
                        <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"
                                   Margin="0,3,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button Content="{Binding ActionLabel}" Command="{Binding ActionCommand}"
                                Visibility="{Binding IsPrimaryAction, Converter={StaticResource BoolToVis}}"
                                Style="{StaticResource ModernAccentButton}" Padding="12,4" FontSize="11.5"/>
                        <Button Content="{Binding ActionLabel}" Command="{Binding ActionCommand}"
                                Visibility="{Binding IsSecondaryAction, Converter={StaticResource BoolToVis}}"
                                Style="{StaticResource ModernOutlineButton}" Padding="10,4" FontSize="11.5"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ProfileTweakToggleTemplate" DataType="{x:Type vm:ProfileTweakToggleViewModel}">
            <Border BorderBrush="#252530" BorderThickness="0,0,0,1" Padding="0,6,0,10" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <!-- The longer rationale lives in the Learn more topic. -->
                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                       AutomationProperties.Name="{Binding AccessibleStatus}"
                                       Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                            <Border Background="{Binding StatusBadgeColor}" CornerRadius="3" Padding="6,1.5" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusBadgeText}" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </Border>
                            <Border Background="#2A2A3A" CornerRadius="3" Padding="6,1.5" Margin="6,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding IsOptIn, Converter={StaticResource BoolToVis}}"
                                    ToolTip="Has a real trade-off, so it stays off until you turn it on yourself.">
                                <TextBlock Text="OPT-IN" FontSize="9" FontWeight="Bold" Foreground="#B8B8CC"/>
                            </Border>
                            <Border Background="#2B2340" CornerRadius="3" Padding="6,1.5" Margin="6,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolToVis}}"
                                    ToolTip="Writes a machine-wide value, so Windows asks for administrator permission.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEA18;" FontFamily="{StaticResource IconFont}" FontSize="9" Foreground="#B9A6F0" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                    <TextBlock Text="ADMIN" FontSize="9" FontWeight="Bold" Foreground="#B9A6F0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding ShortDescription}" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"
                                   Margin="0,3,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Note}" FontSize="11" Foreground="#E8B84E"
                                   Margin="0,3,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}"/>
                        <Button Style="{StaticResource HelpLinkButton}" Margin="0,4,0,0"
                                Command="{x:Static services:HelpCommands.ShowTopic}"
                                CommandParameter="{Binding HelpTopicId}"
                                AutomationProperties.Name="{Binding Name, StringFormat='Learn more about {0}'}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="{Binding ActionButtonText}" Command="{Binding ToggleCommand}"
                            Style="{StaticResource ModernOutlineButton}" Padding="10,4" FontSize="11.5" VerticalAlignment="Center">
                            <AutomationProperties.Name>
                                <MultiBinding StringFormat="{}{0}: {1}">
                                    <Binding Path="ActionButtonText"/>
                                    <Binding Path="AccessibleStatus"/>
                                </MultiBinding>
                            </AutomationProperties.Name>
                        </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Category Tabs -->
            <RowDefinition Height="*"/>    <!-- Main Content -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- 1. HEADER -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <!-- Right: Live Telemetry Indicator - only where the live readings are (All, Hardware Specs) -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="{Binding ShowSpecsSection, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="12"
                           Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBlock Text="Live Hardware Telemetry" FontSize="12" Foreground="{StaticResource BrushTextMuted}"
                           FontFamily="{StaticResource AppFont}" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Left: Title & Subtitle matching Settings -->
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="System &amp; Performance" FontSize="20" Foreground="{StaticResource BrushTextPrimary}" 
                           FontFamily="{StaticResource AppFont}" FontWeight="Normal"/>
                <TextBlock Text="Hardware specs, always-on performance tweaks, and per-game performance profiles"
                           FontSize="12" Foreground="{StaticResource BrushTextSecondary}" 
                           FontFamily="{StaticResource AppFont}" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- 2. CATEGORY SEGMENTED TABS, with the card search beside them -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#181820" BorderBrush="{StaticResource BrushBorderDark}" 
                BorderThickness="1" CornerRadius="6" Padding="3" HorizontalAlignment="Left"
                views:ScrollToTop.Target="{Binding ElementName=ContentScroll}">
            <StackPanel Orientation="Horizontal">
                <Button Content="All" Command="{Binding SelectAllTabCommand}"
                        Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsAllTab}"/>
                <Button Content="Hardware Specs" Command="{Binding SelectSpecsTabCommand}" Margin="2,0,0,0"
                        Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsSpecsTab}"/>
                <Button Content="Performance Tweaks" Command="{Binding SelectTweaksTabCommand}" Margin="2,0,0,0"
                        Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsTweaksTab}"/>
                <Button Content="Performance Profiles" Command="{Binding SelectGameProfilesTabCommand}" Margin="2,0,0,0"
                        Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsGameProfilesTab}"/>
            </StackPanel>
        </Border>
        <!-- Card search (Views/CardSearch, Views/SearchBox), as on Settings and About: it searches the
             selected tab and the text stays as you switch tabs (SystemViewModel.SystemSearchText). -->
        <views:SearchBox x:Name="SystemSearchBox" Grid.Column="1" HorizontalAlignment="Left" Margin="12,0,0,0"
                         Text="{Binding SystemSearchText}" Placeholder="Search system..."/>
        </Grid>

        <!-- 3. CONTENT AREA -->
        <ScrollViewer x:Name="ContentScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,14"
                      views:ScrollToTop.ResetOn="{Binding CurrentSubSection}">
            <StackPanel x:Name="SystemCardsPanel" HorizontalAlignment="Stretch" Margin="0,0,12,0"
                        views:CardSearch.Query="{Binding SystemSearchText}"
                        views:CardSearch.Scope="{Binding SearchScope}">

                <!-- ========================================================== -->
                <!-- CATEGORY 1: HARDWARE SPECS                                 -->
                <!-- ========================================================== -->
                <StackPanel Visibility="{Binding ShowSpecsSection, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                    <!-- Section header, on every tab: the section's own Refresh lives at its right end. -->
                    <Border Margin="0,2,0,8" views:CardSearch.IsHeader="True">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Style="{StaticResource HelpLinkButton}" Content="&#x21BB; Refresh"
                                    Command="{Binding RefreshSpecsCommand}" IsEnabled="{Binding CanRefreshSpecs}"
                                    AutomationProperties.Name="Refresh hardware specs" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE770;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="12.5"
                                           Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="HARDWARE SPECS" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SpecsRefreshedDisplay, StringFormat='·  {0}'}" FontSize="12" Foreground="{StaticResource BrushTextMuted}"
                                           VerticalAlignment="Center" Margin="8,0,0,0"
                                           Visibility="{Binding HasSpecs, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Loading placeholder: shown instead of the spec cards, which would otherwise
                         paint "Unknown GPU / 0 GB / 0 x 0 @ 0Hz" for the first second or two. -->
                    <Border Style="{StaticResource SettingsCard}" Visibility="{Binding IsLoadingSpecs, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="14"
                                       Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Detecting hardware…" FontSize="12.5" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Each spec card carries its own IsSpecsLoaded rule instead of sharing a wrapper
                         panel, so the card search sees them as separate cards. -->

                    <!-- 1. Graphics: every GPU, dedicated first (GpuCardViewModel). A laptop, or a desktop
                         with the processor's own graphics on, has two, and which a game lands on matters.
                         The pill is the live load once the GPU counters have two readings, the VRAM size
                         until then. NVIDIA's driver check asks NVIDIA's site only when clicked; AMD and
                         Intel publish nothing to ask, so theirs opens their driver page. -->
                    <Border Style="{StaticResource SettingsCard}" Visibility="{Binding IsSpecsLoaded, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Graphics (GPU)" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding GpuCards}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,12">
                                            <DockPanel LastChildFill="True" Margin="0,0,0,3">
                                                <!-- Live load in the CPU card's live style; the VRAM size, static, until the first reading. -->
                                                <Grid DockPanel.Dock="Right" VerticalAlignment="Center">
                                                    <Border Style="{StaticResource SpecLivePill}"
                                                            Visibility="{Binding IsLive, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding PillText}"/>
                                                    </Border>
                                                    <Border Style="{StaticResource SpecStaticPill}"
                                                            Visibility="{Binding IsNotLive, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding PillText}"/>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <Border Style="{StaticResource SpecStaticPill}" Padding="5,1" Margin="6,0,0,0"
                                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding KindLabel}" FontSize="10"/>
                                                </Border>
                                            </DockPanel>
                                            <TextBlock Text="{Binding DetailLine}" FontSize="12" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,2"/>
                                            <!-- Fewer PCIe lanes than the card supports: the wrong slot, or one sharing
                                                 its lanes with an M.2 drive. Width only - the speed drops at idle. -->
                                            <TextBlock Text="{Binding PcieWarning}" FontSize="11" Foreground="{StaticResource BrushWarning}"
                                                       TextWrapping="Wrap" Margin="0,2,0,4"
                                                       Visibility="{Binding IsPcieNarrowed, Converter={StaticResource BoolToVis}}"/>
                                            <!-- Resizable BAR off: a BIOS switch, worth a few percent in games that use it. -->
                                            <TextBlock Text="{Binding ResizableBarWarning}" FontSize="11" Foreground="{StaticResource BrushWarning}"
                                                       TextWrapping="Wrap" Margin="0,2,0,4"
                                                       Visibility="{Binding IsResizableBarOff, Converter={StaticResource BoolToVis}}"/>
                                            <DockPanel LastChildFill="True">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                                            Visibility="{Binding HasDriverCheck, Converter={StaticResource BoolToVis}}">
                                                    <Button Content="Get Driver" Command="{Binding GetDriverCommand}"
                                                            Visibility="{Binding ShowGetDriver, Converter={StaticResource BoolToVis}}"
                                                            Style="{StaticResource ModernAccentButton}" Padding="10,3" Margin="0,0,6,0"/>
                                                    <Button Content="{Binding CheckButtonText}" Command="{Binding CheckDriverCommand}"
                                                            ToolTip="{Binding CheckButtonToolTip}"
                                                            Style="{StaticResource ModernOutlineButton}" Padding="10,3"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding DriverLine}" FontSize="12" Foreground="{StaticResource BrushTextMuted}"
                                                           VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding CheckMessage}" FontSize="11.5" TextWrapping="Wrap" Margin="0,5,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasCheckMessage}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding CheckState}" Value="UpToDate">
                                                                <Setter Property="Foreground" Value="#7FE08A"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding CheckState}" Value="NewerAvailable">
                                                                <Setter Property="Foreground" Value="{StaticResource BrushWarning}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <ProgressBar Value="{Binding LoadPercent, Mode=OneWay}" Maximum="100" Height="6" Margin="0,8,0,0"
                                                         Background="#16161B" Foreground="{StaticResource BrushAccent}" BorderThickness="0"
                                                         Visibility="{Binding IsLive, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 2. Displays: each screen by the monitor's own name, its mode, HDR, and a warning
                         when it runs below the fastest refresh rate it offers at that resolution - the
                         display's counterpart of the XMP/EXPO note on the memory card. -->
                    <Border Style="{StaticResource SettingsCard}" Visibility="{Binding IsSpecsLoaded, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <DockPanel LastChildFill="True" Margin="0,0,0,6">
                                <Border DockPanel.Dock="Right" Style="{StaticResource SpecStaticPill}">
                                    <TextBlock Text="{Binding PrimaryDisplay.RefreshRateHz, Mode=OneWay, StringFormat='{}{0} Hz'}"/>
                                </Border>
                                <TextBlock Text="Displays &amp; Refresh Rate" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Displays}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding ModeDisplay}" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"
                                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                <Border Style="{StaticResource SpecStaticPill}" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                        Visibility="{Binding HasHdr, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding HdrDisplay}" FontSize="10"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding DeviceName}" FontSize="12" Foreground="{StaticResource BrushTextMuted}" Margin="0,1,0,0"/>
                                            <DockPanel Margin="0,4,0,0" LastChildFill="True"
                                                       Visibility="{Binding IsBelowMaxRefresh, Converter={StaticResource BoolToVis}}">
                                                <Button DockPanel.Dock="Right" Content="Display Settings..."
                                                        Command="{Binding DataContext.OpenAdvancedDisplaySettingsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        Style="{StaticResource ModernOutlineButton}" Padding="10,3" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                <TextBlock Text="{Binding RefreshWarning}" FontSize="11" Foreground="{StaticResource BrushWarning}"
                                                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 3. Processor (CPU) -->
                    <Border Style="{StaticResource SettingsCard}" Visibility="{Binding IsSpecsLoaded, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <DockPanel LastChildFill="True" Margin="0,0,0,4">
                                <Border DockPanel.Dock="Right" Style="{StaticResource SpecLivePill}">
                                    <TextBlock Text="{Binding Cpu.CurrentUsagePercent, Mode=OneWay, StringFormat='Load: {0}%'}"/>
                                </Border>
                                <TextBlock Text="Processor (CPU)" FontSize="13.5" FontWeight="SemiBold" 
                                           Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Text="{Binding Cpu.ModelName}" FontSize="12.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4"/>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock FontSize="12" Foreground="{StaticResource BrushTextMuted}">
                                    <Run Text="{Binding Cpu.PhysicalCores, Mode=OneWay, StringFormat='{}{0} Cores, '}"/>
                                    <Run Text="{Binding Cpu.LogicalProcessors, Mode=OneWay, StringFormat='{}{0} Threads, '}"/>
                                    <Run Text="{Binding Cpu.ClockSpeedDisplay, Mode=OneWay}"/>
                                </TextBlock>
                            </DockPanel>
                            <!-- What Edit Game's CPU Cores choice works from: P/E cores, or which CCD has the 3D V-Cache. -->
                            <TextBlock Text="{Binding CpuCoreLayoutDisplay, Mode=OneWay}" FontSize="12" Foreground="{StaticResource BrushTextMuted}"
                                       TextWrapping="Wrap" Margin="0,-4,0,2"
                                       Visibility="{Binding HasCpuCoreLayout, Converter={StaticResource BoolToVis}}"/>
                            <Button Style="{StaticResource HelpLinkButton}" Content="About CPU Cores" Margin="0,0,0,8" HorizontalAlignment="Left"
                                    Visibility="{Binding HasCpuCoreLayout, Converter={StaticResource BoolToVis}}"
                                    Command="{x:Static services:HelpCommands.ShowTopic}" CommandParameter="profiles/cpu_affinity"/>
                            <ProgressBar Value="{Binding Cpu.CurrentUsagePercent, Mode=OneWay}" Maximum="100" Height="6" 
                                         Background="#16161B" Foreground="{StaticResource BrushAccent}" BorderThickness="0"/>
                        </StackPanel>
                    </Border>

                    <!-- 4. System Memory (RAM) -->
                    <Border Style="{StaticResource SettingsCard}" Visibility="{Binding IsSpecsLoaded, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <DockPanel LastChildFill="True" Margin="0,0,0,4">
                                <Border DockPanel.Dock="Right" Style="{StaticResource SpecLivePill}">
                                    <TextBlock Text="{Binding Ram.UsagePercent, Mode=OneWay, StringFormat='Used: {0}%'}"/>
                                </Border>
                                <TextBlock Text="System Memory (RAM)" FontSize="13.5" FontWeight="SemiBold" 
                                           Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock FontSize="12" Foreground="{StaticResource BrushTextSecondary}">
                                    <Run Text="{Binding Ram.UsedGigabytes, Mode=OneWay, StringFormat='{}{0:0.#} GB in use'}"/>
                                    <Run Text="{Binding Ram.AvailableGigabytes, Mode=OneWay, StringFormat=' ({0:0.#} GB free of '}"/>
                                    <Run Text="{Binding Ram.TotalGigabytes, Mode=OneWay, StringFormat='{}{0:0.#} GB)'}"/>
                                </TextBlock>
                            </DockPanel>
                            <TextBlock Text="{Binding Ram.SpeedDisplay, Mode=OneWay}" FontSize="12" Foreground="{StaticResource BrushTextMuted}"
                                       Visibility="{Binding Ram.HasSpeedInfo, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8"/>
                            <ProgressBar Value="{Binding Ram.UsagePercent, Mode=OneWay}" Maximum="100" Height="6"
                                         Background="#16161B" Foreground="{StaticResource BrushAccent}" BorderThickness="0"/>
                        </StackPanel>
                    </Border>

                    <!-- 5. Storage & Gaming Drives -->
                    <Border Style="{StaticResource SettingsCard}" Visibility="{Binding IsSpecsLoaded, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Storage &amp; Gaming Drives" FontSize="13.5" FontWeight="SemiBold" 
                                       Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4"/>
                            <TextBlock Text="Fixed drive volumes, available storage capacity, and disk usage." 
                                       FontSize="12" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <ItemsControl ItemsSource="{Binding Drives}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,8">
                                            <DockPanel LastChildFill="True" Margin="0,0,0,4">
                                                <TextBlock HorizontalAlignment="Right" DockPanel.Dock="Right" FontSize="12" Foreground="{StaticResource BrushTextSecondary}">
                                                    <Run Text="{Binding FreeGigabytes, Mode=OneWay, StringFormat='{}{0:0.#} GB free'}"/>
                                                    <Run Text="{Binding TotalGigabytes, Mode=OneWay, StringFormat=' of {0:0.#} GB'}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource BrushTextPrimary}" DockPanel.Dock="Left"/>
                                                <Border Style="{StaticResource SpecStaticPill}" Padding="5,1" Margin="6,0,0,0"
                                                        HorizontalAlignment="Left" DockPanel.Dock="Left"
                                                        Visibility="{Binding HasMediaTypeInfo, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding MediaTypeDisplay}" FontSize="10"/>
                                                </Border>
                                                <!-- How many library games are installed here. -->
                                                <TextBlock Text="{Binding GameCountDisplay}" FontSize="12" Foreground="{StaticResource BrushTextMuted}"
                                                           Margin="8,0,0,0" VerticalAlignment="Center" DockPanel.Dock="Left"
                                                           Visibility="{Binding HasGameCount, Converter={StaticResource BoolToVis}}"/>
                                            </DockPanel>
                                            <ProgressBar Value="{Binding UsagePercent, Mode=OneWay}" Maximum="100" Height="6"
                                                         Background="{StaticResource BrushPillBackground}" BorderThickness="0">
                                                <ProgressBar.Style>
                                                    <Style TargetType="ProgressBar">
                                                        <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
                                                        <Style.Triggers>
                                                            <!-- Over 90% full: warning colour, and it says so to a screen reader. -->
                                                            <DataTrigger Binding="{Binding IsNearlyFull}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource BrushWarning}"/>
                                                                <Setter Property="AutomationProperties.HelpText" Value="Nearly full"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ProgressBar.Style>
                                            </ProgressBar>
                                            <TextBlock Text="{Binding HddGamesNote}" FontSize="12" Foreground="{StaticResource BrushTextMuted}"
                                                       TextWrapping="Wrap" Margin="0,4,0,0"
                                                       Visibility="{Binding HasGamesOnHdd, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 6. Network & Latency -->
                    <Border Style="{StaticResource SettingsCard}" Visibility="{Binding IsSpecsLoaded, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <DockPanel LastChildFill="True" Margin="0,0,0,4">
                                <Border DockPanel.Dock="Right" Style="{StaticResource SpecLivePill}">
                                    <TextBlock Text="{Binding Network.PingDisplay, Mode=OneWay, StringFormat='Ping: {0}'}"/>
                                </Border>
                                <TextBlock Text="Network &amp; Latency" FontSize="13.5" FontWeight="SemiBold" 
                                           Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Text="{Binding Network.ConnectionType, Mode=OneWay, StringFormat='Connection: {0}'}" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding Network.AdapterName, Mode=OneWay, StringFormat='Adapter: {0}'}" FontSize="12" Foreground="{StaticResource BrushTextMuted}"/>
                        </StackPanel>
                    </Border>

                    <!-- 7. Operating System & Power -->
                    <Border Style="{StaticResource SettingsCard}" Visibility="{Binding IsSpecsLoaded, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Operating System &amp; Power" FontSize="13.5" FontWeight="SemiBold" 
                                       Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding Os.FullOsTitle}" FontSize="12.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding Os.MotherboardDisplay, Mode=OneWay}" FontSize="12" Foreground="{StaticResource BrushTextMuted}"
                                       Visibility="{Binding Os.HasMotherboardInfo, Converter={StaticResource BoolToVis}}" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding Os.UptimeDisplay, Mode=OneWay}" FontSize="12" Foreground="{StaticResource BrushTextMuted}"
                                       Visibility="{Binding Os.HasUptimeInfo, Converter={StaticResource BoolToVis}}" Margin="0,0,0,2"/>
                            <DockPanel Margin="0,0,0,2">
                                <TextBlock FontSize="12" Foreground="{StaticResource BrushTextMuted}">
                                    <Run Text="{Binding Os.ActivePowerPlan, Mode=OneWay, StringFormat='Power Plan: {0} • '}"/>
                                    <Run Text="{Binding Power.StatusText, Mode=OneWay, StringFormat='Power Status: {0}'}"/>
                                </TextBlock>
                            </DockPanel>
                        </StackPanel>
                    </Border>


                    <!-- 8. Windows Gaming Utilities. Hidden with the spec cards while they load: alone
                         under the "Detecting hardware…" card it read as one more spec. -->
                    <Border Style="{StaticResource SettingsCard}" Visibility="{Binding IsSpecsLoaded, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <DockPanel LastChildFill="True" Margin="0,0,0,4">
                                <TextBlock Text="Windows Gaming Utilities" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Text="Quick access to native Windows diagnostic and hardware management tools." 
                                       FontSize="12" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <WrapPanel>
                                <Button Content="Task Manager" Command="{Binding OpenTaskManagerCommand}" 
                                        Style="{StaticResource ModernOutlineButton}" Margin="0,0,8,6" Padding="10,4"/>
                                <Button Content="Graphics Settings" Command="{Binding OpenGraphicsSettingsCommand}" 
                                        Style="{StaticResource ModernOutlineButton}" Margin="0,0,8,6" Padding="10,4"/>
                                <Button Content="Device Manager" Command="{Binding OpenDeviceManagerCommand}" 
                                        Style="{StaticResource ModernOutlineButton}" Margin="0,0,8,6" Padding="10,4"/>
                                <Button Content="DirectX Diagnostic (DxDiag)" Command="{Binding OpenDxDiagCommand}" 
                                        Style="{StaticResource ModernOutlineButton}" Margin="0,0,8,6" Padding="10,4"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- ========================================================== -->
                <!-- CATEGORY 2: PERFORMANCE TWEAKS                             -->
                <!-- ========================================================== -->
                <StackPanel Visibility="{Binding ShowTweaksSection, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                    <!-- Section header, on every tab. Refresh here re-reads every tweak and re-runs Stutter Check. -->
                    <Border Margin="0,2,0,8" views:CardSearch.IsHeader="True">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Style="{StaticResource HelpLinkButton}" Content="&#x21BB; Refresh"
                                    Command="{Binding RunStutterCheckCommand}"
                                    AutomationProperties.Name="Refresh tweaks and re-run Stutter Check" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9E9;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="12.5"
                                           Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="PERFORMANCE TWEAKS" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center"/>
                                <TextBlock Text="·  Always on, system-wide" FontSize="12" Foreground="{StaticResource BrushTextMuted}"
                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Stutter Check: the verdict. It only reports; Fix it applies a tweak below. -->
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <DockPanel LastChildFill="True" Margin="0,0,0,4">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                                    <Button Content="{Binding StutterRunButtonText}" Command="{Binding RunStutterCheckCommand}"
                                            Style="{StaticResource ModernAccentButton}" Margin="0,0,6,0" Padding="12,5"
                                            AutomationProperties.Name="Run Stutter Check"/>
                                    <Button Content="Copy Results" Command="{Binding CopyStutterResultsCommand}"
                                            Visibility="{Binding HasStutterReport, Converter={StaticResource BoolToVis}}"
                                            Style="{StaticResource ModernOutlineButton}" Padding="10,5"/>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Top">
                                    <TextBlock Text="Stutter Check" FontSize="13.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushTextPrimary}"/>
                                    <TextBlock Text="The things stutter threads tell you to check, checked for you: overlays, other apps' use of the GPU, your display, memory and drives, Windows services, and the tweaks below that matter for stutter."
                                               FontSize="12" Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- Before the first result: the same ring-and-heading row the result uses, so
                                 the result lands in the same space instead of pushing the cards below down. -->
                            <DockPanel Margin="0,10,0,6" LastChildFill="True"
                                       Visibility="{Binding ShowStutterIntro, Converter={StaticResource BoolToVis}}">
                                <Grid DockPanel.Dock="Left" Width="46" Height="46" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <Ellipse Stroke="{StaticResource BrushBorderLight}" StrokeThickness="3" StrokeDashArray="3 2"/>
                                    <TextBlock Text="&#x2026;" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextMuted}"/>
                                </Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StutterIntroText}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushTextSecondary}"/>
                                    <TextBlock Text="{Binding StutterIntroSubline}" FontSize="12" Foreground="{StaticResource BrushTextMuted}"
                                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DockPanel>

                            <StackPanel Visibility="{Binding HasStutterReport, Converter={StaticResource BoolToVis}}">
                                <DockPanel Margin="0,10,0,6" LastChildFill="True">
                                    <Grid DockPanel.Dock="Left" Width="46" Height="46" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <Ellipse Stroke="{Binding StutterRingColor}" StrokeThickness="3"/>
                                        <TextBlock Text="{Binding StutterRingText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                    </Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StutterSummary}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                                                   Foreground="{StaticResource BrushTextPrimary}"/>
                                        <TextBlock Text="{Binding StutterSubline}" FontSize="12" Foreground="{StaticResource BrushTextMuted}"
                                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding StutterRows}" ItemTemplate="{StaticResource StutterRowTemplate}"/>
                                <!-- The checks that passed, always shown, two columns so twelve of them take six lines. -->
                                <Border BorderBrush="#252530" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,2,0,0"
                                        Visibility="{Binding HasStutterFine, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding StutterFineHeading}" FontSize="11.5" FontWeight="SemiBold" Foreground="#3FB950"/>
                                        <ItemsControl ItemsSource="{Binding StutterFineTitles}" Margin="0,4,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="2"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,1,12,1" TextWrapping="Wrap">
                                                        <Run Text="&#x2713; " Foreground="#3FB950"/><Run Text="{Binding Mode=OneWay}"/>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Fix it applies a TrayTrigger tweak you can undo below. Here's how opens the help page for that app. Results are included in Copy Diagnostic Info."
                                           FontSize="12" Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                            <Button Style="{StaticResource HelpLinkButton}" Content="How Stutter Check works" Margin="0,6,0,0" HorizontalAlignment="Left"
                                    Command="{x:Static services:HelpCommands.ShowTopic}" CommandParameter="tweaks/stutter_check"/>
                        </StackPanel>
                    </Border>

                    <!-- Performance Preset: the recommended tweaks below, applied and undone together -->
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <DockPanel LastChildFill="True" Margin="0,0,0,4">
                                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Top" Margin="12,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Apply Performance Preset" Command="{Binding ApplyRecommendedPresetCommand}"
                                                IsEnabled="{Binding CanRunBulkAction}"
                                                Style="{StaticResource ModernAccentButton}" Margin="0,0,6,0" Padding="12,5"/>
                                        <Button Content="Undo Preset" Command="{Binding ResetDefaultsCommand}"
                                                IsEnabled="{Binding CanRunBulkAction}"
                                                Style="{StaticResource ModernOutlineButton}" Padding="10,5"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Top">
                                    <TextBlock Text="Performance Preset" FontSize="13.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushTextPrimary}"/>
                                    <TextBlock Text="{Binding PresetLeadText}"
                                               FontSize="12" Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Margin="0,10,0,6" LastChildFill="True">
                                <Grid DockPanel.Dock="Left" Width="46" Height="46" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <Ellipse Stroke="{Binding PresetRingColor}" StrokeThickness="3"/>
                                    <TextBlock Text="{Binding PresetRingText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                </Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PresetScoreDisplay}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                                               Foreground="{StaticResource BrushTextPrimary}"/>
                                    <TextBlock Text="{Binding PresetNotAppliedLine}" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"
                                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding PresetNotCountedLine}" FontSize="12" Foreground="{StaticResource BrushTextMuted}"
                                               TextWrapping="Wrap" Margin="0,2,0,0"
                                               Visibility="{Binding HasPresetNotCounted, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- No badge legend here on purpose: the badges (OPTIMAL, OPT-IN, RESTART, ADMIN,
                                 restore point) are defined in the "How tweaks work" help topic this links to. -->
                            <Border Background="#16161B" CornerRadius="6" Padding="8" Margin="0,4,0,0">
                                <!-- The link follows the sentence it belongs to, like the other cards' Learn more links. -->
                                <DockPanel LastChildFill="True">
                                    <TextBlock Text="&#xE82F;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="#CCA84E"
                                               VerticalAlignment="Center" Margin="0,0,7,0" DockPanel.Dock="Left"/>
                                    <WrapPanel VerticalAlignment="Center">
                                        <TextBlock Text="System-wide, always on until you restore them. Documented Windows settings only - no registry cleaners."
                                                   Foreground="#CCA84E" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        <Button Style="{StaticResource HelpLinkButton}" Content="How tweaks work" Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                Command="{x:Static services:HelpCommands.ShowTopic}" CommandParameter="tweaks/overview"/>
                                    </WrapPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 1. Display & Input -->
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock Text="Display &amp; Input" FontSize="15" FontWeight="SemiBold" 
                                       Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding InputAndDisplaySummary}" FontSize="11.5"
                                       Foreground="{StaticResource BrushAccentHover}" Margin="0,0,0,4"/>
                            <TextBlock Text="How Windows presents games and reads the mouse."
                                       FontSize="12" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <ItemsControl ItemsSource="{Binding InputAndDisplayTweaks}" ItemTemplate="{StaticResource TweakItemTemplate}"/>
                        </StackPanel>
                    </Border>

                    <!-- 2. CPU & Scheduling Priority -->
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock Text="CPU &amp; Scheduling Priority" FontSize="15" FontWeight="SemiBold" 
                                       Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding CpuAndPowerSummary}" FontSize="11.5"
                                       Foreground="{StaticResource BrushAccentHover}" Margin="0,0,0,4"/>
                            <TextBlock Text="How much CPU the game gets."
                                       FontSize="12" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <ItemsControl ItemsSource="{Binding CpuAndPowerTweaks}" ItemTemplate="{StaticResource TweakItemTemplate}"/>
                        </StackPanel>
                    </Border>

                    <!-- 3. Network & Background Activity -->
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock Text="Network &amp; Background Activity" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding NetworkAndBackgroundSummary}" FontSize="11.5"
                                       Foreground="{StaticResource BrushAccentHover}" Margin="0,0,0,4"/>
                            <TextBlock Text="What runs behind the game."
                                       FontSize="12" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <ItemsControl ItemsSource="{Binding NetworkAndBackgroundTweaks}" ItemTemplate="{StaticResource TweakItemTemplate}"/>
                        </StackPanel>
                    </Border>

                    <!-- 4. Security (status only) -->
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock Text="Security (status only)" FontSize="15" FontWeight="SemiBold" 
                                       Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,2"/>
                            <TextBlock Text="Memory Integrity is a real security boundary with a documented cost in some games - the switch stays in Windows Security."
                                       FontSize="12" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <ItemsControl ItemsSource="{Binding SecurityAndAdvancedTweaks}" ItemTemplate="{StaticResource TweakItemTemplate}"/>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- ========================================================== -->
                <!-- CATEGORY 3: PERFORMANCE PROFILES                          -->
                <!-- ========================================================== -->
                <StackPanel Visibility="{Binding ShowGameProfilesSection, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                    <!-- Section header, on every tab. -->
                    <Border Margin="0,2,0,8" views:CardSearch.IsHeader="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="12.5"
                                       Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="PERFORMANCE PROFILES" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center"/>
                            <TextBlock Text="·  Per game, while it runs" FontSize="12" Foreground="{StaticResource BrushTextMuted}"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- How profiles apply. No title: the section heading (or on its own, the tab) already
                         says Performance Profiles. -->
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock Text="Assigned per game in Edit Game. Applied at launch, reverted at exit. Changing a tweak here affects every game on that profile."
                                       FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4" TextWrapping="Wrap"/>
                            <Button Style="{StaticResource HelpLinkButton}" Content="How profiles work"
                                    Command="{x:Static services:HelpCommands.ShowTopic}" CommandParameter="profiles/overview"/>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="New games start on" FontSize="12.5" Foreground="{StaticResource BrushTextPrimary}"/>
                                    <TextBlock Text="The profile a game gets when it's added to the library. Games already there keep theirs: change one in Edit Game, or several at once from their right-click menu."
                                               FontSize="12" Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1" AutomationProperties.Name="Profile for new games"
                                          ItemsSource="{Binding NewGameProfileOptions}" SelectedItem="{Binding NewGameProfile}"
                                          Style="{StaticResource ModernComboBox}" Width="140" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="With its default tweaks, Aggressive asks for administrator permission when each game starts and again when it closes."
                                       Visibility="{Binding NewGameProfileIsAggressive, Converter={StaticResource BoolToVis}}"
                                       FontSize="11" Foreground="{StaticResource BrushWarning}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Optimized Profile -->
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock Text="Optimized profile" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding OptimizedProfileSummary}" FontSize="11.5"
                                       Foreground="{StaticResource BrushAccentHover}" Margin="0,0,0,4"/>
                            <TextBlock Text="Balanced tweaks that are safe to apply to any game."
                                       FontSize="12" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <ItemsControl ItemsSource="{Binding OptimizedProfileTweaks}" ItemTemplate="{StaticResource ProfileTweakToggleTemplate}"/>
                        </StackPanel>
                    </Border>

                    <!-- Aggressive Profile -->
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock Text="Aggressive profile (adds to Optimized)" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding AggressiveProfileSummary}" FontSize="11.5"
                                       Foreground="{StaticResource BrushAccentHover}" Margin="0,0,0,4"/>
                            <TextBlock Text="Everything in Optimized, plus the tweaks below."
                                       FontSize="12" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <ItemsControl ItemsSource="{Binding AggressiveProfileTweaks}" ItemTemplate="{StaticResource ProfileTweakToggleTemplate}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Card search found nothing. -->
        <views:SearchNoMatches Grid.Row="2" Host="{Binding ElementName=SystemCardsPanel}"/>

        <!-- Floating Non-Blocking Busy Toast (shown while Apply Preset / Restore Previous Settings runs) -->
        <Border Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18"
                Background="#24242E" BorderBrush="{StaticResource BrushAccent}" BorderThickness="1.5"
                CornerRadius="8" Padding="16,10" Panel.ZIndex="100">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.5" Color="#000000"/>
            </Border.Effect>
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsApplyingTweaks}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="14" Height="14" Margin="0,0,10,0" VerticalAlignment="Center">
                    <Border.RenderTransform>
                        <RotateTransform CenterX="7" CenterY="7"/>
                    </Border.RenderTransform>
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Border.Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="(Border.RenderTransform).(RotateTransform.Angle)"
                                                     From="0" To="360" Duration="0:0:0.9"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>
                    <Path Data="M7,0 A7,7 0 0 1 14,7" Stroke="{StaticResource BrushAccentHover}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Border>
                <TextBlock Text="{Binding BusyToastMessage}" Foreground="{StaticResource BrushTextPrimary}"
                           FontSize="13" FontFamily="{StaticResource AppFont}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 4. STATUS BAR -->
        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" 
                       FontFamily="{StaticResource AppFont}" VerticalAlignment="Center"/>
        </DockPanel>

    </Grid>
</UserControl>
