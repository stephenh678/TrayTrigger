<Window x:Class="TrayTrigger.Views.HelpDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="TrayTrigger Help"
        Width="600" MinWidth="480"
        Height="560" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="{StaticResource BrushDialogBg}"
        Foreground="{StaticResource BrushTextPrimary}"
        FontFamily="{StaticResource AppFont}">

    <Border BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="0,1,0,0">
        <Grid Margin="24,20,24,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Divider -->
                <RowDefinition Height="*"/>    <!-- Scrollable body -->
                <RowDefinition Height="Auto"/> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Header: info badge + title + breadcrumb (same layout as ModernDialog) -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22"
                        Background="#1C2E3D" BorderBrush="{StaticResource BrushBorderAccent}" BorderThickness="1.5"
                        Margin="0,0,16,0" VerticalAlignment="Top">
                    <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="18"
                               Foreground="{StaticResource BrushAccentHover}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="BreadcrumbText" Text="TRAYTRIGGER HELP" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource BrushAccentHover}" Margin="0,0,0,3"/>
                    <TextBlock x:Name="TitleText" Text="Topic" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextPrimary}" TextWrapping="Wrap" LineHeight="20"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Height="1" Background="{StaticResource BrushBorderDark}" Margin="0,0,0,12"/>

            <!-- Body: blocks are added from code-behind so each kind gets the right theme styling -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,14">
                <StackPanel x:Name="BodyPanel" Margin="0,0,10,0"/>
            </ScrollViewer>

            <!-- Footer -->
            <DockPanel Grid.Row="3" LastChildFill="False">
                <TextBlock x:Name="FooterHintText" Text="Esc to close" FontSize="10.5"
                           Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                <Button Content="Close" Style="{StaticResource ModernOutlineButton}" Padding="16,6"
                        DockPanel.Dock="Right" IsCancel="True" Click="OnCloseClick"/>
            </DockPanel>
        </Grid>
    </Border>
</Window>
