<UserControl x:Class="TrayTrigger.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TrayTrigger.ViewModels"
             xmlns:views="clr-namespace:TrayTrigger.Views"
             xmlns:services="clr-namespace:TrayTrigger.Services"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:models="clr-namespace:TrayTrigger.Models"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1100">

    <UserControl.Resources>
        <!-- Batch context menu: shown instead of the game menu when the right-clicked card is one
             of two or more selected cards (Ctrl/Shift+click, Ctrl+A). Its DataContext is set to
             the MainViewModel by LibraryView.OnCardContextMenuOpening; every item applies to the
             whole selection through LibraryViewModel's batch commands. -->
        <ContextMenu x:Key="GameBatchContextMenu">
            <!-- Shared items keep the same order, check marks, and grouping as the single-game
                 menu below, minus everything that only makes sense for one game. Performance
                 Profile is the one addition: a single game reaches it through Edit Game
                 Properties, and there is no batch equivalent of that dialog.

                 DLSS Override goes through each selected game in turn, with the status bar saying
                 which one it is on, as the metadata refresh does: turning it on searches each
                 game's folder first, so it is not instant. -->

            <!-- Scope, first: the items below read the same as the single-game menu's, and only
                 Remove asks before it acts. Without this the other four (category, profile,
                 refresh) fire on the whole selection with nothing on screen saying how big it
                 is. -->
            <MenuItem Header="{Binding SelectionSummary}" Style="{StaticResource MenuSectionHeaderStyle}"/>
            <Separator/>

            <MenuItem Header="{Binding BatchFavoriteLabel}" Command="{Binding BatchFavoriteCommand}"/>
            <MenuItem Header="{Binding BatchHideLabel}" Command="{Binding BatchHideCommand}"/>
            <Separator/>
            <MenuItem Header="Change Category..." Command="{Binding BatchChangeCategoryCommand}"/>
            <!-- All-or-nothing like the toggles below: checked only when every selected game has it,
                 and a click on a mixed selection turns it on for all of them. First in this group, as
                 in the single-game menu. Hidden on a PC with no NVIDIA driver. -->
            <MenuItem Header="DLSS Override" IsCheckable="True" IsChecked="{Binding BatchAllDlssOverrideOn, Mode=OneWay}"
                      Command="{Binding BatchDlssOverrideCommand}"
                      Visibility="{Binding HasNvidiaDriver, Converter={StaticResource BoolToVis}}"
                      ToolTip="Runs each selected game on your GeForce driver's newer DLSS files, one game at a time. Games without DLSS are skipped and named when it's done."/>
            <!-- Same three tiers as Edit Game; the check shows the tier when every selected game
                 shares it, nothing when they differ. -->
            <MenuItem Header="Performance Profile">
                <MenuItem Header="Off" IsCheckable="True" IsChecked="{Binding BatchProfileIsOff, Mode=OneWay}"
                          Command="{Binding BatchSetProfileCommand}" CommandParameter="{x:Static models:PerformanceProfileMode.Off}"/>
                <MenuItem Header="Optimized" IsCheckable="True" IsChecked="{Binding BatchProfileIsOptimized, Mode=OneWay}"
                          Command="{Binding BatchSetProfileCommand}" CommandParameter="{x:Static models:PerformanceProfileMode.Optimized}"/>
                <MenuItem Header="Aggressive" IsCheckable="True" IsChecked="{Binding BatchProfileIsAggressive, Mode=OneWay}"
                          Command="{Binding BatchSetProfileCommand}" CommandParameter="{x:Static models:PerformanceProfileMode.Aggressive}"/>
            </MenuItem>
            <!-- The items are this PC's CPU Cores choices (CpuCoreMenu): P-cores on a hybrid Intel,
                 the V-Cache and frequency CCDs on a dual-CCD X3D, one CCD on another multi-CCD Ryzen.
                 Hidden on a CPU with nothing to choose, where every item would be a no-op. -->
            <MenuItem Header="CPU Cores" Visibility="{Binding CpuCores.IsVisible, Converter={StaticResource BoolToVis}}">
                <MenuItem Header="Auto (Recommended)" IsCheckable="True" IsChecked="{Binding BatchCpuAffinityIsAuto, Mode=OneWay}"
                          Command="{Binding BatchSetCpuAffinityCommand}" CommandParameter="{x:Static models:CpuAffinityMode.Auto}"
                          Visibility="{Binding CpuCores.ShowAuto, Converter={StaticResource BoolToVis}}"/>
                <MenuItem Header="All Cores (Windows default)" IsCheckable="True" IsChecked="{Binding BatchCpuAffinityIsDefault, Mode=OneWay}"
                          Command="{Binding BatchSetCpuAffinityCommand}" CommandParameter="{x:Static models:CpuAffinityMode.Default}"/>
                <MenuItem Header="Performance Cores Only" IsCheckable="True" IsChecked="{Binding BatchCpuAffinityIsPerformanceCores, Mode=OneWay}"
                          Command="{Binding BatchSetCpuAffinityCommand}" CommandParameter="{x:Static models:CpuAffinityMode.PerformanceCoresOnly}"
                          Visibility="{Binding CpuCores.ShowPerformanceCores, Converter={StaticResource BoolToVis}}"/>
                <MenuItem Header="3D V-Cache Cores" IsCheckable="True" IsChecked="{Binding BatchCpuAffinityIsVCache, Mode=OneWay}"
                          Command="{Binding BatchSetCpuAffinityCommand}" CommandParameter="{x:Static models:CpuAffinityMode.VCacheCores}"
                          Visibility="{Binding CpuCores.ShowVCache, Converter={StaticResource BoolToVis}}"/>
                <MenuItem Header="Frequency Cores" IsCheckable="True" IsChecked="{Binding BatchCpuAffinityIsFrequency, Mode=OneWay}"
                          Command="{Binding BatchSetCpuAffinityCommand}" CommandParameter="{x:Static models:CpuAffinityMode.FrequencyCores}"
                          Visibility="{Binding CpuCores.ShowFrequency, Converter={StaticResource BoolToVis}}"/>
                <MenuItem Header="First CCD Only" IsCheckable="True" IsChecked="{Binding BatchCpuAffinityIsOneCcd, Mode=OneWay}"
                          Command="{Binding BatchSetCpuAffinityCommand}" CommandParameter="{x:Static models:CpuAffinityMode.OneCcd}"
                          Visibility="{Binding CpuCores.ShowOneCcd, Converter={StaticResource BoolToVis}}"/>
            </MenuItem>
            <!-- Both are all-or-nothing: the check is on only when every selected game already has
                 it (a mixed selection shows none), and a click turns it on for the whole selection. -->
            <MenuItem Header="Launch Options">
                <MenuItem Header="Run as Administrator" IsCheckable="True" IsChecked="{Binding BatchAllRunAsAdmin, Mode=OneWay}"
                          Command="{Binding BatchRunAsAdminCommand}"/>
                <MenuItem Header="Close Launcher After Game Exits" IsCheckable="True" IsChecked="{Binding BatchAllCloseLauncher, Mode=OneWay}"
                          Command="{Binding BatchCloseLauncherCommand}"/>
            </MenuItem>
            <MenuItem Header="Refresh Poster &amp; Metadata" Command="{Binding BatchRefreshMetadataCommand}"/>
            <Separator/>
            <MenuItem Header="Remove from Library" Command="{Binding BatchRemoveCommand}" Foreground="{DynamicResource BrushDanger}"/>
        </ContextMenu>

        <!-- Reusable Game Context Menu shared across Grid, Icons, and List views -->
        <ContextMenu x:Key="GameItemContextMenu"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <!-- Play first and bold: it is the most frequent action on a game. Details second
                 (it is also the card's left-click), and named for every platform, not just Steam. -->
            <!-- Icons on the first group only, Windows 11 style: the actions a player reaches for
                 most, and the same glyphs the tray menu's Now Playing submenu uses. -->
            <MenuItem Header="Play" Command="{Binding LaunchCommand}" FontWeight="SemiBold">
                <MenuItem.Icon><TextBlock Text="&#xE768;" Style="{StaticResource MenuGlyphIcon}" Foreground="{DynamicResource BrushAccentText}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Game Details..." Command="{Binding ViewDetailsCommand}">
                <MenuItem.Icon><TextBlock Text="&#xE946;" Style="{StaticResource MenuGlyphIcon}"/></MenuItem.Icon>
            </MenuItem>
            <!-- Now Playing: one flyout to the right, as the tray menu's Now Playing row has. Only
                 shown while the game has a session; Suspend's wording follows the game's state. -->
            <MenuItem Header="Now Playing">
                <MenuItem.Icon><TextBlock Text="&#xE768;" Style="{StaticResource MenuGlyphIcon}" Foreground="{DynamicResource BrushAccentText}"/></MenuItem.Icon>
                <MenuItem.Style>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
                <MenuItem Header="{Binding SuspendMenuLabel}" Command="{Binding ToggleSuspendCommand}"
                          ToolTip="Suspend minimizes the game, freezes it where it is and mutes it, and stops its playtime clock until you resume it. Online games disconnect while suspended; games with anti-cheat are never suspended.">
                    <MenuItem.Icon><TextBlock Text="&#xE769;" Style="{StaticResource MenuGlyphIcon}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Close Game" Command="{Binding CloseGameCommand}"
                          ToolTip="Asks the game to quit, as its own close button does. Once it exits, TrayTrigger restores the Performance Profile and runs the post-exit script.">
                    <MenuItem.Icon><TextBlock Text="&#xE7E8;" Style="{StaticResource MenuGlyphIcon}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Restore Settings Now" Command="{Binding RestoreSettingsCommand}"
                          ToolTip="Leaves the game running and puts Windows back the way it was: the Performance Profile is restored, the post-exit script runs and tools set to close after the game close. The game is no longer tracked, so its playtime stops counting.">
                    <MenuItem.Icon><TextBlock Text="&#xE72C;" Style="{StaticResource MenuGlyphIcon}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Force Close Game" Command="{Binding ForceCloseCommand}"
                          ToolTip="Kills the game's process, then ends the session. Anything unsaved in the game is lost.">
                    <MenuItem.Icon><TextBlock Text="&#xE711;" Style="{StaticResource MenuGlyphIcon}" Foreground="{DynamicResource BrushDanger}"/></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="{Binding FavoriteMenuLabel}" Command="{Binding ToggleFavoriteCommand}"/>
            <MenuItem Header="{Binding HideMenuLabel}" Command="{Binding ToggleHiddenCommand}"/>
            <MenuItem Header="Open Containing Folder" Command="{Binding OpenFolderCommand}"/>

            <!-- Broken Game Relocate Option -->
            <MenuItem Header="Locate Executable..." Command="{Binding RelocateCommand}">
                <MenuItem.Style>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>

            <Separator/>

            <!-- Quick settings: the same settings Edit Game Properties holds, in the order that
                 dialog lists them, so the two read alike - DLSS Override is its own card above the
                 Performance card there, and comes first here for the same reason. The point is to
                 flip one without opening the dialog, the way the batch menu already let you flip a
                 whole selection. All four are also in the batch menu, worded identically.

                 DLSS Override is the exception in this group: it writes to the NVIDIA driver
                 rather than a field on the game, so it can fail, it is not instant (switching it on
                 searches the game's folder first), and the status bar narrates it - game by game
                 in the batch menu.
                 Flat rather than cascading because it has two states; the tick reads the game's own
                 ownership records, so it always says what Edit Game > Performance says. Hidden on a
                 PC with no NVIDIA driver, the way CPU Cores is hidden on a uniform CPU. -->
            <MenuItem Header="DLSS Override" IsCheckable="True" IsChecked="{Binding DlssOverrideOn, Mode=OneWay}"
                      Command="{Binding ToggleDlssOverrideCommand}"
                      Visibility="{Binding HasNvidiaDriver, Converter={StaticResource BoolToVis}}"
                      ToolTip="Runs this game on your GeForce driver's newer DLSS files. Nothing in the game folder is touched; unticking puts NVIDIA's settings back."/>
            <MenuItem Header="Performance Profile">
                <MenuItem Header="Off" IsCheckable="True" IsChecked="{Binding ProfileIsOff, Mode=OneWay}"
                          Command="{Binding SetProfileCommand}" CommandParameter="{x:Static models:PerformanceProfileMode.Off}"/>
                <MenuItem Header="Optimized" IsCheckable="True" IsChecked="{Binding ProfileIsOptimized, Mode=OneWay}"
                          Command="{Binding SetProfileCommand}" CommandParameter="{x:Static models:PerformanceProfileMode.Optimized}"/>
                <MenuItem Header="Aggressive" IsCheckable="True" IsChecked="{Binding ProfileIsAggressive, Mode=OneWay}"
                          Command="{Binding SetProfileCommand}" CommandParameter="{x:Static models:PerformanceProfileMode.Aggressive}"/>
            </MenuItem>
            <MenuItem Header="CPU Cores" Visibility="{Binding CpuCores.IsVisible, Converter={StaticResource BoolToVis}}">
                <MenuItem Header="Auto (Recommended)" IsCheckable="True" IsChecked="{Binding CpuAffinityIsAuto, Mode=OneWay}"
                          Command="{Binding SetCpuAffinityCommand}" CommandParameter="{x:Static models:CpuAffinityMode.Auto}"
                          Visibility="{Binding CpuCores.ShowAuto, Converter={StaticResource BoolToVis}}"/>
                <MenuItem Header="All Cores (Windows default)" IsCheckable="True" IsChecked="{Binding CpuAffinityIsDefault, Mode=OneWay}"
                          Command="{Binding SetCpuAffinityCommand}" CommandParameter="{x:Static models:CpuAffinityMode.Default}"/>
                <MenuItem Header="Performance Cores Only" IsCheckable="True" IsChecked="{Binding CpuAffinityIsPerformanceCores, Mode=OneWay}"
                          Command="{Binding SetCpuAffinityCommand}" CommandParameter="{x:Static models:CpuAffinityMode.PerformanceCoresOnly}"
                          Visibility="{Binding CpuCores.ShowPerformanceCores, Converter={StaticResource BoolToVis}}"/>
                <MenuItem Header="3D V-Cache Cores" IsCheckable="True" IsChecked="{Binding CpuAffinityIsVCache, Mode=OneWay}"
                          Command="{Binding SetCpuAffinityCommand}" CommandParameter="{x:Static models:CpuAffinityMode.VCacheCores}"
                          Visibility="{Binding CpuCores.ShowVCache, Converter={StaticResource BoolToVis}}"/>
                <MenuItem Header="Frequency Cores" IsCheckable="True" IsChecked="{Binding CpuAffinityIsFrequency, Mode=OneWay}"
                          Command="{Binding SetCpuAffinityCommand}" CommandParameter="{x:Static models:CpuAffinityMode.FrequencyCores}"
                          Visibility="{Binding CpuCores.ShowFrequency, Converter={StaticResource BoolToVis}}"/>
                <MenuItem Header="First CCD Only" IsCheckable="True" IsChecked="{Binding CpuAffinityIsOneCcd, Mode=OneWay}"
                          Command="{Binding SetCpuAffinityCommand}" CommandParameter="{x:Static models:CpuAffinityMode.OneCcd}"
                          Visibility="{Binding CpuCores.ShowOneCcd, Converter={StaticResource BoolToVis}}"/>
            </MenuItem>
            <MenuItem Header="Launch Options">
                <MenuItem Header="Run as Administrator" IsCheckable="True" IsChecked="{Binding RunAsAdmin, Mode=OneWay}"
                          Command="{Binding ToggleRunAsAdminCommand}"/>
                <!-- Nothing to close for a plain local exe, so the item is not offered there. -->
                <MenuItem Header="Close Launcher After Game Exits" IsCheckable="True" IsChecked="{Binding CloseLauncherOnExit, Mode=OneWay}"
                          Command="{Binding ToggleCloseLauncherCommand}"
                          Visibility="{Binding HasLauncherToClose, Converter={StaticResource BoolToVis}}"/>
            </MenuItem>

            <Separator/>

            <!-- Quick Actions: the umbrella (Edit Game Properties) first, then the shortcuts into it. -->
            <MenuItem Header="Edit Game Properties..." Command="{Binding EditCommand}"/>
            <MenuItem Header="Rename..." Command="{Binding RenameCommand}"/>
            <!-- The five "Change ..." items were a flat run in the middle of an already long menu.
                 Cascaded, the menu reads as actions first and corrections second, and Rename stays
                 at the top level because it is the one used far more often than the rest. -->
            <MenuItem Header="Change">
                <!-- Replaces the old "Fetch Official Name", which renamed silently from a heuristic
                     search with no confirmation and no undo. This opens the same picker Game Details
                     uses, so a wrong match is corrected in one step instead of three. -->
                <MenuItem Header="Match..." Command="{Binding ChangeMatchCommand}"/>
                <MenuItem Header="Category..." Command="{Binding ChangeCategoryCommand}"/>
                <MenuItem Header="Icon..." Command="{Binding ChangeIconCommand}"/>
                <MenuItem Header="Poster Artwork..." Command="{Binding ChangeCoverCommand}"/>
                <Separator/>
                <!-- The manual escape hatch, below the picker that supersedes it for most users. -->
                <MenuItem Header="Steam App ID..." Command="{Binding EditSteamAppIdCommand}"/>
            </MenuItem>
            <MenuItem Header="Refresh Poster &amp; Metadata" Command="{Binding RefreshMetadataCommand}"/>
            <MenuItem Header="PCGamingWiki" Command="{Binding OpenPcGamingWikiCommand}"/>

            <!-- Steam-specific actions. One cascading item rather than three top-level ones and a
                 separator, all four of which carried the same HasSteamOverlay visibility style. -->
            <MenuItem Header="Steam">
                <MenuItem.Style>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSteamOverlay}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
                <MenuItem Header="Store Page" Command="{Binding OpenStoreCommand}"/>
                <MenuItem Header="Open in Steam Library" Command="{Binding OpenInSteamLibraryCommand}"/>
                <MenuItem Header="Verify Game Files" Command="{Binding VerifyFilesCommand}"/>
            </MenuItem>

            <Separator/>
            <MenuItem Header="Remove from Library" Command="{Binding DeleteCommand}" Foreground="{DynamicResource BrushDanger}"/>
        </ContextMenu>

        <!-- ==================================================================== -->
        <!-- POSTER CARD HOVER ZOOM                                               -->
        <!-- The Xbox dashboard lift: the whole tile grows slightly under the      -->
        <!-- pointer. Both poster grids name their card "CardBorder" and give it a -->
        <!-- ScaleTransform, so one pair of storyboards drives both.               -->
        <!--                                                                       -->
        <!-- Scale is deliberately small. A card is 184x276 (240x360 extra large)  -->
        <!-- with a 7px margin, so at 1.05 the growth is ~4.6px per side normally  -->
        <!-- and ~9px vertically when extra large - i.e. it mostly grows into its  -->
        <!-- own margin rather than over its neighbours. RenderTransform does not  -->
        <!-- affect layout, so nothing reflows and the WrapPanel never rewraps.    -->
        <!--                                                                       -->
        <!-- Out is quicker than in: a slow shrink feels sluggish when sweeping     -->
        <!-- across a shelf of cards. -->
        <!-- ==================================================================== -->
        <Storyboard x:Key="PosterCardZoomIn">
            <DoubleAnimation Storyboard.TargetName="CardBorder"
                             Storyboard.TargetProperty="RenderTransform.ScaleX"
                             To="1.05" Duration="0:0:0.16">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CardBorder"
                             Storyboard.TargetProperty="RenderTransform.ScaleY"
                             To="1.05" Duration="0:0:0.16">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="PosterCardZoomOut">
            <DoubleAnimation Storyboard.TargetName="CardBorder"
                             Storyboard.TargetProperty="RenderTransform.ScaleX"
                             To="1.0" Duration="0:0:0.12">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CardBorder"
                             Storyboard.TargetProperty="RenderTransform.ScaleY"
                             To="1.0" Duration="0:0:0.12">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- ==================================================================== -->
        <!-- "SHOW DETAILS ON HOVER" (Settings: PosterDetailsOnHover)             -->
        <!-- The card stays where it is and the art pushes in behind its rounded  -->
        <!-- clip, while the badges, title and playtime fade in over it. The card -->
        <!-- lift above is off in this mode: a frame that grows and art that      -->
        <!-- zooms inside it at once is two motions where one reads better.      -->
        <!--                                                                       -->
        <!-- Everything that fades binds its Opacity to the card template's       -->
        <!-- "DetailsOpacity" element, so one value drives them all and the       -->
        <!-- PLAYING tag and the not-installed dimming, which stay put, are       -->
        <!-- simply the elements that don't bind to it. These two storyboards    -->
        <!-- animate "DetailsFade" towards where PosterDetailsTarget says the     -->
        <!-- details should be; DetailsOpacity reads that animated value, or the  -->
        <!-- target itself while Windows' Animation effects are off               -->
        <!-- (Views/Motion.cs), so the details then appear with no fade.          -->
        <!-- ==================================================================== -->
        <Storyboard x:Key="PosterDetailsFadeIn">
            <DoubleAnimation Storyboard.TargetName="DetailsFade" Storyboard.TargetProperty="Opacity"
                             To="1" Duration="0:0:0.16">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="PosterDetailsFadeOut">
            <DoubleAnimation Storyboard.TargetName="DetailsFade" Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.12">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Where the details should be: hidden while the setting is on and the card is at
             rest, shown otherwise. Tag is the card's "in use" flag (see DetailsFade in the
             card template). Shared by DetailsFade, whose animations start from it, and
             DetailsTarget, which is never animated. -->
        <Style x:Key="PosterDetailsTarget" TargetType="FrameworkElement">
            <Setter Property="Opacity" Value="1"/>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding DataContext.SettingsVM.PosterDetailsOnHover, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Opacity" Value="0"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 1.08 crops 4% off each edge: enough to read as a push-in, not so much that a
             title in the art's corner disappears. Slower than the card lift, because it
             moves the whole picture rather than a frame around it. -->
        <Storyboard x:Key="PosterArtZoomIn">
            <DoubleAnimation Storyboard.TargetName="PosterArt"
                             Storyboard.TargetProperty="RenderTransform.ScaleX"
                             To="1.08" Duration="0:0:0.30">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="PosterArt"
                             Storyboard.TargetProperty="RenderTransform.ScaleY"
                             To="1.08" Duration="0:0:0.30">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="PosterArtZoomOut">
            <DoubleAnimation Storyboard.TargetName="PosterArt"
                             Storyboard.TargetProperty="RenderTransform.ScaleX"
                             To="1.0" Duration="0:0:0.20">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="PosterArt"
                             Storyboard.TargetProperty="RenderTransform.ScaleY"
                             To="1.0" Duration="0:0:0.20">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- A WrapPanel paints its children in order, so without this the card being
             hovered is drawn underneath every card after it in the row and the zoom
             looks clipped on its right and bottom edges. Lifting the container (the
             ContentPresenter the panel actually lays out - the template's own Border
             is too deep for Panel.ZIndex to reach) puts the growing card on top. -->
        <Style x:Key="PosterCardContainerStyle" TargetType="ContentPresenter">
            <Setter Property="Panel.ZIndex" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Panel.ZIndex" Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- ==================================================================== -->
        <!-- POSTER CARD SIZES                                                    -->
        <!-- The Poster Grid and Extra Large views share one card template; these -->
        <!-- are the only things that differ between them. The clip geometries    -->
        <!-- are the card minus its 1px border, for the poster's rounded corners. -->
        <!-- ==================================================================== -->
        <sys:Double x:Key="PosterCardWidth">184</sys:Double>
        <sys:Double x:Key="PosterCardHeight">276</sys:Double>
        <sys:Double x:Key="PosterCardWidthExtraLarge">240</sys:Double>
        <sys:Double x:Key="PosterCardHeightExtraLarge">360</sys:Double>

        <!-- The poster's rounded-corner clip: the border's own size and CornerRadius (RadiusPoster), so it follows the
             card size in every view and the theme's corners. -->
        <Style x:Key="PosterArtClip" TargetType="Border">
            <Setter Property="Clip">
                <Setter.Value>
                    <MultiBinding Converter="{StaticResource RoundedClipConverter}"><Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}"/><Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}"/><Binding Path="CornerRadius" RelativeSource="{RelativeSource Self}"/><Binding Path="BorderThickness" RelativeSource="{RelativeSource Self}"/></MultiBinding>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================================================================== -->
        <!-- "THIS GAME ISN'T THERE" BADGE                                        -->
        <!-- One badge, two readings: orange MISSING for a local exe that is not  -->
        <!-- on disk (which may only have moved - hence "Locate Executable..."),  -->
        <!-- and a quieter blue-grey NOT INSTALLED for a launcher game its own    -->
        <!-- launcher no longer has. Uninstalling a game is an ordinary thing to  -->
        <!-- do, so it does not get an error colour. Every card layout uses these -->
        <!-- and sets only its own size, padding and margin locally.              -->
        <!-- ==================================================================== -->
        <Style x:Key="UnavailableBadgeBorder" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource BrushWarningWash}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushWarningBorder}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsUnavailable}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsNotInstalled}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BrushSurfaceHover}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- The game's own art, pushed well back when the game isn't there to play. Dimming the
             whole card instead would take the badge and the title down with it, and those are
             exactly what has to stay readable. -->
        <Style x:Key="UnavailableDimmedArt" TargetType="Image">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsUnavailable}" Value="True">
                    <Setter Property="Opacity" Value="0.22"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- The same job for full-bleed poster art, which has no single Image to fade: a near-black
             wash over the artwork layers, under the title and badges. -->
        <Style x:Key="UnavailablePosterScrim" TargetType="Border" BasedOn="{StaticResource PosterArtClip}">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsUnavailable}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BrushScrim}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="UnavailableBadgeText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushWarning}"/>
            <Setter Property="Text" Value="{Binding UnavailableLabel}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsNotInstalled}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource BrushInfoText}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
                       <Grid.RowDefinitions>
                           <RowDefinition Height="Auto"/> <!-- Header -->
                           <RowDefinition Height="Auto"/> <!-- Category Tabs & Actions -->
                           <RowDefinition Height="Auto"/> <!-- Search, Sort & View Mode Bar -->
                           <RowDefinition Height="*"/>    <!-- Games Grid & Undo Toast -->
                           <RowDefinition Height="Auto"/> <!-- Status Bar -->
                       </Grid.RowDefinitions>

                       <!-- 1. Header -->
                       <DockPanel Grid.Row="0" Margin="0,0,0,14">
                           <!-- Right: Live Game Count Status (matching Settings & System) -->
                           <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                               <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeBody}" 
                                          Foreground="{DynamicResource BrushAccentText}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                               <TextBlock Text="{Binding TotalGameCountDisplay, Mode=OneWay}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}" 
                                          FontFamily="{DynamicResource AppFont}" VerticalAlignment="Center"/>
                           </StackPanel>

                           <!-- Left: Title & Subtitle matching Settings & System -->
                           <StackPanel VerticalAlignment="Center">
                               <TextBlock Text="Games Library" FontSize="{DynamicResource FontSizeHeading}" Foreground="{DynamicResource BrushTextPrimary}" 
                                          FontFamily="{DynamicResource AppFont}" FontWeight="Normal"/>
                               <TextBlock Text="Launch and organize your games from Steam, GOG, EA, Epic, Ubisoft Connect, Xbox, Battle.net, and local folders"
                                          FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}" TextTrimming="CharacterEllipsis"
                                          FontFamily="{DynamicResource AppFont}" Margin="0,4,0,0"/>
                           </StackPanel>
                       </DockPanel>

                       <!-- 2. Category Tabs & Action Buttons -->
                       <DockPanel Grid.Row="1" Margin="0,0,0,16">
                           <!-- Right: Action Buttons (+ Add Game, Add Folder, Scan for Games). MDL2 glyphs
                                instead of emoji so they match the rest of the app on every Windows build.
                                "Refresh Posters" moved to Settings > Library & Art: a rare maintenance
                                action that was taking primary toolbar space. -->
                           <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                               <Button AutomationProperties.Name="Add Game" Command="{Binding AddGameCommand}" Style="{StaticResource ModernAccentButton}" Margin="0,0,10,0">
                                   <StackPanel Orientation="Horizontal">
                                       <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeBody}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                       <TextBlock Text="Add Game" VerticalAlignment="Center"/>
                                   </StackPanel>
                               </Button>
                               <Button AutomationProperties.Name="Add Folder" Command="{Binding AddFolderCommand}" Style="{StaticResource ModernOutlineButton}" Margin="0,0,10,0">
                                   <StackPanel Orientation="Horizontal">
                                       <TextBlock Text="&#xED25;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeBody}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                       <TextBlock Text="Add Folder" VerticalAlignment="Center"/>
                                   </StackPanel>
                               </Button>
                               <Button AutomationProperties.Name="Scan for Games" Command="{Binding OpenScanForGamesCommand}" Style="{StaticResource ModernOutlineButton}">
                                   <StackPanel Orientation="Horizontal">
                                       <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeBody}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                       <TextBlock Text="Scan for Games" VerticalAlignment="Center"/>
                                   </StackPanel>
                               </Button>
                           </StackPanel>

                           <!-- Left: Segmented Category Tabs -->
                           <Border Background="{DynamicResource BrushDialogCard}" BorderBrush="{DynamicResource BrushBorder}"
                                   BorderThickness="1" CornerRadius="{DynamicResource RadiusControl}" Padding="3" Height="{StaticResource TabStripHeight}" Margin="0,0,16,0"
                                   HorizontalAlignment="Left" VerticalAlignment="Center">
                               <ScrollViewer x:Name="CategoryScrollViewer" Style="{StaticResource EdgeChevronScrollViewer}"
                                             PreviewMouseWheel="CategoryScrollViewer_PreviewMouseWheel">
                                   <ItemsControl ItemsSource="{Binding CategoryTabs}">
                                       <ItemsControl.ItemsPanel>
                                           <ItemsPanelTemplate>
                                               <StackPanel Orientation="Horizontal"/>
                                           </ItemsPanelTemplate>
                                       </ItemsControl.ItemsPanel>
                                       <ItemsControl.ItemTemplate>
                                           <DataTemplate>
                                               <Button AutomationProperties.Name="{Binding DisplayName}" Command="{Binding SelectCommand}"
                                                       Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsSelected}"
                                                       Margin="0,0,2,0">
                                                   <StackPanel Orientation="Horizontal">
                                                       <TextBlock Text="&#xE735;" FontFamily="{StaticResource IconFont}"
                                                                  FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushGold}" Margin="0,0,5,0" VerticalAlignment="Center"
                                                                  Visibility="{Binding IsFavoritesTab, Converter={StaticResource BoolToVis}}"/>
                                                       <TextBlock Text="&#xED1A;" FontFamily="{StaticResource IconFont}"
                                                                  FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,5,0" VerticalAlignment="Center"
                                                                  Visibility="{Binding IsHiddenTab, Converter={StaticResource BoolToVis}}"/>
                                                       <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                                                   </StackPanel>
                                               </Button>
                                           </DataTemplate>
                                       </ItemsControl.ItemTemplate>
                                   </ItemsControl>
                               </ScrollViewer>
                           </Border>
                       </DockPanel>

                       <!-- 3. Search, Sort & View Mode Bar -->
                       <Grid Grid.Row="2" Margin="0,0,0,14">
                           <Grid.ColumnDefinitions>
                               <ColumnDefinition Width="*"/>
                               <ColumnDefinition Width="190"/>
                               <ColumnDefinition Width="Auto"/>
                               <ColumnDefinition Width="Auto"/>
                           </Grid.ColumnDefinitions>

                           <!-- The same search box as Settings, About and System, with its clear x;
                                stretched to fill the bar instead of their fixed 160. -->
                           <views:SearchBox x:Name="LibrarySearchBox" Grid.Column="0" Width="Auto" Margin="0,0,10,0"
                                            Text="{Binding SearchText}" Placeholder="Search games by title, category, or path..."/>

                           <ComboBox AutomationProperties.Name="Sort order" Grid.Column="1"
                                     ItemsSource="{Binding SortOptions}"
                                     SelectedItem="{Binding SelectedSortOption, Mode=TwoWay}"
                                     Style="{StaticResource ModernComboBox}" Margin="0,0,10,0"/>

                           <!-- Filter flyout. Sits beside Sort because it is the same kind of control: it
                                changes what the list shows without changing the library. The category tabs
                                above stay the primary cut; this narrows within whichever one is selected. -->
                           <Grid Grid.Column="2" Margin="0,0,10,0">
                               <!-- Same container as the view-mode switcher to its right, so the two icon
                                    controls read as one family rather than a loose button beside a group. -->
                               <Border Background="{DynamicResource BrushDialogCard}" BorderBrush="{DynamicResource BrushBorder}"
                                       BorderThickness="1" CornerRadius="{DynamicResource RadiusControl}" Padding="3"/>
                               <!-- 34 rather than the 32 of every other icon button in this row: the badge
                                    needs the extra two pixels to clear the glyph. Kept as close as it can
                                    be so the control still reads as one of the family. -->
                               <Button x:Name="LibraryFilterButton"
                                       Command="{Binding Library.Filter.ToggleOpenCommand}"
                                       Width="34" Height="30" Padding="0" Cursor="Hand" Margin="4,4,4,4"
                                       Style="{StaticResource SegmentedTabButton}"
                                       Tag="{Binding Library.Filter.IsOpen}"
                                       ToolTip="{Binding Library.Filter.ActiveFilterSummary}"
                                       AutomationProperties.Name="{Binding Library.Filter.AccessibleName}">
                                   <TextBlock Text="&#xE71C;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeBody}"
                                              Foreground="{DynamicResource BrushTextPrimary}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                               </Button>

                               <!-- How many filters are on. Once the flyout closes this is the only thing on
                                    screen saying anything is hidden, so it carries a number rather than a
                                    dot - a dot says "something", which leaves reopening the flyout as the
                                    only way to find out how much. Geometry and type follow the badge pills
                                    on the game cards; the 1px outline is the container background, holding
                                    the badge off the glyph behind it.

                                    It sits in this Grid rather than inside the Button because
                                    SegmentedTabButton centres its ContentPresenter: content there shrinks to
                                    fit, so "top right" resolves against the glyph's own bounds and lands the
                                    badge squarely on top of it. Out here it aligns to the whole control.
                                    Not hit-testable, so the corner it covers still presses the button. -->
                               <Border x:Name="LibraryFilterBadge"
                                       Background="{DynamicResource BrushAccentHover}"
                                       BorderBrush="{DynamicResource BrushDialogCard}" BorderThickness="1" IsHitTestVisible="False"
                                       CornerRadius="{DynamicResource RadiusCard}" Height="15" MinWidth="15" Padding="3,0"
                                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,1,0"
                                       Visibility="{Binding Library.Filter.HasActiveFilters, Converter={StaticResource BoolToVis}}">
                                   <TextBlock Text="{Binding Library.Filter.ActiveFilterCount}"
                                              FontSize="{DynamicResource FontSizeBadge}" FontFamily="{DynamicResource AppFont}"
                                              Foreground="{DynamicResource BrushTextOnSolid}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                               </Border>

                               <!-- Placement is computed in code-behind rather than a fixed HorizontalOffset:
                                    the panel is MinWidth 270 / MaxWidth 300, so any single hardcoded offset
                                    is only right at one width and drifts off the button at the others. -->
                               <Popup x:Name="LibraryFilterPopup"
                                      IsOpen="{Binding Library.Filter.IsOpen, Mode=TwoWay}"
                                      PlacementTarget="{Binding ElementName=LibraryFilterButton}" Placement="Custom"
                                      StaysOpen="False" AllowsTransparency="True" Focusable="True"
                                      Opened="LibraryFilterPopup_Opened" PreviewKeyDown="LibraryFilterPopup_PreviewKeyDown">
                                   <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                                           CornerRadius="{DynamicResource RadiusCard}" Padding="6,12" MinWidth="270" MaxWidth="300"
                                           Focusable="True" FocusVisualStyle="{x:Null}">
                                       <Border.Effect>
                                           <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.65" Color="{DynamicResource ColorFloatingShadow}"/>
                                       </Border.Effect>
                                       <StackPanel>
                                           <DockPanel Margin="8,0,8,8">
                                               <!-- Clear resets and leaves the flyout open. Hidden rather than collapsed
                                                    at zero, so the header doesn't reflow under the pointer that pressed it;
                                                    the Click handler moves keyboard focus off it onto the first option. -->
                                               <Button DockPanel.Dock="Right" Content="Clear" Command="{Binding Library.Filter.ClearCommand}"
                                                       Click="LibraryFilterClear_Click">
                                                   <Button.Style>
                                                       <Style TargetType="Button" BasedOn="{StaticResource HelpLinkButton}">
                                                           <Style.Triggers>
                                                               <DataTrigger Binding="{Binding Library.Filter.HasActiveFilters}" Value="False">
                                                                   <Setter Property="Visibility" Value="Hidden"/>
                                                               </DataTrigger>
                                                           </Style.Triggers>
                                                       </Style>
                                                   </Button.Style>
                                               </Button>
                                               <StackPanel VerticalAlignment="Center">
                                                   <TextBlock Text="{Binding Library.Filter.ActiveFilterSummary}" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold"
                                                              Foreground="{DynamicResource BrushTextPrimary}"/>
                                                   <TextBlock Text="{Binding Library.Filter.ResultSummary}" FontSize="{DynamicResource FontSizeBody}"
                                                              Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0"/>
                                               </StackPanel>
                                           </DockPanel>

                                           <ScrollViewer MaxHeight="460" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                               <StackPanel>
                                                   <!-- Saved: named combinations of the ticks below. Applying one puts exactly its
                                                        ticks on screen; changing a tick afterwards marks it "edited". -->
                                                   <StackPanel Margin="0,0,0,10">
                                                       <DockPanel Margin="8,0,8,4">
                                                           <!-- Nothing ticked: nothing to save, and HelpLinkButton shows the link as disabled. -->
                                                           <Button DockPanel.Dock="Right" Content="Save current..." Style="{StaticResource HelpLinkButton}"
                                                                   Command="{Binding Library.Filter.SaveCurrentCommand}" Click="LibraryFilterSave_Click"
                                                                   AutomationProperties.Name="Save the ticked filters under a name"/>
                                                           <TextBlock Text="SAVED" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold"
                                                                      Foreground="{DynamicResource BrushAccentText}" VerticalAlignment="Center"/>
                                                       </DockPanel>
                                                       <TextBlock Text="Tick some options, then save them here." Margin="22,0,8,0" TextWrapping="Wrap"
                                                                  FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}">
                                                           <TextBlock.Style>
                                                               <Style TargetType="TextBlock">
                                                                   <Setter Property="Visibility" Value="Collapsed"/>
                                                                   <Style.Triggers>
                                                                       <DataTrigger Binding="{Binding Library.Filter.HasSavedFilters}" Value="False">
                                                                           <Setter Property="Visibility" Value="Visible"/>
                                                                       </DataTrigger>
                                                                   </Style.Triggers>
                                                               </Style>
                                                           </TextBlock.Style>
                                                       </TextBlock>
                                                       <ItemsControl ItemsSource="{Binding Library.Filter.SavedFilters}" Margin="14,0,0,0">
                                                           <ItemsControl.ItemTemplate>
                                                               <DataTemplate DataType="{x:Type vm:SavedFilterItem}">
                                                                   <DockPanel>
                                                                       <Button DockPanel.Dock="Right" Content="&#xE711;" Command="{Binding DeleteCommand}"
                                                                               Style="{StaticResource FilterSavedGlyphButton}" HorizontalAlignment="Right"
                                                                               FontFamily="{StaticResource IconFont}" ToolTip="Delete this saved filter"
                                                                               AutomationProperties.Name="{Binding Name, StringFormat=Delete saved filter {0}}"/>
                                                                       <Button Command="{Binding ApplyCommand}" Tag="{Binding IsSelected}"
                                                                               Style="{StaticResource FilterSavedRow}"
                                                                               AutomationProperties.Name="{Binding AccessibleName}">
                                                                           <StackPanel Orientation="Horizontal">
                                                                               <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="170"/>
                                                                               <TextBlock Text="edited" Margin="8,0,0,0" FontStyle="Italic" VerticalAlignment="Center"
                                                                                          Visibility="{Binding IsEdited, Converter={StaticResource BoolToVis}}"/>
                                                                           </StackPanel>
                                                                       </Button>
                                                                   </DockPanel>
                                                               </DataTemplate>
                                                           </ItemsControl.ItemTemplate>
                                                       </ItemsControl>
                                                   </StackPanel>

                                                   <ItemsControl ItemsSource="{Binding Library.Filter.Groups}">
                                                       <ItemsControl.ItemTemplate>
                                                           <DataTemplate DataType="{x:Type vm:LibraryFilterGroup}">
                                                               <StackPanel Margin="0,0,0,4"
                                                                           Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                                                                   <!-- A thin rule, then a small blue heading: what the group is, how its ticks combine, and a
                                                                        "clear" while something in it is on. The options below are indented, so the heading is
                                                                        plainly a label and not something to press. -->
                                                                   <Border Height="1" Background="{DynamicResource BrushBorder}" Margin="8,6,8,8"/>
                                                                   <DockPanel Margin="8,0,8,4">
                                                                       <Button DockPanel.Dock="Right" Content="clear" Command="{Binding ClearCommand}"
                                                                               AutomationProperties.Name="{Binding Title, StringFormat=Clear {0}}">
                                                                           <Button.Style>
                                                                               <Style TargetType="Button" BasedOn="{StaticResource HelpLinkButton}">
                                                                                   <Setter Property="Visibility" Value="Hidden"/>
                                                                                   <Style.Triggers>
                                                                                       <DataTrigger Binding="{Binding HasChecked}" Value="True">
                                                                                           <Setter Property="Visibility" Value="Visible"/>
                                                                                       </DataTrigger>
                                                                                   </Style.Triggers>
                                                                               </Style>
                                                                           </Button.Style>
                                                                       </Button>
                                                                       <TextBlock Text="{Binding HeadingText}" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold"
                                                                                  Foreground="{DynamicResource BrushAccentText}" VerticalAlignment="Center"/>
                                                                   </DockPanel>
                                                                   <ItemsControl ItemsSource="{Binding Options}" Margin="14,0,0,0">
                                                                       <ItemsControl.ItemTemplate>
                                                                           <DataTemplate DataType="{x:Type vm:LibraryFilterOption}">
                                                                               <ToggleButton IsThreeState="{Binding AllowExclude, Mode=OneTime}" IsChecked="{Binding State, Mode=TwoWay}"
                                                                                             Style="{StaticResource FilterOptionToggle}"
                                                                                             Content="{Binding DisplayLabel}"
                                                                                             Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVis}}"
                                                                                             ToolTip="{Binding ToolTipText}"
                                                                                             AutomationProperties.Name="{Binding DisplayLabel}"/>
                                                                           </DataTemplate>
                                                                       </ItemsControl.ItemTemplate>
                                                                   </ItemsControl>
                                                               </StackPanel>
                                                           </DataTemplate>
                                                       </ItemsControl.ItemTemplate>
                                                   </ItemsControl>
                                               </StackPanel>
                                           </ScrollViewer>

                                           <!-- Click runs before Command, so the flyout is already closed by
                                                the time the help window appears over the same corner. -->
                                           <Button Style="{StaticResource HelpLinkButton}" Margin="8,4,0,0"
                                                   Click="LibraryFilterHelp_Click"
                                                   Command="{x:Static services:HelpCommands.ShowTopic}"
                                                   CommandParameter="library/filtering"/>
                                       </StackPanel>
                                   </Border>
                               </Popup>
                           </Grid>

                           <!-- View Mode Switcher (Grid, Icons, List) -->
                           <Border Grid.Column="3" Background="{DynamicResource BrushDialogCard}" BorderBrush="{DynamicResource BrushBorder}"
                                   BorderThickness="1" CornerRadius="{DynamicResource RadiusControl}" Padding="3">
                               <StackPanel Orientation="Horizontal">
                                   <!-- Not one of the views: it changes how both poster views draw their cards,
                                        so it sits first, divided off from the four views it doesn't replace.
                                        Disabled (not hidden) in the other two, so the views don't shift along
                                        the bar as you switch between them. The glyph is Hide (an eye struck
                                        through): lit, it means the details are hidden until you point at a card. -->
                                   <Button Command="{Binding SettingsVM.TogglePosterDetailsOnHoverCommand}"
                                           Width="32" Height="30" Padding="0" Cursor="Hand"
                                           IsEnabled="{Binding SettingsVM.IsPosterView}"
                                           ToolTipService.ShowOnDisabled="True"
        AutomationProperties.Name="{Binding SettingsVM.PosterDetailsOnHoverAccessibleName}">
                                       <Button.Style>
                                           <Style TargetType="Button" BasedOn="{StaticResource SegmentedTabButton}">
                                               <Setter Property="ToolTip" Value="Show details on hover: posters show only their art until you point at one"/>
                                               <Style.Triggers>
                                                   <Trigger Property="IsEnabled" Value="False">
                                                       <Setter Property="Opacity" Value="0.35"/>
                                                       <Setter Property="ToolTip" Value="Show details on hover: for the two poster views"/>
                                                   </Trigger>
                                               </Style.Triggers>
                                           </Style>
                                       </Button.Style>
                                       <!-- On is an outline and an accent glyph, not the filled blue of the view buttons
                                            beside it: filled, it read as a second view being selected. -->
                                       <Border Width="26" Height="24" CornerRadius="{DynamicResource RadiusSmall}" BorderThickness="1">
                                           <Border.Style>
                                               <Style TargetType="Border">
                                                   <Setter Property="BorderBrush" Value="Transparent"/>
                                                   <Style.Triggers>
                                                       <DataTrigger Binding="{Binding SettingsVM.PosterDetailsOnHover}" Value="True">
                                                           <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                                                           <Setter Property="Background" Value="{DynamicResource BrushAccentWash}"/>
                                                       </DataTrigger>
                                                   </Style.Triggers>
                                               </Style>
                                           </Border.Style>
                                           <TextBlock Text="&#xED1A;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeSubhead}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center">
                                               <TextBlock.Style>
                                                   <Style TargetType="TextBlock">
                                                       <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                                                       <Style.Triggers>
                                                           <DataTrigger Binding="{Binding SettingsVM.PosterDetailsOnHover}" Value="True">
                                                               <Setter Property="Foreground" Value="{DynamicResource BrushAccentText}"/>
                                                           </DataTrigger>
                                                       </Style.Triggers>
                                                   </Style>
                                               </TextBlock.Style>
                                           </TextBlock>
                                       </Border>
                                   </Button>
                                   <Border Width="1" Margin="4,5" Background="{DynamicResource BrushBorder}"/>

                                   <!-- Every button is icon-only, so each carries a tooltip and an automation
                                        name. Extra Large uses a "large tiles" glyph (E8A9) - the old E71D
                                        rendered as a bulleted list and was mistaken for Details List. -->
                                   <Button Command="{Binding SettingsVM.SetViewModeCommand}" CommandParameter="Extra Large"
                                           Width="32" Height="30" Padding="0" Cursor="Hand"
                                           Style="{StaticResource SegmentedTabButton}" Tag="{Binding SettingsVM.IsExtraLargeView}"
        AutomationProperties.Name="Extra Large posters view" ToolTip="Extra large posters">
                                       <TextBlock Text="&#xE8A9;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeSubhead}"
                                                  Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                   </Button>
                                   <Button Command="{Binding SettingsVM.SetViewModeCommand}" CommandParameter="Poster Grid"
                                           Width="32" Height="30" Padding="0" Cursor="Hand" Margin="2,0,0,0"
                                           Style="{StaticResource SegmentedTabButton}" Tag="{Binding SettingsVM.IsGridView}"
        AutomationProperties.Name="Poster grid view" ToolTip="Poster grid">
                                       <TextBlock Text="&#xE8B9;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeBody}"
                                                  Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                   </Button>
                                   <Button Command="{Binding SettingsVM.SetViewModeCommand}" CommandParameter="Compact Icons"
                                           Width="32" Height="30" Padding="0" Cursor="Hand" Margin="2,0,0,0"
                                           Style="{StaticResource SegmentedTabButton}" Tag="{Binding SettingsVM.IsIconsView}"
        AutomationProperties.Name="Compact icons view" ToolTip="Compact icons">
                                       <TextBlock Text="&#xE80A;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeBody}"
                                                  Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                   </Button>
                                   <Button Command="{Binding SettingsVM.SetViewModeCommand}" CommandParameter="Details List"
                                           Width="32" Height="30" Padding="0" Cursor="Hand" Margin="2,0,0,0"
                                           Style="{StaticResource SegmentedTabButton}" Tag="{Binding SettingsVM.IsListView}"
        AutomationProperties.Name="Details list view" ToolTip="Details list">
                                       <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeBody}"
                                                  Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                   </Button>
                               </StackPanel>
                           </Border>
                       </Grid>

                       <!-- 4. Game Cards View -->
                       <Grid Grid.Row="3">
                           <!-- Empty State (also the drop target - dragging a file/folder anywhere
                                on the window already works, but this gives it a visible highlight) -->
                           <Border x:Name="DropZoneBorder" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                   Margin="0,20,0,20" CornerRadius="{DynamicResource RadiusCard}"
                                   BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1.5"
                                   Background="{DynamicResource BrushDialogCard}"
                                   AllowDrop="True" Drop="DropZone_Drop" DragOver="DropZone_DragOver"
                                   DragEnter="DropZone_DragEnter" DragLeave="DropZone_DragLeave">
                               <Border.Style>
                                   <Style TargetType="Border">
                                       <Setter Property="Visibility" Value="Collapsed"/>
                                       <Style.Triggers>
                                           <DataTrigger Binding="{Binding FilteredGames.IsEmpty}" Value="True">
                                               <Setter Property="Visibility" Value="Visible"/>
                                           </DataTrigger>
                                       </Style.Triggers>
                                   </Style>
                               </Border.Style>
                               <Grid>
                               <!-- Empty library: the first-run state. Scan is the accent action because for
                                    anyone with a launcher installed it fills the library in one click. -->
                               <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                   <StackPanel.Style>
                                       <Style TargetType="StackPanel">
                                           <Setter Property="Visibility" Value="Collapsed"/>
                                           <Style.Triggers>
                                               <DataTrigger Binding="{Binding HasAnyGames}" Value="False">
                                                   <Setter Property="Visibility" Value="Visible"/>
                                               </DataTrigger>
                                           </Style.Triggers>
                                       </Style>
                                   </StackPanel.Style>
                                   <Image Source="pack://application:,,,/Assets/app_icon.png" Width="64" Height="64"
                                          HorizontalAlignment="Center" Margin="0,0,0,14" RenderOptions.BitmapScalingMode="HighQuality"/>
                                   <TextBlock Text="Your library is empty"
                                              FontSize="{DynamicResource FontSizeTitle}" Foreground="{DynamicResource BrushTextPrimary}"
                                              FontFamily="{DynamicResource AppFont}" HorizontalAlignment="Center"/>
                                   <TextBlock Text="Scan for Games imports what's installed from Steam, GOG, EA, Epic, Ubisoft Connect, Xbox (PC Game Pass), and Battle.net. Or drop a game's exe, shortcut, or install folder anywhere on this window."
                                              FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" MaxWidth="520" TextAlignment="Center"
                                              FontFamily="{DynamicResource AppFont}" HorizontalAlignment="Center" Margin="0,6,0,18"/>
                                   <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                       <Button AutomationProperties.Name="Scan for Games" Command="{Binding OpenScanForGamesCommand}" Style="{StaticResource ModernAccentButton}" Margin="0,0,10,0">
                                           <StackPanel Orientation="Horizontal">
                                               <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeBody}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                               <TextBlock Text="Scan for Games" VerticalAlignment="Center"/>
                                           </StackPanel>
                                       </Button>
                                       <Button AutomationProperties.Name="Add Game" Command="{Binding AddGameCommand}" Style="{StaticResource ModernOutlineButton}" Margin="0,0,10,0">
                                           <StackPanel Orientation="Horizontal">
                                               <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeBody}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                               <TextBlock Text="Add Game" VerticalAlignment="Center"/>
                                           </StackPanel>
                                       </Button>
                                       <Button AutomationProperties.Name="Add Folder" Command="{Binding AddFolderCommand}" Style="{StaticResource ModernOutlineButton}">
                                           <StackPanel Orientation="Horizontal">
                                               <TextBlock Text="&#xED25;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeBody}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                               <TextBlock Text="Add Folder" VerticalAlignment="Center"/>
                                           </StackPanel>
                                       </Button>
                                   </StackPanel>
                               </StackPanel>

                               <!-- No match: the library has games, but this search / category tab shows
                                    none. Previously this fell through to the "library is empty" text above. -->
                               <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                   <StackPanel.Style>
                                       <Style TargetType="StackPanel">
                                           <Setter Property="Visibility" Value="Visible"/>
                                           <Style.Triggers>
                                               <DataTrigger Binding="{Binding HasAnyGames}" Value="False">
                                                   <Setter Property="Visibility" Value="Collapsed"/>
                                               </DataTrigger>
                                               <DataTrigger Binding="{Binding SelectedCategory}" Value="Favorites">
                                                   <Setter Property="Visibility" Value="Collapsed"/>
                                               </DataTrigger>
                                               <DataTrigger Binding="{Binding Library.IsEmptyBecauseOfFilters}" Value="True">
                                                   <Setter Property="Visibility" Value="Collapsed"/>
                                               </DataTrigger>
                                           </Style.Triggers>
                                       </Style>
                                   </StackPanel.Style>
                                   <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeDisplay}"
                                              Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                   <TextBlock Text="No games match"
                                              FontSize="{DynamicResource FontSizeTitle}" Foreground="{DynamicResource BrushTextPrimary}"
                                              FontFamily="{DynamicResource AppFont}" HorizontalAlignment="Center"/>
                                   <TextBlock Text="Nothing in this category matches your search. Press Esc to clear the search, or pick another tab."
                                              FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" MaxWidth="520" TextAlignment="Center"
                                              FontFamily="{DynamicResource AppFont}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                   <TextBlock Text="Adding a game instead? Drop its exe, shortcut, or install folder anywhere on this window, or use Add Game / Add Folder above."
                                              FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextMuted}" TextWrapping="Wrap" MaxWidth="520" TextAlignment="Center"
                                              FontFamily="{DynamicResource AppFont}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                               </StackPanel>

                               <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                   <StackPanel.Style>
                                       <Style TargetType="StackPanel">
                                           <Setter Property="Visibility" Value="Collapsed"/>
                                           <Style.Triggers>
                                               <MultiDataTrigger>
                                                   <MultiDataTrigger.Conditions>
                                                       <Condition Binding="{Binding SelectedCategory}" Value="Favorites"/>
                                                       <Condition Binding="{Binding HasAnyGames}" Value="True"/>
                                                   </MultiDataTrigger.Conditions>
                                                   <Setter Property="Visibility" Value="Visible"/>
                                               </MultiDataTrigger>
                                               <!-- Last trigger wins: on the Favorites tab with filters on,
                                                    "clear filters" is the useful advice, not "star a game". -->
                                               <DataTrigger Binding="{Binding Library.IsEmptyBecauseOfFilters}" Value="True">
                                                   <Setter Property="Visibility" Value="Collapsed"/>
                                               </DataTrigger>
                                           </Style.Triggers>
                                       </Style>
                                   </StackPanel.Style>
                                   <TextBlock Text="&#xE734;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeDisplay}"
                                              Foreground="{DynamicResource BrushGold}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                   <TextBlock Text="No favorites yet"
                                              FontSize="{DynamicResource FontSizeTitle}" Foreground="{DynamicResource BrushTextPrimary}"
                                              FontFamily="{DynamicResource AppFont}" HorizontalAlignment="Center"/>
                                   <TextBlock Text="Click the star on any game to add it to your Favorites."
                                              FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}"
                                              FontFamily="{DynamicResource AppFont}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                               </StackPanel>

                               <!-- Filtered to nothing. The filter flyout persists across restarts, so
                                    without this a tick left on last night reads as a library that lost its
                                    games. Wins over the "No games match" panel above, which would send the
                                    user looking at the search box and the tabs instead. -->
                               <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                   <StackPanel.Style>
                                       <Style TargetType="StackPanel">
                                           <Setter Property="Visibility" Value="Collapsed"/>
                                           <Style.Triggers>
                                               <DataTrigger Binding="{Binding Library.IsEmptyBecauseOfFilters}" Value="True">
                                                   <Setter Property="Visibility" Value="Visible"/>
                                               </DataTrigger>
                                           </Style.Triggers>
                                       </Style>
                                   </StackPanel.Style>
                                   <TextBlock Text="&#xE71C;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeDisplay}"
                                              Foreground="{DynamicResource BrushAccentText}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                   <TextBlock Text="Hidden by your filters"
                                              FontSize="{DynamicResource FontSizeTitle}" Foreground="{DynamicResource BrushTextPrimary}"
                                              FontFamily="{DynamicResource AppFont}" HorizontalAlignment="Center"/>
                                   <TextBlock Text="Your library has games, but none of them match the filters you have set. Filters stay put between sessions - the filter button shows how many are on."
                                              FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" MaxWidth="520" TextAlignment="Center"
                                              FontFamily="{DynamicResource AppFont}" HorizontalAlignment="Center" Margin="0,6,0,16"/>
                                   <Button Content="Clear filters" Command="{Binding Library.Filter.ClearCommand}"
                                           Style="{StaticResource ModernAccentButton}" HorizontalAlignment="Center"/>
                               </StackPanel>
                               </Grid>
                           </Border>

                           <!-- ScrollViewer for WrapPanel Views (View 1: Poster Cards & View 2: Compact Icons) -->
                           <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                               <ScrollViewer.Style>
                                   <Style TargetType="ScrollViewer">
                                       <Setter Property="Visibility" Value="Collapsed"/>
                                       <Style.Triggers>
                                           <MultiDataTrigger>
                                               <MultiDataTrigger.Conditions>
                                                   <Condition Binding="{Binding SettingsVM.IsListView}" Value="False"/>
                                                   <Condition Binding="{Binding FilteredGames.IsEmpty}" Value="False"/>
                                               </MultiDataTrigger.Conditions>
                                               <Setter Property="Visibility" Value="Visible"/>
                                           </MultiDataTrigger>
                                       </Style.Triggers>
                                   </Style>
                               </ScrollViewer.Style>
                               <Grid>

                                   <!-- ============================================================== -->
                                   <!-- VIEW 1: POSTER CARDS, NORMAL AND EXTRA LARGE                   -->
                                   <!-- One template for both: the card's size and its poster clip come -->
                                   <!-- from the PosterCard* resources, and the Extra Large view swaps  -->
                                   <!-- them for the larger pair. Compact Icons and the Details List    -->
                                   <!-- are different designs and stay separate.                        -->
                                   <!-- ============================================================== -->
                                   <ItemsControl ItemsSource="{Binding FilteredGames}" Focusable="False">
                                       <ItemsControl.Style>
                                           <Style TargetType="ItemsControl">
                                               <Setter Property="Visibility" Value="Collapsed"/>
                                               <Style.Triggers>
                                                   <DataTrigger Binding="{Binding SettingsVM.IsGridView}" Value="True">
                                                       <Setter Property="Visibility" Value="Visible"/>
                                                   </DataTrigger>
                                                   <DataTrigger Binding="{Binding SettingsVM.IsExtraLargeView}" Value="True">
                                                       <Setter Property="Visibility" Value="Visible"/>
                                                   </DataTrigger>
                                               </Style.Triggers>
                                           </Style>
                                       </ItemsControl.Style>

                                       <ItemsControl.ItemContainerStyle>
                                           <StaticResource ResourceKey="PosterCardContainerStyle"/>
                                       </ItemsControl.ItemContainerStyle>

                                       <ItemsControl.ItemsPanel>
                                           <ItemsPanelTemplate>
                                               <WrapPanel Orientation="Horizontal"/>
                                           </ItemsPanelTemplate>
                                       </ItemsControl.ItemsPanel>

                                       <ItemsControl.ItemTemplate>
                                           <DataTemplate DataType="{x:Type vm:GameCardViewModel}">
                                               <!-- The card carries the poster's corners in its Tag: the style below needs them to shape the outline, and a binding cannot read a DynamicResource itself. -->
                                               <Border x:Name="CardBorder" 
                                                       BorderThickness="1"
                                                       Tag="{DynamicResource RadiusPoster}"
                                                       Margin="7"
                                                       RenderTransformOrigin="0.5,0.5"
                                                       Cursor="Hand" Focusable="True"
                                                       AutomationProperties.Name="{Binding Name}"
                                                       ContextMenu="{StaticResource GameItemContextMenu}"
                                                       ContextMenuOpening="OnCardContextMenuOpening">

                                                   <Border.Style>
                                                       <Style TargetType="Border">
                                                           <Setter Property="Width" Value="{StaticResource PosterCardWidth}"/>
                                                           <Setter Property="Height" Value="{StaticResource PosterCardHeight}"/>
                                                           <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}"/>
                                                           <Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
                                                           <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
                                                           <Style.Triggers>
                                                               <!-- A card showing its poster has no fill of its own, and its outline follows the poster's shape
                                                                    (the same corners as the art's clip, for any shape and either card size), so no card shows in
                                                                    the corners when a theme makes the poster rounder than the card. -->
                                                               <DataTrigger Binding="{Binding ShowPosterArt}" Value="True">
                                                                   <Setter Property="Background" Value="Transparent"/>
                                                                   <Setter Property="CornerRadius">
                                                                       <Setter.Value>
                                                                           <MultiBinding Converter="{StaticResource PosterCardRadiusConverter}">
                                                                               <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}"/>
                                                                               <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}"/>
                                                                               <Binding Path="Tag" RelativeSource="{RelativeSource Self}"/>
                                                                               <Binding Path="BorderThickness" RelativeSource="{RelativeSource Self}"/>
                                                                           </MultiBinding>
                                                                       </Setter.Value>
                                                                   </Setter>
                                                               </DataTrigger>
                                                               <!-- The Extra Large view: the same card, bigger. Badge, text and button
                                                                    sizes stay as they are - only the card and its poster grow, as
                                                                    Windows Explorer's own "Extra Large Icons" view does. -->
                                                               <DataTrigger Binding="{Binding DataContext.SettingsVM.IsExtraLargeView, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                   <Setter Property="Width" Value="{StaticResource PosterCardWidthExtraLarge}"/>
                                                                   <Setter Property="Height" Value="{StaticResource PosterCardHeightExtraLarge}"/>
                                                               </DataTrigger>
                                                           </Style.Triggers>
                                                       </Style>
                                                   </Border.Style>

                                                   <!-- Target of the hover zoom - see PosterCardZoomIn. Declared
                                                        per card (not a shared resource) so each card animates on
                                                        its own transform instance. -->
                                                   <Border.RenderTransform>
                                                       <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                   </Border.RenderTransform>

                                                   <!-- Cards are focusable so Tab reaches them: Enter opens Details
                                                        (same as click), Ctrl+Enter launches; the focus ring and the
                                                        Play button appear on keyboard focus as well as hover. -->
                                                   <Border.InputBindings>
                                                       <MouseBinding Gesture="LeftClick" Command="{Binding PrimaryClickCommand}"/>
                                                       <MouseBinding Gesture="Ctrl+LeftClick" Command="{Binding ToggleSelectCommand}"/>
                                                       <MouseBinding Gesture="Shift+LeftClick" Command="{Binding RangeSelectCommand}"/>
                                                       <KeyBinding Key="Enter" Command="{Binding ViewDetailsCommand}"/>
                                                       <KeyBinding Key="Enter" Modifiers="Ctrl" Command="{Binding LaunchCommand}"/>
                                                   </Border.InputBindings>

                                                   <Grid>
                                                       <!-- 1. Full Bleed Poster View (Active when ShowPosterArt = True) -->
                                                       <Grid x:Name="PosterArtView" Visibility="Collapsed">
                                                           <!-- Both artwork layers share one clip so "Show details on hover" can zoom
                                                                them inside it (PosterArtZoomIn scales PosterArt): a transform on the
                                                                clipped Border itself would grow the clip along with the art. -->
                                                           <Border x:Name="PosterClipBorder" CornerRadius="{DynamicResource RadiusPoster}" Style="{StaticResource PosterArtClip}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                               <Grid x:Name="PosterArt" RenderTransformOrigin="0.5,0.5">
                                                                   <Grid.RenderTransform>
                                                                       <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                                   </Grid.RenderTransform>

                                                                   <!-- Ambient Blurred Background Fill (Fills entire card with game colors, zero black voids) -->
                                                                   <Image Source="{Binding CoverImage}" Stretch="UniformToFill"
                                                                          Opacity="0.45"
                                                                          RenderOptions.BitmapScalingMode="LowQuality"/>
                                                                   <Border Background="{DynamicResource BrushScrim}"/>

                                                                   <!-- Crisp Artwork Layer (Fits cleanly without cropping letters, logos, or characters) -->
                                                                   <Image Source="{Binding CoverImage}" Stretch="Uniform"
                                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                          RenderOptions.BitmapScalingMode="HighQuality"/>
                                                               </Grid>
                                                           </Border>

                                                           <!-- Over both artwork layers, under the vignette, title and badges. -->
                                                           <Border CornerRadius="{DynamicResource RadiusPoster}" Style="{StaticResource UnavailablePosterScrim}"
                                                                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                                                           <!-- Top Dark Vignette for badge readability. With details on hover it stays at
                                                                rest only while the logo or category does (PosterDetailsViewModel.TopShade). -->
                                                           <Border VerticalAlignment="Top" Height="48"
                                                                   views:PosterDetailFade.Part="TopShade">
                                                               <Border.Clip>
                                                                   <MultiBinding Converter="{StaticResource PosterShadeClipConverter}">
                                                                       <Binding Path="ActualWidth" ElementName="PosterArtView"/>
                                                                       <Binding Path="ActualHeight" ElementName="PosterArtView"/>
                                                                       <Binding Path="CornerRadius" ElementName="PosterClipBorder"/>
                                                                       <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}"/>
                                                                   </MultiBinding>
                                                               </Border.Clip>
                                                               <Border.Background>
                                                                   <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                       <GradientStop Color="{DynamicResource ColorRaw990D0D12}" Offset="0.0"/>
                                                                       <GradientStop Color="{DynamicResource ColorRaw000D0D12}" Offset="1.0"/>
                                                                   </LinearGradientBrush>
                                                               </Border.Background>
                                                           </Border>

                                                           <!-- Bottom Gradient Overlay with Game Title & Playtime. The gradient is a sibling
                                                                of the text rather than its container so that, with details on hover, each can
                                                                stay or fade on its own (Settings can keep any of the three lines at rest, and the
                                                                gradient with them); the Grid takes the text's height, as the Border did. -->
                                                           <Grid VerticalAlignment="Bottom">
                                                               <Border views:PosterDetailFade.Part="BottomShade">
                                                                   <Border.Clip>
                                                                       <MultiBinding Converter="{StaticResource PosterShadeClipConverter}" ConverterParameter="bottom">
                                                                           <Binding Path="ActualWidth" ElementName="PosterArtView"/>
                                                                           <Binding Path="ActualHeight" ElementName="PosterArtView"/>
                                                                           <Binding Path="CornerRadius" ElementName="PosterClipBorder"/>
                                                                           <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}"/>
                                                                       </MultiBinding>
                                                                   </Border.Clip>
                                                                   <Border.Background>
                                                                       <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                           <GradientStop Color="{DynamicResource ColorRaw00111114}" Offset="0.0"/>
                                                                           <GradientStop Color="{DynamicResource ColorRaw88111114}" Offset="0.25"/>
                                                                           <GradientStop Color="{DynamicResource ColorRawE6111114}" Offset="0.65"/>
                                                                           <GradientStop Color="{DynamicResource ColorRawF8111114}" Offset="1.0"/>
                                                                       </LinearGradientBrush>
                                                                   </Border.Background>
                                                               </Border>
                                                               <StackPanel Margin="11,18,11,9">
                                                                   <TextBlock Text="{Binding Name}" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold"
                                                                              Foreground="{DynamicResource BrushArtText}" 
                                                                              FontFamily="{DynamicResource AppFont}"
                                                                              TextTrimming="CharacterEllipsis"
                                                                              views:PosterDetailFade.Part="Title"/>
                                                                   <Grid Margin="0,3,0,0">
                                                                       <Grid.ColumnDefinitions>
                                                                           <ColumnDefinition Width="Auto" MaxWidth="80"/>
                                                                           <ColumnDefinition Width="*"/>
                                                                       </Grid.ColumnDefinitions>
                                                                       <TextBlock Grid.Column="0" Text="{Binding PlaytimeDisplay}" FontSize="{DynamicResource FontSizeBody}" 
                                                                                  Foreground="{DynamicResource BrushArtTextSecondary}" 
                                                                                  FontFamily="{DynamicResource AppFont}"
                                                                                  TextTrimming="CharacterEllipsis"
                                                                                  views:PosterDetailFade.Part="Playtime"/>
                                                                       <TextBlock Grid.Column="1" Text="{Binding LastPlayedDisplay}" FontSize="{DynamicResource FontSizeBody}" 
                                                                                  Foreground="{DynamicResource BrushArtTextMuted}" 
                                                                                  HorizontalAlignment="Right"
                                                                                  TextAlignment="Right"
                                                                                  TextTrimming="CharacterEllipsis"
                                                                                  Margin="4,0,0,0"
                                                                                  FontFamily="{DynamicResource AppFont}"
                                                                                  views:PosterDetailFade.Part="LastPlayed"/>
                                                                   </Grid>
                                                               </StackPanel>
                                                           </Grid>
                                                       </Grid>

                                                       <!-- 2. Standard Icon Fallback View (Active when ShowPosterArt = False) -->
                                                       <Grid x:Name="IconFallbackView" Margin="12">
                                                           <Grid.RowDefinitions>
                                                               <RowDefinition Height="Auto"/>
                                                               <RowDefinition Height="*"/>
                                                               <RowDefinition Height="Auto"/>
                                                           </Grid.RowDefinitions>

                                                           <!-- Center Icon & Name -->
                                                           <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,4">
                                                               <Border CornerRadius="{DynamicResource RadiusCard}" Width="64" Height="64" Margin="0,0,0,12"
                                                                       Background="{DynamicResource BrushSurfaceHover}" HorizontalAlignment="Center">
                                                                   <Image Source="{Binding IconImage}" Width="56" Height="56"
                                                                          Style="{StaticResource UnavailableDimmedArt}"
                                                                          RenderOptions.BitmapScalingMode="HighQuality"
                                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                               </Border>

                                                               <TextBlock Text="{Binding Name}" FontSize="{DynamicResource FontSizeBody}" 
                                                                          Foreground="{DynamicResource BrushTextPrimary}" 
                                                                          FontFamily="{DynamicResource AppFont}" FontWeight="SemiBold"
                                                                          TextAlignment="Center" TextTrimming="CharacterEllipsis" 
                                                                          MaxWidth="160" HorizontalAlignment="Center"/>
                                                           </StackPanel>

                                                           <!-- Footer Playtime -->
                                                           <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                                                               <Grid>
                                                                   <Grid.ColumnDefinitions>
                                                                       <ColumnDefinition Width="*"/>
                                                                       <ColumnDefinition Width="Auto"/>
                                                                   </Grid.ColumnDefinitions>
                                                                   <TextBlock Grid.Column="0" Text="{Binding PlaytimeDisplay}" FontSize="{DynamicResource FontSizeBody}" 
                                                                              Foreground="{DynamicResource BrushTextSecondary}" 
                                                                              FontFamily="{DynamicResource AppFont}"
                                                                              TextTrimming="CharacterEllipsis"/>
                                                                   <TextBlock Grid.Column="1" Text="{Binding LastPlayedDisplay}" FontSize="{DynamicResource FontSizeBody}" 
                                                                              Foreground="{DynamicResource BrushTextMuted}" 
                                                                              HorizontalAlignment="Right"
                                                                              TextAlignment="Right"
                                                                              TextTrimming="CharacterEllipsis"
                                                                              Margin="0"
                                                                              FontFamily="{DynamicResource AppFont}"/>
                                                               </Grid>
                                                           </StackPanel>
                                                       </Grid>

                                                       <!-- 3. Top Badges (Category, Steam Overlay, Missing, Hotkey) -->
                                                       <!-- Two rows. The pills and the favourite star share the first; the "this game
                                                            isn't there" badge has the second to itself, centred. It used to sit beside
                                                            the star, where NOT INSTALLED plus the star the card shows on hover outran
                                                            the card and the badge was clipped to "INSTALLED" - which reads as the
                                                            opposite of what it means.

                                                            With "Show details on hover" on, each part here fades with DetailsOpacity unless
                                                            Settings keeps it at rest (views:PosterDetailFade.Part; by default only PLAYING
                                                            stays). The not-installed scrim under the art always stays. -->
                                                       <StackPanel VerticalAlignment="Top" Margin="10,10,10,0">
                                                           <DockPanel LastChildFill="False">
                                                               <!-- Declared first so it gets its room first: at a large text size the left badges and category would otherwise take the whole row and push PLAYING and the favorite star out of the card. -->
                                                               <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                                                                   <!-- With details on hover there's no top vignette under PLAYING while the card
                                                                        is at rest, so its near-clear fill goes nearly solid to stay readable on
                                                                        bright art. -->
                                                                   <Border BorderBrush="{DynamicResource BrushSuccessSolid}" BorderThickness="1" CornerRadius="{DynamicResource RadiusSmall}" Padding="6,2" Margin="0,0,4,0" VerticalAlignment="Center"
                                                                           views:PosterDetailFade.Part="PlayingTag">
                                                                       <Border.Style>
                                                                           <Style TargetType="Border">
                                                                               <Setter Property="Visibility" Value="Collapsed"/>
                                                                               <Setter Property="Background" Value="{DynamicResource BrushSuccessWash}"/>
                                                                               <Style.Triggers>
                                                                                   <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                                                       <Setter Property="Visibility" Value="Visible"/>
                                                                                   </DataTrigger>
                                                                                   <DataTrigger Binding="{Binding DataContext.SettingsVM.PosterDetailsOnHover, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                                       <Setter Property="Background" Value="{DynamicResource BrushSuccessWash}"/>
                                                                                   </DataTrigger>
                                                                               </Style.Triggers>
                                                                           </Style>
                                                                       </Border.Style>
                                                                       <TextBlock Text="{Binding PlayingTagText}" FontSize="{DynamicResource FontSizeBadge}" FontWeight="SemiBold" Foreground="{DynamicResource BrushSuccessText}" FontFamily="{DynamicResource AppFont}"/>
                                                                   </Border>
                                                                   <!-- Favorite Star - outermost corner -->
                                                                   <Button Command="{Binding ToggleFavoriteCommand}" VerticalAlignment="Center"
                                                                           views:PosterDetailFade.Part="FavoriteStar"
            AutomationProperties.Name="{Binding FavoriteMenuLabel}">
                                                                       <Button.Style>
                                                                           <Style TargetType="Button" BasedOn="{StaticResource FavoriteToggleButton}">
                                                                               <Setter Property="Width" Value="19"/>
                                                                               <Setter Property="Height" Value="19"/>
                                                                               <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
                                                                               <Setter Property="Visibility" Value="Collapsed"/>
                                                                               <Style.Triggers>
                                                                                   <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                                       <Setter Property="Visibility" Value="Visible"/>
                                                                                   </DataTrigger>
                                                                                   <DataTrigger Binding="{Binding IsMouseOver, ElementName=CardBorder}" Value="True">
                                                                                       <Setter Property="Visibility" Value="Visible"/>
                                                                                   </DataTrigger>
                                                                                   <!-- With details on hover the star is only there while the card has
                                                                                        focus, so tabbing on to it would hide it - the trap the Play button
                                                                                        below avoids the same way. Favorite stays on the right-click menu. -->
                                                                                   <DataTrigger Binding="{Binding DataContext.SettingsVM.PosterDetailsOnHover, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                                       <Setter Property="Focusable" Value="False"/>
                                                                                   </DataTrigger>
                                                                               </Style.Triggers>
                                                                           </Style>
                                                                       </Button.Style>
                                                                   </Button>
                                                               </StackPanel>
                                                               <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" DockPanel.Dock="Left">
                                                                   <!-- The launcher logos, one part for "Show details on hover": a card shows
                                                                        exactly one of them. -->
                                                                   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                                               views:PosterDetailFade.Part="LauncherLogo">
                                                                       <!-- Steam Game Indicator Badge Overlay - leftmost, no extra box since
                                                                            the icon already includes its own colored background. -->
                                                                       <Border VerticalAlignment="Center">
                                                                           <Border.Style>
                                                                               <Style TargetType="Border">
                                                                                   <Setter Property="Visibility" Value="Collapsed"/>
                                                                                   <Style.Triggers>
                                                                                       <DataTrigger Binding="{Binding HasSteamOverlay}" Value="True">
                                                                                           <Setter Property="Visibility" Value="Visible"/>
                                                                                       </DataTrigger>
                                                                                   </Style.Triggers>
                                                                               </Style>
                                                                           </Border.Style>
                                                                           <Image Source="pack://application:,,,/Assets/LauncherLogos/steam.png"
                                                                                  Height="22.5" Stretch="Uniform" VerticalAlignment="Center"
                                                                                  RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                       </Border>

                                                                       <!-- GOG Game Indicator Badge Overlay -->
                                                                       <Border VerticalAlignment="Center">
                                                                           <Border.Style>
                                                                               <Style TargetType="Border">
                                                                                   <Setter Property="Visibility" Value="Collapsed"/>
                                                                                   <Style.Triggers>
                                                                                       <DataTrigger Binding="{Binding IsGogGame}" Value="True">
                                                                                           <Setter Property="Visibility" Value="Visible"/>
                                                                                       </DataTrigger>
                                                                                   </Style.Triggers>
                                                                               </Style>
                                                                           </Border.Style>
                                                                           <Image Source="pack://application:,,,/Assets/LauncherLogos/gog_galaxy.png"
                                                                                  Height="22.5" Stretch="Uniform" VerticalAlignment="Center"
                                                                                  RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                       </Border>

                                                                       <!-- EA Game Indicator Badge Overlay -->
                                                                       <Border VerticalAlignment="Center">
                                                                           <Border.Style>
                                                                               <Style TargetType="Border">
                                                                                   <Setter Property="Visibility" Value="Collapsed"/>
                                                                                   <Style.Triggers>
                                                                                       <DataTrigger Binding="{Binding IsEaGame}" Value="True">
                                                                                           <Setter Property="Visibility" Value="Visible"/>
                                                                                       </DataTrigger>
                                                                                   </Style.Triggers>
                                                                               </Style>
                                                                           </Border.Style>
                                                                           <Image Source="pack://application:,,,/Assets/LauncherLogos/ea_app.png"
                                                                                  Height="22.5" Stretch="Uniform" VerticalAlignment="Center"
                                                                                  RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                       </Border>

                                                                       <!-- Epic Games Indicator Badge Overlay -->
                                                                       <Border VerticalAlignment="Center">
                                                                           <Border.Style>
                                                                               <Style TargetType="Border">
                                                                                   <Setter Property="Visibility" Value="Collapsed"/>
                                                                                   <Style.Triggers>
                                                                                       <DataTrigger Binding="{Binding IsEpicGame}" Value="True">
                                                                                           <Setter Property="Visibility" Value="Visible"/>
                                                                                       </DataTrigger>
                                                                                   </Style.Triggers>
                                                                               </Style>
                                                                           </Border.Style>
                                                                           <Image Source="pack://application:,,,/Assets/LauncherLogos/epic_games.png"
                                                                                  Height="22.5" Stretch="Uniform" VerticalAlignment="Center"
                                                                                  RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                       </Border>

                                                                       <!-- Ubisoft Connect Indicator Badge Overlay -->
                                                                       <Border VerticalAlignment="Center">
                                                                           <Border.Style>
                                                                               <Style TargetType="Border">
                                                                                   <Setter Property="Visibility" Value="Collapsed"/>
                                                                                   <Style.Triggers>
                                                                                       <DataTrigger Binding="{Binding IsUbisoftGame}" Value="True">
                                                                                           <Setter Property="Visibility" Value="Visible"/>
                                                                                       </DataTrigger>
                                                                                   </Style.Triggers>
                                                                               </Style>
                                                                           </Border.Style>
                                                                           <Image Source="pack://application:,,,/Assets/LauncherLogos/ubisoft_connect.png"
                                                                                  Height="22.5" Stretch="Uniform" VerticalAlignment="Center"
                                                                                  RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                       </Border>

                                                                       <!-- Xbox / PC Game Pass Indicator Badge Overlay -->
                                                                       <Border VerticalAlignment="Center">
                                                                           <Border.Style>
                                                                               <Style TargetType="Border">
                                                                                   <Setter Property="Visibility" Value="Collapsed"/>
                                                                                   <Style.Triggers>
                                                                                       <DataTrigger Binding="{Binding IsXboxGame}" Value="True">
                                                                                           <Setter Property="Visibility" Value="Visible"/>
                                                                                       </DataTrigger>
                                                                                   </Style.Triggers>
                                                                               </Style>
                                                                           </Border.Style>
                                                                           <Image Source="pack://application:,,,/Assets/LauncherLogos/xbox.png"
                                                                                  Height="22.5" Stretch="Uniform" VerticalAlignment="Center"
                                                                                  RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                       </Border>

                                                                       <!-- Battle.net Indicator Badge Overlay -->
                                                                       <Border VerticalAlignment="Center">
                                                                           <Border.Style>
                                                                               <Style TargetType="Border">
                                                                                   <Setter Property="Visibility" Value="Collapsed"/>
                                                                                   <Style.Triggers>
                                                                                       <DataTrigger Binding="{Binding IsBattleNetGame}" Value="True">
                                                                                           <Setter Property="Visibility" Value="Visible"/>
                                                                                       </DataTrigger>
                                                                                   </Style.Triggers>
                                                                               </Style>
                                                                           </Border.Style>
                                                                           <Image Source="pack://application:,,,/Assets/LauncherLogos/battlenet.png"
                                                                                  Height="22.5" Stretch="Uniform" VerticalAlignment="Center"
                                                                                  RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                       </Border>

                                                                       <!-- Local Games Indicator Badge Overlay - shown for a game added via plain
                                                                            exe/shortcut/folder scan rather than any supported launcher. -->
                                                                       <Border VerticalAlignment="Center">
                                                                           <Border.Style>
                                                                               <Style TargetType="Border">
                                                                                   <Setter Property="Visibility" Value="Collapsed"/>
                                                                                   <Style.Triggers>
                                                                                       <DataTrigger Binding="{Binding IsLocalGame}" Value="True">
                                                                                           <Setter Property="Visibility" Value="Visible"/>
                                                                                       </DataTrigger>
                                                                                   </Style.Triggers>
                                                                               </Style>
                                                                           </Border.Style>
                                                                           <Image Source="pack://application:,,,/Assets/LauncherLogos/local_games.png"
                                                                                  Height="22.5" Stretch="Uniform" VerticalAlignment="Center"
                                                                                  RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                       </Border>
                                                                   </StackPanel>

                                                                   <!-- Category Pill (Hidden if category is Steam to prevent duplicate badges).
                                                                        Always preceded by exactly one visible platform/local badge above, so
                                                                        its left margin is unconditional. -->
                                                                   <Border Background="{DynamicResource BrushScrim}" BorderBrush="{DynamicResource BrushOverlayLine}" BorderThickness="1"
                                                                           CornerRadius="{DynamicResource RadiusSmall}" Padding="6,2" Height="19" Margin="5,0,0,0" VerticalAlignment="Center"
                                                                           views:PosterDetailFade.Part="Category">
                                                                       <Border.Style>
                                                                           <Style TargetType="Border">
                                                                               <Setter Property="Visibility" Value="Visible"/>
                                                                               <Style.Triggers>
                                                                                   <DataTrigger Binding="{Binding ShowCategoryBadge}" Value="False">
                                                                                       <Setter Property="Visibility" Value="Collapsed"/>
                                                                                   </DataTrigger>
                                                                               </Style.Triggers>
                                                                           </Style>
                                                                       </Border.Style>
                                                                       <TextBlock Text="{Binding Category}" FontSize="{DynamicResource FontSizeBody}"
                                                                                  Foreground="{DynamicResource BrushArtTextSecondary}"
                                                                                  FontFamily="{DynamicResource AppFont}" VerticalAlignment="Center"/>
                                                                   </Border>

                                                                   <!-- Hidden Pill -->
                                                                   <Border Background="{DynamicResource BrushBorder}" BorderBrush="{DynamicResource BrushOverlayLine}" BorderThickness="1"
                                                                           CornerRadius="{DynamicResource RadiusSmall}" Padding="6,2" Height="19" Margin="5,0,0,0" VerticalAlignment="Center"
                                                                           views:PosterDetailFade.Part="HiddenTag">
                                                                       <Border.Style>
                                                                           <Style TargetType="Border">
                                                                               <Setter Property="Visibility" Value="Collapsed"/>
                                                                               <Style.Triggers>
                                                                                   <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                                                                       <Setter Property="Visibility" Value="Visible"/>
                                                                                   </DataTrigger>
                                                                               </Style.Triggers>
                                                                           </Style>
                                                                       </Border.Style>
                                                                       <TextBlock Text="HIDDEN" FontSize="{DynamicResource FontSizeBadge}" FontWeight="Bold"
                                                                                  Foreground="{DynamicResource BrushTextSoft}"
                                                                                  FontFamily="{DynamicResource AppFont}" VerticalAlignment="Center"/>
                                                                   </Border>
                                                               </StackPanel>

                                                           </DockPanel>

                                                           <Border Style="{StaticResource UnavailableBadgeBorder}"
                                                                   views:PosterDetailFade.Part="NotInstalledTag"
                                                                   CornerRadius="{DynamicResource RadiusSmall}" Padding="6,2" Margin="0,5,0,0" HorizontalAlignment="Center">
                                                               <TextBlock Style="{StaticResource UnavailableBadgeText}"
                                                                          FontSize="{DynamicResource FontSizeBadge}" FontFamily="{DynamicResource AppFont}"/>
                                                           </Border>
                                                       </StackPanel>

                                                       <!-- 4. Hover Play Button Overlay. Not focusable: it shows only while the
                                                            card is hovered or focused, so Tab onto it hid it and dropped focus
                                                            back on the card - a trap. Ctrl+Enter on the card launches.
                                                            With details on hover it fades in with them rather than popping in
                                                            ahead of them. -->
                                                       <Button Command="{Binding LaunchCommand}" Focusable="False" AutomationProperties.Name="{Binding Name, StringFormat='Play {0}'}"
                                                               Width="46" Height="46"
                                                               Opacity="{Binding Opacity, ElementName=DetailsOpacity}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                                           <Button.Style>
                                                               <Style TargetType="Button" BasedOn="{StaticResource CirclePlayButton}">
                                                                   <Setter Property="Visibility" Value="Collapsed"/>
                                                                   <Style.Triggers>
                                                                       <DataTrigger Binding="{Binding IsMouseOver, ElementName=CardBorder}" Value="True">
                                                                           <Setter Property="Visibility" Value="Visible"/>
                                                                       </DataTrigger>
                                                                       <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=CardBorder}" Value="True">
                                                                           <Setter Property="Visibility" Value="Visible"/>
                                                                       </DataTrigger>
                                                                       <!-- Hidden while games are multi-selected: Play is a single-game action. -->
                                                                       <DataTrigger Binding="{Binding DataContext.HasSelection, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                           <Setter Property="Visibility" Value="Collapsed"/>
                                                                       </DataTrigger>
                                                                   </Style.Triggers>
                                                               </Style>
                                                           </Button.Style>
                                                       </Button>

                                                       <!-- 5. Never drawn: the details' opacity, worked out once for every element that
                                                            fades (see PosterDetailsFadeIn). DetailsFade's Tag is whether the card is in use -
                                                            pointed at, keyboard-focused, or its right-click menu open - so the triggers can
                                                            test a single value; its Opacity is animated by the fade trigger below.
                                                            DetailsTarget has the same style and is never animated, so it is always exactly
                                                            where the details should be. DetailsOpacity is what the details bind to: the
                                                            animated value with Animation effects on, the target with them off. -->
                                                       <FrameworkElement x:Name="DetailsFade" Visibility="Collapsed" Style="{StaticResource PosterDetailsTarget}">
                                                           <FrameworkElement.Tag>
                                                               <MultiBinding Converter="{StaticResource AnyTrueConverter}">
                                                                   <Binding Path="IsMouseOver" ElementName="CardBorder"/>
                                                                   <Binding Path="IsKeyboardFocused" ElementName="CardBorder"/>
                                                                   <Binding Path="IsContextMenuOpen"/>
                                                               </MultiBinding>
                                                           </FrameworkElement.Tag>
                                                       </FrameworkElement>
                                                       <FrameworkElement x:Name="DetailsTarget" Visibility="Collapsed" Style="{StaticResource PosterDetailsTarget}"
                                                                         Tag="{Binding Tag, ElementName=DetailsFade}"/>
                                                       <FrameworkElement x:Name="DetailsOpacity" Visibility="Collapsed">
                                                           <FrameworkElement.Opacity>
                                                               <MultiBinding Converter="{StaticResource PickByFlagConverter}">
                                                                   <Binding Path="(views:Motion.IsEnabled)"/>
                                                                   <Binding Path="Opacity" ElementName="DetailsFade"/>
                                                                   <Binding Path="Opacity" ElementName="DetailsTarget"/>
                                                               </MultiBinding>
                                                           </FrameworkElement.Opacity>
                                                       </FrameworkElement>

                                                   </Grid>
                                               </Border>

                                               <DataTemplate.Triggers>
                                                   <DataTrigger Binding="{Binding ShowPosterArt}" Value="True">
                                                       <Setter TargetName="PosterArtView" Property="Visibility" Value="Visible"/>
                                                       <Setter TargetName="IconFallbackView" Property="Visibility" Value="Collapsed"/>
                                                   </DataTrigger>
                                                   <!-- The art is darkened by its own scrim, so the card itself only needs to
                                                        lose a little - the badge and the title have to stay readable. -->
                                                   <DataTrigger Binding="{Binding IsUnavailable}" Value="True">
                                                       <Setter TargetName="CardBorder" Property="Opacity" Value="0.82"/>
                                                       <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource BrushWarningBorder}"/>
                                                   </DataTrigger>
                                                   <!-- After the one above, so a not-installed card takes this border instead. -->
                                                   <DataTrigger Binding="{Binding IsNotInstalled}" Value="True">
                                                       <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
                                                   </DataTrigger>
                                                   <Trigger Property="IsMouseOver" Value="True">
                                                       <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                                                   </Trigger>
                                                   <!-- The card lift: in while the card is pointed at or its right-click menu is up,
                                                        out otherwise. The menu counts because it takes the mouse, so IsMouseOver
                                                        drops the moment it opens and the card would shrink out from under it.
                                                        One trigger with both actions, so anything that ends the state - the mouse
                                                        leaving, Animation effects going off (Views/Motion.cs), or "Show details on
                                                        hover" coming on - shrinks it back; and EnterActions run for a trigger that
                                                        is already true when the card is made, so a card created under a resting
                                                        cursor still lifts. Off with details on hover, whose art zoom replaces it. -->
                                                   <MultiDataTrigger>
                                                       <MultiDataTrigger.Conditions>
                                                           <Condition Value="True">
                                                               <Condition.Binding>
                                                                   <MultiBinding Converter="{StaticResource AnyTrueConverter}">
                                                                       <Binding Path="IsMouseOver" ElementName="CardBorder"/>
                                                                       <Binding Path="IsContextMenuOpen"/>
                                                                   </MultiBinding>
                                                               </Condition.Binding>
                                                           </Condition>
                                                           <Condition Binding="{Binding Path=(views:Motion.IsEnabled)}" Value="True"/>
                                                           <Condition Binding="{Binding DataContext.SettingsVM.PosterDetailsOnHover, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"/>
                                                       </MultiDataTrigger.Conditions>
                                                       <MultiDataTrigger.EnterActions>
                                                           <BeginStoryboard Storyboard="{StaticResource PosterCardZoomIn}"/>
                                                       </MultiDataTrigger.EnterActions>
                                                       <MultiDataTrigger.ExitActions>
                                                           <BeginStoryboard Storyboard="{StaticResource PosterCardZoomOut}"/>
                                                       </MultiDataTrigger.ExitActions>
                                                   </MultiDataTrigger>
                                                   <!-- Keep the card lit while its menu is up, so it's clear which game is being changed. -->
                                                   <DataTrigger Binding="{Binding IsContextMenuOpen}" Value="True">
                                                       <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                                                   </DataTrigger>

                                                   <!-- Show details on hover: the art zoom. Same shape as the lift above. -->
                                                   <MultiDataTrigger>
                                                       <MultiDataTrigger.Conditions>
                                                           <Condition Binding="{Binding Tag, ElementName=DetailsFade}" Value="True"/>
                                                           <Condition Binding="{Binding Path=(views:Motion.IsEnabled)}" Value="True"/>
                                                           <Condition Binding="{Binding DataContext.SettingsVM.PosterDetailsOnHover, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                                       </MultiDataTrigger.Conditions>
                                                       <MultiDataTrigger.EnterActions>
                                                           <BeginStoryboard Storyboard="{StaticResource PosterArtZoomIn}"/>
                                                       </MultiDataTrigger.EnterActions>
                                                       <MultiDataTrigger.ExitActions>
                                                           <BeginStoryboard Storyboard="{StaticResource PosterArtZoomOut}"/>
                                                       </MultiDataTrigger.ExitActions>
                                                   </MultiDataTrigger>

                                                   <!-- Show details on hover: the fade. Both directions live in this one trigger on
                                                        purpose. WPF gives each template trigger its own animation layer, in the order
                                                        they're declared, and a value a later trigger's animation is holding sits on top
                                                        of anything an earlier one starts - so a fade-out here and a fade-in in a
                                                        separate trigger would leave whichever is lower stuck under the other's last
                                                        value. Exit runs for every way out of "at rest": the card coming into use and
                                                        the setting going off both want the details back. Not tied to Animation
                                                        effects: it runs either way, and DetailsOpacity just stops reading it while
                                                        they're off, so the fade is always where it should be when they come back. -->
                                                   <MultiDataTrigger>
                                                       <MultiDataTrigger.Conditions>
                                                           <Condition Binding="{Binding DataContext.SettingsVM.PosterDetailsOnHover, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                                           <Condition Binding="{Binding Tag, ElementName=DetailsFade}" Value="False"/>
                                                       </MultiDataTrigger.Conditions>
                                                       <MultiDataTrigger.EnterActions>
                                                           <BeginStoryboard Storyboard="{StaticResource PosterDetailsFadeOut}"/>
                                                       </MultiDataTrigger.EnterActions>
                                                       <MultiDataTrigger.ExitActions>
                                                           <BeginStoryboard Storyboard="{StaticResource PosterDetailsFadeIn}"/>
                                                       </MultiDataTrigger.ExitActions>
                                                   </MultiDataTrigger>
                                                   <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=CardBorder}" Value="True">
                                                       <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                                                       <Setter TargetName="CardBorder" Property="BorderThickness" Value="2"/>
                                                   </DataTrigger>
                                                   <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                       <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                                                       <Setter TargetName="CardBorder" Property="BorderThickness" Value="2"/>
                                                   </DataTrigger>
                                               </DataTemplate.Triggers>
                                           </DataTemplate>
                                       </ItemsControl.ItemTemplate>
                                   </ItemsControl>

                                   <!-- ============================================================== -->
                                   <!-- VIEW 2: COMPACT ICONS VIEW                                     -->
                                   <!-- ============================================================== -->
                                   <ItemsControl ItemsSource="{Binding FilteredGames}" Focusable="False">
                                       <ItemsControl.Style>
                                           <Style TargetType="ItemsControl">
                                               <Setter Property="Visibility" Value="Collapsed"/>
                                               <Style.Triggers>
                                                   <DataTrigger Binding="{Binding SettingsVM.IsIconsView}" Value="True">
                                                       <Setter Property="Visibility" Value="Visible"/>
                                                   </DataTrigger>
                                               </Style.Triggers>
                                           </Style>
                                       </ItemsControl.Style>

                                       <ItemsControl.ItemsPanel>
                                           <ItemsPanelTemplate>
                                               <WrapPanel Orientation="Horizontal"/>
                                           </ItemsPanelTemplate>
                                       </ItemsControl.ItemsPanel>

                                       <ItemsControl.ItemTemplate>
                                           <DataTemplate DataType="{x:Type vm:GameCardViewModel}">
                                               <Border x:Name="IconCardBorder" CornerRadius="{DynamicResource RadiusCard}" 
                                                       Background="{DynamicResource BrushSurface}" 
                                                       BorderBrush="{DynamicResource BrushBorder}" 
                                                       BorderThickness="1"
                                                       Width="116" Height="124" Margin="6"
                                                       Cursor="Hand" Focusable="True" AutomationProperties.Name="{Binding Name}"
                                                       ContextMenu="{StaticResource GameItemContextMenu}"
                                                       ContextMenuOpening="OnCardContextMenuOpening">
                                                   <!-- Cards are focusable so Tab reaches them: Enter opens Details
                                                        (same as click), Ctrl+Enter launches; the focus ring and the
                                                        Play button appear on keyboard focus as well as hover. -->
                                                   <Border.InputBindings>
                                                       <MouseBinding Gesture="LeftClick" Command="{Binding PrimaryClickCommand}"/>
                                                       <MouseBinding Gesture="Ctrl+LeftClick" Command="{Binding ToggleSelectCommand}"/>
                                                       <MouseBinding Gesture="Shift+LeftClick" Command="{Binding RangeSelectCommand}"/>
                                                       <KeyBinding Key="Enter" Command="{Binding ViewDetailsCommand}"/>
                                                       <KeyBinding Key="Enter" Modifiers="Ctrl" Command="{Binding LaunchCommand}"/>
                                                   </Border.InputBindings>

                                                   <Grid Margin="8,8,8,8">
                                                       <Grid.RowDefinitions>
                                                           <RowDefinition Height="Auto"/>
                                                           <RowDefinition Height="*"/>
                                                           <RowDefinition Height="Auto"/>
                                                           <RowDefinition Height="Auto"/>
                                                       </Grid.RowDefinitions>

                                                       <!-- Top Badges -->
                                                       <DockPanel Grid.Row="0" Height="14">
                                                           <Button DockPanel.Dock="Left" Command="{Binding ToggleFavoriteCommand}"
                                                                   Width="14" Height="14" Padding="0" Margin="0,0,3,0"
                                                                   Background="Transparent" BorderThickness="0" Cursor="Hand"
        AutomationProperties.Name="{Binding FavoriteMenuLabel}" ToolTip="{Binding FavoriteMenuLabel}" VerticalAlignment="Center">
                                                               <Button.Template>
                                                                   <ControlTemplate TargetType="Button">
                                                                       <TextBlock x:Name="StarGlyph" Text="&#xE734;" FontFamily="{StaticResource IconFont}"
                                                                                  FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextPrimary}"
                                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                       <ControlTemplate.Triggers>
                                                                           <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                               <Setter TargetName="StarGlyph" Property="Text" Value="&#xE735;"/>
                                                                               <Setter TargetName="StarGlyph" Property="Foreground" Value="{DynamicResource BrushGold}"/>
                                                                           </DataTrigger>
                                                                           <Trigger Property="IsMouseOver" Value="True">
                                                                               <Setter TargetName="StarGlyph" Property="Foreground" Value="{DynamicResource BrushGold}"/>
                                                                           </Trigger>
                                                                       </ControlTemplate.Triggers>
                                                                   </ControlTemplate>
                                                               </Button.Template>
                                                           </Button>

                                                           <Border Background="{DynamicResource BrushAccentWash}" CornerRadius="{DynamicResource RadiusSmall}" Padding="4,0" HorizontalAlignment="Left">
                                                               <Border.Style>
                                                                   <Style TargetType="Border">
                                                                       <Setter Property="Visibility" Value="Collapsed"/>
                                                                       <Style.Triggers>
                                                                           <DataTrigger Binding="{Binding HasSteamOverlay}" Value="True">
                                                                               <Setter Property="Visibility" Value="Visible"/>
                                                                           </DataTrigger>
                                                                       </Style.Triggers>
                                                                   </Style>
                                                               </Border.Style>
                                                               <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                   <Image Source="pack://application:,,,/Assets/LauncherLogos/steam.png" Height="11" Margin="0,0,2,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                   <TextBlock Text="STEAM" FontSize="{DynamicResource FontSizeBadge}" Foreground="{DynamicResource BrushAccentText}" FontWeight="SemiBold"/>
                                                               </StackPanel>
                                                           </Border>

                                                           <Border Background="{DynamicResource BrushBadgePurpleWash}" CornerRadius="{DynamicResource RadiusSmall}" Padding="4,0" HorizontalAlignment="Left">
                                                               <Border.Style>
                                                                   <Style TargetType="Border">
                                                                       <Setter Property="Visibility" Value="Collapsed"/>
                                                                       <Style.Triggers>
                                                                           <DataTrigger Binding="{Binding IsGogGame}" Value="True">
                                                                               <Setter Property="Visibility" Value="Visible"/>
                                                                           </DataTrigger>
                                                                       </Style.Triggers>
                                                                   </Style>
                                                               </Border.Style>
                                                               <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                   <Image Source="pack://application:,,,/Assets/LauncherLogos/gog_galaxy.png" Height="11" Margin="0,0,2,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                   <TextBlock Text="GOG" FontSize="{DynamicResource FontSizeBadge}" Foreground="{DynamicResource BrushBadgePurple}" FontWeight="SemiBold"/>
                                                               </StackPanel>
                                                           </Border>

                                                           <Border Background="{DynamicResource BrushSuccessWash}" CornerRadius="{DynamicResource RadiusSmall}" Padding="4,0" HorizontalAlignment="Left">
                                                               <Border.Style>
                                                                   <Style TargetType="Border">
                                                                       <Setter Property="Visibility" Value="Collapsed"/>
                                                                       <Style.Triggers>
                                                                           <DataTrigger Binding="{Binding IsEaGame}" Value="True">
                                                                               <Setter Property="Visibility" Value="Visible"/>
                                                                           </DataTrigger>
                                                                       </Style.Triggers>
                                                                   </Style>
                                                               </Border.Style>
                                                               <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                   <Image Source="pack://application:,,,/Assets/LauncherLogos/ea_app.png" Height="11" Margin="0,0,2,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                   <TextBlock Text="EA" FontSize="{DynamicResource FontSizeBadge}" Foreground="{DynamicResource BrushSuccessText}" FontWeight="SemiBold"/>
                                                               </StackPanel>
                                                           </Border>

                                                           <Border Background="{DynamicResource BrushSurfaceHover}" CornerRadius="{DynamicResource RadiusSmall}" Padding="4,0" HorizontalAlignment="Left">
                                                               <Border.Style>
                                                                   <Style TargetType="Border">
                                                                       <Setter Property="Visibility" Value="Collapsed"/>
                                                                       <Style.Triggers>
                                                                           <DataTrigger Binding="{Binding IsEpicGame}" Value="True">
                                                                               <Setter Property="Visibility" Value="Visible"/>
                                                                           </DataTrigger>
                                                                       </Style.Triggers>
                                                                   </Style>
                                                               </Border.Style>
                                                               <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                   <Image Source="pack://application:,,,/Assets/LauncherLogos/epic_games.png" Height="11" Margin="0,0,2,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                   <TextBlock Text="EPIC" FontSize="{DynamicResource FontSizeBadge}" Foreground="{DynamicResource BrushTextPrimary}" FontWeight="SemiBold"/>
                                                               </StackPanel>
                                                           </Border>

                                                           <Border Background="{DynamicResource BrushWarningWash}" CornerRadius="{DynamicResource RadiusSmall}" Padding="4,0" HorizontalAlignment="Left">
                                                               <Border.Style>
                                                                   <Style TargetType="Border">
                                                                       <Setter Property="Visibility" Value="Collapsed"/>
                                                                       <Style.Triggers>
                                                                           <DataTrigger Binding="{Binding IsUbisoftGame}" Value="True">
                                                                               <Setter Property="Visibility" Value="Visible"/>
                                                                           </DataTrigger>
                                                                       </Style.Triggers>
                                                                   </Style>
                                                               </Border.Style>
                                                               <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                   <Image Source="pack://application:,,,/Assets/LauncherLogos/ubisoft_connect.png" Height="11" Margin="0,0,2,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                   <TextBlock Text="UBI" FontSize="{DynamicResource FontSizeBadge}" Foreground="{DynamicResource BrushGold}" FontWeight="SemiBold"/>
                                                               </StackPanel>
                                                           </Border>

                                                           <Border Background="{DynamicResource BrushSuccessWash}" CornerRadius="{DynamicResource RadiusSmall}" Padding="4,0" HorizontalAlignment="Left">
                                                               <Border.Style>
                                                                   <Style TargetType="Border">
                                                                       <Setter Property="Visibility" Value="Collapsed"/>
                                                                       <Style.Triggers>
                                                                           <DataTrigger Binding="{Binding IsXboxGame}" Value="True">
                                                                               <Setter Property="Visibility" Value="Visible"/>
                                                                           </DataTrigger>
                                                                       </Style.Triggers>
                                                                   </Style>
                                                               </Border.Style>
                                                               <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                   <Image Source="pack://application:,,,/Assets/LauncherLogos/xbox.png" Height="11" Margin="0,0,2,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                   <TextBlock Text="XBOX" FontSize="{DynamicResource FontSizeBadge}" Foreground="{DynamicResource BrushSuccessText}" FontWeight="SemiBold"/>
                                                               </StackPanel>
                                                           </Border>

                                                           <Border Background="{DynamicResource BrushAccentWash}" CornerRadius="{DynamicResource RadiusSmall}" Padding="4,0" HorizontalAlignment="Left">
                                                               <Border.Style>
                                                                   <Style TargetType="Border">
                                                                       <Setter Property="Visibility" Value="Collapsed"/>
                                                                       <Style.Triggers>
                                                                           <DataTrigger Binding="{Binding IsBattleNetGame}" Value="True">
                                                                               <Setter Property="Visibility" Value="Visible"/>
                                                                           </DataTrigger>
                                                                       </Style.Triggers>
                                                                   </Style>
                                                               </Border.Style>
                                                               <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                   <Image Source="pack://application:,,,/Assets/LauncherLogos/battlenet.png" Height="11" Margin="0,0,2,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                   <TextBlock Text="B.NET" FontSize="{DynamicResource FontSizeBadge}" Foreground="{DynamicResource BrushInfoText}" FontWeight="SemiBold"/>
                                                               </StackPanel>
                                                           </Border>

                                                           <!-- Local games get a pill here too, so every platform is marked in every view. -->
                                                           <Border Background="{DynamicResource BrushSurfaceHover}" CornerRadius="{DynamicResource RadiusSmall}" Padding="4,0" HorizontalAlignment="Left">
                                                               <Border.Style>
                                                                   <Style TargetType="Border">
                                                                       <Setter Property="Visibility" Value="Collapsed"/>
                                                                       <Style.Triggers>
                                                                           <DataTrigger Binding="{Binding IsLocalGame}" Value="True">
                                                                               <Setter Property="Visibility" Value="Visible"/>
                                                                           </DataTrigger>
                                                                       </Style.Triggers>
                                                                   </Style>
                                                               </Border.Style>
                                                               <TextBlock Text="LOCAL" FontSize="{DynamicResource FontSizeBadge}" Foreground="{DynamicResource BrushTextSoft}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                           </Border>

                                                       </DockPanel>

                                                       <!-- Icon -->
                                                       <Border Grid.Row="1" Width="48" Height="48" CornerRadius="{DynamicResource RadiusControl}"
                                                               Background="{DynamicResource BrushSurfaceHover}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                           <Image Source="{Binding IconImage}" Width="42" Height="42"
                                                                  Style="{StaticResource UnavailableDimmedArt}"
                                                                  RenderOptions.BitmapScalingMode="HighQuality"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                       </Border>

                                                       <!-- PLAYING, or NOT INSTALLED / MISSING: across the foot of the icon, where the
                                                            whole tag fits. Beside the star and the launcher pill in the top row there
                                                            was room for "NOT IN" at best. Only one of the two ever shows. -->
                                                       <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-3">
                                                           <Border Background="{DynamicResource BrushSuccessWash}" BorderBrush="{DynamicResource BrushSuccessSolid}" BorderThickness="1" CornerRadius="{DynamicResource RadiusSmall}" Padding="4,0" HorizontalAlignment="Center">
                                                               <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsPlaying}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                                               <TextBlock Text="{Binding PlayingTagText}" FontSize="{DynamicResource FontSizeBadge}" FontWeight="SemiBold" Foreground="{DynamicResource BrushSuccessText}"/>
                                                           </Border>
                                                           <Border Style="{StaticResource UnavailableBadgeBorder}"
                                                                   CornerRadius="{DynamicResource RadiusSmall}" Padding="4,0" HorizontalAlignment="Center">
                                                               <TextBlock Style="{StaticResource UnavailableBadgeText}" FontSize="{DynamicResource FontSizeBadge}"/>
                                                           </Border>
                                                       </StackPanel>

                                                       <!-- Title -->
                                                       <TextBlock Grid.Row="2" Text="{Binding Name}" FontSize="{DynamicResource FontSizeBody}" 
                                                                  Foreground="{DynamicResource BrushTextPrimary}" 
                                                                  FontFamily="{DynamicResource AppFont}" FontWeight="SemiBold"
                                                                  TextAlignment="Center" TextTrimming="CharacterEllipsis" 
                                                                  HorizontalAlignment="Center" Margin="0,5,0,0"/>

                                                       <!-- Playtime / Category Subtext -->
                                                       <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                                                           <TextBlock Text="{Binding Category}" FontSize="{DynamicResource FontSizeBody}"
                                                                      Foreground="{DynamicResource BrushTextMuted}"
                                                                      FontFamily="{DynamicResource AppFont}"
                                                                      TextTrimming="CharacterEllipsis"/>
                                                           <TextBlock Text=" &#x2022; HIDDEN" FontSize="{DynamicResource FontSizeBody}" FontWeight="Bold"
                                                                      Foreground="{DynamicResource BrushTextSoft}" FontFamily="{DynamicResource AppFont}"
                                                                      Visibility="{Binding IsHidden, Converter={StaticResource BoolToVis}}"/>
                                                       </StackPanel>

                                                       <!-- Hover Play Button Overlay -->
                                                       <Button Grid.Row="1" Command="{Binding LaunchCommand}" Focusable="False" AutomationProperties.Name="{Binding Name, StringFormat='Play {0}'}"
                                                               Width="34" Height="34"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                                           <Button.Style>
                                                               <Style TargetType="Button" BasedOn="{StaticResource CirclePlayButton}">
                                                                   <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
                                                                   <Setter Property="Visibility" Value="Collapsed"/>
                                                                   <Style.Triggers>
                                                                       <DataTrigger Binding="{Binding IsMouseOver, ElementName=IconCardBorder}" Value="True">
                                                                           <Setter Property="Visibility" Value="Visible"/>
                                                                       </DataTrigger>
                                                                       <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=IconCardBorder}" Value="True">
                                                                           <Setter Property="Visibility" Value="Visible"/>
                                                                       </DataTrigger>
                                                                       <!-- Hidden while games are multi-selected: Play is a single-game action. -->
                                                                       <DataTrigger Binding="{Binding DataContext.HasSelection, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                           <Setter Property="Visibility" Value="Collapsed"/>
                                                                       </DataTrigger>
                                                                   </Style.Triggers>
                                                               </Style>
                                                           </Button.Style>
                                                       </Button>
                                                   </Grid>
                                               </Border>

                                               <DataTemplate.Triggers>
                                                   <DataTrigger Binding="{Binding IsUnavailable}" Value="True">
                                                       <Setter TargetName="IconCardBorder" Property="Opacity" Value="0.82"/>
                                                       <Setter TargetName="IconCardBorder" Property="BorderBrush" Value="{DynamicResource BrushWarningBorder}"/>
                                                   </DataTrigger>
                                                   <DataTrigger Binding="{Binding IsNotInstalled}" Value="True">
                                                       <Setter TargetName="IconCardBorder" Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
                                                   </DataTrigger>
                                                   <Trigger Property="IsMouseOver" Value="True">
                                                       <Setter TargetName="IconCardBorder" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                                                       <Setter TargetName="IconCardBorder" Property="Background" Value="{DynamicResource BrushSurfaceHover}"/>
                                                   </Trigger>
                                                   <!-- Stays lit while the card's right-click menu is open (the menu takes the mouse). -->
                                                   <DataTrigger Binding="{Binding IsContextMenuOpen}" Value="True">
                                                       <Setter TargetName="IconCardBorder" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                                                       <Setter TargetName="IconCardBorder" Property="Background" Value="{DynamicResource BrushSurfaceHover}"/>
                                                   </DataTrigger>
                                                   <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=IconCardBorder}" Value="True">
                                                       <Setter TargetName="IconCardBorder" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                                                       <Setter TargetName="IconCardBorder" Property="Background" Value="{DynamicResource BrushSurfaceHover}"/>
                                                   </DataTrigger>
                                                   <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                       <Setter TargetName="IconCardBorder" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                                                       <Setter TargetName="IconCardBorder" Property="BorderThickness" Value="2"/>
                                                   </DataTrigger>
                                               </DataTemplate.Triggers>
                                           </DataTemplate>
                                       </ItemsControl.ItemTemplate>
                                   </ItemsControl>
                               </Grid>
                           </ScrollViewer>

                           <!-- ============================================================== -->
                           <!-- VIEW 3: DETAILS LIST VIEW (VIRTUALIZED & PINNED HEADER)        -->
                           <!-- ============================================================== -->
                           <Grid>
                               <Grid.Style>
                                   <Style TargetType="Grid">
                                       <Setter Property="Visibility" Value="Collapsed"/>
                                       <Style.Triggers>
                                           <MultiDataTrigger>
                                               <MultiDataTrigger.Conditions>
                                                   <Condition Binding="{Binding SettingsVM.IsListView}" Value="True"/>
                                                   <Condition Binding="{Binding FilteredGames.IsEmpty}" Value="False"/>
                                               </MultiDataTrigger.Conditions>
                                               <Setter Property="Visibility" Value="Visible"/>
                                           </MultiDataTrigger>
                                       </Style.Triggers>
                                   </Style>
                               </Grid.Style>
                               <Grid.RowDefinitions>
                                   <RowDefinition Height="Auto"/> <!-- Pinned Header Bar -->
                                   <RowDefinition Height="*"/>    <!-- Virtualized Game Rows -->
                               </Grid.RowDefinitions>

                               <!-- Header Bar (Fixed, never scrolls out of view) -->
                               <Border Grid.Row="0" Background="{DynamicResource BrushDialogCard}" BorderBrush="{DynamicResource BrushBorder}" 
                                       BorderThickness="0,0,0,1" Padding="11,8" Margin="0,0,6,6" CornerRadius="{DynamicResource RadiusSmall}">
                                   <Grid>
                                       <Grid.ColumnDefinitions>
                                           <ColumnDefinition Width="42"/> <!-- Icon -->
                                           <ColumnDefinition Width="*"/>  <!-- Title -->
                                           <ColumnDefinition Width="135"/> <!-- Category -->
                                           <ColumnDefinition Width="110"/> <!-- Playtime -->
                                           <ColumnDefinition Width="125"/> <!-- Last Played -->
                                           <ColumnDefinition Width="90"/>  <!-- Actions -->
                                       </Grid.ColumnDefinitions>
                                       <TextBlock Grid.Column="1" Text="GAME TITLE" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold" 
                                                  Foreground="{DynamicResource BrushTextMuted}" FontFamily="{DynamicResource AppFont}"/>
                                       <TextBlock Grid.Column="2" Text="CATEGORY" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold" 
                                                  Foreground="{DynamicResource BrushTextMuted}" FontFamily="{DynamicResource AppFont}"/>
                                       <TextBlock Grid.Column="3" Text="PLAYTIME" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold" 
                                                  Foreground="{DynamicResource BrushTextMuted}" FontFamily="{DynamicResource AppFont}"/>
                                       <TextBlock Grid.Column="4" Text="LAST PLAYED" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold" 
                                                  Foreground="{DynamicResource BrushTextMuted}" FontFamily="{DynamicResource AppFont}"/>
                                       <TextBlock Grid.Column="5" Text="ACTIONS" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold" 
                                                  Foreground="{DynamicResource BrushTextMuted}" FontFamily="{DynamicResource AppFont}" 
                                                  HorizontalAlignment="Right" Margin="0,0,6,0"/>
                                   </Grid>
                               </Border>

                               <!-- Virtualized List Rows -->
                               <ListBox Grid.Row="1" x:Name="GamesListBox"
                                        ItemsSource="{Binding FilteredGames}"
                                        KeyboardNavigation.TabNavigation="Once"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                        ScrollViewer.VerticalScrollBarVisibility="Visible"
                                        ScrollViewer.CanContentScroll="True"
                                        VirtualizingPanel.IsVirtualizing="True"
                                        VirtualizingPanel.VirtualizationMode="Recycling"
                                        VirtualizingPanel.ScrollUnit="Pixel">
                                   <!-- Keyboard: Enter opens Details (same as click), Ctrl+Enter launches. -->
                                   <ListBox.InputBindings>
                                       <KeyBinding Key="Enter" Command="{Binding SelectedItem.ViewDetailsCommand, ElementName=GamesListBox}"/>
                                       <KeyBinding Key="Enter" Modifiers="Ctrl" Command="{Binding SelectedItem.LaunchCommand, ElementName=GamesListBox}"/>
                                   </ListBox.InputBindings>
                                   <ListBox.ItemContainerStyle>
                                       <Style TargetType="ListBoxItem">
                                           <Setter Property="Padding" Value="0"/>
                                           <Setter Property="Margin" Value="0"/>
                                           <Setter Property="BorderThickness" Value="0"/>
                                           <Setter Property="Background" Value="Transparent"/>
                                           <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                           <Setter Property="FocusVisualStyle" Value="{StaticResource ListRowFocusRing}"/>
                                           <Setter Property="Template">
                                               <Setter.Value>
                                                   <ControlTemplate TargetType="ListBoxItem">
                                                       <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                                   </ControlTemplate>
                                               </Setter.Value>
                                           </Setter>
                                       </Style>
                                   </ListBox.ItemContainerStyle>
                                   <ListBox.ItemTemplate>
                                       <DataTemplate DataType="{x:Type vm:GameCardViewModel}">
                                           <Border x:Name="ListRowBorder" CornerRadius="{DynamicResource RadiusControl}" 
                                                   Background="{DynamicResource BrushSurface}" 
                                                   BorderBrush="{DynamicResource BrushBorder}" 
                                                   BorderThickness="1"
                                                   Height="46" Margin="0,2,0,3" Padding="10,0"
                                                   Cursor="Hand"
                                                   ContextMenu="{StaticResource GameItemContextMenu}"
                                                   ContextMenuOpening="OnCardContextMenuOpening">
                                               <Border.InputBindings>
                                                   <MouseBinding Gesture="LeftClick" Command="{Binding PrimaryClickCommand}"/>
                                                   <MouseBinding Gesture="Ctrl+LeftClick" Command="{Binding ToggleSelectCommand}"/>
                                                   <MouseBinding Gesture="Shift+LeftClick" Command="{Binding RangeSelectCommand}"/>
                                               </Border.InputBindings>
                                               <Grid VerticalAlignment="Center">
                                                   <Grid.ColumnDefinitions>
                                                       <ColumnDefinition Width="42"/>
                                                       <ColumnDefinition Width="*"/>
                                                       <ColumnDefinition Width="135"/>
                                                       <ColumnDefinition Width="110"/>
                                                       <ColumnDefinition Width="125"/>
                                                       <ColumnDefinition Width="90"/>
                                                   </Grid.ColumnDefinitions>

                                                   <!-- Icon -->
                                                   <Border Grid.Column="0" Width="30" Height="30" CornerRadius="{DynamicResource RadiusSmall}" 
                                                           Background="{DynamicResource BrushSurfaceHover}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                       <Image Source="{Binding IconImage}" Width="24" Height="24"
                                                              Style="{StaticResource UnavailableDimmedArt}"
                                                              RenderOptions.BitmapScalingMode="HighQuality"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                   </Border>

                                                   <!-- Title & Badges -->
                                                   <!-- Title and badges. A DockPanel, not a StackPanel: a horizontal StackPanel measures
                                                        its children at their full width, so at a narrow window the title was cut
                                                        mid-word and the badge beside it sliced in half. Docked, each is measured in
                                                        what is left, so the title trims with an ellipsis instead. Same layout otherwise -
                                                        DockPanel docks to the left by default.
                                                        The badges are docked right and the title is the last child, so the badges are
                                                        measured first and always fit, and a long title is what shortens. The panel is
                                                        left-aligned, so with room to spare the badges still sit beside the title. -->
                                                   <DockPanel Grid.Column="1" LastChildFill="True" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,10,0">
                                                       <Button Style="{StaticResource FavoriteToggleButton}" Command="{Binding ToggleFavoriteCommand}" Margin="0,0,4,0"
        AutomationProperties.Name="{Binding FavoriteMenuLabel}"/>
                                                       <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                       <Border Background="{DynamicResource BrushSuccessWash}" BorderBrush="{DynamicResource BrushSuccessSolid}" BorderThickness="1" CornerRadius="{DynamicResource RadiusSmall}" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                           <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsPlaying}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                                           <TextBlock Text="{Binding PlayingTagText}" FontSize="{DynamicResource FontSizeBadge}" FontWeight="SemiBold" Foreground="{DynamicResource BrushSuccessText}" FontFamily="{DynamicResource AppFont}"/>
                                                       </Border>
                                                       <Border Style="{StaticResource UnavailableBadgeBorder}"
                                                               CornerRadius="{DynamicResource RadiusSmall}" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                           <TextBlock Style="{StaticResource UnavailableBadgeText}"
                                                                      FontSize="{DynamicResource FontSizeBadge}" FontFamily="{DynamicResource AppFont}"/>
                                                       </Border>
                                                       <Border Background="{DynamicResource BrushAccentWash}" CornerRadius="{DynamicResource RadiusSmall}" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                           <Border.Style>
                                                               <Style TargetType="Border">
                                                                   <Setter Property="Visibility" Value="Collapsed"/>
                                                                   <Style.Triggers>
                                                                       <DataTrigger Binding="{Binding HasSteamOverlay}" Value="True">
                                                                           <Setter Property="Visibility" Value="Visible"/>
                                                                       </DataTrigger>
                                                                   </Style.Triggers>
                                                               </Style>
                                                           </Border.Style>
                                                           <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                               <Image Source="pack://application:,,,/Assets/LauncherLogos/steam.png" Height="11" Margin="0,0,3,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                               <TextBlock Text="STEAM" FontSize="{DynamicResource FontSizeBadge}" Foreground="{DynamicResource BrushAccentText}"
                                                                          FontFamily="{DynamicResource AppFont}" FontWeight="SemiBold"/>
                                                           </StackPanel>
                                                       </Border>
                                                       <Border Background="{DynamicResource BrushBadgePurpleWash}" CornerRadius="{DynamicResource RadiusSmall}" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                           <Border.Style>
                                                               <Style TargetType="Border">
                                                                   <Setter Property="Visibility" Value="Collapsed"/>
                                                                   <Style.Triggers>
                                                                       <DataTrigger Binding="{Binding IsGogGame}" Value="True">
                                                                           <Setter Property="Visibility" Value="Visible"/>
                                                                       </DataTrigger>
                                                                   </Style.Triggers>
                                                               </Style>
                                                           </Border.Style>
                                                           <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                               <Image Source="pack://application:,,,/Assets/LauncherLogos/gog_galaxy.png" Height="11" Margin="0,0,3,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                               <TextBlock Text="GOG" FontSize="{DynamicResource FontSizeBadge}" Foreground="{DynamicResource BrushBadgePurple}"
                                                                          FontFamily="{DynamicResource AppFont}" FontWeight="SemiBold"/>
                                                           </StackPanel>
                                                       </Border>
                                                       <Border Background="{DynamicResource BrushSuccessWash}" CornerRadius="{DynamicResource RadiusSmall}" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                           <Border.Style>
                                                               <Style TargetType="Border">
                                                                   <Setter Property="Visibility" Value="Collapsed"/>
                                                                   <Style.Triggers>
                                                                       <DataTrigger Binding="{Binding IsEaGame}" Value="True">
                                                                           <Setter Property="Visibility" Value="Visible"/>
                                                                       </DataTrigger>
                                                                   </Style.Triggers>
                                                               </Style>
                                                           </Border.Style>
                                                           <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                               <Image Source="pack://application:,,,/Assets/LauncherLogos/ea_app.png" Height="11" Margin="0,0,3,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                               <TextBlock Text="EA" FontSize="{DynamicResource FontSizeBadge}" Foreground="{DynamicResource BrushSuccessText}"
                                                                          FontFamily="{DynamicResource AppFont}" FontWeight="SemiBold"/>
                                                           </StackPanel>
                                                       </Border>
                                                       <Border Background="{DynamicResource BrushSurfaceHover}" CornerRadius="{DynamicResource RadiusSmall}" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                           <Border.Style>
                                                               <Style TargetType="Border">
                                                                   <Setter Property="Visibility" Value="Collapsed"/>
                                                                   <Style.Triggers>
                                                                       <DataTrigger Binding="{Binding IsEpicGame}" Value="True">
                                                                           <Setter Property="Visibility" Value="Visible"/>
                                                                       </DataTrigger>
                                                                   </Style.Triggers>
                                                               </Style>
                                                           </Border.Style>
                                                           <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                               <Image Source="pack://application:,,,/Assets/LauncherLogos/epic_games.png" Height="11" Margin="0,0,3,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                               <TextBlock Text="EPIC" FontSize="{DynamicResource FontSizeBadge}" Foreground="{DynamicResource BrushTextPrimary}"
                                                                          FontFamily="{DynamicResource AppFont}" FontWeight="SemiBold"/>
                                                           </StackPanel>
                                                       </Border>
                                                       <Border Background="{DynamicResource BrushWarningWash}" CornerRadius="{DynamicResource RadiusSmall}" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                           <Border.Style>
                                                               <Style TargetType="Border">
                                                                   <Setter Property="Visibility" Value="Collapsed"/>
                                                                   <Style.Triggers>
                                                                       <DataTrigger Binding="{Binding IsUbisoftGame}" Value="True">
                                                                           <Setter Property="Visibility" Value="Visible"/>
                                                                       </DataTrigger>
                                                                   </Style.Triggers>
                                                               </Style>
                                                           </Border.Style>
                                                           <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                               <Image Source="pack://application:,,,/Assets/LauncherLogos/ubisoft_connect.png" Height="11" Margin="0,0,3,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                               <TextBlock Text="UBI" FontSize="{DynamicResource FontSizeBadge}" Foreground="{DynamicResource BrushGold}"
                                                                          FontFamily="{DynamicResource AppFont}" FontWeight="SemiBold"/>
                                                           </StackPanel>
                                                       </Border>
                                                       <Border Background="{DynamicResource BrushSuccessWash}" CornerRadius="{DynamicResource RadiusSmall}" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                           <Border.Style>
                                                               <Style TargetType="Border">
                                                                   <Setter Property="Visibility" Value="Collapsed"/>
                                                                   <Style.Triggers>
                                                                       <DataTrigger Binding="{Binding IsXboxGame}" Value="True">
                                                                           <Setter Property="Visibility" Value="Visible"/>
                                                                       </DataTrigger>
                                                                   </Style.Triggers>
                                                               </Style>
                                                           </Border.Style>
                                                           <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                               <Image Source="pack://application:,,,/Assets/LauncherLogos/xbox.png" Height="11" Margin="0,0,3,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                               <TextBlock Text="XBOX" FontSize="{DynamicResource FontSizeBadge}" Foreground="{DynamicResource BrushSuccessText}"
                                                                          FontFamily="{DynamicResource AppFont}" FontWeight="SemiBold"/>
                                                           </StackPanel>
                                                       </Border>

                                                       <Border Background="{DynamicResource BrushAccentWash}" CornerRadius="{DynamicResource RadiusSmall}" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                           <Border.Style>
                                                               <Style TargetType="Border">
                                                                   <Setter Property="Visibility" Value="Collapsed"/>
                                                                   <Style.Triggers>
                                                                       <DataTrigger Binding="{Binding IsBattleNetGame}" Value="True">
                                                                           <Setter Property="Visibility" Value="Visible"/>
                                                                       </DataTrigger>
                                                                   </Style.Triggers>
                                                               </Style>
                                                           </Border.Style>
                                                           <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                               <Image Source="pack://application:,,,/Assets/LauncherLogos/battlenet.png" Height="11" Margin="0,0,3,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                               <TextBlock Text="B.NET" FontSize="{DynamicResource FontSizeBadge}" Foreground="{DynamicResource BrushInfoText}"
                                                                          FontFamily="{DynamicResource AppFont}" FontWeight="SemiBold"/>
                                                           </StackPanel>
                                                       </Border>
                                                       <Border Background="{DynamicResource BrushSurfaceHover}" CornerRadius="{DynamicResource RadiusSmall}" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                           <Border.Style>
                                                               <Style TargetType="Border">
                                                                   <Setter Property="Visibility" Value="Collapsed"/>
                                                                   <Style.Triggers>
                                                                       <DataTrigger Binding="{Binding IsLocalGame}" Value="True">
                                                                           <Setter Property="Visibility" Value="Visible"/>
                                                                       </DataTrigger>
                                                                   </Style.Triggers>
                                                               </Style>
                                                           </Border.Style>
                                                           <TextBlock Text="LOCAL" FontSize="{DynamicResource FontSizeBadge}" Foreground="{DynamicResource BrushTextSoft}"
                                                                      FontFamily="{DynamicResource AppFont}" FontWeight="SemiBold"/>
                                                       </Border>
                                                       <Border Background="{DynamicResource BrushBorder}" CornerRadius="{DynamicResource RadiusSmall}" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                           <Border.Style>
                                                               <Style TargetType="Border">
                                                                   <Setter Property="Visibility" Value="Collapsed"/>
                                                                   <Style.Triggers>
                                                                       <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                                                           <Setter Property="Visibility" Value="Visible"/>
                                                                       </DataTrigger>
                                                                   </Style.Triggers>
                                                               </Style>
                                                           </Border.Style>
                                                           <TextBlock Text="HIDDEN" FontSize="{DynamicResource FontSizeBadge}" FontWeight="Bold"
                                                                      Foreground="{DynamicResource BrushTextSoft}" FontFamily="{DynamicResource AppFont}"/>
                                                       </Border>
                                                       </StackPanel>
                                                       <TextBlock Text="{Binding Name}" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold"
                                                                  Foreground="{DynamicResource BrushTextPrimary}"
                                                                  FontFamily="{DynamicResource AppFont}"
                                                                  TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"
                                                                  VerticalAlignment="Center"/>
                                                   </DockPanel>

                                                   <!-- Category Pill -->
                                                   <Border Grid.Column="2" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushOverlayLine}" BorderThickness="1"
                                                           CornerRadius="{DynamicResource RadiusSmall}" Padding="7,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                       <TextBlock Text="{Binding Category}" FontSize="{DynamicResource FontSizeBadge}" 
                                                                  Foreground="{DynamicResource BrushTextSecondary}" 
                                                                  FontFamily="{DynamicResource AppFont}"/>
                                                   </Border>

                                                   <!-- Playtime -->
                                                   <TextBlock Grid.Column="3" Text="{Binding ListPlaytimeDisplay}" FontSize="{DynamicResource FontSizeBody}" 
                                                              Foreground="{DynamicResource BrushTextSecondary}" 
                                                              FontFamily="{DynamicResource AppFont}" VerticalAlignment="Center"/>

                                                   <!-- Last Played -->
                                                   <TextBlock Grid.Column="4" Text="{Binding LastPlayedDisplay}" FontSize="{DynamicResource FontSizeBody}" 
                                                              Foreground="{DynamicResource BrushTextMuted}" 
                                                              FontFamily="{DynamicResource AppFont}" VerticalAlignment="Center"/>

                                                   <!-- Action Buttons -->
                                                   <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                       <!-- Details needs no button here: a left-click anywhere on the row opens it. -->
                                                       <Button Command="{Binding LaunchCommand}" AutomationProperties.Name="Play Game"
                                                               Height="34" Width="34">
                                                           <Button.Style>
                                                               <Style TargetType="Button" BasedOn="{StaticResource CirclePlayButton}">
                                                                   <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
                                                                   <Style.Triggers>
                                                                       <!-- Hidden while games are multi-selected: Play is a single-game action. -->
                                                                       <DataTrigger Binding="{Binding DataContext.HasSelection, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                           <Setter Property="Visibility" Value="Collapsed"/>
                                                                       </DataTrigger>
                                                                   </Style.Triggers>
                                                               </Style>
                                                           </Button.Style>
                                                       </Button>
                                                   </StackPanel>
                                               </Grid>
                                           </Border>

                                           <DataTemplate.Triggers>
                                               <DataTrigger Binding="{Binding IsUnavailable}" Value="True">
                                                   <Setter TargetName="ListRowBorder" Property="Opacity" Value="0.82"/>
                                                   <Setter TargetName="ListRowBorder" Property="BorderBrush" Value="{DynamicResource BrushWarningBorder}"/>
                                               </DataTrigger>
                                               <DataTrigger Binding="{Binding IsNotInstalled}" Value="True">
                                                   <Setter TargetName="ListRowBorder" Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
                                               </DataTrigger>
                                               <Trigger Property="IsMouseOver" Value="True">
                                                   <Setter TargetName="ListRowBorder" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                                                   <Setter TargetName="ListRowBorder" Property="Background" Value="{DynamicResource BrushSurfaceHover}"/>
                                               </Trigger>
                                               <!-- Stays lit while the row's right-click menu is open (the menu takes the mouse). -->
                                               <DataTrigger Binding="{Binding IsContextMenuOpen}" Value="True">
                                                   <Setter TargetName="ListRowBorder" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                                                   <Setter TargetName="ListRowBorder" Property="Background" Value="{DynamicResource BrushSurfaceHover}"/>
                                               </DataTrigger>
                                               <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                   <Setter TargetName="ListRowBorder" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                                                   <Setter TargetName="ListRowBorder" Property="BorderThickness" Value="2"/>
                                               </DataTrigger>
                                           </DataTemplate.Triggers>
                                       </DataTemplate>
                                   </ListBox.ItemTemplate>
                               </ListBox>
                           </Grid>

                           <!-- Floating bars over the bottom of the grid: the selection bar, then the undo
                                toast. They float so the grid never moves when one appears, and they stack so
                                both can show at once. -->
                           <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18" Panel.ZIndex="100">

                           <!-- Selection bar (UX-06): says a selection exists and offers what the batch
                                menu does. The menu stays the fast path; More opens it. Named so the
                                window's click-away (Window_PreviewMouseDown) leaves the selection alone. -->
                           <Border x:Name="SelectionBar" Style="{StaticResource SelectionBarStyle}"
                                   Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                               <StackPanel Orientation="Horizontal">
                                   <TextBlock Text="{Binding SelectionSummary}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,12,0"
                                              Foreground="{DynamicResource BrushTextPrimary}"/>
                                   <Button Command="{Binding BatchFavoriteCommand}" Style="{StaticResource SelectionBarButton}"
                                           AutomationProperties.Name="{Binding BatchFavoriteLabel}">
                                       <StackPanel Orientation="Horizontal">
                                           <TextBlock Text="&#xE734;" Style="{StaticResource SelectionBarGlyph}"/>
                                           <TextBlock Text="{Binding BatchFavoriteLabel}"/>
                                       </StackPanel>
                                   </Button>
                                   <Button Command="{Binding BatchChangeCategoryCommand}" Style="{StaticResource SelectionBarButton}"
                                           AutomationProperties.Name="Change Category">
                                       <StackPanel Orientation="Horizontal">
                                           <TextBlock Text="&#xE8EC;" Style="{StaticResource SelectionBarGlyph}"/>
                                           <TextBlock Text="Change Category..."/>
                                       </StackPanel>
                                   </Button>
                                   <Button Command="{Binding BatchHideCommand}" Style="{StaticResource SelectionBarButton}"
                                           AutomationProperties.Name="{Binding BatchHideLabel}">
                                       <StackPanel Orientation="Horizontal">
                                           <TextBlock Text="&#xED1A;" Style="{StaticResource SelectionBarGlyph}"/>
                                           <TextBlock Text="{Binding BatchHideLabel}"/>
                                       </StackPanel>
                                   </Button>
                                   <Button Click="SelectionBarMore_Click" Style="{StaticResource SelectionBarButton}"
                                           AutomationProperties.Name="More batch actions" ToolTip="Every batch action, as in the right-click menu">
                                       <StackPanel Orientation="Horizontal">
                                           <TextBlock Text="More"/>
                                           <TextBlock Text="&#xE70D;" Style="{StaticResource SelectionBarGlyph}" Margin="6,1,0,0"/>
                                       </StackPanel>
                                   </Button>
                                   <Rectangle Width="1" Fill="{DynamicResource BrushBorderStrong}" Margin="6,4"/>
                                   <Button Command="{Binding ClearSelectionCommand}" Style="{StaticResource SelectionBarButton}"
                                           AutomationProperties.Name="Clear selection" ToolTip="Clear selection (Esc)">
                                       <StackPanel Orientation="Horizontal">
                                           <TextBlock Text="&#xE711;" Style="{StaticResource SelectionBarGlyph}"/>
                                           <TextBlock Text="Clear"/>
                                       </StackPanel>
                                   </Button>
                               </StackPanel>
                           </Border>

                           <!-- Floating Non-Blocking Undo Toast. The 10-second window pauses while the
                                pointer is over it or it has keyboard focus (OnUndoToastHoldChanged). -->
                           <Border HorizontalAlignment="Center" Margin="0,8,0,0"
                                   Background="{DynamicResource BrushSurfaceHover}" BorderBrush="{DynamicResource BrushAccent}" BorderThickness="1.5"
                                   CornerRadius="{DynamicResource RadiusCard}" Padding="16,10"
                                   MouseEnter="OnUndoToastHoldChanged" MouseLeave="OnUndoToastHoldChanged"
                                   IsKeyboardFocusWithinChanged="OnUndoToastFocusChanged" IsVisibleChanged="OnUndoToastFocusChanged">
                               <Border.Effect>
                                   <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.5" Color="{DynamicResource ColorFloatingShadow}"/>
                               </Border.Effect>
                               <Border.Style>
                                   <Style TargetType="Border">
                                       <Setter Property="Visibility" Value="Collapsed"/>
                                       <Style.Triggers>
                                           <DataTrigger Binding="{Binding IsUndoToastVisible}" Value="True">
                                               <Setter Property="Visibility" Value="Visible"/>
                                           </DataTrigger>
                                       </Style.Triggers>
                                   </Style>
                               </Border.Style>
                               <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                   <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeSubhead}" Margin="0,0,10,0" VerticalAlignment="Center"
                                              Foreground="{DynamicResource BrushAccent}"/>
                                   <TextBlock Text="{Binding UndoToastMessage}" Foreground="{DynamicResource BrushTextPrimary}"
                                              FontSize="{DynamicResource FontSizeBody}" FontFamily="{DynamicResource AppFont}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                   <Button Content="UNDO" Command="{Binding UndoDeleteCommand}"
                                           Style="{StaticResource ModernAccentButton}" Padding="12,4" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                   <Button Content="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeBody}" Command="{Binding DismissUndoToastCommand}"
                                           Style="{StaticResource ModernGhostButton}" Padding="6,4" VerticalAlignment="Center" ToolTip="Dismiss"
        AutomationProperties.Name="Dismiss"/>
                               </StackPanel>
                           </Border>

                           </StackPanel>

                           <!-- The floating launch/import toast used to sit here; it now lives at the top of
                                the MAIN CONTENT AREA grid so it also renders over Settings/System/About. -->
                       </Grid>

                       <!-- 5. Status Bar -->
                       <!-- Right-docked parts are laid out first so the status message is what trims
                            when the row runs out of room, never the hotkey or the selection hint. -->
                       <DockPanel Grid.Row="4" Margin="0,14,0,0" LastChildFill="True">
                           <!-- Bound to the configurable hotkey, not hard-coded to Ctrl+Alt+G. -->
                           <!-- Only for the first five sessions (UX-14e); after that the tray tooltip says it. -->
                           <TextBlock DockPanel.Dock="Right" Text="{Binding SettingsVM.GlobalManageHotkey, StringFormat='Hotkey: {0} to show or hide this window'}" FontSize="{DynamicResource FontSizeBody}"
                                      Visibility="{Binding SettingsVM.ShowHotkeyHint, Converter={StaticResource BoolToVis}}"
                                      Foreground="{DynamicResource BrushTextMuted}" Margin="14,0,0,0"
                                      FontFamily="{DynamicResource AppFont}" VerticalAlignment="Center"/>
                           <!-- Multi-select hint: only while two or more cards are selected. -->
                           <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                               <StackPanel.Style>
                                   <Style TargetType="StackPanel">
                                       <Style.Triggers>
                                           <DataTrigger Binding="{Binding SelectionHint}" Value="">
                                               <Setter Property="Visibility" Value="Collapsed"/>
                                           </DataTrigger>
                                       </Style.Triggers>
                                   </Style>
                               </StackPanel.Style>
                               <TextBlock Text="{Binding SelectionHint}" FontSize="{DynamicResource FontSizeBody}"
                                          Foreground="{DynamicResource BrushAccentText}"
                                          FontFamily="{DynamicResource AppFont}" VerticalAlignment="Center"/>
                               <Button Style="{StaticResource HelpLinkButton}" Content="Learn more" Margin="10,0,0,0" VerticalAlignment="Center"
                                       Command="{x:Static services:HelpCommands.ShowTopic}" CommandParameter="library/select_mode"/>
                           </StackPanel>
                           <TextBlock Text="{Binding StatusMessage}" FontSize="{DynamicResource FontSizeBody}" TextTrimming="CharacterEllipsis"
                                      Foreground="{DynamicResource BrushTextSecondary}"
                                      FontFamily="{DynamicResource AppFont}" VerticalAlignment="Center"/>
                       </DockPanel>
    </Grid>
</UserControl>
