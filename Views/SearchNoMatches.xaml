<UserControl x:Class="TrayTrigger.Views.SearchNoMatches"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0" Visibility="Collapsed">
    <!-- What a page's card search shows when nothing on the selected tab matches. -->
    <StackPanel>
        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeDisplay}"
                   Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
        <TextBlock x:Name="TitleText" FontSize="{DynamicResource FontSizeTitle}" Foreground="{DynamicResource BrushTextPrimary}"
                   FontFamily="{DynamicResource AppFont}" HorizontalAlignment="Center"/>
        <TextBlock Text="Try a different word or another tab, or press Esc to clear the search."
                   FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushTextSecondary}"
                   FontFamily="{DynamicResource AppFont}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
    </StackPanel>
</UserControl>
