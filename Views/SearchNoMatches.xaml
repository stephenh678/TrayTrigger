<UserControl x:Class="TrayTrigger.Views.SearchNoMatches"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0" Visibility="Collapsed">
    <!-- What a page's card search shows when nothing on the selected tab matches. -->
    <StackPanel>
        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="36"
                   Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
        <TextBlock x:Name="TitleText" FontSize="16" Foreground="{StaticResource BrushTextPrimary}"
                   FontFamily="{StaticResource AppFont}" HorizontalAlignment="Center"/>
        <TextBlock Text="Try a different word or another tab, or press Esc to clear the search."
                   FontSize="13" Foreground="{StaticResource BrushTextSecondary}"
                   FontFamily="{StaticResource AppFont}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
    </StackPanel>
</UserControl>
