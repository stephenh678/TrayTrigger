<Window x:Class="TrayTrigger.Views.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="TrayTrigger - Update Available"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource BrushDialogBg}"
        Foreground="{StaticResource BrushTextPrimary}">

    <Border BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="0,1,0,0">
        <Grid Margin="24,20,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header with Badge & Version Comparison -->
                <RowDefinition Height="Auto"/> <!-- Release Notes Section -->
                <RowDefinition Height="Auto"/> <!-- Download Progress Section -->
                <RowDefinition Height="Auto"/> <!-- Action Buttons -->
            </Grid.RowDefinitions>

            <!-- Row 0: Header with Icon & Version Info -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Update Icon Badge -->
                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" 
                        Background="#1C2E3D" BorderBrush="#25547C" BorderThickness="1.5" 
                        Margin="0,0,16,0" VerticalAlignment="Top" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="18" 
                               Foreground="{StaticResource BrushAccentHover}" 
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Title & Version Row -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Update Available!" FontSize="15" FontWeight="SemiBold" 
                               Foreground="{StaticResource BrushTextPrimary}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0" VerticalAlignment="Center">
                        <!-- Current Version Badge -->
                        <Border Background="#1C1C24" BorderBrush="#2D2D38" BorderThickness="1" CornerRadius="4" Padding="6,2">
                            <TextBlock x:Name="CurrentVersionText" Text="v1.0.0" FontSize="11" 
                                       Foreground="{StaticResource BrushTextMuted}" FontWeight="SemiBold"/>
                        </Border>

                        <TextBlock Text="➔" FontSize="12" Foreground="{StaticResource BrushTextMuted}" 
                                   Margin="8,0,8,0" VerticalAlignment="Center"/>

                        <!-- New Version Badge -->
                        <Border Background="#1A3326" BorderBrush="#2E6B47" BorderThickness="1" CornerRadius="4" Padding="6,2">
                            <TextBlock x:Name="NewVersionText" Text="v1.0.1" FontSize="11" 
                                       Foreground="#4EC9B0" FontWeight="SemiBold"/>
                        </Border>

                        <Border x:Name="LatestBadge" Background="#1C2E3D" CornerRadius="3" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="LATEST" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource BrushAccentHover}"/>
                        </Border>
                        <Border x:Name="PrereleaseBadge" Background="#3D2E1C" CornerRadius="3" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock Text="PRE-RELEASE" FontSize="8.5" FontWeight="Bold" Foreground="#E5A94B"/>
                        </Border>
                    </StackPanel>

                    <!-- Release Name -->
                    <TextBlock x:Name="ReleaseTitleText" Text="TrayTrigger Release" FontSize="12" 
                               FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" 
                               Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>

            <!-- Row 1: Release Notes Viewer -->
            <Border Grid.Row="1" Background="#141419" BorderBrush="{StaticResource BrushBorderDark}" 
                    BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="RELEASE NOTES" FontSize="9.5" FontWeight="SemiBold" 
                               Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,6"/>
                    <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="ReleaseNotesText" 
                                   Text="No release notes provided." 
                                   FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" 
                                   TextWrapping="Wrap" LineHeight="17" FontFamily="{StaticResource AppFont}"/>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- Row 2: Download Progress & Status Area -->
            <StackPanel x:Name="ProgressContainer" Grid.Row="2" Margin="0,0,0,16" Visibility="Collapsed">
                <DockPanel Margin="0,0,0,6">
                    <TextBlock x:Name="ProgressStatusText" Text="Downloading installer..." FontSize="11" 
                               Foreground="{StaticResource BrushTextSecondary}" DockPanel.Dock="Left"/>
                    <TextBlock x:Name="ProgressPercentText" Text="0%" FontSize="11" FontWeight="SemiBold" 
                               Foreground="{StaticResource BrushAccentHover}" DockPanel.Dock="Right"/>
                </DockPanel>
                <ProgressBar x:Name="DownloadProgressBar" Height="6" Minimum="0" Maximum="100" Value="0" 
                             Foreground="{StaticResource BrushAccentHover}" Background="#1C1C24" BorderThickness="0"/>
            </StackPanel>

            <!-- Row 3: Action Buttons Footer -->
            <DockPanel Grid.Row="3" LastChildFill="False">
                <Button x:Name="ViewOnGitHubBtn" Content="View on GitHub" 
                        Style="{StaticResource ModernOutlineButton}" 
                        Padding="14,6" DockPanel.Dock="Left" Click="OnViewOnGitHubClick"/>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button x:Name="RemindLaterBtn" Content="Remind Me Later" 
                            Style="{StaticResource ModernGhostButton}" 
                            Padding="14,6" Margin="0,0,8,0" 
                            IsCancel="True" Click="OnRemindLaterClick"/>

                    <Button x:Name="InstallBtn" Content="Download &amp; Install" 
                            Style="{StaticResource ModernAccentButton}" 
                            Padding="16,6" 
                            IsDefault="True" Click="OnInstallClick"/>
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</Window>
