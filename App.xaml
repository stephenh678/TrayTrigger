<Application x:Class="TrayTrigger.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:TrayTrigger.Converters"
             xmlns:theming="clr-namespace:TrayTrigger.Services.Theming"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="Resources/Colors.xaml"/>
            <ResourceDictionary Source="Resources/Typography.xaml"/>
            <ResourceDictionary Source="Resources/Shapes.xaml"/>
        </ResourceDictionary.MergedDictionaries>

        <!-- The height of the segmented tab strip at the top of every page (About, Settings, System, Activity, Tools, Library), so the
             strips are the same size from page to page, and the same height as the search box beside them. -->
        <sys:Double x:Key="TabStripHeight">44</sys:Double>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:TabBackgroundConverter x:Key="TabBackgroundConverter"/>
        <converters:TabForegroundConverter x:Key="TabForegroundConverter"/>
        <converters:ScrollEdgeConverter x:Key="ScrollEdgeConverter"/>
        <converters:RoundedClipConverter x:Key="RoundedClipConverter"/>
        <converters:PosterCardRadiusConverter x:Key="PosterCardRadiusConverter"/>
        <converters:PosterShadeClipConverter x:Key="PosterShadeClipConverter"/>
        <converters:AnyTrueConverter x:Key="AnyTrueConverter"/>
        <converters:PickByFlagConverter x:Key="PickByFlagConverter"/>

        <!-- Global Font -->
        <FontFamily x:Key="AppFont">Segoe UI</FontFamily>
        <FontFamily x:Key="IconFont">Segoe MDL2 Assets, Segoe Fluent Icons</FontFamily>

        <!-- Keyboard focus: a 1 px accent ring drawn only when focus arrives by keyboard (Tab,
             arrows), never on a mouse click. WPF's own dotted rectangle is black and vanished on
             the dark surfaces, so buttons, tabs, the sidebar and list rows showed no focus at all. -->
        <Style x:Key="KeyboardFocusRing">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border Margin="-2" CornerRadius="{DynamicResource RadiusControl}" BorderThickness="1" SnapsToDevicePixels="True"
                                BorderBrush="{DynamicResource BrushAccentHover}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="KeyboardFocusRingRound">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border Margin="-2" CornerRadius="{DynamicResource RadiusLarge}" BorderThickness="1" SnapsToDevicePixels="True"
                                BorderBrush="{DynamicResource BrushAccentHover}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A Details List or Tools list row: hugs the row's own border, inside the item's spacing. -->
        <Style x:Key="ListRowFocusRing">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border Margin="0,2,0,3" CornerRadius="{DynamicResource RadiusControl}" BorderThickness="1" SnapsToDevicePixels="True"
                                BorderBrush="{DynamicResource BrushAccentHover}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A bare ItemsControl only hosts items (tab strips, card grids, tweak lists), yet WPF makes
             it a tab stop of its own that shows nothing when focused. Its items stay reachable. -->
        <Style TargetType="ItemsControl">
            <Setter Property="Focusable" Value="False"/>
        </Style>

        <!-- Modern Danger Button -->
        <Style x:Key="ModernDangerButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusRing}"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextOnSolid}"/>
            <Setter Property="Background" Value="{DynamicResource BrushDangerSolid}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="11,5"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource RadiusSmall}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BrushDangerSolidHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BrushDangerBorder}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BrushDangerWash}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextDisabled}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Accent Button -->
        <Style x:Key="ModernAccentButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusRing}"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextOnSolid}"/>
            <Setter Property="Background" Value="{DynamicResource BrushAccent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="11,5"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource RadiusSmall}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BrushAccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BrushAccentPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Circular Play Button (dark fill by default, accent blue on hover) -->
        <Style x:Key="CirclePlayButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusRingRound}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PlayCircle" CornerRadius="{DynamicResource RadiusLarge}" Background="{DynamicResource BrushScrim}"
                                BorderBrush="{DynamicResource BrushAccent}" BorderThickness="1.5">
                            <TextBlock Text="&#9654;" FontSize="{TemplateBinding FontSize}" Foreground="{DynamicResource BrushTextOnSolid}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PlayCircle" Property="Background" Value="{DynamicResource BrushAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Outline Button -->
        <Style x:Key="ModernOutlineButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusRing}"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,5"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="{DynamicResource RadiusSmall}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BrushSurfaceHover}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BrushBorder}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Ghost Button -->
        <Style x:Key="ModernGhostButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusRing}"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource RadiusSmall}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BrushSurfaceHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BrushBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- Help Link: the inline "Learn more" text link that opens a HelpDialog topic. Plain accent
             text, underline on hover, no chrome - sits under a control's one-line hint. Use with
             Command="{x:Static services:HelpCommands.ShowTopic}" CommandParameter="section/topic". -->
        <!-- The "Key works" line under a SteamGridDB or RAWG key box, bound to an
             ApiKeyCheckViewModel. Shared by Settings and the Welcome dialog. -->
        <Style x:Key="ApiKeyCheckStatusText" TargetType="TextBlock">
            <Setter Property="Text" Value="{Binding Message}"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasMessage}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Valid">
                    <Setter Property="Foreground" Value="{DynamicResource BrushSuccessText}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Rejected">
                    <Setter Property="Foreground" Value="{DynamicResource BrushDanger}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Unreachable">
                    <Setter Property="Foreground" Value="{DynamicResource BrushWarning}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HelpLinkButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushAccentText}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Content" Value="Learn more"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="txt" Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}"
                                   FontFamily="{TemplateBinding FontFamily}"
                                   Padding="{TemplateBinding Padding}"
                                   VerticalAlignment="Center"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="txt" Property="TextDecorations" Value="Underline"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="txt" Property="TextDecorations" Value="Underline"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource BrushAccentPressed}"/>
                            </Trigger>
                            <!-- A link with nothing to do reads as disabled in the theme's disabled text color. -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextDisabled}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented Tab Button: for pill/segmented switchers (System page's Specs/Tweaks
             tabs, library view-mode switcher). Bind Tag to a bool indicating "this segment is
             active". Background/Foreground are driven by MultiBinding converters (not XAML
             triggers) combining that active flag with live IsMouseOver - matching a trigger's
             string Value against a boxed bool read through an object-typed property (Tag) via
             RelativeSource TemplatedParent is unreliable in WPF; a converter works with the
             actual runtime values directly, sidestepping that entirely. -->
        <Style x:Key="SegmentedTabButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusRing}"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Tag" Value="False"/>
            <Setter Property="Foreground">
                <Setter.Value>
                    <MultiBinding Converter="{StaticResource TabForegroundConverter}">
                        <Binding RelativeSource="{RelativeSource Self}" Path="Tag"/>
                        <Binding RelativeSource="{RelativeSource Self}" Path="IsMouseOver"/>
                        <!-- The converter reads the theme's colors itself; this makes it run again when the theme changes. -->
                        <Binding Source="{x:Static theming:ThemeState.Instance}" Path="Version"/>
                    </MultiBinding>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="segBorder" CornerRadius="{DynamicResource RadiusSmall}" Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <MultiBinding Converter="{StaticResource TabBackgroundConverter}">
                                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Tag"/>
                                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="IsMouseOver"/>
                                    <Binding Source="{x:Static theming:ThemeState.Instance}" Path="Version"/>
                                </MultiBinding>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <!-- The selected tab looks selected; this says so to a screen reader too ("selected"
                 after the tab's name), since a Button has no selected state of its own. -->
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="AutomationProperties.ItemStatus" Value="selected"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Modern Sidebar Navigation Button -->
        <Style x:Key="SidebarNavButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusRing}"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource RadiusControl}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BrushSurfaceHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BrushBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="True">
                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                    <Setter Property="Padding" Value="10,0"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(AutomationProperties.Name)}"/>
                    <Setter Property="Padding" Value="0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Card Hover Quick Action Circle Buttons -->
        <Style x:Key="CardHoverCircleButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusRingRound}"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
            <Setter Property="Background" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="circleBorder" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="{DynamicResource RadiusLarge}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="circleBorder" Property="Background" Value="{DynamicResource BrushAccent}"/>
                                <Setter TargetName="circleBorder" Property="BorderBrush" Value="{DynamicResource BrushAccentHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextOnSolid}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="circleBorder" Property="Background" Value="{DynamicResource BrushAccentPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardHoverDeleteButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusRingRound}"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
            <Setter Property="Background" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="circleBorder" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="{DynamicResource RadiusLarge}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="circleBorder" Property="Background" Value="{DynamicResource BrushDangerSolid}"/>
                                <Setter TargetName="circleBorder" Property="BorderBrush" Value="{DynamicResource BrushDangerSolidHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextOnSolid}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="circleBorder" Property="Background" Value="{DynamicResource BrushDangerBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Favorite Star Toggle (Game Cards, List Rows, Details Dialog) -->
        <Style x:Key="FavoriteToggleButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusRingRound}"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource RadiusCard}">
                            <TextBlock x:Name="StarGlyph" Text="&#xE734;" FontFamily="{StaticResource IconFont}"
                                       FontSize="{TemplateBinding FontSize}" Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                <Setter TargetName="StarGlyph" Property="Text" Value="&#xE735;"/>
                                <Setter TargetName="StarGlyph" Property="Foreground" Value="{DynamicResource BrushGold}"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="StarGlyph" Property="Foreground" Value="{DynamicResource BrushGold}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Search & Input TextBox with Placeholder Support -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource BrushDialogCard}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="CaretBrush" Value="{DynamicResource BrushAccent}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="{DynamicResource RadiusSmall}">
                            <Grid>
                                <TextBlock Text="{TemplateBinding Tag}" Foreground="{DynamicResource BrushTextDisabled}" FontSize="{StaticResource FontSizeBody}" 
                                           Margin="9,5" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <!-- Windows already insets the text by the box's Padding. A margin of the same Padding on
                                     top doubled it: typed text sat twice as far in as the placeholder and as the
                                     text of a drop-down beside it. Only the vertical half is kept, which is what
                                     gives the box the height the layouts were built around. -->
                                <ScrollViewer x:Name="PART_ContentHost" Margin="0,5"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource BrushBorderAccent}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                            </Trigger>
                            <!-- Faded like a disabled check box, so a box that ignores typing doesn't look ready for it. -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBox Toggle Button -->
        <Style x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ClickMode" Value="Press"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="templateRoot" Background="{DynamicResource BrushDialogCard}" BorderBrush="{DynamicResource BrushBorder}" 
                                BorderThickness="1" CornerRadius="{DynamicResource RadiusSmall}">
                            <Border x:Name="splitBorder" Width="20" HorizontalAlignment="Right" 
                                    Margin="0" BorderThickness="0" Background="Transparent">
                                <Path x:Name="arrow" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                      Data="M 0 0 L 3.5 3.5 L 7 0 Z" Fill="{DynamicResource BrushTextSecondary}"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="templateRoot" Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
                                <Setter TargetName="arrow" Property="Fill" Value="{DynamicResource BrushTextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Dark ComboBox -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusRing}"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource BrushDialogCard}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="toggleButton" Style="{StaticResource ComboBoxToggleButton}" 
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter x:Name="contentPresenter" Content="{TemplateBinding SelectionBoxItem}" 
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                              Margin="{TemplateBinding Padding}" 
                                              HorizontalAlignment="Left" VerticalAlignment="Center" 
                                              IsHitTestVisible="False"/>
                            <TextBox x:Name="PART_EditableTextBox"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                     Margin="9,0,24,0"
                                     Focusable="True"
                                     Background="Transparent"
                                     Foreground="{DynamicResource BrushTextPrimary}"
                                     CaretBrush="{DynamicResource BrushTextPrimary}"
                                     BorderThickness="0"
                                     FontFamily="{TemplateBinding FontFamily}"
                                     FontSize="{TemplateBinding FontSize}"
                                     Visibility="Hidden"
                                     IsReadOnly="{TemplateBinding IsReadOnly}"/>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" 
                                   IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom">
                                <Border x:Name="dropDownBorder" Background="{DynamicResource BrushSurface}" 
                                        BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" 
                                        CornerRadius="{DynamicResource RadiusSmall}" Padding="3" Margin="0,3,0,0" MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer MaxHeight="220" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="dropDownBorder" Property="MinHeight" Value="60"/>
                            </Trigger>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter Property="IsTabStop" Value="False"/>
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="contentPresenter" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBoxItem Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="border" Background="Transparent" CornerRadius="{DynamicResource RadiusSmall}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BrushSurfaceHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BrushAccent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextOnSolid}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filter flyout option row: a full-width row with a blue check in a fixed gutter. The check is what says
             "on" and nothing is drawn while it is off, so a list of unticked options stays quiet; the row itself
             never fills, so a row cannot look picked unless it has the check. A ToggleButton rather than a CheckBox
             because the settings options have a third state, the opposite ("DLSS Override off"): it keeps the same
             blue check, and its label turns the warning color, so the wording and the color say which way it is asked for. -->
        <Style x:Key="FilterOptionToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusRing}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" Background="Transparent" CornerRadius="{DynamicResource RadiusSmall}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <DockPanel>
                                <Grid x:Name="Gutter" DockPanel.Dock="Left" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <Path x:Name="Tick" Data="M 3.5,8.2 L 6.6,11.2 L 12.4,4.9" Stroke="{DynamicResource BrushAccentText}" StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
                                </Grid>
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BrushSurfaceHover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <!-- The opposite (the third state): the same blue check, and the label in the warning color. -->
                            <Trigger Property="IsChecked" Value="{x:Null}">
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushWarning}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A saved filter's row in the library filter flyout: the same gutter and blue check as the options, shown while
             it is the filter on screen. It is a button (applying a saved filter is an action, not a tick) and Tag says
             whether it is the one on screen. -->
        <Style x:Key="FilterSavedRow" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusRing}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="Transparent" CornerRadius="{DynamicResource RadiusSmall}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <DockPanel>
                                <Grid x:Name="Gutter" DockPanel.Dock="Left" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <Path x:Name="Tick" Data="M 3.5,8.2 L 6.6,11.2 L 12.4,4.9" Stroke="{DynamicResource BrushAccentText}" StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
                                </Grid>
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BrushSurfaceHover}"/>
                            </Trigger>
                            <!-- A DataTrigger, not a Trigger on Tag: Tag is an object, so a plain Trigger compares the string
                                 "True" with the bool the binding puts there and never matches. Among a template's own triggers
                                 the control is "Self"; TemplatedParent would look one level further out and find nothing. -->
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <!-- The tick is only seen; this says "applied" to a screen reader too, as a selected tab says "selected". -->
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="AutomationProperties.ItemStatus" Value="applied"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The small glyph button beside a saved filter (delete): a row-height hover wash and nothing else. -->
        <Style x:Key="FilterSavedGlyphButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="Transparent" CornerRadius="{DynamicResource RadiusSmall}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BrushSurfaceHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Sleek Dark ScrollBar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Bg" SnapsToDevicePixels="true" Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="False">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="thumbBorder" CornerRadius="{DynamicResource RadiusSmall}" Background="{DynamicResource BrushBorder}"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="thumbBorder" Property="Background" Value="{DynamicResource BrushBorderStrong}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="thumbBorder" Property="Background" Value="{DynamicResource BrushAccentHover}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- A vertical scrollbar's value increases downward while its track's
                                 "increase" side is visually below the thumb, so it needs the track
                                 direction reversed. A horizontal scrollbar's value already increases
                                 left-to-right in the same direction as its track, so reversing it
                                 (the previous unconditional default) swapped left/right dragging
                                 and made the left/right ends scroll the opposite way. -->
                            <Trigger Property="Orientation" Value="Vertical">
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="True"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="6"/>
                    <Setter Property="MinHeight" Value="6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern CheckBox -->
        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <!-- Without a template this was the stock white Windows box, the one bright square in a
                 dark window. Unchecked: an outlined dark box. Checked: accent fill, white tick.
                 Indeterminate: accent fill, white dash. Keyboard focus rings the box in the accent. -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent" SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="FocusRing" Width="22" Height="22" CornerRadius="{DynamicResource RadiusControl}" BorderThickness="2"
                                    BorderBrush="{DynamicResource BrushAccentHover}" Visibility="Collapsed" Margin="-3"/>
                            <Border x:Name="Box" Width="16" Height="16" CornerRadius="{DynamicResource RadiusSmall}" VerticalAlignment="Center"
                                    Background="{DynamicResource BrushDialogCard}" BorderBrush="{DynamicResource BrushTextDisabled}" BorderThickness="1">
                                <Grid>
                                    <Path x:Name="Tick" Data="M 3.5,8.2 L 6.6,11.2 L 12.4,4.9" Stroke="{DynamicResource BrushTextOnSolid}" StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
                                    <Rectangle x:Name="Dash" Width="8" Height="2" RadiusX="1" RadiusY="1" Fill="{DynamicResource BrushTextOnSolid}" Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="8,0,0,0" RecognizesAccessKey="True"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BrushAccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource BrushAccent}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="{x:Null}">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource BrushAccent}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                                <Setter TargetName="Dash" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Disabled = "not relevant yet": keep the tick visible so the default is still
                     readable, but fade the whole row so it isn't mistaken for an active choice. -->
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>


        <!-- Dark Context Menu -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource BrushDialogCard}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="Padding" Value="6,6"/>
            <Setter Property="MinWidth" Value="275"/>
            <Setter Property="Grid.IsSharedSizeScope" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="{DynamicResource RadiusCard}" Padding="{TemplateBinding Padding}"
                                MinWidth="{TemplateBinding MinWidth}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.65" Color="{DynamicResource ColorFloatingShadow}"/>
                            </Border.Effect>
                            <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="640">
                                <StackPanel IsItemsHost="True"/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tooltips: dark, like the context menus, instead of the stock light Windows box. Many
             are full sentences, so they wrap at MaxWidth. The TextBlock style inside the
             presenter reaches the TextBlock WPF generates for a plain string tooltip, and leaves
             any tooltip with its own content alone. -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="MaxWidth" Value="320"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource RadiusCard}" Padding="{TemplateBinding Padding}"
                                MaxWidth="{TemplateBinding MaxWidth}">
                            <ContentPresenter>
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A slider: a thin track filled with the accent up to a round thumb. Foreground is the filled part and Background the
             rest, so a slider set to Transparent for both is just a thumb over whatever is drawn behind it (the color picker's
             hue strip). The thumb gets a ring while the keyboard is on the slider. -->
        <Style x:Key="SliderRepeatStyle" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" CornerRadius="{DynamicResource RadiusSmall}" Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderThumbStyle" TargetType="Thumb">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBackground}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border CornerRadius="{DynamicResource RadiusLarge}" Background="{DynamicResource BrushTextPrimary}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ThemeSliderStyle" TargetType="Slider">
            <Setter Property="Foreground" Value="{DynamicResource BrushAccent}"/>
            <Setter Property="Background" Value="{DynamicResource BrushBorderStrong}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent" SnapsToDevicePixels="True">
                            <Border Height="4" CornerRadius="{DynamicResource RadiusSmall}" Background="{TemplateBinding Background}" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderRepeatStyle}" Background="{TemplateBinding Foreground}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderRepeatStyle}" Background="Transparent"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb" Style="{StaticResource SliderThumbStyle}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Thumb" Property="BorderBrush" Value="{DynamicResource BrushAccentHover}"/>
                                <Setter TargetName="Thumb" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A plain disclosure: chevron and label on one line, content below when open. Used for
             Edit Game's "Advanced launch options". The header is a ToggleButton, so it takes Tab,
             Space and the keyboard focus ring like any button. -->
        <Style x:Key="DisclosureExpander" TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <DockPanel>
                            <ToggleButton x:Name="HeaderToggle" DockPanel.Dock="Top" HorizontalAlignment="Left"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          AutomationProperties.Name="{TemplateBinding Header}"
                                          FocusVisualStyle="{StaticResource KeyboardFocusRing}" Cursor="Hand"
                                          Foreground="{TemplateBinding Foreground}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <StackPanel Orientation="Horizontal" Background="Transparent">
                                            <TextBlock x:Name="Chevron" Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource FontSizeBadge}"
                                                       VerticalAlignment="Center" Margin="0,1,6,0" Foreground="{TemplateBinding Foreground}"/>
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="Text" Value="&#xE70D;"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                            </ToggleButton>
                            <ContentPresenter x:Name="Body" Visibility="Collapsed"/>
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="Body" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The floating selection bar over the Library and Tools grids (UX-06), and its
             compact buttons: icon plus label, ghost until hovered. -->
        <Style x:Key="SelectionBarStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="TextElement.FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="TextElement.FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.5" Color="{DynamicResource ColorFloatingShadow}"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SelectionBarButton" TargetType="Button" BasedOn="{StaticResource ModernGhostButton}">
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SelectionBarGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="Margin" Value="0,1,6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SpecStaticPill" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BrushDialogCard}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushSurfaceHover}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource BrushSuccessText}"/>
            <Setter Property="TextElement.FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="SpecLivePill" TargetType="Border" BasedOn="{StaticResource SpecStaticPill}">
            <Setter Property="Background" Value="{DynamicResource BrushAccentWash}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderAccent}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource BrushAccentText}"/>
        </Style>

        <!-- A horizontal strip that scrolls without a scrollbar (UX-14f): the Library and Tools
             category tabs. When tabs run past an edge, that edge fades out and shows a chevron;
             pressing it (or holding it) scrolls that way. Keyboard users reach every tab with Tab,
             which scrolls it into view, so the chevrons are not tab stops. The fade matches the
             strip's #181820 background. -->
        <Style x:Key="EdgeChevronButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Interval" Value="40"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="{TemplateBinding Background}">
                            <TextBlock Text="{TemplateBinding Content}" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource FontSizeBadge}"
                                       Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"
                                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="4,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EdgeChevronScrollViewer" TargetType="ScrollViewer">
            <Setter Property="HorizontalScrollBarVisibility" Value="Hidden"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <ScrollContentPresenter CanContentScroll="{TemplateBinding CanContentScroll}"/>
                            <RepeatButton Style="{StaticResource EdgeChevronButton}" HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                                          Content="&#xE76B;" Background="{DynamicResource BrushTabStripFadeLeft}"
                                          Command="{x:Static ScrollBar.LineLeftCommand}" AutomationProperties.Name="Scroll tabs left">
                                <RepeatButton.Visibility>
                                    <MultiBinding Converter="{StaticResource ScrollEdgeConverter}" ConverterParameter="Left">
                                        <Binding Path="HorizontalOffset" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="ScrollableWidth" RelativeSource="{RelativeSource TemplatedParent}"/>
                                    </MultiBinding>
                                </RepeatButton.Visibility>
                            </RepeatButton>
                            <RepeatButton Style="{StaticResource EdgeChevronButton}" HorizontalAlignment="Right" HorizontalContentAlignment="Right"
                                          Content="&#xE76C;" Background="{DynamicResource BrushTabStripFadeRight}"
                                          Command="{x:Static ScrollBar.LineRightCommand}" AutomationProperties.Name="Scroll tabs right">
                                <RepeatButton.Visibility>
                                    <MultiBinding Converter="{StaticResource ScrollEdgeConverter}" ConverterParameter="Right">
                                        <Binding Path="HorizontalOffset" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="ScrollableWidth" RelativeSource="{RelativeSource TemplatedParent}"/>
                                    </MultiBinding>
                                </RepeatButton.Visibility>
                            </RepeatButton>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The tray menu's search box (UX-16): no chrome of its own, so the row looks like any
             other tray row; the caret and the placeholder behind it say it takes typing. -->
        <Style x:Key="TraySearchBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource BrushAccent}"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="menuItemBorder" Background="Transparent" CornerRadius="{DynamicResource RadiusControl}" Padding="{TemplateBinding Padding}" Margin="0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="IconGroup"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ArrowGroup"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" ContentSource="Icon" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <!-- Current state for a checkable item (a profile tier, Run as Administrator). Hidden,
                                     not collapsed, while unchecked so the siblings in a submenu keep one text column. -->
                                <TextBlock x:Name="CheckGlyph" Grid.Column="0" Text="&#xE73E;" Margin="0,0,10,0"
                                           FontFamily="{StaticResource IconFont}" FontSize="{StaticResource FontSizeBody}" Width="20" TextAlignment="Center"
                                           Foreground="{DynamicResource BrushAccentText}" VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                                <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center"/>
                                <TextBlock x:Name="SubmenuArrow" Grid.Column="2" Text="›" FontSize="{StaticResource FontSizeSubhead}" FontWeight="SemiBold" 
                                           Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" Margin="16,0,2,0"
                                           Visibility="Collapsed"/>
                                <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" 
                                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" 
                                       Placement="Right" VerticalOffset="-5" HorizontalOffset="4">
                                    <Border Background="{DynamicResource BrushDialogCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="{DynamicResource RadiusCard}" Padding="6,6" MinWidth="220">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.65" Color="{DynamicResource ColorFloatingShadow}"/>
                                        </Border.Effect>
                                        <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="640">
                                            <StackPanel IsItemsHost="True"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="menuItemBorder" Property="Background" Value="{DynamicResource BrushSurfaceHover}"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="True">
                                <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsCheckable" Value="True">
                                <Setter TargetName="CheckGlyph" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tray menu rows. The default MenuItem padding (10,7) is sized for text-only rows; with a
             20 px icon it made a 40 px row, taller than the in-app menus (33 px) and Windows' own
             (32-36 px). 10,5 with a 20 px icon is 32 px. Compact drops to 26 px with 16 px icons. -->
        <Style x:Key="TrayMenuItemStyle" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="Padding" Value="10,5"/>
        </Style>
        <Style x:Key="TrayMenuCompactItemStyle" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        </Style>

        <!-- A Segoe glyph in a MenuItem.Icon slot: 20 px wide so it lines up with a 20 px game icon
             in the same column. Shared by the tray menu (built in code) and the in-app menus. -->
        <Style x:Key="MenuGlyphIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
        </Style>

        <!-- One separator everywhere: a 1 px low-contrast line. -->
        <Style x:Key="AppSeparatorStyle" TargetType="Separator">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceHover}"/>
            <Setter Property="Margin" Value="4,5"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Background="{TemplateBinding Background}" Height="1" SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Separator" BasedOn="{StaticResource AppSeparatorStyle}"/>

        <!-- WPF does not give a Separator inside a Menu or ContextMenu the implicit style above: it
             looks up this key instead, and without it falls back to the system default - the
             bright, heavy rule the tray menu and the card, batch and tool context menus all had. -->
        <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator" BasedOn="{StaticResource AppSeparatorStyle}">
            <Setter Property="Margin" Value="8,4"/>
        </Style>

        <!-- Tray Context Menu Section Header (Non-interactive) -->
        <!-- A non-interactive label inside a menu. Used for the tray menu's section headings and
             for the batch context menu's selection count. -->
        <Style x:Key="MenuSectionHeaderStyle" TargetType="MenuItem">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border Background="Transparent" Padding="12,7,12,3" Margin="0">
                            <TextBlock Text="{TemplateBinding Header}" 
                                       FontSize="{TemplateBinding FontSize}" 
                                       FontWeight="{TemplateBinding FontWeight}" 
                                       Foreground="{TemplateBinding Foreground}" 
                                       FontFamily="{TemplateBinding FontFamily}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
