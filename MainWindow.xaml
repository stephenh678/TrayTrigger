                                            </Border>
                                            <Border Background="#1E2028" CornerRadius="4" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text=".NET 10.0" FontSize="10.5" Foreground="#85929E" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
