                                                        <Border Background="#D9153A2B" BorderBrush="#33FFFFFF" BorderThickness="1"
                                                                CornerRadius="4" Padding="6,2" Height="19" VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsEaGame}" Value="True">
