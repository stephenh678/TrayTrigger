<Window x:Class="TrayTrigger.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TrayTrigger.ViewModels"
        xmlns:views="clr-namespace:TrayTrigger.Views"
        xmlns:services="clr-namespace:TrayTrigger.Services"
        xmlns:models="clr-namespace:TrayTrigger.Models"
        mc:Ignorable="d"
        Title="TrayTrigger - Game Launcher"
        Height="700" Width="1020"
        MinHeight="500" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBgDark}"
        ShowInTaskbar="True"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseDown="Window_PreviewMouseDown">

    <Window.Resources>
        <!-- Batch context menu: shown instead of the game menu when the right-clicked card is one
             of two or more selected cards (Ctrl/Shift+click, Ctrl+A). Its DataContext is set to
             the MainViewModel by MainWindow.OnCardContextMenuOpening; every item applies to the
             whole selection through LibraryViewModel's batch commands. -->
        <ContextMenu x:Key="GameBatchContextMenu">
            <!-- Same items, order, check marks, and grouping as the single-game menu below,
                 minus everything that only makes sense for one game. -->
            <MenuItem Header="{Binding BatchFavoriteLabel}" IsCheckable="True" IsChecked="{Binding BatchAllFavorite, Mode=OneWay}" Command="{Binding BatchFavoriteCommand}"/>
            <MenuItem Header="{Binding BatchHideLabel}" IsCheckable="True" IsChecked="{Binding BatchAllHidden, Mode=OneWay}" Command="{Binding BatchHideCommand}"/>
            <Separator/>
            <MenuItem Header="Change Category..." Command="{Binding BatchChangeCategoryCommand}"/>
            <!-- Same three tiers as Edit Game; the check shows the tier when every selected game
                 shares it, nothing when they differ. -->
            <MenuItem Header="Performance Profile">
                <MenuItem Header="Off" IsCheckable="True" IsChecked="{Binding BatchProfileIsOff, Mode=OneWay}"
                          Command="{Binding BatchSetProfileCommand}" CommandParameter="{x:Static models:PerformanceProfileMode.Off}"/>
                <MenuItem Header="Optimized" IsCheckable="True" IsChecked="{Binding BatchProfileIsOptimized, Mode=OneWay}"
                          Command="{Binding BatchSetProfileCommand}" CommandParameter="{x:Static models:PerformanceProfileMode.Optimized}"/>
                <MenuItem Header="Aggressive" IsCheckable="True" IsChecked="{Binding BatchProfileIsAggressive, Mode=OneWay}"
                          Command="{Binding BatchSetProfileCommand}" CommandParameter="{x:Static models:PerformanceProfileMode.Aggressive}"/>
            </MenuItem>
            <MenuItem Header="Refresh Poster &amp; Metadata" Command="{Binding BatchRefreshMetadataCommand}"/>
            <Separator/>
            <MenuItem Header="Remove from Library" Command="{Binding BatchRemoveCommand}" Foreground="#E06C75"/>
        </ContextMenu>

        <!-- Reusable Game Context Menu shared across Grid, Icons, and List views -->
        <ContextMenu x:Key="GameItemContextMenu"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <!-- Play first and bold: it is the most frequent action on a game. Details second
                 (it is also the card's left-click), and named for every platform, not just Steam. -->
            <MenuItem Header="Play" Command="{Binding LaunchCommand}" FontWeight="SemiBold"/>
            <MenuItem Header="Game Details..." Command="{Binding ViewDetailsCommand}"/>
            <MenuItem Header="End Session (restore tweaks)" Command="{Binding EndSessionCommand}">
                <MenuItem.Style>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <MenuItem Header="Force Close Game" Command="{Binding ForceCloseCommand}">
                <MenuItem.Style>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <MenuItem Header="{Binding FavoriteMenuLabel}" IsCheckable="True" IsChecked="{Binding IsFavorite, Mode=OneWay}" Command="{Binding ToggleFavoriteCommand}"/>
            <MenuItem Header="{Binding HideMenuLabel}" IsCheckable="True" IsChecked="{Binding IsHidden, Mode=OneWay}" Command="{Binding ToggleHiddenCommand}"/>
            <MenuItem Header="Open Containing Folder" Command="{Binding OpenFolderCommand}"/>

            <!-- Broken Game Relocate Option -->
            <MenuItem Header="Locate Executable..." Command="{Binding RelocateCommand}">
                <MenuItem.Style>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>

            <Separator/>

            <!-- Quick Actions: the umbrella (Edit Game Properties) first, then the shortcuts into it. -->
            <MenuItem Header="Edit Game Properties..." Command="{Binding EditCommand}"/>
            <MenuItem Header="Rename..." Command="{Binding RenameCommand}"/>
            <MenuItem Header="Fetch Official Name (Steam / Exe)" Command="{Binding FetchExeNameCommand}">
                <MenuItem.Style>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSteamGame}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <MenuItem Header="Change Category..." Command="{Binding ChangeCategoryCommand}"/>
            <MenuItem Header="Change Icon..." Command="{Binding ChangeIconCommand}"/>
            <MenuItem Header="Change Poster Artwork..." Command="{Binding ChangeCoverCommand}"/>
            <MenuItem Header="Set Steam App ID..." Command="{Binding EditSteamAppIdCommand}"/>
            <MenuItem Header="Refresh Poster &amp; Metadata" Command="{Binding RefreshMetadataCommand}"/>

            <!-- Steam Specific Actions -->
            <Separator>
                <Separator.Style>
                    <Style TargetType="Separator">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSteamOverlay}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Separator.Style>
            </Separator>
            <MenuItem Header="Steam Store Page" Command="{Binding OpenStoreCommand}">
                <MenuItem.Style>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSteamOverlay}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <MenuItem Header="Open in Steam Library" Command="{Binding OpenInSteamLibraryCommand}">
                <MenuItem.Style>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSteamOverlay}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <MenuItem Header="Verify Game Files" Command="{Binding VerifyFilesCommand}">
                <MenuItem.Style>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSteamOverlay}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>

            <Separator/>
            <MenuItem Header="Remove from Library" Command="{Binding DeleteCommand}" Foreground="#E06C75"/>
        </ContextMenu>

        <!-- Settings > Game Scanner: one row in the editable Scan Locations list -->
        <DataTemplate x:Key="ScanLocationRowTemplate" DataType="{x:Type vm:ScanLocationRowViewModel}">
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center"
                          Margin="0,0,10,0" Style="{StaticResource ModernCheckBox}"/>

                <TextBlock Grid.Column="1" Text="{Binding Path}" FontSize="12.5" Foreground="{StaticResource BrushTextPrimary}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                <Button Grid.Column="2" Content="Remove"
                        Command="{Binding DataContext.RemoveScanLocationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}" Style="{StaticResource ModernGhostButton}" Padding="8,3" FontSize="11.5"/>
            </Grid>
        </DataTemplate>

        <!-- Settings > Launcher Integrations: one auto-detected Steam library folder under the
             Steam toggle. Only a checkbox - these rows are owned by the Steam sync, not the user,
             so there's no Remove (it would just come back on the next sync). -->
        <DataTemplate x:Key="SteamLibraryRowTemplate" DataType="{x:Type vm:ScanLocationRowViewModel}">
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center"
                          Margin="0,0,10,0" Style="{StaticResource ModernCheckBox}"/>

                <TextBlock Grid.Column="1" Text="{Binding Path}" FontSize="12" Foreground="{StaticResource BrushTextPrimary}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </DataTemplate>

        <!-- Settings > Game Scanner: one row in the Ignored Games list -->
        <DataTemplate x:Key="IgnoredGamePathRowTemplate" DataType="{x:Type vm:IgnoredGamePathRowViewModel}">
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="{StaticResource BrushTextPrimary}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding DisplayPath}" FontSize="10.5" Foreground="{StaticResource BrushTextMuted}"
                               TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" Content="Remove"
                        Command="{Binding DataContext.RemoveIgnoredGamePathCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}" Style="{StaticResource ModernGhostButton}" Padding="8,3" FontSize="11.5"
                        VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/> <!-- Left Collapsible Sidebar -->
            <ColumnDefinition Width="*"/>    <!-- Main Content Area -->
        </Grid.ColumnDefinitions>

        <!-- ============================================================== -->
        <!-- LEFT COLLAPSIBLE SIDEBAR                                      -->
        <!-- ============================================================== -->
        <Border Grid.Column="0" Background="#141418" BorderBrush="{StaticResource BrushBorderDark}" 
                BorderThickness="0,0,1,0" Width="{Binding SidebarWidth}">
            <Grid Margin="6,12,6,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Brand & Toggle -->
                    <RowDefinition Height="Auto"/> <!-- Divider -->
                    <RowDefinition Height="*"/>    <!-- Navigation Items -->
                </Grid.RowDefinitions>

                <!-- Brand & Toggle Header -->
                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                    <Button Command="{Binding ToggleSidebarCommand}" Style="{StaticResource ModernGhostButton}" 
                            Height="38" Width="48" Padding="0" AutomationProperties.Name="{Binding SidebarToggleName}" DockPanel.Dock="Left"
                            HorizontalContentAlignment="Center">
                        <TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="15" 
                                   Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="TrayTrigger" FontSize="14.5" FontWeight="SemiBold" 
                                   Foreground="{StaticResource BrushTextPrimary}" FontFamily="{StaticResource AppFont}"/>
                    </StackPanel>
                </DockPanel>

                <!-- Separator -->
                <Separator Grid.Row="1" Background="#26262E" Margin="2,0,2,12"/>

                <!-- Navigation & Action Items -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top Navigation Items -->
                    <StackPanel Grid.Row="0">
                        <!-- 1. Games Library -->
                        <Button Command="{Binding SelectLibraryCommand}" AutomationProperties.Name="Games Library" Margin="0,0,0,6">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLibraryView}" Value="True">
                                            <Setter Property="Background" Value="#1C2E3D"/>
                                            <Setter Property="Foreground" Value="{StaticResource BrushAccentHover}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <DockPanel LastChildFill="True" VerticalAlignment="Center">
                                <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="16" 
                                           Width="26" Height="20" TextAlignment="Center" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                <TextBlock Text="Library" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0" FontFamily="{StaticResource AppFont}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DockPanel>
                        </Button>

                        <!-- 2. System & Performance -->
                        <Button Command="{Binding SelectSystemCommand}" AutomationProperties.Name="System &amp; Performance" Margin="0,0,0,6">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSystemView}" Value="True">
                                            <Setter Property="Background" Value="#1C2E3D"/>
                                            <Setter Property="Foreground" Value="{StaticResource BrushAccentHover}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <DockPanel LastChildFill="True" VerticalAlignment="Center">
                                <TextBlock Text="&#xE950;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="16"
                                           Width="26" Height="20" TextAlignment="Center" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                <TextBlock Text="System" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0" FontFamily="{StaticResource AppFont}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DockPanel>
                        </Button>

                        <!-- 3. Settings -->
                        <Button Command="{Binding SelectSettingsCommand}" AutomationProperties.Name="Application Settings" Margin="0,0,0,6">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSettingsView}" Value="True">
                                            <Setter Property="Background" Value="#1C2E3D"/>
                                            <Setter Property="Foreground" Value="{StaticResource BrushAccentHover}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <DockPanel LastChildFill="True" VerticalAlignment="Center">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="16" 
                                           Width="26" Height="20" TextAlignment="Center" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                <TextBlock Text="Settings" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0" FontFamily="{StaticResource AppFont}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DockPanel>
                        </Button>

                        <!-- 3. About -->
                        <Button Command="{Binding SelectAboutCommand}" AutomationProperties.Name="About TrayTrigger" Margin="0,0,0,6">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAboutView}" Value="True">
                                            <Setter Property="Background" Value="#1C2E3D"/>
                                            <Setter Property="Foreground" Value="{StaticResource BrushAccentHover}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <DockPanel LastChildFill="True" VerticalAlignment="Center">
                                <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="16" 
                                           Width="26" Height="20" TextAlignment="Center" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                <TextBlock Text="About" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0" FontFamily="{StaticResource AppFont}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DockPanel>
                        </Button>
                    </StackPanel>

                    <!-- Bottom Actions: Exit TrayTrigger -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
                        <Separator Background="#26262E" Margin="2,0,2,8"/>
                        <Button Command="{Binding ExitApplicationCommand}" AutomationProperties.Name="Exit TrayTrigger" Style="{StaticResource SidebarNavButton}">
                            <DockPanel LastChildFill="True" VerticalAlignment="Center">
                                <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="16" 
                                           Foreground="#E06C75" Width="26" Height="20" TextAlignment="Center" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                <TextBlock Text="Exit App" FontSize="13" Foreground="#E06C75" VerticalAlignment="Center" Margin="10,0,0,0" FontFamily="{StaticResource AppFont}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DockPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ============================================================== -->
        <!-- MAIN CONTENT AREA                                              -->
        <!-- ============================================================== -->
        <Grid Grid.Column="1" Margin="18">

            <!-- Floating non-blocking toast: game launches (Play glyph + "Launching...") and, when the user is
                 on a section other than Library, import/scan results (Accept glyph + "Added 3 new games").
                 Sits at the content-area level (not inside any one section's grid) so it renders
                 over whichever section is visible. Offset above the undo toast's anchor point so
                 the two don't overlap if both happen to be visible at once. -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,70"
                    Background="#24242E" BorderBrush="{StaticResource BrushAccent}" BorderThickness="1.5"
                    CornerRadius="8" Padding="16,10" Panel.ZIndex="100">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.5" Color="#000000"/>
                </Border.Effect>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLaunchToastVisible}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LaunchToastIcon}" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"
                               Foreground="{StaticResource BrushAccent}"/>
                    <TextBlock Text="{Binding LaunchToastMessage}" Foreground="{StaticResource BrushTextPrimary}"
                               FontSize="13" FontFamily="{StaticResource AppFont}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button Content="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="11" Command="{Binding DismissLaunchToastCommand}"
                            Style="{StaticResource ModernGhostButton}" Padding="6,4" VerticalAlignment="Center"
 AutomationProperties.Name="Dismiss"/>
                </StackPanel>
            </Border>

            <!-- ========================================================== -->
            <!-- 1. GAMES LIBRARY VIEW                                      -->
            <!-- ========================================================== -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLibraryView}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="Auto"/> <!-- Category Tabs & Actions -->
                    <RowDefinition Height="Auto"/> <!-- Search, Sort & View Mode Bar -->
                    <RowDefinition Height="*"/>    <!-- Games Grid & Undo Toast -->
                    <RowDefinition Height="Auto"/> <!-- Status Bar -->
                </Grid.RowDefinitions>

                <!-- 1. Header -->
                <DockPanel Grid.Row="0" Margin="0,0,0,14">
                    <!-- Right: Live Game Count Status (matching Settings & System) -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="12" 
                                   Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="{Binding TotalGameCountDisplay, Mode=OneWay}" FontSize="11.5" Foreground="{StaticResource BrushTextMuted}" 
                                   FontFamily="{StaticResource AppFont}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Left: Title & Subtitle matching Settings & System -->
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Games Library" FontSize="20" Foreground="{StaticResource BrushTextPrimary}" 
                                   FontFamily="{StaticResource AppFont}" FontWeight="Normal"/>
                        <TextBlock Text="Launch and organize your games from Steam, GOG, EA, Epic, Ubisoft Connect, Xbox, and local folders"
                                   FontSize="12" Foreground="{StaticResource BrushTextSecondary}" 
                                   FontFamily="{StaticResource AppFont}" Margin="0,4,0,0"/>
                    </StackPanel>
                </DockPanel>

                <!-- 2. Category Tabs & Action Buttons -->
                <DockPanel Grid.Row="1" Margin="0,0,0,16">
                    <!-- Right: Action Buttons (+ Add Game, Add Folder, Scan for Games). MDL2 glyphs
                         instead of emoji so they match the rest of the app on every Windows build.
                         "Refresh Posters" moved to Settings > Library & Art: a rare maintenance
                         action that was taking primary toolbar space. -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding AddGameCommand}" Style="{StaticResource ModernAccentButton}" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="11" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Add Game" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding AddFolderCommand}" Style="{StaticResource ModernOutlineButton}" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="12" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Add Folder" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenScanForGamesCommand}" Style="{StaticResource ModernOutlineButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="12" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Scan for Games" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Left: Segmented Category Tabs -->
                    <Border Background="#181820" BorderBrush="{StaticResource BrushBorderDark}"
                            BorderThickness="1" CornerRadius="6" Padding="3" Margin="0,0,16,0"
                            HorizontalAlignment="Left" VerticalAlignment="Center">
                        <ScrollViewer x:Name="CategoryScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False"
                                      PreviewMouseWheel="CategoryScrollViewer_PreviewMouseWheel">
                            <ItemsControl ItemsSource="{Binding CategoryTabs}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding SelectCommand}"
                                                Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsSelected}"
                                                Margin="0,0,2,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE735;" FontFamily="{StaticResource IconFont}"
                                                           FontSize="13" Foreground="#FFD700" Margin="0,0,5,0" VerticalAlignment="Center"
                                                           Visibility="{Binding IsFavoritesTab, Converter={StaticResource BoolToVis}}"/>
                                                <TextBlock Text="&#xED1A;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                                           FontSize="12" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,5,0" VerticalAlignment="Center"
                                                           Visibility="{Binding IsHiddenTab, Converter={StaticResource BoolToVis}}"/>
                                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </DockPanel>

                <!-- 3. Search, Sort & View Mode Bar -->
                <Grid Grid.Row="2" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="LibrarySearchTextBox" Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}" Margin="0,0,10,0"
                             Tag="Search games by title, category, or path..."/>

                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding SortOptions}"
                              SelectedItem="{Binding SelectedSortOption, Mode=TwoWay}"
                              Style="{StaticResource ModernComboBox}" Margin="0,0,10,0"/>

                    <!-- View Mode Switcher (Grid, Icons, List) -->
                    <Border Grid.Column="2" Background="#181820" BorderBrush="{StaticResource BrushBorderDark}"
                            BorderThickness="1" CornerRadius="6" Padding="3">
                        <StackPanel Orientation="Horizontal">
                            <!-- Every button is icon-only, so each carries a tooltip and an automation
                                 name. Extra Large uses a "large tiles" glyph (E8A9) - the old E71D
                                 rendered as a bulleted list and was mistaken for Details List. -->
                            <Button Command="{Binding SettingsVM.SetViewModeCommand}" CommandParameter="Extra Large"
                                    Width="32" Height="30" Padding="0" Cursor="Hand"
                                    Style="{StaticResource SegmentedTabButton}" Tag="{Binding SettingsVM.IsExtraLargeView}"
 AutomationProperties.Name="Extra Large posters view">
                                <TextBlock Text="&#xE8A9;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="14"
                                           Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                            <Button Command="{Binding SettingsVM.SetViewModeCommand}" CommandParameter="Poster Grid"
                                    Width="32" Height="30" Padding="0" Cursor="Hand" Margin="2,0,0,0"
                                    Style="{StaticResource SegmentedTabButton}" Tag="{Binding SettingsVM.IsGridView}"
 AutomationProperties.Name="Poster grid view">
                                <TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="13"
                                           Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                            <Button Command="{Binding SettingsVM.SetViewModeCommand}" CommandParameter="Compact Icons"
                                    Width="32" Height="30" Padding="0" Cursor="Hand" Margin="2,0,0,0"
                                    Style="{StaticResource SegmentedTabButton}" Tag="{Binding SettingsVM.IsIconsView}"
 AutomationProperties.Name="Compact icons view">
                                <TextBlock Text="&#xE80A;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="13"
                                           Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                            <Button Command="{Binding SettingsVM.SetViewModeCommand}" CommandParameter="Details List"
                                    Width="32" Height="30" Padding="0" Cursor="Hand" Margin="2,0,0,0"
                                    Style="{StaticResource SegmentedTabButton}" Tag="{Binding SettingsVM.IsListView}"
 AutomationProperties.Name="Details list view">
                                <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="13"
                                           Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 4. Game Cards View -->
                <Grid Grid.Row="3">
                    <!-- Empty State (also the drop target - dragging a file/folder anywhere
                         on the window already works, but this gives it a visible highlight) -->
                    <Border x:Name="DropZoneBorder" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            Margin="0,20,0,20" CornerRadius="10"
                            BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1.5"
                            Background="#161619"
                            AllowDrop="True" Drop="DropZone_Drop" DragOver="DropZone_DragOver"
                            DragEnter="DropZone_DragEnter" DragLeave="DropZone_DragLeave">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FilteredGames.IsEmpty}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                        <!-- Empty library: the first-run state. Scan is the accent action because for
                             anyone with a launcher installed it fills the library in one click. -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasAnyGames}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="42"
                                       Foreground="{StaticResource BrushAccentHover}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="Your library is empty"
                                       FontSize="16" Foreground="{StaticResource BrushTextPrimary}"
                                       FontFamily="{StaticResource AppFont}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Scan for Games imports what's installed from Steam, GOG, EA, Epic, Ubisoft Connect, and Xbox (PC Game Pass). Or drop a game's exe, shortcut, or install folder anywhere on this window."
                                       FontSize="13" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" MaxWidth="520" TextAlignment="Center"
                                       FontFamily="{StaticResource AppFont}" HorizontalAlignment="Center" Margin="0,6,0,18"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Command="{Binding OpenScanForGamesCommand}" Style="{StaticResource ModernAccentButton}" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="12" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Scan for Games" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding AddGameCommand}" Style="{StaticResource ModernOutlineButton}" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="11" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Add Game" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding AddFolderCommand}" Style="{StaticResource ModernOutlineButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="12" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Add Folder" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <!-- No match: the library has games, but this search / category tab shows
                             none. Previously this fell through to the "library is empty" text above. -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasAnyGames}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedCategory}" Value="Favorites">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="36"
                                       Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="No games match"
                                       FontSize="16" Foreground="{StaticResource BrushTextPrimary}"
                                       FontFamily="{StaticResource AppFont}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Nothing in this category matches your search. Press Esc to clear the search, or pick another tab."
                                       FontSize="13" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" MaxWidth="520" TextAlignment="Center"
                                       FontFamily="{StaticResource AppFont}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            <TextBlock Text="Adding a game instead? Drop its exe, shortcut, or install folder anywhere on this window, or use Add Game / Add Folder above."
                                       FontSize="12.5" Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap" MaxWidth="520" TextAlignment="Center"
                                       FontFamily="{StaticResource AppFont}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding SelectedCategory}" Value="Favorites"/>
                                                <Condition Binding="{Binding HasAnyGames}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="&#xE734;" FontFamily="{StaticResource IconFont}" FontSize="40"
                                       Foreground="#FFFFFFFF" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="No favorites yet"
                                       FontSize="16" Foreground="{StaticResource BrushTextPrimary}"
                                       FontFamily="{StaticResource AppFont}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Click the star on any game to add it to your Favorites."
                                       FontSize="13" Foreground="{StaticResource BrushTextSecondary}"
                                       FontFamily="{StaticResource AppFont}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ScrollViewer for WrapPanel Views (View 1: Poster Cards & View 2: Compact Icons) -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding SettingsVM.IsListView}" Value="False"/>
                                            <Condition Binding="{Binding FilteredGames.IsEmpty}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <Grid>

                            <!-- ============================================================== -->
                            <!-- VIEW 1: POSTER CARDS GRID VIEW                                 -->
                            <!-- ============================================================== -->
                            <ItemsControl ItemsSource="{Binding FilteredGames}">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SettingsVM.IsGridView}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>

                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:GameCardViewModel}">
                                        <Border x:Name="CardBorder" CornerRadius="8" 
                                                Background="{StaticResource BrushSurfaceDark}" 
                                                BorderBrush="{StaticResource BrushBorderDark}" 
                                                BorderThickness="1"
                                                Width="184" Height="276" Margin="7"
                                                Cursor="Hand" Focusable="True"
                                                AutomationProperties.Name="{Binding Name}"
                                                ContextMenu="{StaticResource GameItemContextMenu}"
                                                ContextMenuOpening="OnCardContextMenuOpening">

                                            <!-- Cards are focusable so Tab reaches them: Enter opens Details
                                                 (same as click), Ctrl+Enter launches; the focus ring and the
                                                 Play button appear on keyboard focus as well as hover. -->
                                            <Border.InputBindings>
                                                <MouseBinding Gesture="LeftClick" Command="{Binding PrimaryClickCommand}"/>
                                                <MouseBinding Gesture="Ctrl+LeftClick" Command="{Binding ToggleSelectCommand}"/>
                                                <MouseBinding Gesture="Shift+LeftClick" Command="{Binding RangeSelectCommand}"/>
                                                <KeyBinding Key="Enter" Command="{Binding ViewDetailsCommand}"/>
                                                <KeyBinding Key="Enter" Modifiers="Ctrl" Command="{Binding LaunchCommand}"/>
                                            </Border.InputBindings>

                                            <Grid>
                                                <!-- 1. Full Bleed Poster View (Active when ShowPosterArt = True) -->
                                                <Grid x:Name="PosterArtView" Visibility="Collapsed">
                                                    <!-- Ambient Blurred Background Fill (Fills entire card with game colors, zero black voids) -->
                                                    <Border CornerRadius="7" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                        <Border.Clip>
                                                            <RectangleGeometry Rect="0,0,182,274" RadiusX="7" RadiusY="7"/>
                                                        </Border.Clip>
                                                        <Grid>
                                                            <Image Source="{Binding CoverImage}" Stretch="UniformToFill"
                                                                   Opacity="0.45"
                                                                   RenderOptions.BitmapScalingMode="LowQuality"/>
                                                            <Border Background="#550D0D12"/>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Crisp Artwork Layer (Fits cleanly without cropping letters, logos, or characters) -->
                                                    <Border CornerRadius="7" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                        <Border.Clip>
                                                            <RectangleGeometry Rect="0,0,182,274" RadiusX="7" RadiusY="7"/>
                                                        </Border.Clip>
                                                        <Image Source="{Binding CoverImage}" Stretch="Uniform"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    </Border>

                                                    <!-- Top Dark Vignette for badge readability -->
                                                    <Border VerticalAlignment="Top" Height="48" CornerRadius="7,7,0,0">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Color="#990D0D12" Offset="0.0"/>
                                                                <GradientStop Color="#000D0D12" Offset="1.0"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>

                                                    <!-- Bottom Gradient Overlay with Game Title & Playtime -->
                                                    <Border VerticalAlignment="Bottom" CornerRadius="0,0,7,7">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Color="#00111114" Offset="0.0"/>
                                                                <GradientStop Color="#88111114" Offset="0.25"/>
                                                                <GradientStop Color="#E6111114" Offset="0.65"/>
                                                                <GradientStop Color="#F8111114" Offset="1.0"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                        <StackPanel Margin="11,18,11,9">
                                                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource BrushTextPrimary}" 
                                                                       FontFamily="{StaticResource AppFont}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <Grid Margin="0,3,0,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" MaxWidth="80"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding PlaytimeDisplay}" FontSize="10.5" 
                                                                           Foreground="{StaticResource BrushTextSecondary}" 
                                                                           FontFamily="{StaticResource AppFont}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding LastPlayedDisplay}" FontSize="10" 
                                                                           Foreground="{StaticResource BrushTextMuted}" 
                                                                           HorizontalAlignment="Right"
                                                                           TextAlignment="Right"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Margin="4,0,0,0"
                                                                           FontFamily="{StaticResource AppFont}"/>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>

                                                <!-- 2. Standard Icon Fallback View (Active when ShowPosterArt = False) -->
                                                <Grid x:Name="IconFallbackView" Margin="12">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- Center Icon & Name -->
                                                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,4">
                                                        <Border CornerRadius="8" Width="64" Height="64" Margin="0,0,0,12" 
                                                                Background="#222228" HorizontalAlignment="Center">
                                                            <Image Source="{Binding IconImage}" Width="56" Height="56" 
                                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>

                                                        <TextBlock Text="{Binding Name}" FontSize="13" 
                                                                   Foreground="{StaticResource BrushTextPrimary}" 
                                                                   FontFamily="{StaticResource AppFont}" FontWeight="SemiBold"
                                                                   TextAlignment="Center" TextTrimming="CharacterEllipsis" 
                                                                   MaxWidth="160" HorizontalAlignment="Center"/>
                                                    </StackPanel>

                                                    <!-- Footer Playtime -->
                                                    <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" MaxWidth="80"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding PlaytimeDisplay}" FontSize="11" 
                                                                       Foreground="{StaticResource BrushTextSecondary}" 
                                                                       FontFamily="{StaticResource AppFont}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding LastPlayedDisplay}" FontSize="10.5" 
                                                                       Foreground="{StaticResource BrushTextMuted}" 
                                                                       HorizontalAlignment="Right"
                                                                       TextAlignment="Right"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Margin="4,0,0,0"
                                                                       FontFamily="{StaticResource AppFont}"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- 3. Top Badges (Category, Steam Overlay, Missing, Hotkey) -->
                                                <DockPanel VerticalAlignment="Top" Margin="10,10,10,0" LastChildFill="False">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" DockPanel.Dock="Left">
                                                        <!-- Steam Game Indicator Badge Overlay - leftmost, no extra box since
                                                             the icon already includes its own colored background. -->
                                                        <Border VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasSteamOverlay}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Image Source="pack://application:,,,/Assets/LauncherLogos/steam.png"
                                                                   Height="22.5" Stretch="Uniform" VerticalAlignment="Center"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        </Border>

                                                        <!-- GOG Game Indicator Badge Overlay -->
                                                        <Border VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsGogGame}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Image Source="pack://application:,,,/Assets/LauncherLogos/gog_galaxy.png"
                                                                   Height="22.5" Stretch="Uniform" VerticalAlignment="Center"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        </Border>

                                                        <!-- EA Game Indicator Badge Overlay -->
                                                        <Border VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsEaGame}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Image Source="pack://application:,,,/Assets/LauncherLogos/ea_app.png"
                                                                   Height="22.5" Stretch="Uniform" VerticalAlignment="Center"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        </Border>

                                                        <!-- Epic Games Indicator Badge Overlay -->
                                                        <Border VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsEpicGame}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Image Source="pack://application:,,,/Assets/LauncherLogos/epic_games.png"
                                                                   Height="22.5" Stretch="Uniform" VerticalAlignment="Center"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        </Border>

                                                        <!-- Ubisoft Connect Indicator Badge Overlay -->
                                                        <Border VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsUbisoftGame}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Image Source="pack://application:,,,/Assets/LauncherLogos/ubisoft_connect.png"
                                                                   Height="22.5" Stretch="Uniform" VerticalAlignment="Center"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        </Border>

                                                        <!-- Xbox / PC Game Pass Indicator Badge Overlay -->
                                                        <Border VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsXboxGame}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Image Source="pack://application:,,,/Assets/LauncherLogos/xbox.png"
                                                                   Height="22.5" Stretch="Uniform" VerticalAlignment="Center"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        </Border>

                                                        <!-- Local Games Indicator Badge Overlay - shown for a game added via plain
                                                             exe/shortcut/folder scan rather than any supported launcher. -->
                                                        <Border VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsLocalGame}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Image Source="pack://application:,,,/Assets/LauncherLogos/local_games.png"
                                                                   Height="22.5" Stretch="Uniform" VerticalAlignment="Center"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        </Border>

                                                        <!-- Category Pill (Hidden if category is Steam to prevent duplicate badges).
                                                             Always preceded by exactly one visible platform/local badge above, so
                                                             its left margin is unconditional. -->
                                                        <Border Background="#D91D1D24" BorderBrush="#33FFFFFF" BorderThickness="1"
                                                                CornerRadius="4" Padding="6,2" Height="19" Margin="5,0,0,0" VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding ShowCategoryBadge}" Value="False">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding Category}" FontSize="10"
                                                                       Foreground="{StaticResource BrushTextSecondary}"
                                                                       FontFamily="{StaticResource AppFont}" VerticalAlignment="Center"/>
                                                        </Border>

                                                        <!-- Hidden Pill -->
                                                        <Border Background="#2A2A3A" BorderBrush="#33FFFFFF" BorderThickness="1"
                                                                CornerRadius="4" Padding="6,2" Height="19" Margin="5,0,0,0" VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="HIDDEN" FontSize="9" FontWeight="Bold"
                                                                       Foreground="#B8B8CC"
                                                                       FontFamily="{StaticResource AppFont}" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </StackPanel>

                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                                                        <Border Background="#2E1F5E2C" BorderBrush="#4CAF50" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,4,0" VerticalAlignment="Center">
                                                            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsPlaying}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                                            <TextBlock Text="&#9654; PLAYING" FontSize="9.5" FontWeight="SemiBold" Foreground="#7FE08A" FontFamily="{StaticResource AppFont}"/>
                                                        </Border>
                                                        <Border Background="#E64A1E14" BorderBrush="#E65100" BorderThickness="1"
                                                                CornerRadius="4" Padding="6,2" Margin="0,0,4,0" VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="MISSING" FontSize="9.5" FontWeight="SemiBold"
                                                                       Foreground="#FFA040" FontFamily="{StaticResource AppFont}"/>
                                                        </Border>

                                                        <!-- Favorite Star - outermost corner -->
                                                        <Button Command="{Binding ToggleFavoriteCommand}" VerticalAlignment="Center"
 AutomationProperties.Name="{Binding FavoriteMenuLabel}">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource FavoriteToggleButton}">
                                                                    <Setter Property="Width" Value="19"/>
                                                                    <Setter Property="Height" Value="19"/>
                                                                    <Setter Property="FontSize" Value="13"/>
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=CardBorder}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </StackPanel>
                                                </DockPanel>

                                                <!-- 4. Hover Play Button Overlay -->
                                                <Button Command="{Binding LaunchCommand}"
                                                        Width="46" Height="46"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource CirclePlayButton}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=CardBorder}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=CardBorder}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                                <!-- Hidden while games are multi-selected: Play is a single-game action. -->
                                                                <DataTrigger Binding="{Binding DataContext.HasSelection, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                            </Grid>
                                        </Border>

                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding ShowPosterArt}" Value="True">
                                                <Setter TargetName="PosterArtView" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="IconFallbackView" Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                <Setter TargetName="CardBorder" Property="Opacity" Value="0.65"/>
                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#805030"/>
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=CardBorder}" Value="True">
                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                                <Setter TargetName="CardBorder" Property="BorderThickness" Value="2"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                                <Setter TargetName="CardBorder" Property="BorderThickness" Value="2"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- ============================================================== -->
                            <!-- VIEW: EXTRA LARGE POSTER GRID                                  -->
                            <!-- Identical to VIEW 1 above, just bigger cards - see that view's  -->
                            <!-- comments for what each part does. Badge/text/button sizes stay  -->
                            <!-- the same as the normal grid (only the poster area itself grows), -->
                            <!-- same as e.g. Windows Explorer's own "Extra Large Icons" view.    -->
                            <!-- ============================================================== -->
                            <ItemsControl ItemsSource="{Binding FilteredGames}">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SettingsVM.IsExtraLargeView}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>

                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:GameCardViewModel}">
                                        <Border x:Name="CardBorder" CornerRadius="8"
                                                Background="{StaticResource BrushSurfaceDark}"
                                                BorderBrush="{StaticResource BrushBorderDark}"
                                                BorderThickness="1"
                                                Width="240" Height="360" Margin="7"
                                                Cursor="Hand" Focusable="True"
                                                AutomationProperties.Name="{Binding Name}"
                                                ContextMenu="{StaticResource GameItemContextMenu}"
                                                ContextMenuOpening="OnCardContextMenuOpening">

                                            <!-- Cards are focusable so Tab reaches them: Enter opens Details
                                                 (same as click), Ctrl+Enter launches; the focus ring and the
                                                 Play button appear on keyboard focus as well as hover. -->
                                            <Border.InputBindings>
                                                <MouseBinding Gesture="LeftClick" Command="{Binding PrimaryClickCommand}"/>
                                                <MouseBinding Gesture="Ctrl+LeftClick" Command="{Binding ToggleSelectCommand}"/>
                                                <MouseBinding Gesture="Shift+LeftClick" Command="{Binding RangeSelectCommand}"/>
                                                <KeyBinding Key="Enter" Command="{Binding ViewDetailsCommand}"/>
                                                <KeyBinding Key="Enter" Modifiers="Ctrl" Command="{Binding LaunchCommand}"/>
                                            </Border.InputBindings>

                                            <Grid>
                                                <!-- 1. Full Bleed Poster View (Active when ShowPosterArt = True) -->
                                                <Grid x:Name="PosterArtView" Visibility="Collapsed">
                                                    <!-- Ambient Blurred Background Fill (Fills entire card with game colors, zero black voids) -->
                                                    <Border CornerRadius="7" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                        <Border.Clip>
                                                            <RectangleGeometry Rect="0,0,238,358" RadiusX="7" RadiusY="7"/>
                                                        </Border.Clip>
                                                        <Grid>
                                                            <Image Source="{Binding CoverImage}" Stretch="UniformToFill"
                                                                   Opacity="0.45"
                                                                   RenderOptions.BitmapScalingMode="LowQuality"/>
                                                            <Border Background="#550D0D12"/>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Crisp Artwork Layer (Fits cleanly without cropping letters, logos, or characters) -->
                                                    <Border CornerRadius="7" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                        <Border.Clip>
                                                            <RectangleGeometry Rect="0,0,238,358" RadiusX="7" RadiusY="7"/>
                                                        </Border.Clip>
                                                        <Image Source="{Binding CoverImage}" Stretch="Uniform"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    </Border>

                                                    <!-- Top Dark Vignette for badge readability -->
                                                    <Border VerticalAlignment="Top" Height="48" CornerRadius="7,7,0,0">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Color="#990D0D12" Offset="0.0"/>
                                                                <GradientStop Color="#000D0D12" Offset="1.0"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>

                                                    <!-- Bottom Gradient Overlay with Game Title & Playtime -->
                                                    <Border VerticalAlignment="Bottom" CornerRadius="0,0,7,7">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Color="#00111114" Offset="0.0"/>
                                                                <GradientStop Color="#88111114" Offset="0.25"/>
                                                                <GradientStop Color="#E6111114" Offset="0.65"/>
                                                                <GradientStop Color="#F8111114" Offset="1.0"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                        <StackPanel Margin="11,18,11,9">
                                                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource BrushTextPrimary}"
                                                                       FontFamily="{StaticResource AppFont}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <Grid Margin="0,3,0,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" MaxWidth="80"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding PlaytimeDisplay}" FontSize="10.5"
                                                                           Foreground="{StaticResource BrushTextSecondary}"
                                                                           FontFamily="{StaticResource AppFont}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding LastPlayedDisplay}" FontSize="10"
                                                                           Foreground="{StaticResource BrushTextMuted}"
                                                                           HorizontalAlignment="Right"
                                                                           TextAlignment="Right"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Margin="4,0,0,0"
                                                                           FontFamily="{StaticResource AppFont}"/>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>

                                                <!-- 2. Standard Icon Fallback View (Active when ShowPosterArt = False) -->
                                                <Grid x:Name="IconFallbackView" Margin="12">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- Center Icon & Name -->
                                                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,4">
                                                        <Border CornerRadius="8" Width="64" Height="64" Margin="0,0,0,12"
                                                                Background="#222228" HorizontalAlignment="Center">
                                                            <Image Source="{Binding IconImage}" Width="56" Height="56"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>

                                                        <TextBlock Text="{Binding Name}" FontSize="13"
                                                                   Foreground="{StaticResource BrushTextPrimary}"
                                                                   FontFamily="{StaticResource AppFont}" FontWeight="SemiBold"
                                                                   TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                   MaxWidth="160" HorizontalAlignment="Center"/>
                                                    </StackPanel>

                                                    <!-- Footer Playtime -->
                                                    <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" MaxWidth="80"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding PlaytimeDisplay}" FontSize="11"
                                                                       Foreground="{StaticResource BrushTextSecondary}"
                                                                       FontFamily="{StaticResource AppFont}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding LastPlayedDisplay}" FontSize="10.5"
                                                                       Foreground="{StaticResource BrushTextMuted}"
                                                                       HorizontalAlignment="Right"
                                                                       TextAlignment="Right"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Margin="4,0,0,0"
                                                                       FontFamily="{StaticResource AppFont}"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- 3. Top Badges (Category, Steam Overlay, Missing, Hotkey) -->
                                                <DockPanel VerticalAlignment="Top" Margin="10,10,10,0" LastChildFill="False">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" DockPanel.Dock="Left">
                                                        <!-- Steam Game Indicator Badge Overlay - leftmost, no extra box since
                                                             the icon already includes its own colored background. -->
                                                        <Border VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasSteamOverlay}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Image Source="pack://application:,,,/Assets/LauncherLogos/steam.png"
                                                                   Height="22.5" Stretch="Uniform" VerticalAlignment="Center"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        </Border>

                                                        <!-- GOG Game Indicator Badge Overlay -->
                                                        <Border VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsGogGame}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Image Source="pack://application:,,,/Assets/LauncherLogos/gog_galaxy.png"
                                                                   Height="22.5" Stretch="Uniform" VerticalAlignment="Center"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        </Border>

                                                        <!-- EA Game Indicator Badge Overlay -->
                                                        <Border VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsEaGame}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Image Source="pack://application:,,,/Assets/LauncherLogos/ea_app.png"
                                                                   Height="22.5" Stretch="Uniform" VerticalAlignment="Center"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        </Border>

                                                        <!-- Epic Games Indicator Badge Overlay -->
                                                        <Border VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsEpicGame}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Image Source="pack://application:,,,/Assets/LauncherLogos/epic_games.png"
                                                                   Height="22.5" Stretch="Uniform" VerticalAlignment="Center"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        </Border>

                                                        <!-- Ubisoft Connect Indicator Badge Overlay -->
                                                        <Border VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsUbisoftGame}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Image Source="pack://application:,,,/Assets/LauncherLogos/ubisoft_connect.png"
                                                                   Height="22.5" Stretch="Uniform" VerticalAlignment="Center"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        </Border>

                                                        <!-- Xbox / PC Game Pass Indicator Badge Overlay -->
                                                        <Border VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsXboxGame}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Image Source="pack://application:,,,/Assets/LauncherLogos/xbox.png"
                                                                   Height="22.5" Stretch="Uniform" VerticalAlignment="Center"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        </Border>

                                                        <!-- Local Games Indicator Badge Overlay - shown for a game added via plain
                                                             exe/shortcut/folder scan rather than any supported launcher. -->
                                                        <Border VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsLocalGame}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Image Source="pack://application:,,,/Assets/LauncherLogos/local_games.png"
                                                                   Height="22.5" Stretch="Uniform" VerticalAlignment="Center"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        </Border>

                                                        <!-- Category Pill (Hidden if category is Steam to prevent duplicate badges).
                                                             Always preceded by exactly one visible platform/local badge above, so
                                                             its left margin is unconditional. -->
                                                        <Border Background="#D91D1D24" BorderBrush="#33FFFFFF" BorderThickness="1"
                                                                CornerRadius="4" Padding="6,2" Height="19" Margin="5,0,0,0" VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding ShowCategoryBadge}" Value="False">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding Category}" FontSize="10"
                                                                       Foreground="{StaticResource BrushTextSecondary}"
                                                                       FontFamily="{StaticResource AppFont}" VerticalAlignment="Center"/>
                                                        </Border>

                                                        <!-- Hidden Pill -->
                                                        <Border Background="#2A2A3A" BorderBrush="#33FFFFFF" BorderThickness="1"
                                                                CornerRadius="4" Padding="6,2" Height="19" Margin="5,0,0,0" VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="HIDDEN" FontSize="9" FontWeight="Bold"
                                                                       Foreground="#B8B8CC"
                                                                       FontFamily="{StaticResource AppFont}" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </StackPanel>

                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                                                        <Border Background="#2E1F5E2C" BorderBrush="#4CAF50" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,4,0" VerticalAlignment="Center">
                                                            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsPlaying}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                                            <TextBlock Text="&#9654; PLAYING" FontSize="9.5" FontWeight="SemiBold" Foreground="#7FE08A" FontFamily="{StaticResource AppFont}"/>
                                                        </Border>
                                                        <Border Background="#E64A1E14" BorderBrush="#E65100" BorderThickness="1"
                                                                CornerRadius="4" Padding="6,2" Margin="0,0,4,0" VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="MISSING" FontSize="9.5" FontWeight="SemiBold"
                                                                       Foreground="#FFA040" FontFamily="{StaticResource AppFont}"/>
                                                        </Border>

                                                        <!-- Favorite Star - outermost corner -->
                                                        <Button Command="{Binding ToggleFavoriteCommand}" VerticalAlignment="Center"
 AutomationProperties.Name="{Binding FavoriteMenuLabel}">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource FavoriteToggleButton}">
                                                                    <Setter Property="Width" Value="19"/>
                                                                    <Setter Property="Height" Value="19"/>
                                                                    <Setter Property="FontSize" Value="13"/>
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=CardBorder}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </StackPanel>
                                                </DockPanel>

                                                <!-- 4. Hover Play Button Overlay -->
                                                <Button Command="{Binding LaunchCommand}"
                                                        Width="46" Height="46"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource CirclePlayButton}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=CardBorder}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=CardBorder}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                                <!-- Hidden while games are multi-selected: Play is a single-game action. -->
                                                                <DataTrigger Binding="{Binding DataContext.HasSelection, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                            </Grid>
                                        </Border>

                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding ShowPosterArt}" Value="True">
                                                <Setter TargetName="PosterArtView" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="IconFallbackView" Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                <Setter TargetName="CardBorder" Property="Opacity" Value="0.65"/>
                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#805030"/>
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=CardBorder}" Value="True">
                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                                <Setter TargetName="CardBorder" Property="BorderThickness" Value="2"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                                <Setter TargetName="CardBorder" Property="BorderThickness" Value="2"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- ============================================================== -->
                            <!-- VIEW 2: COMPACT ICONS VIEW                                     -->
                            <!-- ============================================================== -->
                            <ItemsControl ItemsSource="{Binding FilteredGames}">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SettingsVM.IsIconsView}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>

                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:GameCardViewModel}">
                                        <Border x:Name="IconCardBorder" CornerRadius="8" 
                                                Background="{StaticResource BrushSurfaceDark}" 
                                                BorderBrush="{StaticResource BrushBorderDark}" 
                                                BorderThickness="1"
                                                Width="116" Height="124" Margin="6"
                                                Cursor="Hand" Focusable="True" AutomationProperties.Name="{Binding Name}"
                                                ContextMenu="{StaticResource GameItemContextMenu}"
                                                ContextMenuOpening="OnCardContextMenuOpening">
                                            <!-- Cards are focusable so Tab reaches them: Enter opens Details
                                                 (same as click), Ctrl+Enter launches; the focus ring and the
                                                 Play button appear on keyboard focus as well as hover. -->
                                            <Border.InputBindings>
                                                <MouseBinding Gesture="LeftClick" Command="{Binding PrimaryClickCommand}"/>
                                                <MouseBinding Gesture="Ctrl+LeftClick" Command="{Binding ToggleSelectCommand}"/>
                                                <MouseBinding Gesture="Shift+LeftClick" Command="{Binding RangeSelectCommand}"/>
                                                <KeyBinding Key="Enter" Command="{Binding ViewDetailsCommand}"/>
                                                <KeyBinding Key="Enter" Modifiers="Ctrl" Command="{Binding LaunchCommand}"/>
                                            </Border.InputBindings>

                                            <Grid Margin="8,8,8,8">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Top Badges -->
                                                <DockPanel Grid.Row="0" Height="14">
                                                    <Button DockPanel.Dock="Left" Command="{Binding ToggleFavoriteCommand}"
                                                            Width="14" Height="14" Padding="0" Margin="0,0,3,0"
                                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
 AutomationProperties.Name="{Binding FavoriteMenuLabel}" VerticalAlignment="Center">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <TextBlock x:Name="StarGlyph" Text="&#xE734;" FontFamily="{StaticResource IconFont}"
                                                                           FontSize="12" Foreground="#FFFFFFFF"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                <ControlTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                        <Setter TargetName="StarGlyph" Property="Text" Value="&#xE735;"/>
                                                                        <Setter TargetName="StarGlyph" Property="Foreground" Value="#FFD700"/>
                                                                    </DataTrigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="StarGlyph" Property="Foreground" Value="#FFD700"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>

                                                    <Border Background="#1C2E3D" CornerRadius="3" Padding="4,0" HorizontalAlignment="Left">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasSteamOverlay}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Image Source="pack://application:,,,/Assets/LauncherLogos/steam.png" Height="11" Margin="0,0,2,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            <TextBlock Text="STEAM" FontSize="9" Foreground="{StaticResource BrushAccentHover}" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Background="#1C1A2E" CornerRadius="3" Padding="4,0" HorizontalAlignment="Left">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsGogGame}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Image Source="pack://application:,,,/Assets/LauncherLogos/gog_galaxy.png" Height="11" Margin="0,0,2,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            <TextBlock Text="GOG" FontSize="9" Foreground="#B583F7" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Background="#1C2E22" CornerRadius="3" Padding="4,0" HorizontalAlignment="Left">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsEaGame}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Image Source="pack://application:,,,/Assets/LauncherLogos/ea_app.png" Height="11" Margin="0,0,2,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            <TextBlock Text="EA" FontSize="9" Foreground="#66BB6A" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Background="#2A2A2E" CornerRadius="3" Padding="4,0" HorizontalAlignment="Left">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsEpicGame}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Image Source="pack://application:,,,/Assets/LauncherLogos/epic_games.png" Height="11" Margin="0,0,2,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            <TextBlock Text="EPIC" FontSize="9" Foreground="#E0E0E0" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Background="#332B1A" CornerRadius="3" Padding="4,0" HorizontalAlignment="Left">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsUbisoftGame}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Image Source="pack://application:,,,/Assets/LauncherLogos/ubisoft_connect.png" Height="11" Margin="0,0,2,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            <TextBlock Text="UBI" FontSize="9" Foreground="#FFC107" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Background="#1B2E1B" CornerRadius="3" Padding="4,0" HorizontalAlignment="Left">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsXboxGame}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Image Source="pack://application:,,,/Assets/LauncherLogos/xbox.png" Height="11" Margin="0,0,2,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            <TextBlock Text="XBOX" FontSize="9" Foreground="#6CC04A" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Local games get a pill here too, so every platform is marked in every view. -->
                                                    <Border Background="#2A2A2E" CornerRadius="3" Padding="4,0" HorizontalAlignment="Left">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsLocalGame}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="LOCAL" FontSize="9" Foreground="#B8B8CC" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </Border>

                                                    <Border Background="#2E1F5E2C" BorderBrush="#4CAF50" BorderThickness="1" CornerRadius="3" Padding="4,0" Margin="0,0,3,0" HorizontalAlignment="Right">
                                                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsPlaying}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                                        <TextBlock Text="&#9654; PLAYING" FontSize="9" FontWeight="SemiBold" Foreground="#7FE08A"/>
                                                    </Border>
                                                    <Border Background="#E64A1E14" BorderBrush="#E65100" BorderThickness="1"
                                                            CornerRadius="3" Padding="4,0" HorizontalAlignment="Right">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="MISSING" FontSize="9" FontWeight="SemiBold" Foreground="#FFA040"/>
                                                    </Border>
                                                </DockPanel>

                                                <!-- Icon -->
                                                <Border Grid.Row="1" Width="48" Height="48" CornerRadius="6" 
                                                        Background="#222228" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Image Source="{Binding IconImage}" Width="42" Height="42" 
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- Title -->
                                                <TextBlock Grid.Row="2" Text="{Binding Name}" FontSize="11" 
                                                           Foreground="{StaticResource BrushTextPrimary}" 
                                                           FontFamily="{StaticResource AppFont}" FontWeight="SemiBold"
                                                           TextAlignment="Center" TextTrimming="CharacterEllipsis" 
                                                           HorizontalAlignment="Center" Margin="0,5,0,0"/>

                                                <!-- Playtime / Category Subtext -->
                                                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding Category}" FontSize="9.5"
                                                               Foreground="{StaticResource BrushTextMuted}"
                                                               FontFamily="{StaticResource AppFont}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text=" &#x2022; HIDDEN" FontSize="9.5" FontWeight="Bold"
                                                               Foreground="#B8B8CC" FontFamily="{StaticResource AppFont}"
                                                               Visibility="{Binding IsHidden, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>

                                                <!-- Hover Play Button Overlay -->
                                                <Button Grid.Row="1" Command="{Binding LaunchCommand}"
                                                        Width="34" Height="34"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource CirclePlayButton}">
                                                            <Setter Property="FontSize" Value="13"/>
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=IconCardBorder}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=IconCardBorder}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                                <!-- Hidden while games are multi-selected: Play is a single-game action. -->
                                                                <DataTrigger Binding="{Binding DataContext.HasSelection, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </Grid>
                                        </Border>

                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                <Setter TargetName="IconCardBorder" Property="Opacity" Value="0.65"/>
                                                <Setter TargetName="IconCardBorder" Property="BorderBrush" Value="#805030"/>
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="IconCardBorder" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                                <Setter TargetName="IconCardBorder" Property="Background" Value="#25252E"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=IconCardBorder}" Value="True">
                                                <Setter TargetName="IconCardBorder" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                                <Setter TargetName="IconCardBorder" Property="Background" Value="#25252E"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="IconCardBorder" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                                <Setter TargetName="IconCardBorder" Property="BorderThickness" Value="2"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>

                    <!-- ============================================================== -->
                    <!-- VIEW 3: DETAILS LIST VIEW (VIRTUALIZED & PINNED HEADER)        -->
                    <!-- ============================================================== -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding SettingsVM.IsListView}" Value="True"/>
                                            <Condition Binding="{Binding FilteredGames.IsEmpty}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Pinned Header Bar -->
                            <RowDefinition Height="*"/>    <!-- Virtualized Game Rows -->
                        </Grid.RowDefinitions>

                        <!-- Header Bar (Fixed, never scrolls out of view) -->
                        <Border Grid.Row="0" Background="#16161C" BorderBrush="{StaticResource BrushBorderDark}" 
                                BorderThickness="0,0,0,1" Padding="12,8" Margin="0,0,16,6" CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42"/> <!-- Icon -->
                                    <ColumnDefinition Width="*"/>  <!-- Title -->
                                    <ColumnDefinition Width="135"/> <!-- Category -->
                                    <ColumnDefinition Width="110"/> <!-- Playtime -->
                                    <ColumnDefinition Width="125"/> <!-- Last Played -->
                                    <ColumnDefinition Width="90"/>  <!-- Actions -->
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="GAME TITLE" FontSize="10.5" FontWeight="SemiBold" 
                                           Foreground="{StaticResource BrushTextMuted}" FontFamily="{StaticResource AppFont}"/>
                                <TextBlock Grid.Column="2" Text="CATEGORY" FontSize="10.5" FontWeight="SemiBold" 
                                           Foreground="{StaticResource BrushTextMuted}" FontFamily="{StaticResource AppFont}"/>
                                <TextBlock Grid.Column="3" Text="PLAYTIME" FontSize="10.5" FontWeight="SemiBold" 
                                           Foreground="{StaticResource BrushTextMuted}" FontFamily="{StaticResource AppFont}"/>
                                <TextBlock Grid.Column="4" Text="LAST PLAYED" FontSize="10.5" FontWeight="SemiBold" 
                                           Foreground="{StaticResource BrushTextMuted}" FontFamily="{StaticResource AppFont}"/>
                                <TextBlock Grid.Column="5" Text="ACTIONS" FontSize="10.5" FontWeight="SemiBold" 
                                           Foreground="{StaticResource BrushTextMuted}" FontFamily="{StaticResource AppFont}" 
                                           HorizontalAlignment="Right" Margin="0,0,6,0"/>
                            </Grid>
                        </Border>

                        <!-- Virtualized List Rows -->
                        <ListBox Grid.Row="1" x:Name="GamesListBox"
                                 ItemsSource="{Binding FilteredGames}"
                                 KeyboardNavigation.TabNavigation="Once"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel">
                            <!-- Keyboard: Enter opens Details (same as click), Ctrl+Enter launches. -->
                            <ListBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SelectedItem.ViewDetailsCommand, ElementName=GamesListBox}"/>
                                <KeyBinding Key="Enter" Modifiers="Ctrl" Command="{Binding SelectedItem.LaunchCommand, ElementName=GamesListBox}"/>
                            </ListBox.InputBindings>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:GameCardViewModel}">
                                    <Border x:Name="ListRowBorder" CornerRadius="6" 
                                            Background="{StaticResource BrushSurfaceDark}" 
                                            BorderBrush="{StaticResource BrushBorderDark}" 
                                            BorderThickness="1"
                                            Height="46" Margin="0,2,0,3" Padding="10,0"
                                            Cursor="Hand"
                                            ContextMenu="{StaticResource GameItemContextMenu}"
                                            ContextMenuOpening="OnCardContextMenuOpening">
                                        <Border.InputBindings>
                                            <MouseBinding Gesture="LeftClick" Command="{Binding PrimaryClickCommand}"/>
                                            <MouseBinding Gesture="Ctrl+LeftClick" Command="{Binding ToggleSelectCommand}"/>
                                            <MouseBinding Gesture="Shift+LeftClick" Command="{Binding RangeSelectCommand}"/>
                                        </Border.InputBindings>
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="135"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="125"/>
                                                <ColumnDefinition Width="90"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Icon -->
                                            <Border Grid.Column="0" Width="30" Height="30" CornerRadius="4" 
