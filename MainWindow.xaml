                                    <Border Grid.Column="3" Background="#17171C" CornerRadius="6" Padding="12,10" Margin="6,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="TRAY INTEGRATION" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,3"/>
                                            <TextBlock Text="Win32 Shell Notify" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                            <TextBlock Text="Global Win32 Hotkeys" FontSize="10.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- ============================================== -->
                        <!-- CATEGORY 2: KEY FEATURES                       -->
