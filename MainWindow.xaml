                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Image Source="pack://application:,,,/Assets/LauncherLogos/ubisoft_connect.png" Height="11" Margin="0,0,3,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        <TextBlock Text="UBI" FontSize="9.5" Foreground="#FFC107"
                                                                   FontFamily="{StaticResource AppFont}" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Background="#1B2E1B" CornerRadius="3" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsXboxGame}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Image Source="pack://application:,,,/Assets/LauncherLogos/xbox.png" Height="11" Margin="0,0,3,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        <TextBlock Text="XBOX" FontSize="9.5" Foreground="#6CC04A"
                                                                   FontFamily="{StaticResource AppFont}" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Background="#2A2A2E" CornerRadius="3" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsLocalGame}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="LOCAL" FontSize="9.5" Foreground="#B8B8CC"
                                                               FontFamily="{StaticResource AppFont}" FontWeight="SemiBold"/>
                                                </Border>
                                                <Border Background="#2A2A3A" CornerRadius="3" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="HIDDEN" FontSize="8.5" FontWeight="Bold"
                                                               Foreground="#B8B8CC" FontFamily="{StaticResource AppFont}"/>
                                                </Border>
                                            </StackPanel>

                                            <!-- Category Pill -->
                                            <Border Grid.Column="2" Background="#1D1D24" BorderBrush="#33FFFFFF" BorderThickness="1"
                                                    CornerRadius="4" Padding="7,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Category}" FontSize="10" 
                                                           Foreground="{StaticResource BrushTextSecondary}" 
                                                           FontFamily="{StaticResource AppFont}"/>
                                            </Border>

                                            <!-- Playtime -->
                                            <TextBlock Grid.Column="3" Text="{Binding ListPlaytimeDisplay}" FontSize="11" 
                                                       Foreground="{StaticResource BrushTextSecondary}" 
                                                       FontFamily="{StaticResource AppFont}" VerticalAlignment="Center"/>

                                            <!-- Last Played -->
                                            <TextBlock Grid.Column="4" Text="{Binding LastPlayedDisplay}" FontSize="11" 
                                                       Foreground="{StaticResource BrushTextMuted}" 
                                                       FontFamily="{StaticResource AppFont}" VerticalAlignment="Center"/>

                                            <!-- Action Buttons -->
                                            <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <!-- Details needs no button here: a left-click anywhere on the row opens it. -->
                                                <Button Command="{Binding LaunchCommand}" AutomationProperties.Name="Play Game"
                                                        Height="34" Width="34">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource CirclePlayButton}">
                                                            <Setter Property="FontSize" Value="12"/>
                                                            <Style.Triggers>
                                                                <!-- Hidden while games are multi-selected: Play is a single-game action. -->
                                                                <DataTrigger Binding="{Binding DataContext.HasSelection, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                            <Setter TargetName="ListRowBorder" Property="Opacity" Value="0.65"/>
                                            <Setter TargetName="ListRowBorder" Property="BorderBrush" Value="#805030"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ListRowBorder" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                            <Setter TargetName="ListRowBorder" Property="Background" Value="#25252E"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="ListRowBorder" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                            <Setter TargetName="ListRowBorder" Property="BorderThickness" Value="2"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- Floating Non-Blocking Undo Toast -->
                    <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18"
                            Background="#24242E" BorderBrush="{StaticResource BrushAccent}" BorderThickness="1.5"
                            CornerRadius="8" Padding="16,10" Panel.ZIndex="100">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.5" Color="#000000"/>
                        </Border.Effect>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsUndoToastVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource BrushAccent}"/>
                            <TextBlock Text="{Binding UndoToastMessage}" Foreground="{StaticResource BrushTextPrimary}"
                                       FontSize="13" FontFamily="{StaticResource AppFont}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <Button Content="UNDO" Command="{Binding UndoDeleteCommand}"
                                    Style="{StaticResource ModernAccentButton}" Padding="12,4" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <Button Content="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="11" Command="{Binding DismissUndoToastCommand}"
                                    Style="{StaticResource ModernGhostButton}" Padding="6,4" VerticalAlignment="Center"
 AutomationProperties.Name="Dismiss"/>
                        </StackPanel>
                    </Border>

                    <!-- The floating launch/import toast used to sit here; it now lives at the top of
                         the MAIN CONTENT AREA grid so it also renders over Settings/System/About. -->
                </Grid>

                <!-- 5. Status Bar -->
                <!-- Right-docked parts are laid out first so the status message is what trims
                     when the row runs out of room, never the hotkey or the selection hint. -->
                <DockPanel Grid.Row="4" Margin="0,14,0,0" LastChildFill="True">
                    <!-- Bound to the configurable hotkey, not hard-coded to Ctrl+Alt+G. -->
                    <TextBlock DockPanel.Dock="Right" Text="{Binding SettingsVM.GlobalManageHotkey, StringFormat='Hotkey: {0} to show or hide this window'}" FontSize="11"
                               Foreground="{StaticResource BrushTextMuted}" Margin="14,0,0,0"
                               FontFamily="{StaticResource AppFont}" VerticalAlignment="Center"/>
                    <!-- Multi-select hint: only while two or more cards are selected. -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectionHint}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{Binding SelectionHint}" FontSize="12"
                                   Foreground="{StaticResource BrushAccentHover}"
                                   FontFamily="{StaticResource AppFont}" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource HelpLinkButton}" Content="Learn more" Margin="10,0,0,0" VerticalAlignment="Center"
                                Command="{x:Static services:HelpCommands.ShowTopic}" CommandParameter="library/select_mode"/>
                    </StackPanel>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource BrushTextSecondary}"
                               FontFamily="{StaticResource AppFont}" VerticalAlignment="Center"/>
                </DockPanel>

            </Grid>

            <!-- ========================================================== -->
            <!-- 2. IN-WINDOW SETTINGS VIEW                                 -->
            <!-- ========================================================== -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSettingsView}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid DataContext="{Binding SettingsVM}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="Auto"/> <!-- Category Segmented Tabs -->
                        <RowDefinition Height="*"/>    <!-- Settings ScrollViewer -->
                        <RowDefinition Height="Auto"/> <!-- Status line -->
                    </Grid.RowDefinitions>

                <!-- Header -->
                <DockPanel Grid.Row="0" Margin="0,0,0,14">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="12" 
                                   Foreground="#4EC9B0" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="Saved in real time" FontSize="11.5" Foreground="{StaticResource BrushTextMuted}" 
                                   FontFamily="{StaticResource AppFont}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Application Settings" FontSize="20" Foreground="{StaticResource BrushTextPrimary}" 
                                   FontFamily="{StaticResource AppFont}" FontWeight="Normal"/>
                        <TextBlock Text="Startup and updates, launcher integrations and artwork, the tray menu, launch behaviour, and logs"
                                   FontSize="12" Foreground="{StaticResource BrushTextSecondary}" 
                                   FontFamily="{StaticResource AppFont}" Margin="0,4,0,0"/>
                    </StackPanel>
                </DockPanel>

                <!-- Category Segmented Tabs -->
                <Border Grid.Row="1" Background="#181820" BorderBrush="{StaticResource BrushBorderDark}" 
                        BorderThickness="1" CornerRadius="6" Padding="3" HorizontalAlignment="Left" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="All Settings" Command="{Binding SelectAllTabCommand}"
                                Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsAllTab}"/>
                        <Button Content="General" Command="{Binding SelectGeneralTabCommand}" Margin="2,0,0,0"
                                Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsGeneralTab}"/>
                        <Button Content="Library &amp; Art" Command="{Binding SelectLibraryTabCommand}" Margin="2,0,0,0"
                                Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsLibraryTab}"/>
                        <Button Content="Tray Menu" Command="{Binding SelectTrayMenuTabCommand}" Margin="2,0,0,0"
                                Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsTrayMenuTab}"/>
                        <Button Content="Launch &amp; Performance" Command="{Binding SelectPerformanceTweaksTabCommand}" Margin="2,0,0,0"
                                Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsPerformanceTweaksTab}"/>
                        <Button Content="Diagnostics &amp; Storage" Command="{Binding SelectDiagnosticsTabCommand}" Margin="2,0,0,0"
                                Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsDiagnosticsTab}"/>
                    </StackPanel>
                </Border>

                <!-- Settings Cards ScrollViewer -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14">
                    <StackPanel HorizontalAlignment="Stretch" Margin="0,0,12,0">

                        <!-- ============================================== -->
                        <!-- CATEGORY 1: GENERAL & SYSTEM INTEGRATION       -->
                        <!-- ============================================== -->
                        <StackPanel Visibility="{Binding ShowGeneralSection, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                            <!-- Section Header (shown in All Settings view) -->
                            <Border Margin="0,2,0,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAllTab}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="12.5" 
                                               Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="GENERAL &amp; SYSTEM INTEGRATION" FontSize="11.5" FontWeight="SemiBold" 
                                               Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- 1.1 Windows Startup & System Tray Integration -->
                            <Border CornerRadius="8" Background="{StaticResource BrushSurfaceDark}" 
                                    BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" 
                                    Padding="14,12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Windows Startup &amp; System Tray" FontSize="13.5" FontWeight="SemiBold" 
                                               Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,8"/>

                                    <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows}" 
                                              Style="{StaticResource ModernCheckBox}" FontSize="13"/>
                                    <TextBlock Text="Launches TrayTrigger automatically when you log in to Windows." 
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11" 
                                               Margin="24,3,0,0" TextWrapping="Wrap"/>

                                    <!-- Nested Sub-Toggle: Start Minimized -->
                                    <StackPanel Margin="24,8,0,10">
                                        <CheckBox Content="Start minimized to tray" 
                                                  IsChecked="{Binding StartMinimizedToTray}" 
                                                  IsEnabled="{Binding CanConfigureMinimized}" 
                                                  Style="{StaticResource ModernCheckBox}" FontSize="12.5"/>
                                        <TextBlock Text="When enabled, runs tray-only with no window opened on system boot." 
                                                   Foreground="{StaticResource BrushTextMuted}" FontSize="10.5" 
                                                   Margin="24,2,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <DockPanel LastChildFill="False">
                                        <CheckBox Content="Always show icon in tray (prevent collapsing into overflow)" 
                                                  IsChecked="{Binding AlwaysShowTrayIcon}" 
                                                  Style="{StaticResource ModernCheckBox}" FontSize="12.5" 
                                                  VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                        <Button Content="Taskbar Settings..." Command="{Binding OpenTaskbarSettingsCommand}" 
                                                Style="{StaticResource ModernOutlineButton}" DockPanel.Dock="Right" 
                                                VerticalAlignment="Center" Padding="10,5"/>
                                    </DockPanel>
                                    <TextBlock Text="Requests Windows to keep the TrayTrigger icon pinned to the taskbar outside the hidden overflow chevron." 
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11" 
                                               Margin="24,3,0,6" TextWrapping="Wrap"/>

                                    <Border Background="#1A1A22" CornerRadius="6" Padding="8" Margin="24,4,0,0">
                                        <DockPanel LastChildFill="True">
                                            <TextBlock Text="&#xE82F;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="#CCA84E"
                                                       VerticalAlignment="Center" Margin="0,0,7,0" DockPanel.Dock="Left"/>
                                            <TextBlock Text="Tip: You can also drag the TrayTrigger icon from the taskbar ^ overflow chevron directly onto your taskbar to pin it permanently."
                                                       Foreground="#CCA84E" FontSize="10.5" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>

                                    <CheckBox Content="Minimize to system tray when launching a game" 
                                              IsChecked="{Binding MinimizeOnGameLaunch}" 
                                              Style="{StaticResource ModernCheckBox}" FontSize="12.5" Margin="0,12,0,0"/>
                                    <TextBlock Text="Automatically hides the TrayTrigger window to the system tray whenever a game starts so it never covers your game." 
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11" 
                                               Margin="24,3,0,4" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- 1.2 Updates & GitHub Releases -->
                            <Border CornerRadius="8" Background="{StaticResource BrushSurfaceDark}"
                                    BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1"
                                    Padding="14,12" Margin="0,0,0,10">
                                <StackPanel>
                                    <DockPanel LastChildFill="False" Margin="0,0,0,8">
                                        <TextBlock Text="Updates" FontSize="13.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                        <Button Content="Check for Updates Now" Command="{Binding CheckUpdatesInSettingsCommand}"
                                                Style="{StaticResource ModernOutlineButton}" DockPanel.Dock="Right"
                                                VerticalAlignment="Center" Padding="10,4"/>
                                    </DockPanel>

                                    <CheckBox Content="Automatically check for updates on startup"
                                              IsChecked="{Binding AutoCheckForUpdates}"
                                              Style="{StaticResource ModernCheckBox}" FontSize="12.5"/>
                                    <TextBlock Text="Checks GitHub Releases when TrayTrigger starts and notifies you when an update is available."
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11"
                                               Margin="24,3,0,10" TextWrapping="Wrap"/>

                                    <CheckBox Content="Receive pre-release (beta) updates"
                                              IsChecked="{Binding IncludePrereleaseUpdates}"
                                              Style="{StaticResource ModernCheckBox}" FontSize="12.5"/>
                                    <TextBlock Text="Also offer beta builds. New features first, but they may be less stable."
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11"
                                               Margin="24,3,0,2" TextWrapping="Wrap"/>
                                    <Button Style="{StaticResource HelpLinkButton}" Content="About the beta channel" Margin="24,0,0,10"
                                            Command="{x:Static services:HelpCommands.ShowTopic}" CommandParameter="updates/prerelease"/>

                                    <TextBlock Text="GitHub Repository (owner/repo):" FontSize="12" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding GitHubRepository, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ModernTextBox}" Width="240" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                                    <TextBlock Text="The public GitHub repository where TrayTrigger release packages and tags are published (default: stephenh678/TrayTrigger)."
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11" TextWrapping="Wrap"/>

                                    <TextBlock Text="{Binding UpdateStatusText}" FontSize="11.5" Foreground="{StaticResource BrushAccentHover}"
                                               Margin="0,8,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- 1.3 Global Manage Hotkey -->
                            <Border CornerRadius="8" Background="{StaticResource BrushSurfaceDark}"
                                    BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1"
                                    Padding="14,12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Show / Hide Window Hotkey" FontSize="13.5" FontWeight="SemiBold"
                                                Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding GlobalManageHotkey, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource ModernTextBox}" Margin="0,0,0,6" Width="150" HorizontalAlignment="Left"
                                             Tag="e.g. Ctrl+Alt+G"/>
                                    <TextBlock Text="Press this key combination anywhere in Windows to show or hide the TrayTrigger window (default: Ctrl+Alt+G). Type it as modifier+key, e.g. Ctrl+Alt+G, Ctrl+Shift+F12, or F9."
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>

                        <!-- ============================================== -->
                        <!-- CATEGORY 2: LIBRARY & ARTWORK                  -->
                        <!-- ============================================== -->
                        <StackPanel Visibility="{Binding ShowLibrarySection, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                            <!-- Section Header (shown in All Settings view) -->
                            <Border Margin="0,2,0,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAllTab}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="12.5" 
                                               Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="LIBRARY &amp; ARTWORK" FontSize="11.5" FontWeight="SemiBold" 
                                               Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- 2.1 Launcher Integrations -->
                            <Border CornerRadius="8" Background="{StaticResource BrushSurfaceDark}"
                                    BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1"
                                    Padding="14,12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Launcher Integrations" FontSize="13.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Each toggle controls whether Scan for Games looks for that launcher's installed games. Turning one off never removes or changes games already in your library."
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,0,0,4" TextWrapping="Wrap"/>
                                    <Button Style="{StaticResource HelpLinkButton}" Content="How the Game Scanner works" Margin="0,0,0,10"
                                            Command="{x:Static services:HelpCommands.ShowTopic}" CommandParameter="scanner/overview"/>

                                    <DockPanel LastChildFill="False">
                                        <CheckBox IsChecked="{Binding SteamIntegrationEnabled}"
                                                  Style="{StaticResource ModernCheckBox}" FontSize="13"
                                                  VerticalAlignment="Center" DockPanel.Dock="Left">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Enable Steam Library Integration" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </CheckBox>
                                        <Button Content="Scan for Games..." Command="{Binding OpenScanForGamesCommand}"
                                                Style="{StaticResource ModernOutlineButton}" DockPanel.Dock="Right"
                                                VerticalAlignment="Center" Padding="10,5"/>
                                    </DockPanel>
                                    <TextBlock Text="Found via Steam's own library manifests, with official artwork from Steam's cache. Untick a library folder below to skip it."
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11"
                                               Margin="24,3,0,6" TextWrapping="Wrap"/>

                                    <!-- Steam's library folders live here, under the toggle that owns them, rather than
                                         in the manual Scan Locations list below. Untick one to skip that library. -->
                                    <Border Background="#16161B" BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1"
                                            CornerRadius="6" Padding="10,8" Margin="24,0,0,10"
                                            Visibility="{Binding SteamIntegrationEnabled, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                                <TextBlock Text="Steam Libraries" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                                <Button Content="Refresh" Command="{Binding RefreshSteamScanLocationsCommand}"
                                                        Style="{StaticResource ModernGhostButton}" DockPanel.Dock="Right" Padding="8,3" FontSize="11"/>
                                            </DockPanel>

                                            <TextBlock Text="No Steam libraries detected. Click Refresh after installing Steam."
                                                       FontSize="11" Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap"
                                                       Visibility="{Binding HasNoSteamLibraryLocations, Converter={StaticResource BoolToVis}}"/>

                                            <ItemsControl ItemsSource="{Binding SteamLibraryLocations}" ItemTemplate="{StaticResource SteamLibraryRowTemplate}"/>
                                        </StackPanel>
                                    </Border>

                                    <CheckBox IsChecked="{Binding GogIntegrationEnabled}"
                                              Style="{StaticResource ModernCheckBox}" FontSize="13"
                                              Margin="0,0,0,4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Enable GOG Library Integration" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </CheckBox>
                                    <TextBlock Text="Found via GOG Galaxy's own install records. No scan location needed."
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11"
                                               Margin="24,3,0,10" TextWrapping="Wrap"/>

                                    <CheckBox IsChecked="{Binding EaIntegrationEnabled}"
                                              Style="{StaticResource ModernCheckBox}" FontSize="13"
                                              Margin="0,0,0,4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Enable EA Library Integration" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </CheckBox>
                                    <TextBlock Text="Found via the EA app's install manifests. Limitation: only games in EA's default folders (EA Games / Origin Games) are found - a custom install location is not."
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11"
                                               Margin="24,3,0,10" TextWrapping="Wrap"/>

                                    <CheckBox IsChecked="{Binding EpicIntegrationEnabled}"
                                              Style="{StaticResource ModernCheckBox}" FontSize="13"
                                              Margin="0,0,0,4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Enable Epic Games Library Integration" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </CheckBox>
                                    <TextBlock Text="Found via the Epic Games Launcher's own install records. No scan location needed."
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11"
                                               Margin="24,3,0,10" TextWrapping="Wrap"/>

                                    <CheckBox IsChecked="{Binding UbisoftIntegrationEnabled}"
                                              Style="{StaticResource ModernCheckBox}" FontSize="13"
                                              Margin="0,0,0,4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Enable Ubisoft Connect Library Integration" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </CheckBox>
                                    <TextBlock Text="Found via Ubisoft Connect's install records, any location. Limitation: Ubisoft records no title or exe, so both are read from the install folder - occasionally wrong for a game with several executables."
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11"
                                               Margin="24,3,0,10" TextWrapping="Wrap"/>

                                    <CheckBox IsChecked="{Binding XboxIntegrationEnabled}"
                                              Style="{StaticResource ModernCheckBox}" FontSize="13"
                                              Margin="0,0,0,4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Enable Xbox / PC Game Pass Library Integration" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </CheckBox>
                                    <TextBlock Text="Found via Windows' own Gaming Services records, so every game installed through the Xbox app is covered, on any drive. Games launch through Windows like the Xbox app does - no direct-exe option. Limitation: only modern (GDK) titles are detected; a few older Microsoft Store games that never moved to the current format are not."
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11"
                                               Margin="24,3,0,10" TextWrapping="Wrap"/>

                                    <CheckBox Content="Automatically scan for new games on startup"
                                              IsChecked="{Binding AutoScanForGamesOnStartup}"
                                              Style="{StaticResource ModernCheckBox}" FontSize="13" Margin="0,0,0,4"/>
                                    <TextBlock Text="Runs Scan for Games quietly each time TrayTrigger opens, covering the launchers above and your Scan Locations - only interrupts you with the New Games Found picker if it actually finds something new."
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11"
                                               Margin="24,3,0,2" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- 2.2 Scan Locations & Ignored Games -->
                            <Border CornerRadius="8" Background="{StaticResource BrushSurfaceDark}"
                                    BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1"
                                    Padding="14,12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Scan Locations &amp; Ignored Games" FontSize="13.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Extra folders to search for games that aren't installed through a launcher above, and games the scanner should skip."
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap"/>

                                    <!-- Scan Locations manager (manual folders only - Steam's own libraries are listed
                                         under the Steam integration toggle above) -->
                                    <Border Background="#16161B" BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1"
                                            CornerRadius="6" Padding="12,10">
                                        <StackPanel>
                                            <TextBlock Text="Scan Locations" FontSize="12.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,8"/>

                                            <TextBlock Text="No folders yet. Add one such as D:\Games to have Scan for Games look through its subfolders."
                                                       FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,8" TextWrapping="Wrap"
                                                       Visibility="{Binding HasNoScanLocations, Converter={StaticResource BoolToVis}}"/>

                                            <ItemsControl ItemsSource="{Binding ScanLocations}" ItemTemplate="{StaticResource ScanLocationRowTemplate}" Margin="0,0,0,4"/>

                                            <Button Content="+ Add a Scan Location" Command="{Binding AddScanLocationCommand}"
                                                    Style="{StaticResource ModernOutlineButton}" HorizontalAlignment="Left" Padding="10,5" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Ignored Games manager -->
                                    <Border Background="#16161B" BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1"
                                            CornerRadius="6" Padding="12,10" Margin="0,10,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasNoIgnoredGamePaths}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="Ignored Games" FontSize="12.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4"/>
                                            <TextBlock Text="Never suggested by Add Folder or Scan for Games. Remove one to let it be detected again."
                                                       FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                            <ItemsControl ItemsSource="{Binding IgnoredGamePaths}" ItemTemplate="{StaticResource IgnoredGamePathRowTemplate}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- 2.3 Game Titles & Metadata Detection -->
                            <Border CornerRadius="8" Background="{StaticResource BrushSurfaceDark}" 
                                    BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" 
                                    Padding="14,12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Game Titles &amp; Metadata Detection" FontSize="13.5" FontWeight="SemiBold" 
                                               Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4"/>
                                    <TextBlock Text="How game titles and categories are determined when importing files or scanning folders."
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,0,0,2" TextWrapping="Wrap"/>
                                    <Button Style="{StaticResource HelpLinkButton}" Content="How titles are detected" Margin="0,0,0,10"
                                            Command="{x:Static services:HelpCommands.ShowTopic}" CommandParameter="library/titles"/>

                                    <CheckBox Content="Search official game titles online (Steam store)"
                                              IsChecked="{Binding SearchOfficialTitleOnline}" 
                                              Style="{StaticResource ModernCheckBox}" FontSize="12.5"/>
                                    <TextBlock Text="Looks up the official title and Steam App ID instead of using the file name."
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11" 
                                               Margin="24,3,0,8" TextWrapping="Wrap"/>

                                    <DockPanel Margin="24,0,0,10" LastChildFill="False" IsEnabled="{Binding SearchOfficialTitleOnline}">
                                        <TextBlock Text="Matching sensitivity:" Foreground="{StaticResource BrushTextSecondary}" 
                                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <ComboBox ItemsSource="{Binding ConfidenceThresholdOptions}" 
                                                  SelectedItem="{Binding OnlineMatchSensitivity, Mode=TwoWay}" 
                                                  Style="{StaticResource ModernComboBox}" Width="190" HorizontalAlignment="Left"/>
                                    </DockPanel>

                                    <CheckBox Content="Local title fallback: Prefer executable (.exe) over folder name" 
                                              IsChecked="{Binding PreferExeForGameName}" 
                                              Style="{StaticResource ModernCheckBox}" FontSize="12.5"/>
                                    <TextBlock Text="Builds the title from the exe's name and metadata rather than its parent folder."
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11" 
                                               Margin="24,3,0,10" TextWrapping="Wrap"/>

                                    <CheckBox Content="Automatically categorize games from store genres" 
                                              IsChecked="{Binding AutoCategorizeFromSteam}" 
                                              Style="{StaticResource ModernCheckBox}" FontSize="12.5"/>
                                    <TextBlock Text="New games get their store genre (Action, RPG, Strategy) as a category instead of Uncategorized."
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11" 
                                               Margin="24,3,0,2" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- 2.4 Library Box Art & Visuals -->
                            <Border CornerRadius="8" Background="{StaticResource BrushSurfaceDark}" 
                                    BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" 
                                    Padding="14,12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Library Box Art &amp; Visuals" FontSize="13.5" FontWeight="SemiBold" 
                                               Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Customize poster covers and presentation styles on library game cards." 
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,0,0,12" TextWrapping="Wrap"/>

                                    <DockPanel Margin="0,0,0,12" LastChildFill="False">
                                        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                            <TextBlock Text="Library view mode:" Foreground="{StaticResource BrushTextPrimary}" FontSize="12.5"/>
                                            <TextBlock Text="The same setting as the view buttons above the library; it is remembered between sessions." Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ComboBox ItemsSource="{Binding ViewModeOptions}" 
                                                  SelectedItem="{Binding LibraryViewMode, Mode=TwoWay}" 
                                                  Style="{StaticResource ModernComboBox}" Width="140" HorizontalAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                    </DockPanel>

                                    <CheckBox Content="Display vertical poster art on game cards (Steam 600×900)"
                                              IsChecked="{Binding UseVerticalPosterArt}"
                                              Style="{StaticResource ModernCheckBox}" FontSize="12.5"/>
                                    <TextBlock Text="Shows official high-resolution vertical box artwork on library game cards instead of square icons when available."
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11"
                                               Margin="24,3,0,10" TextWrapping="Wrap"/>

                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Refresh All Game Posters" Command="{Binding RefreshAllPostersCommand}"
                                                IsEnabled="{Binding CanRefreshAllPosters}"
                                                Style="{StaticResource ModernOutlineButton}" Padding="10,5"
                                                HorizontalAlignment="Left" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding PosterRefreshStatus}" Foreground="{StaticResource BrushAccentHover}"
                                                   FontSize="11.5" VerticalAlignment="Center" Margin="10,0,0,4"/>
                                    </StackPanel>
                                    <TextBlock Text="Re-checks every game for better art, including ones that already have a cover."
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11"
                                               Margin="0,4,0,2" TextWrapping="Wrap"/>
                                    <Button Style="{StaticResource HelpLinkButton}" Content="How artwork is found" Margin="0,0,0,12"
                                            Command="{x:Static services:HelpCommands.ShowTopic}" CommandParameter="library/artwork"/>

                                    <CheckBox Content="Use SteamGridDB for fallback poster art (optional)"
                                              IsChecked="{Binding UseSteamGridDbArt}" 
                                              Style="{StaticResource ModernCheckBox}" FontSize="12.5"/>
                                    <TextBlock Text="Community box art for games Steam has no poster for yet. Needs a free API key."
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11" 
                                               Margin="24,3,0,8" TextWrapping="Wrap"/>

                                    <Grid Margin="24,0,0,0" IsEnabled="{Binding UseSteamGridDbArt}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding SteamGridDbApiKey, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{StaticResource ModernTextBox}" Margin="0,0,8,0" 
                                                 Tag="Paste your SteamGridDB API key here..."/>
                                        <Button Grid.Column="1" Content="Get API Key..." Command="{Binding OpenSteamGridDbSiteCommand}"
                                                Style="{StaticResource ModernOutlineButton}" Padding="10,5"/>
                                    </Grid>

                                    <!-- RAWG metadata key: for developer/publisher/synopsis/genre on non-Steam games,
                                         shown via the source toggle in the Game Details window. -->
                                    <TextBlock Text="Non-Steam game info (RAWG)" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushTextPrimary}" Margin="0,16,0,2"/>
                                    <TextBlock Text="Developer, publisher, release date, synopsis, and genre for games that aren't on Steam (Game Pass, Epic exclusives, Roblox, and so on). Needs a free RAWG API key; shown via a source toggle in each game's details window."
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11"
                                               Margin="0,0,0,8" TextWrapping="Wrap"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding RawgApiKey, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ModernTextBox}" Margin="0,0,8,0"
                                                 Tag="Paste your RAWG API key here..."/>
                                        <Button Grid.Column="1" Content="Get API Key..." Command="{Binding OpenRawgSiteCommand}"
                                                Style="{StaticResource ModernOutlineButton}" Padding="10,5"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ============================================== -->
                        <!-- CATEGORY 3: SYSTEM TRAY MENU                   -->
                        <!-- ============================================== -->
                        <StackPanel Visibility="{Binding ShowTrayMenuSection, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                            <!-- Section Header (shown in All Settings view) -->
                            <Border Margin="0,2,0,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAllTab}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74C;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="12.5" 
                                               Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="SYSTEM TRAY MENU" FontSize="11.5" FontWeight="SemiBold" 
                                               Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- 3.1 System Tray Context Menu Preferences -->
                            <Border CornerRadius="8" Background="{StaticResource BrushSurfaceDark}" 
                                    BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" 
                                    Padding="14,12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Tray Context Menu Preferences" FontSize="13.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4"/>
                                    <Button Style="{StaticResource HelpLinkButton}" Content="How the tray menu works" Margin="0,0,0,8"
                                            Command="{x:Static services:HelpCommands.ShowTopic}" CommandParameter="traymenu/overview"/>

                                    <CheckBox Content="Include 'Recent' category in tray menu"
                                              IsChecked="{Binding ShowRecentInTray}" 
                                              Style="{StaticResource ModernCheckBox}" FontSize="12.5"/>
                                    <TextBlock Text="Adds a 'Recent' section at the top of the tray menu with your last-played games, whether category grouping is on or not."
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11" 
                                               Margin="24,3,0,6" TextWrapping="Wrap"/>

                                    <DockPanel Margin="24,0,0,6" LastChildFill="False" IsEnabled="{Binding ShowRecentInTray}">
                                        <TextBlock Text="Max recent games to show:" Foreground="{StaticResource BrushTextSecondary}"
                                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBox Text="{Binding MaxRecentInTray, UpdateSourceTrigger=LostFocus}"
                                                 Style="{StaticResource ModernTextBox}" Width="50" HorizontalAlignment="Left"
                                                 PreviewTextInput="NumericTextBox_PreviewTextInput"
                                                 DataObject.Pasting="NumericTextBox_Pasting"/>
                                    </DockPanel>

                                    <DockPanel Margin="24,0,0,12" LastChildFill="False" IsEnabled="{Binding ShowRecentInTray}">
                                        <TextBlock Text="Recent sort order:" Foreground="{StaticResource BrushTextSecondary}"
                                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <ComboBox ItemsSource="{Binding TraySortOptions}"
                                                  SelectedItem="{Binding RecentTraySortOption, Mode=TwoWay}"
                                                  Style="{StaticResource ModernComboBox}" Width="180" HorizontalAlignment="Left"/>
                                    </DockPanel>

                                    <CheckBox Content="Include 'Favorites' category in tray menu"
                                              IsChecked="{Binding ShowFavoritesInTray}"
                                              Style="{StaticResource ModernCheckBox}" FontSize="12.5"/>
                                    <TextBlock Text="Adds a 'Favorites' section near the top of the tray menu with your starred games, whether category grouping is on or not. Hidden while you have no favorites."
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11"
                                               Margin="24,3,0,6" TextWrapping="Wrap"/>

                                    <DockPanel Margin="24,0,0,6" LastChildFill="False" IsEnabled="{Binding ShowFavoritesInTray}">
                                        <TextBlock Text="Max favorites to show:" Foreground="{StaticResource BrushTextSecondary}"
                                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBox Text="{Binding MaxFavoritesInTray, UpdateSourceTrigger=LostFocus}"
                                                 Style="{StaticResource ModernTextBox}" Width="50" HorizontalAlignment="Left"
                                                 PreviewTextInput="NumericTextBox_PreviewTextInput"
                                                 DataObject.Pasting="NumericTextBox_Pasting"/>
                                    </DockPanel>

                                    <DockPanel Margin="24,0,0,12" LastChildFill="False" IsEnabled="{Binding ShowFavoritesInTray}">
                                        <TextBlock Text="Favorites sort order:" Foreground="{StaticResource BrushTextSecondary}"
                                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <ComboBox ItemsSource="{Binding TraySortOptions}"
                                                  SelectedItem="{Binding FavoritesTraySortOption, Mode=TwoWay}"
                                                  Style="{StaticResource ModernComboBox}" Width="180" HorizontalAlignment="Left"/>
                                    </DockPanel>

                                    <CheckBox Content="Group tray context menu by category"
                                              IsChecked="{Binding GroupTrayMenuByCategory}" 
                                              Style="{StaticResource ModernCheckBox}" FontSize="12.5"/>
                                    <TextBlock Text="When enabled, games are shown under category submenus in the right-click tray menu. When disabled, shows a flat list sorted by your preference." 
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11" 
                                               Margin="24,3,0,10" TextWrapping="Wrap"/>

                                    <DockPanel Margin="24,0,0,4" LastChildFill="False">
                                        <TextBlock Text="Tray menu sort order:" Foreground="{StaticResource BrushTextSecondary}" 
                                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <ComboBox ItemsSource="{Binding TraySortOptions}" 
                                                  SelectedItem="{Binding TrayMenuSortOption, Mode=TwoWay}" 
                                                  Style="{StaticResource ModernComboBox}" Width="180" HorizontalAlignment="Left"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ============================================== -->
                        <!-- CATEGORY 4: PERFORMANCE TWEAKS                 -->
                        <!-- ============================================== -->
                        <StackPanel Visibility="{Binding ShowPerformanceTweaksSection, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                            <!-- Section Header (shown in All Settings view) -->
                            <Border Margin="0,2,0,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAllTab}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="12.5"
                                               Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="LAUNCH &amp; PERFORMANCE" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- 4.0 Per-game launch scripts (off by default; gates the Edit Game card).
                                 Lives here, with the other launch-time behaviour, rather than under General. -->
                            <Border CornerRadius="8" Background="{StaticResource BrushSurfaceDark}"
                                    BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1"
                                    Padding="14,12" Margin="0,0,0,10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="Game Launch Scripts" FontSize="13.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                        <Border Background="#2A2A3A" CornerRadius="3" Padding="6,1.5" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="ADVANCED" FontSize="9" FontWeight="Bold" Foreground="#B8B8CC"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Run your own script or program before a game starts and after it exits - close Discord, switch audio, set an RGB profile."
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap"/>

                                    <CheckBox Content="Show Pre-Launch &amp; Post-Exit Scripts in Edit Game"
                                              IsChecked="{Binding EnableGameScripts}"
                                              Style="{StaticResource ModernCheckBox}" FontSize="12.5"/>
                                    <TextBlock Text="Off by default to keep Edit Game simple. Games that already have a script keep it either way."
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11"
                                               Margin="24,3,0,2" TextWrapping="Wrap"/>
                                    <Button Style="{StaticResource HelpLinkButton}" Content="Script guide &amp; examples" Margin="24,0,0,2"
                                            Command="{x:Static services:HelpCommands.ShowTopic}" CommandParameter="scripts/overview"/>
                                </StackPanel>
                            </Border>

                            <!-- 4.1 Preset & Reset Options -->
                            <Border CornerRadius="8" Background="{StaticResource BrushSurfaceDark}"
                                    BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1"
                                    Padding="14,12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Performance Tweak Safety" FontSize="13.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Applies to Apply Performance Preset and Reset Defaults on the System &amp; Performance page."
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap"/>

                                    <CheckBox Content="Create a System Restore Point before applying a preset or reset"
                                              IsChecked="{Binding CreateRestorePointBeforeTweaks}"
                                              Style="{StaticResource ModernCheckBox}" FontSize="12.5"/>
                                    <TextBlock Text="A Windows rollback point in case a bulk change causes problems. Recommended on."
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11"
                                               Margin="24,3,0,2" TextWrapping="Wrap"/>
                                    <Button Style="{StaticResource HelpLinkButton}" Content="About restore points" Margin="24,0,0,2"
                                            Command="{x:Static services:HelpCommands.ShowTopic}" CommandParameter="tweaks/restore_point"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ============================================== -->
                        <!-- CATEGORY 5: STORAGE & DIAGNOSTICS              -->
                        <!-- ============================================== -->
                        <StackPanel Visibility="{Binding ShowDiagnosticsSection, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                            <!-- Section Header (shown in All Settings view) -->
                            <Border Margin="0,2,0,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAllTab}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="12.5" 
                                               Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="DIAGNOSTICS &amp; STORAGE" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- 5.1 Troubleshooting & Diagnostics -->
                            <Border CornerRadius="8" Background="{StaticResource BrushSurfaceDark}" 
                                    BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" 
                                    Padding="14,12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Diagnostic Logging &amp; Traces" FontSize="13.5" FontWeight="SemiBold" 
                                               Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Configure diagnostic logging to catch errors and trace execution while troubleshooting issues." 
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap"/>

                                    <CheckBox Content="Enable Verbose Logging" 
                                              IsChecked="{Binding VerboseLoggingEnabled}" 
                                              Style="{StaticResource ModernCheckBox}" FontSize="12.5"/>
                                    <TextBlock Text="Adds detailed traces (launch parameters, scoring, registry checks) to the log. Turn on when reproducing a problem."
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11"
                                               Margin="24,3,0,2" TextWrapping="Wrap"/>
                                    <Button Style="{StaticResource HelpLinkButton}" Content="Reading the log &amp; reporting a problem" Margin="24,0,0,12"
                                            Command="{x:Static services:HelpCommands.ShowTopic}" CommandParameter="troubleshooting/logs"/>

                                    <!-- Active Debug Log Info Box -->
                                    <Border Background="#16161B" CornerRadius="6" BorderBrush="#252530" BorderThickness="1" Padding="12,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="Active Debug Log File" FontSize="10.5" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,2"/>
                                                <TextBlock Text="{Binding LogFilePathDisplay}" FontSize="11.5" FontFamily="{StaticResource AppFont}" 
                                                           Foreground="{StaticResource BrushAccentHover}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding LogFileSizeDisplay, StringFormat='Current File Size: {0}'}" 
                                                           FontSize="10.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="Open Log" Command="{Binding OpenLogFileCommand}" 
                                                        Style="{StaticResource ModernOutlineButton}" Margin="0,0,6,0" Padding="10,5"/>
                                                <Button Content="Clear Log" Command="{Binding ClearLogCommand}" 
                                                        Style="{StaticResource ModernOutlineButton}" Margin="0,0,6,0" Padding="10,5"/>
                                                <Button Content="Open Folder" Command="{Binding OpenLogFolderCommand}" 
                                                        Style="{StaticResource ModernOutlineButton}" Padding="10,5"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- 5.2 Storage & Asset Caches -->
                            <Border CornerRadius="8" Background="{StaticResource BrushSurfaceDark}" 
                                    BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" 
                                    Padding="14,12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Data Storage &amp; Asset Cache" FontSize="13.5" FontWeight="SemiBold" 
                                               Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Local application databases, configurations, and downloaded artwork caches." 
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap"/>

                                    <!-- Roaming: Database & Settings -->
                                    <DockPanel LastChildFill="True" Margin="0,0,0,10">
                                        <Button DockPanel.Dock="Right" Content="Open Data Folder" Command="{Binding OpenStorageFolderCommand}" 
                                                Style="{StaticResource ModernOutlineButton}" VerticalAlignment="Center" Padding="10,5"/>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="User Data &amp; Settings (%AppData%)" FontSize="12" FontWeight="SemiBold" 
                                                       Foreground="{StaticResource BrushTextSecondary}"/>
                                            <TextBlock Text="{Binding StorageDirectoryDisplay}" Foreground="{StaticResource BrushAccentHover}" 
                                                       FontSize="11" FontFamily="{StaticResource AppFont}" Margin="0,2,0,2"/>
                                            <TextBlock Text="Contains games.json, settings.json, and atomic .bak recovery backups." 
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="10.5" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <Separator Background="#252530" Margin="0,2,0,10"/>

                                    <!-- Local: Artwork & Media Caches -->
                                    <DockPanel LastChildFill="True">
                                        <Button DockPanel.Dock="Right" Content="Open Cache Folder" Command="{Binding OpenCacheFolderCommand}" 
                                                Style="{StaticResource ModernOutlineButton}" VerticalAlignment="Center" Padding="10,5"/>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="Artwork &amp; Icons Cache (%LocalAppData%)" FontSize="12" FontWeight="SemiBold" 
                                                       Foreground="{StaticResource BrushTextSecondary}"/>
                                            <TextBlock Text="{Binding CacheDirectoryDisplay}" Foreground="{StaticResource BrushAccentHover}" 
                                                       FontSize="11" FontFamily="{StaticResource AppFont}" Margin="0,2,0,2"/>
                                            <TextBlock Text="Contains extracted game icons (.png) and downloaded poster artwork (.jpg)." 
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="10.5" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <!-- 5.3 Reset Settings to Defaults -->
                            <Border CornerRadius="8" Background="{StaticResource BrushSurfaceDark}" 
                                    BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" 
                                    Padding="14,12" Margin="0,0,0,10">
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Right" Content="Restore Defaults" Command="{Binding ResetSettingsCommand}" 
                                            Style="{StaticResource ModernOutlineButton}" VerticalAlignment="Center" Padding="12,6"/>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="Reset Settings to Defaults" FontSize="13.5" FontWeight="SemiBold" 
                                                   Foreground="{StaticResource BrushTextPrimary}"/>
                                        <TextBlock Text="Restores startup, tray menu, game detection, and display preferences to the recommended defaults. Your game library and custom artwork are preserved."
                                                   Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

                <!-- Settings status line. SettingsViewModel.StatusMessage was previously bound
                     nowhere (the Library status bar is collapsed while Settings is shown), so
                     "Settings saved", "Added scan location", and the integration-toggle messages
                     were all invisible. -->
                <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" FontSize="12"
                           Foreground="{StaticResource BrushTextSecondary}" FontFamily="{StaticResource AppFont}"
                           TextWrapping="Wrap" Margin="0,0,0,2">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusMessage}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusMessage}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                </Grid>
            </Grid>

            <!-- ========================================================== -->
            <!-- 3. IN-WINDOW ABOUT VIEW                                    -->
            <!-- ========================================================== -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAboutView}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="Auto"/> <!-- Category Segmented Tabs -->
                    <RowDefinition Height="*"/>    <!-- About Content ScrollViewer -->
                </Grid.RowDefinitions>

                <!-- 1. Header matching Settings, System, Library -->
                <DockPanel Grid.Row="0" Margin="0,0,0,14">
                    <!-- Right: Version & Status Indicator Badge -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding UpdateStatusIcon}" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="12" 
                                   Foreground="{Binding UpdateStatusBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="{Binding UpdateStatusBadgeText}" FontSize="11.5" Foreground="{StaticResource BrushTextMuted}" 
                                   FontFamily="{StaticResource AppFont}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Left: Title & Subtitle matching Settings -->
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="About TrayTrigger" FontSize="20" Foreground="{StaticResource BrushTextPrimary}" 
                                   FontFamily="{StaticResource AppFont}" FontWeight="Normal"/>
                        <TextBlock Text="Application overview, keyboard shortcuts, verified features, and diagnostics" 
                                   FontSize="12" Foreground="{StaticResource BrushTextSecondary}" 
                                   FontFamily="{StaticResource AppFont}" Margin="0,4,0,0"/>
                    </StackPanel>
                </DockPanel>

                <!-- 2. Category Segmented Tabs -->
                <Border Grid.Row="1" Background="#181820" BorderBrush="{StaticResource BrushBorderDark}" 
                        BorderThickness="1" CornerRadius="6" Padding="3" HorizontalAlignment="Left" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="All" Command="{Binding SelectAboutAllTabCommand}"
                                Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsAboutAllTab}"/>
                        <Button Content="Overview" Command="{Binding SelectAboutOverviewTabCommand}" Margin="2,0,0,0"
                                Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsAboutOverviewTab}"/>
                        <Button Content="Key Features" Command="{Binding SelectAboutFeaturesTabCommand}" Margin="2,0,0,0"
                                Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsAboutFeaturesTab}"/>
                        <Button Content="Shortcuts" Command="{Binding SelectAboutShortcutsTabCommand}" Margin="2,0,0,0"
                                Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsAboutShortcutsTab}"/>
                        <Button Content="Support &amp; Links" Command="{Binding SelectAboutSupportTabCommand}" Margin="2,0,0,0"
                                Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsAboutSupportTab}"/>
                    </StackPanel>
                </Border>

                <!-- 3. About Content ScrollViewer -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14">
                    <StackPanel HorizontalAlignment="Stretch" Margin="0,0,12,0">

                        <!-- ============================================== -->
                        <!-- CATEGORY 1: APPLICATION OVERVIEW               -->
                        <!-- ============================================== -->
                        <StackPanel Visibility="{Binding ShowAboutOverviewSection, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                            <!-- Section Header (shown in All view) -->
                            <Border Margin="0,2,0,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAboutAllTab}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="12.5" 
                                               Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="APPLICATION OVERVIEW" FontSize="11.5" FontWeight="SemiBold" 
                                               Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Hero Identity Card -->
                            <Border CornerRadius="8" Background="{StaticResource BrushSurfaceDark}" 
                                    BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" 
                                    Padding="18,16" Margin="0,0,0,10">
                                <DockPanel LastChildFill="True">
                                    <Image Source="/Assets/app_icon.png" Width="52" Height="52"
                                           Margin="0,0,18,0" DockPanel.Dock="Left" VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>

                                    <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0">
                                        <Button Content="Check for Updates" Command="{Binding CheckForUpdatesCommand}" 
                                                Style="{StaticResource ModernAccentButton}" Padding="12,5" Margin="0,0,0,6"/>
                                        <Button Content="GitHub Project" Command="{Binding OpenGitHubCommand}" 
                                                Style="{StaticResource ModernOutlineButton}" Padding="12,5"/>
                                    </StackPanel>

                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="TrayTrigger" FontSize="19" FontWeight="SemiBold" 
                                                       Foreground="{StaticResource BrushTextPrimary}" FontFamily="{StaticResource AppFont}"/>
                                            <Border Background="#1C2E3D" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding AppVersionDisplay}" FontSize="11" Foreground="{StaticResource BrushAccentHover}" FontWeight="SemiBold"/>
                                            </Border>
                                            <Border Background="#1E2028" CornerRadius="4" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text=".NET 10.0" FontSize="10.5" Foreground="#85929E" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="A modern, distraction-free Windows tray launcher designed for zero friction, fast access, and clean game organization." 
                                                   Foreground="{StaticResource BrushTextSecondary}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Environment strip: real values about this install (what a bug report
                                 needs), replacing the old marketing labels. -->
                            <Border CornerRadius="8" Background="{StaticResource BrushSurfaceDark}"
                                    BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1"
                                    Padding="14,12" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="#17171C" CornerRadius="6" Padding="12,10" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="WINDOWS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,3"/>
                                            <TextBlock Text="{Binding OsDisplay}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Background="#17171C" CornerRadius="6" Padding="12,10" Margin="3,0,3,0">
                                        <StackPanel>
                                            <TextBlock Text="RUNTIME" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,3"/>
                                            <TextBlock Text="{Binding RuntimeDisplay}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Background="#17171C" CornerRadius="6" Padding="12,10" Margin="3,0,3,0">
                                        <StackPanel>
                                            <TextBlock Text="LIBRARY" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,3"/>
                                            <TextBlock Text="{Binding TotalGameCountDisplay}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="3" Background="#17171C" CornerRadius="6" Padding="12,10" Margin="6,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="DATA FOLDER" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,3"/>
                                            <TextBlock Text="{Binding SettingsVM.StorageDirectoryDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- ============================================== -->
                        <!-- CATEGORY 2: KEY FEATURES                       -->
                        <!-- ============================================== -->
                        <StackPanel Visibility="{Binding ShowAboutFeaturesSection, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                            <!-- Section Header (shown in All view) -->
                            <Border Margin="0,2,0,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAboutAllTab}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="12.5" 
                                               Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="KEY FEATURES &amp; CAPABILITIES" FontSize="11.5" FontWeight="SemiBold" 
                                               Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Feature Grid (2 columns x 5 rows), ordered best to worst -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Feature 1: Game-Level Performance Profiles -->
                                <Border Grid.Row="0" Grid.Column="0" CornerRadius="8" Background="{StaticResource BrushSurfaceDark}"
                                        BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1"
                                        Padding="14,12" Margin="0,0,5,10">
                                    <DockPanel LastChildFill="True">
                                        <Border Width="34" Height="34" CornerRadius="6" Background="#20202A" Margin="0,0,12,0" VerticalAlignment="Top">
                                            <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="14"
                                                       Foreground="{StaticResource BrushAccentHover}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Game-Level Performance Profiles" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                            <TextBlock Text="Assign each game an Optimized or Aggressive tweak profile, automatically applied for the duration of that game's session and fully reverted the moment it closes."
                                                       FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- Feature 2: Multi-Platform Library Integration -->
                                <Border Grid.Row="0" Grid.Column="1" CornerRadius="8" Background="{StaticResource BrushSurfaceDark}"
                                        BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1"
                                        Padding="14,12" Margin="5,0,0,10">
                                    <DockPanel LastChildFill="True">
                                        <Border Width="34" Height="34" CornerRadius="6" Background="#20202A" Margin="0,0,12,0" VerticalAlignment="Top">
                                            <TextBlock Text="&#xE753;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="14"
                                                       Foreground="{StaticResource BrushAccentHover}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Multi-Platform Library Integration" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                            <TextBlock Text="Auto-discovers installed games from Steam, GOG, EA, Epic, Ubisoft Connect, and Xbox, matches official titles and genres, and imports store artwork."
                                                       FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- Feature 3: One-Click Launch -->
                                <Border Grid.Row="1" Grid.Column="0" CornerRadius="8" Background="{StaticResource BrushSurfaceDark}"
                                        BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1"
                                        Padding="14,12" Margin="0,0,5,10">
                                    <DockPanel LastChildFill="True">
                                        <Border Width="34" Height="34" CornerRadius="6" Background="#20202A" Margin="0,0,12,0" VerticalAlignment="Top">
                                            <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="14"
                                                       Foreground="{StaticResource BrushAccentHover}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="One-Click Launch &amp; Focus" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                            <TextBlock Text="Launch a game or bring the running one forward - never a duplicate process. Tracked sessions show a PLAYING badge and a Now Playing tray section with End Session and Force Close."
                                                       FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- Feature 4: Live Hardware Telemetry & Performance Tweaks -->
                                <Border Grid.Row="1" Grid.Column="1" CornerRadius="8" Background="{StaticResource BrushSurfaceDark}"
                                        BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1"
                                        Padding="14,12" Margin="5,0,0,10">
                                    <DockPanel LastChildFill="True">
                                        <Border Width="34" Height="34" CornerRadius="6" Background="#20202A" Margin="0,0,12,0" VerticalAlignment="Top">
                                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="14"
                                                       Foreground="{StaticResource BrushAccentHover}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Hardware Telemetry &amp; Tweaks" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                            <TextBlock Text="Live CPU and RAM load plus GPU, display, drive, and network specs, and documented Windows gaming tweaks - with an automatic System Restore Point as a safety net."
                                                       FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- Feature 5: Per-Game Global Hotkeys -->
                                <Border Grid.Row="2" Grid.Column="0" CornerRadius="8" Background="{StaticResource BrushSurfaceDark}"
                                        BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1"
                                        Padding="14,12" Margin="0,0,5,10">
                                    <DockPanel LastChildFill="True">
                                        <Border Width="34" Height="34" CornerRadius="6" Background="#20202A" Margin="0,0,12,0" VerticalAlignment="Top">
                                            <TextBlock Text="&#xE92E;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="14"
                                                       Foreground="{StaticResource BrushAccentHover}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Per-Game Global Hotkeys" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                            <TextBlock Text="Assign a dedicated hotkey to any game for instant launch, and optionally your own pre-launch and post-exit scripts."
                                                       FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- Feature 6: Distraction-Free Tray Launcher -->
                                <Border Grid.Row="2" Grid.Column="1" CornerRadius="8" Background="{StaticResource BrushSurfaceDark}"
                                        BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1"
                                        Padding="14,12" Margin="5,0,0,10">
                                    <DockPanel LastChildFill="True">
                                        <Border Width="34" Height="34" CornerRadius="6" Background="#20202A" Margin="0,0,12,0" VerticalAlignment="Top">
                                            <TextBlock Text="&#xE704;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="14"
                                                       Foreground="{StaticResource BrushAccentHover}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Distraction-Free Tray Launcher" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                            <TextBlock Text="A lightweight, tray-native footprint, global hotkey toggle, and instant access via tray menus."
                                                       FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- Feature 7: Smart Folder Detection -->
                                <Border Grid.Row="3" Grid.Column="0" CornerRadius="8" Background="{StaticResource BrushSurfaceDark}"
                                        BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1"
                                        Padding="14,12" Margin="0,0,5,10">
                                    <DockPanel LastChildFill="True">
                                        <Border Width="34" Height="34" CornerRadius="6" Background="#20202A" Margin="0,0,12,0" VerticalAlignment="Top">
                                            <TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="14"
                                                       Foreground="{StaticResource BrushAccentHover}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Smart Folder Detection" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                            <TextBlock Text="Drag and drop install folders to auto-filter uninstallers and extract high-resolution icons."
                                                       FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- Feature 8: Categories & Sorting -->
                                <Border Grid.Row="3" Grid.Column="1" CornerRadius="8" Background="{StaticResource BrushSurfaceDark}"
                                        BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1"
                                        Padding="14,12" Margin="5,0,0,10">
                                    <DockPanel LastChildFill="True">
                                        <Border Width="34" Height="34" CornerRadius="6" Background="#20202A" Margin="0,0,12,0" VerticalAlignment="Top">
                                            <TextBlock Text="&#xE8EC;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="14"
                                                       Foreground="{StaticResource BrushAccentHover}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Categories &amp; Multi-Criteria Sorting" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                            <TextBlock Text="Organize games by genres and platforms with instant sorting by A-Z, Playtime, or Last Played."
                                                       FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- Feature 9: Opt-In Performance Tweaks -->
                                <Border Grid.Row="4" Grid.Column="0" CornerRadius="8" Background="{StaticResource BrushSurfaceDark}"
                                        BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1"
                                        Padding="14,12" Margin="0,0,5,0">
                                    <DockPanel LastChildFill="True">
                                        <Border Width="34" Height="34" CornerRadius="6" Background="#20202A" Margin="0,0,12,0" VerticalAlignment="Top">
                                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="14"
                                                       Foreground="{StaticResource BrushAccentHover}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Opt-In Performance Tweaks" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                            <TextBlock Text="Situational or tradeoff-heavy tweaks (like Visual Effects and Nagle's Algorithm) stay off by default and clearly badged, so nothing with a real downside applies without you choosing it."
                                                       FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- Feature 10: SteamGridDB Fallback Artwork -->
                                <Border Grid.Row="4" Grid.Column="1" CornerRadius="8" Background="{StaticResource BrushSurfaceDark}"
                                        BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1"
                                        Padding="14,12" Margin="5,0,0,0">
                                    <DockPanel LastChildFill="True">
                                        <Border Width="34" Height="34" CornerRadius="6" Background="#20202A" Margin="0,0,12,0" VerticalAlignment="Top">
                                            <TextBlock Text="&#xEB9F;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="14"
                                                       Foreground="{StaticResource BrushAccentHover}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="SteamGridDB Fallback Artwork" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                            <TextBlock Text="Falls back to community-submitted box art from SteamGridDB when official artwork isn't available yet."
                                                       FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <!-- ============================================== -->
                        <!-- CATEGORY 3: QUICK REFERENCE & SHORTCUTS        -->
                        <!-- ============================================== -->
                        <StackPanel Visibility="{Binding ShowAboutShortcutsSection, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                            <!-- Section Header (shown in All view) -->
                            <Border Margin="0,2,0,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAboutAllTab}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="12.5" 
                                               Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="QUICK REFERENCE &amp; SHORTCUTS" FontSize="11.5" FontWeight="SemiBold" 
                                               Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border CornerRadius="8" Background="{StaticResource BrushSurfaceDark}" 
                                    BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" 
                                    Padding="14,12" Margin="0,0,0,10">
                                <StackPanel>
                                    <DockPanel LastChildFill="True" Margin="0,0,0,12">
                                        <Button DockPanel.Dock="Right" Content="Configure Hotkey..." 
                                                Command="{Binding NavigateToGeneralSettingsCommand}" 
                                                Style="{StaticResource ModernOutlineButton}" 
                                                VerticalAlignment="Center" Padding="11,5"/>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="Keyboard &amp; Mouse Controls" FontSize="13.5" FontWeight="SemiBold" 
                                                       Foreground="{StaticResource BrushTextPrimary}"/>
                                            <TextBlock Text="Convenient hotkeys and mouse actions for lightning-fast library and tray management." 
                                                       Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <!-- Table Container -->
                                    <Border Background="#17171C" CornerRadius="6" Padding="14,10">
                                        <StackPanel>
                                            <!-- Row 1: Global Hotkey - shows the configured value, not a hard-coded Ctrl+Alt+G -->
                                            <DockPanel Margin="0,0,0,9">
                                                <StackPanel Orientation="Horizontal" Width="200" VerticalAlignment="Center">
                                                    <Border Background="#252532" BorderBrush="#353545" BorderThickness="1" CornerRadius="4" Padding="7,2">
                                                        <TextBlock Text="{Binding SettingsVM.GlobalManageHotkey}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushAccentHover}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="Show or hide the TrayTrigger window from anywhere in Windows (change it in Settings > General)"
                                                           Foreground="{StaticResource BrushTextSecondary}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            </DockPanel>

                                            <!-- Row 2: Tray Left-Click -->
                                            <DockPanel Margin="0,0,0,9">
                                                <StackPanel Orientation="Horizontal" Width="200" VerticalAlignment="Center">
                                                    <Border Background="#252532" BorderBrush="#353545" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="Left-Click" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                                    </Border>
                                                    <TextBlock Text=" Tray Icon" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="Show or hide the TrayTrigger window"
                                                           Foreground="{StaticResource BrushTextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                                            </DockPanel>

                                            <!-- Row 3: Tray Right-Click -->
                                            <DockPanel Margin="0,0,0,9">
                                                <StackPanel Orientation="Horizontal" Width="200" VerticalAlignment="Center">
                                                    <Border Background="#252532" BorderBrush="#353545" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="Right-Click" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                                    </Border>
                                                    <TextBlock Text=" Tray Icon" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="Quick-launch menu: Now Playing, Recent, Favorites, all games (grouped or flat), Scan for Games, Settings, Exit"
                                                           Foreground="{StaticResource BrushTextSecondary}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            </DockPanel>

                                            <!-- Row 4: Game Card Left-Click -->
                                            <DockPanel Margin="0,0,0,9">
                                                <StackPanel Orientation="Horizontal" Width="200" VerticalAlignment="Center">
                                                    <Border Background="#252532" BorderBrush="#353545" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="Left-Click" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                                    </Border>
                                                    <TextBlock Text=" Game Card" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="Open Game Details (store data, playtime, box art). Keyboard: Enter on a focused card; Ctrl+Enter launches"
                                                           Foreground="{StaticResource BrushTextSecondary}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            </DockPanel>

                                            <!-- Row 4b: Select mode -->
                                            <DockPanel Margin="0,0,0,9">
                                                <StackPanel Orientation="Horizontal" Width="200" VerticalAlignment="Center">
                                                    <Border Background="#252532" BorderBrush="#353545" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="Ctrl+Click" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                                    </Border>
                                                    <TextBlock Text=" / " Foreground="{StaticResource BrushTextMuted}" FontSize="11" VerticalAlignment="Center"/>
                                                    <Border Background="#252532" BorderBrush="#353545" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="Ctrl+A" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                                    </Border>
                                                    <TextBlock Text=" Game Card" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="Select several games (Shift+click for a range), then right-click one of them for the batch menu: Favorite, Hide, Change Category, Performance Profile, Refresh, or Remove them together. Delete removes the selection; Esc or a click on empty space clears it"
                                                           Foreground="{StaticResource BrushTextSecondary}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            </DockPanel>

                                            <!-- Row 5: Game Card Right-Click -->
                                            <DockPanel Margin="0,0,0,9">
                                                <StackPanel Orientation="Horizontal" Width="200" VerticalAlignment="Center">
                                                    <Border Background="#252532" BorderBrush="#353545" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="Right-Click" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                                    </Border>
                                                    <TextBlock Text=" Game Card" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="Play, Details, Favorite, Hide, End Session / Force Close while playing, edit shortcuts, Steam links, Remove"
                                                           Foreground="{StaticResource BrushTextSecondary}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            </DockPanel>

                                            <!-- Row 6: Quick Search -->
                                            <DockPanel Margin="0,0,0,9">
                                                <StackPanel Orientation="Horizontal" Width="200" VerticalAlignment="Center">
                                                    <Border Background="#252532" BorderBrush="#353545" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,3,0">
                                                        <TextBlock Text="Ctrl" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                                    </Border>
                                                    <TextBlock Text="+" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                                    <Border Background="#252532" BorderBrush="#353545" BorderThickness="1" CornerRadius="4" Padding="7,2">
                                                        <TextBlock Text="F" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushAccentHover}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="Focus the search input bar in the Games Library" 
                                                           Foreground="{StaticResource BrushTextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                                            </DockPanel>

                                            <!-- Row 7: Escape -->
                                            <DockPanel>
                                                <StackPanel Orientation="Horizontal" Width="200" VerticalAlignment="Center">
                                                    <Border Background="#252532" BorderBrush="#353545" BorderThickness="1" CornerRadius="4" Padding="8,2">
                                                        <TextBlock Text="Esc" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="Clear active search filter and restore all games" 
                                                           Foreground="{StaticResource BrushTextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ============================================== -->
                        <!-- CATEGORY 4: SUPPORT & DIAGNOSTICS              -->
                        <!-- ============================================== -->
                        <StackPanel Visibility="{Binding ShowAboutSupportSection, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                            <!-- Section Header (shown in All view) -->
                            <Border Margin="0,2,0,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAboutAllTab}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="12.5" 
                                               Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="SUPPORT &amp; LINKS" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 0: Help Topics index (every embedded Help/**.md, grouped by section) -->
                            <Border CornerRadius="8" Background="{StaticResource BrushSurfaceDark}"
                                    BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1"
                                    Padding="14,12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Help Topics" FontSize="13.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushTextPrimary}"/>
                                    <TextBlock Text="The same explanations that sit behind every Learn more link, in one place."
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,2,0,10" TextWrapping="Wrap"/>
                                    <ItemsControl ItemsSource="{Binding HelpTopicIndex}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,8">
                                                    <TextBlock Text="{Binding Label}" FontSize="10.5" FontWeight="Bold"
                                                               Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4"/>
                                                    <ItemsControl ItemsSource="{Binding Topics}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Style="{StaticResource HelpLinkButton}" Content="{Binding Title}" FontSize="11.5"
                                                                        Margin="0,0,18,5"
                                                                        Command="{x:Static services:HelpCommands.ShowTopic}"
                                                                        CommandParameter="{Binding Id}"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Card 1: Centralized Diagnostics Link -->
                            <Border CornerRadius="8" Background="{StaticResource BrushSurfaceDark}"
                                    BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1"
                                    Padding="14,12" Margin="0,0,0,10">
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Right"
                                            Command="{Binding OpenDiagnosticsSettingsCommand}"
                                            Style="{StaticResource ModernAccentButton}"
                                            VerticalAlignment="Center" Padding="12,5">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Open Diagnostics &amp; Storage" VerticalAlignment="Center"/>
                                            <TextBlock Text="&#xE72A;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" Margin="7,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Diagnostics &amp; Storage" FontSize="13.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrushTextPrimary}"/>
                                        <TextBlock Text="The debug log, verbose logging, data and artwork folders, and Reset Settings live under Settings › Diagnostics &amp; Storage."
                                                   Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Card 2: Copy System Info for Bug Reports -->
                            <Border CornerRadius="8" Background="{StaticResource BrushSurfaceDark}" 
                                    BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" 
                                    Padding="14,12" Margin="0,0,0,10">
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Right" Content="Copy Diagnostic Info" 
                                            Command="{Binding CopySystemInfoCommand}" 
                                            Style="{StaticResource ModernOutlineButton}" 
                                            VerticalAlignment="Center" Padding="12,5"/>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="System Environment Report" FontSize="13.5" FontWeight="SemiBold" 
                                                   Foreground="{StaticResource BrushTextPrimary}"/>
                                        <TextBlock Text="Quickly copy OS build, .NET runtime, architecture, and game library metrics to your clipboard for troubleshooting or bug reporting." 
                                                   Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Card 3: Community & Issues -->
                            <Border CornerRadius="8" Background="{StaticResource BrushSurfaceDark}" 
                                    BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" 
                                    Padding="14,12" Margin="0,0,0,10">
                                <DockPanel LastChildFill="True">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Report an Issue" Command="{Binding OpenGitHubIssuesCommand}" 
                                                Style="{StaticResource ModernOutlineButton}" VerticalAlignment="Center" Padding="11,5" Margin="0,0,6,0"/>
                                        <Button Content="GitHub Repository" Command="{Binding OpenGitHubCommand}" 
                                                Style="{StaticResource ModernOutlineButton}" VerticalAlignment="Center" Padding="11,5"/>
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Community &amp; Open Source" FontSize="13.5" FontWeight="SemiBold" 
                                                   Foreground="{StaticResource BrushTextPrimary}"/>
                                        <TextBlock Text="TrayTrigger is open source software. Submit bug reports, suggest features, or explore the documentation on GitHub." 
                                                   Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ========================================================== -->
            <!-- 4. SYSTEM & PERFORMANCE VIEW                               -->
            <!-- ========================================================== -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSystemView}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <views:SystemView DataContext="{Binding SystemVM}"/>
            </Grid>

        </Grid>
    </Grid>
</Window>
