                                        <Border Width="34" Height="34" CornerRadius="6" Background="#20202A" Margin="0,0,12,0" VerticalAlignment="Top">
                                            <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="14"
                                                       Foreground="{StaticResource BrushAccentHover}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Game-Level Performance Profiles" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                            <TextBlock Text="Assign each game an Optimized or Aggressive tweak profile, automatically applied for the duration of that game's session and fully reverted the moment it closes."
                                                       FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- Feature 2: Multi-Platform Library Integration -->
                                <Border Grid.Row="0" Grid.Column="1" CornerRadius="8" Background="{StaticResource BrushSurfaceDark}"
