                                        Padding="14,12" Margin="5,0,0,10">
                                    <DockPanel LastChildFill="True">
                                        <Border Width="34" Height="34" CornerRadius="6" Background="#20202A" Margin="0,0,12,0" VerticalAlignment="Top">
                                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="14"
                                                       Foreground="{StaticResource BrushAccentHover}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Hardware Telemetry &amp; Tweaks" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                            <TextBlock Text="Monitor CPU/RAM/VRAM telemetry and apply verified Windows gaming optimizations - with an automatic System Restore Point as a safety net."
                                                       FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- Feature 5: Per-Game Global Hotkeys -->
                                <Border Grid.Row="2" Grid.Column="0" CornerRadius="8" Background="{StaticResource BrushSurfaceDark}"
                                        BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1"
                                        Padding="14,12" Margin="0,0,5,10">
                                    <DockPanel LastChildFill="True">
                                        <Border Width="34" Height="34" CornerRadius="6" Background="#20202A" Margin="0,0,12,0" VerticalAlignment="Top">
                                            <TextBlock Text="&#xE92E;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="14"
                                                       Foreground="{StaticResource BrushAccentHover}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
