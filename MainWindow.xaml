<Window x:Class="TrayTrigger.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TrayTrigger.ViewModels"
        xmlns:views="clr-namespace:TrayTrigger.Views"
        xmlns:services="clr-namespace:TrayTrigger.Services"
        xmlns:theming="clr-namespace:TrayTrigger.Services.Theming"
        xmlns:models="clr-namespace:TrayTrigger.Models"
        mc:Ignorable="d"
        Title="TrayTrigger - Game Launcher"
        Height="700" Width="1020"
        MinHeight="500" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrushBackground}"
        ShowInTaskbar="True"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        PreviewKeyDown="Window_PreviewKeyDown"
        KeyDown="Window_KeyDown"
        PreviewMouseDown="Window_PreviewMouseDown">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/> <!-- Left Collapsible Sidebar -->
            <ColumnDefinition Width="*"/>    <!-- Main Content Area -->
        </Grid.ColumnDefinitions>

        <!-- The theme's background picture, under everything, dimmed by a layer of the theme's own background
             color so text on the page stays as readable as the theme meant (Light included). The pages have no
             background of their own, so it shows around the cards; the sidebar and the cards stay solid.
             Nothing here when the theme has no picture or the setting is off. -->
        <Grid Grid.ColumnSpan="2" IsHitTestVisible="False" ClipToBounds="True"
              DataContext="{x:Static theming:ThemeBackgroundState.Instance}"
              Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}">
            <Image Source="{Binding Image}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"
                   HorizontalAlignment="{Binding HorizontalAlign}" VerticalAlignment="{Binding VerticalAlign}"/>
            <Border Background="{DynamicResource BrushBackground}" Opacity="{Binding TintOpacity}"/>
        </Grid>

        <!-- ============================================================== -->
        <!-- LEFT COLLAPSIBLE SIDEBAR                                      -->
        <!-- ============================================================== -->
        <Border Grid.Column="0" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" 
                BorderThickness="0,0,1,0" Width="{Binding SidebarWidth}">
            <Grid Margin="6,12,6,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Brand & Toggle -->
                    <RowDefinition Height="Auto"/> <!-- Divider -->
                    <RowDefinition Height="*"/>    <!-- Navigation Items -->
                </Grid.RowDefinitions>

                <!-- Brand & Toggle Header -->
                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                    <Button Command="{Binding ToggleSidebarCommand}" Style="{StaticResource ModernGhostButton}" 
                            Height="38" Width="48" Padding="0" AutomationProperties.Name="{Binding SidebarToggleName}" ToolTip="{Binding SidebarToggleName}" DockPanel.Dock="Left"
                            HorizontalContentAlignment="Center">
                        <TextBlock Text="&#xE700;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeTitle}" 
                                   Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <!-- The wordmark, "Trigger" in the logo's blue, sized to fill the ~120 px beside the
                             toggle in the 190 px expanded sidebar. Runs on one line, so no space creeps in. -->
                        <TextBlock FontSize="{DynamicResource FontSizeHeading}" FontWeight="SemiBold" FontFamily="{DynamicResource AppFont}"
                                   Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"><Run Text="Tray"/><Run Text="Trigger" Foreground="{DynamicResource BrushBrand}"/></TextBlock>
                    </StackPanel>
                </DockPanel>

                <!-- Separator -->
                <Separator Grid.Row="1" Background="{DynamicResource BrushBorder}" Margin="2,0,2,12"/>

                <!-- Navigation & Action Items -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top Navigation Items -->
                    <StackPanel Grid.Row="0">
                        <!-- 1. Games Library -->
                        <Button Command="{Binding SelectLibraryCommand}" AutomationProperties.Name="Games Library" Margin="0,0,0,6">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLibraryView}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource BrushAccentWash}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource BrushAccentText}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <DockPanel LastChildFill="True" VerticalAlignment="Center">
                                <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeTitle}" 
                                           Width="26" Height="20" TextAlignment="Center" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                <TextBlock Text="Library" FontSize="{DynamicResource FontSizeBody}" VerticalAlignment="Center" Margin="10,0,0,0" FontFamily="{DynamicResource AppFont}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DockPanel>
                        </Button>

                        <!-- 1b. Tools: only while Settings > General > Enable Tools is on -->
                        <Button Command="{Binding SelectToolsCommand}" AutomationProperties.Name="Tools" Margin="0,0,0,6"
                                Visibility="{Binding IsToolsEnabled, Converter={StaticResource BoolToVis}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsToolsView}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource BrushAccentWash}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource BrushAccentText}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <DockPanel LastChildFill="True" VerticalAlignment="Center">
                                <TextBlock Text="&#xE90F;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeTitle}"
                                           Width="26" Height="20" TextAlignment="Center" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                <TextBlock Text="Tools" FontSize="{DynamicResource FontSizeBody}" VerticalAlignment="Center" Margin="10,0,0,0" FontFamily="{DynamicResource AppFont}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DockPanel>
                        </Button>

                        <!-- 2. System & Performance -->
                        <Button Command="{Binding SelectSystemCommand}" AutomationProperties.Name="System &amp; Performance" Margin="0,0,0,6">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSystemView}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource BrushAccentWash}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource BrushAccentText}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <DockPanel LastChildFill="True" VerticalAlignment="Center">
                                <TextBlock Text="&#xE950;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeTitle}"
                                           Width="26" Height="20" TextAlignment="Center" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                <TextBlock Text="System" FontSize="{DynamicResource FontSizeBody}" VerticalAlignment="Center" Margin="10,0,0,0" FontFamily="{DynamicResource AppFont}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DockPanel>
                        </Button>

                        <!-- 3. Settings -->
                        <Button Command="{Binding SelectSettingsCommand}" AutomationProperties.Name="Application Settings" Margin="0,0,0,6">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSettingsView}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource BrushAccentWash}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource BrushAccentText}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <DockPanel LastChildFill="True" VerticalAlignment="Center">
                                <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeTitle}" 
                                           Width="26" Height="20" TextAlignment="Center" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                <TextBlock Text="Settings" FontSize="{DynamicResource FontSizeBody}" VerticalAlignment="Center" Margin="10,0,0,0" FontFamily="{DynamicResource AppFont}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DockPanel>
                        </Button>

                        <!-- 3. About -->
                        <Button Command="{Binding SelectAboutCommand}" AutomationProperties.Name="About TrayTrigger" Margin="0,0,0,6">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAboutView}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource BrushAccentWash}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource BrushAccentText}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <DockPanel LastChildFill="True" VerticalAlignment="Center">
                                <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeTitle}" 
                                           Width="26" Height="20" TextAlignment="Center" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                <TextBlock Text="About" FontSize="{DynamicResource FontSizeBody}" VerticalAlignment="Center" Margin="10,0,0,0" FontFamily="{DynamicResource AppFont}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DockPanel>
                        </Button>
                    </StackPanel>

                    <!-- Bottom Actions: Activity & History, then Exit TrayTrigger -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
                        <Separator Background="{DynamicResource BrushBorder}" Margin="2,0,2,8"/>
                        <!-- The bell: a red dot while something needs attention, and the way into Activity & History.
                             The only indicator in the sidebar; the count is in the page header. -->
                        <Button Command="{Binding SelectActivityCommand}" Margin="0,0,0,6"
                                AutomationProperties.Name="{Binding ActivityVM.HeaderStatus, StringFormat='Activity and History, {0}'}"
                                ToolTip="{Binding ActivityVM.HeaderStatus, StringFormat='Activity &amp; History · {0}'}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActivityView}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource BrushAccentWash}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource BrushAccentText}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <DockPanel LastChildFill="True" VerticalAlignment="Center">
                                <Grid Width="26" Height="20" DockPanel.Dock="Left">
                                    <TextBlock Text="&#xEA8F;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeTitle}"
                                               TextAlignment="Center" VerticalAlignment="Center"/>
                                    <Ellipse Width="8" Height="8" Fill="{DynamicResource BrushDanger}" Stroke="{DynamicResource BrushSurface}" StrokeThickness="1"
                                             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,2,0"
                                             Visibility="{Binding ActivityVM.HasAttention, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                                <TextBlock Text="Activity" FontSize="{DynamicResource FontSizeBody}" VerticalAlignment="Center" Margin="10,0,0,0" FontFamily="{DynamicResource AppFont}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DockPanel>
                        </Button>
                        <Button Command="{Binding ExitApplicationCommand}" AutomationProperties.Name="Exit TrayTrigger" Style="{StaticResource SidebarNavButton}">
                            <DockPanel LastChildFill="True" VerticalAlignment="Center">
                                <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeTitle}" 
                                           Foreground="{DynamicResource BrushDanger}" Width="26" Height="20" TextAlignment="Center" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                <TextBlock Text="Exit App" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource BrushDanger}" VerticalAlignment="Center" Margin="10,0,0,0" FontFamily="{DynamicResource AppFont}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DockPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ============================================================== -->
        <!-- MAIN CONTENT AREA                                              -->
        <!-- ============================================================== -->
        <Grid Grid.Column="1" Margin="18">

            <!-- Floating non-blocking toast: game launches (Play glyph + "Launching...") and, when the user is
                 on a section other than Library, import/scan results (Accept glyph + "Added 3 new games").
                 Sits at the content-area level (not inside any one section's grid) so it renders
                 over whichever section is visible. Offset above the undo toast's anchor point so
                 the two don't overlap if both happen to be visible at once. -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,70"
                    Background="{DynamicResource BrushSurfaceHover}" BorderBrush="{DynamicResource BrushAccent}" BorderThickness="1.5"
                    CornerRadius="{DynamicResource RadiusCard}" Padding="16,10" Panel.ZIndex="100">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.5" Color="{DynamicResource ColorFloatingShadow}"/>
                </Border.Effect>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLaunchToastVisible}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LaunchToastIcon}" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeSubhead}" Margin="0,0,10,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource BrushAccent}"/>
                    <TextBlock Text="{Binding LaunchToastMessage}" Foreground="{DynamicResource BrushTextPrimary}"
                               FontSize="{DynamicResource FontSizeBody}" FontFamily="{DynamicResource AppFont}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button Content="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource FontSizeBody}" Command="{Binding DismissLaunchToastCommand}"
                            Style="{StaticResource ModernGhostButton}" Padding="6,4" VerticalAlignment="Center" ToolTip="Dismiss"
 AutomationProperties.Name="Dismiss"/>
                </StackPanel>
            </Border>

            <!-- ========================================================== -->
            <!-- 1. GAMES LIBRARY VIEW                                      -->
            <!-- ========================================================== -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLibraryView}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <views:LibraryView x:Name="LibraryPage"/>
            </Grid>

            <!-- ========================================================== -->
            <!-- 2. IN-WINDOW SETTINGS VIEW                                 -->
            <!-- ========================================================== -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSettingsView}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <views:SettingsView x:Name="SettingsPage" DataContext="{Binding SettingsVM}"/>
            </Grid>

            <!-- ========================================================== -->
            <!-- 3. IN-WINDOW ABOUT VIEW                                    -->
            <!-- ========================================================== -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAboutView}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <views:AboutView x:Name="AboutPage"/>
            </Grid>

            <!-- ========================================================== -->
            <!-- 4. SYSTEM & PERFORMANCE VIEW                               -->
            <!-- ========================================================== -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSystemView}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <views:SystemView x:Name="SystemPage" DataContext="{Binding SystemVM}"/>
            </Grid>

            <!-- ========================================================== -->
            <!-- TOOLS VIEW                                                 -->
            <!-- ========================================================== -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsToolsView}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <views:ToolsView x:Name="ToolsPage" DataContext="{Binding Tools}"/>
            </Grid>

            <!-- ========================================================== -->
            <!-- ACTIVITY & HISTORY VIEW                                    -->
            <!-- ========================================================== -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActivityView}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <views:ActivityView x:Name="ActivityPage" DataContext="{Binding ActivityVM}"/>
            </Grid>

        </Grid>
    </Grid>
</Window>
