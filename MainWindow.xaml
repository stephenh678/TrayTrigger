<Window x:Class="TrayTrigger.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TrayTrigger.ViewModels"
        xmlns:views="clr-namespace:TrayTrigger.Views"
        mc:Ignorable="d"
        Title="TrayTrigger - Game Launcher"
        Height="700" Width="1020"
        MinHeight="500" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBgDark}"
        ShowInTaskbar="True"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

    <Window.Resources>
        <!-- Reusable Game Context Menu shared across Grid, Icons, and List views -->
        <ContextMenu x:Key="GameItemContextMenu"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="Game Info (Steam Details)..." Command="{Binding ViewDetailsCommand}" FontWeight="SemiBold"/>
            <MenuItem Header="Play" Command="{Binding LaunchCommand}"/>
            <MenuItem Header="{Binding FavoriteMenuLabel}" IsCheckable="True" IsChecked="{Binding IsFavorite, Mode=OneWay}" Command="{Binding ToggleFavoriteCommand}"/>
            <MenuItem Header="Open Containing Folder" Command="{Binding OpenFolderCommand}"/>

            <!-- Broken Game Relocate Option -->
            <MenuItem Header="Locate Executable..." Command="{Binding RelocateCommand}">
                <MenuItem.Style>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>

            <Separator/>

            <!-- Quick Actions -->
            <MenuItem Header="Rename..." Command="{Binding RenameCommand}"/>
            <MenuItem Header="Fetch Official Name (Steam / Exe)" Command="{Binding FetchExeNameCommand}">
                <MenuItem.Style>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSteamGame}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <MenuItem Header="Change Category..." Command="{Binding ChangeCategoryCommand}"/>
            <MenuItem Header="Change Icon..." Command="{Binding ChangeIconCommand}"/>
            <MenuItem Header="Change Poster Artwork..." Command="{Binding ChangeCoverCommand}"/>
            <MenuItem Header="Set Steam App ID..." Command="{Binding EditSteamAppIdCommand}"/>
            <MenuItem Header="Refresh Poster &amp; Metadata" Command="{Binding RefreshMetadataCommand}"/>
            <MenuItem Header="Edit Game Properties..." Command="{Binding EditCommand}"/>

            <!-- Steam Specific Actions -->
            <Separator>
                <Separator.Style>
                    <Style TargetType="Separator">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSteamOverlay}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Separator.Style>
            </Separator>
            <MenuItem Header="Steam Store Page" Command="{Binding OpenStoreCommand}">
                <MenuItem.Style>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSteamOverlay}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <MenuItem Header="Open in Steam Library" Command="{Binding OpenInSteamLibraryCommand}">
                <MenuItem.Style>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSteamOverlay}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <MenuItem Header="Verify Game Files" Command="{Binding VerifyFilesCommand}">
                <MenuItem.Style>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSteamOverlay}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>

            <Separator/>
            <MenuItem Header="Remove from Library" Command="{Binding DeleteCommand}" Foreground="#E06C75"/>
        </ContextMenu>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/> <!-- Left Collapsible Sidebar -->
            <ColumnDefinition Width="*"/>    <!-- Main Content Area -->
        </Grid.ColumnDefinitions>

        <!-- ============================================================== -->
        <!-- LEFT COLLAPSIBLE SIDEBAR                                      -->
        <!-- ============================================================== -->
        <Border Grid.Column="0" Background="#141418" BorderBrush="{StaticResource BrushBorderDark}" 
                BorderThickness="0,0,1,0" Width="{Binding SidebarWidth}">
            <Grid Margin="6,12,6,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Brand & Toggle -->
                    <RowDefinition Height="Auto"/> <!-- Divider -->
                    <RowDefinition Height="*"/>    <!-- Navigation Items -->
                </Grid.RowDefinitions>

                <!-- Brand & Toggle Header -->
                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                    <Button Command="{Binding ToggleSidebarCommand}" Style="{StaticResource ModernGhostButton}" 
                            Height="38" Width="48" Padding="0" ToolTip="{Binding SidebarToggleTooltip}" DockPanel.Dock="Left"
                            HorizontalContentAlignment="Center">
                        <TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="15" 
                                   Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="TrayTrigger" FontSize="14.5" FontWeight="SemiBold" 
                                   Foreground="{StaticResource BrushTextPrimary}" FontFamily="{StaticResource AppFont}"/>
                    </StackPanel>
                </DockPanel>

                <!-- Separator -->
                <Separator Grid.Row="1" Background="#26262E" Margin="2,0,2,12"/>

                <!-- Navigation & Action Items -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top Navigation Items -->
                    <StackPanel Grid.Row="0">
                        <!-- 1. Games Library -->
                        <Button Command="{Binding SelectLibraryCommand}" ToolTip="Games Library" Margin="0,0,0,6">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLibraryView}" Value="True">
                                            <Setter Property="Background" Value="#1C2E3D"/>
                                            <Setter Property="Foreground" Value="{StaticResource BrushAccentHover}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <DockPanel LastChildFill="True" VerticalAlignment="Center">
                                <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="16" 
                                           Width="26" Height="20" TextAlignment="Center" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                <TextBlock Text="Library" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0" FontFamily="{StaticResource AppFont}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DockPanel>
                        </Button>

                        <!-- 2. System & Performance -->
                        <Button Command="{Binding SelectSystemCommand}" ToolTip="System &amp; Performance" Margin="0,0,0,6">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSystemView}" Value="True">
                                            <Setter Property="Background" Value="#1C2E3D"/>
                                            <Setter Property="Foreground" Value="{StaticResource BrushAccentHover}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <DockPanel LastChildFill="True" VerticalAlignment="Center">
                                <TextBlock Text="&#xE770;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="16" 
                                           Width="26" Height="20" TextAlignment="Center" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                <TextBlock Text="System" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0" FontFamily="{StaticResource AppFont}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DockPanel>
                        </Button>

                        <!-- 3. Settings -->
                        <Button Command="{Binding SelectSettingsCommand}" ToolTip="Application Settings" Margin="0,0,0,6">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSettingsView}" Value="True">
                                            <Setter Property="Background" Value="#1C2E3D"/>
                                            <Setter Property="Foreground" Value="{StaticResource BrushAccentHover}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <DockPanel LastChildFill="True" VerticalAlignment="Center">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="16" 
                                           Width="26" Height="20" TextAlignment="Center" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                <TextBlock Text="Settings" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0" FontFamily="{StaticResource AppFont}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DockPanel>
                        </Button>

                        <!-- 3. About -->
                        <Button Command="{Binding SelectAboutCommand}" ToolTip="About TrayTrigger" Margin="0,0,0,6">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAboutView}" Value="True">
                                            <Setter Property="Background" Value="#1C2E3D"/>
                                            <Setter Property="Foreground" Value="{StaticResource BrushAccentHover}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <DockPanel LastChildFill="True" VerticalAlignment="Center">
                                <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="16" 
                                           Width="26" Height="20" TextAlignment="Center" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                <TextBlock Text="About" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0" FontFamily="{StaticResource AppFont}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DockPanel>
                        </Button>
                    </StackPanel>

                    <!-- Bottom Actions: Exit TrayTrigger -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
                        <Separator Background="#26262E" Margin="2,0,2,8"/>
                        <Button Command="{Binding ExitApplicationCommand}" ToolTip="Exit TrayTrigger" Style="{StaticResource SidebarNavButton}">
                            <DockPanel LastChildFill="True" VerticalAlignment="Center">
                                <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="16" 
                                           Foreground="#E06C75" Width="26" Height="20" TextAlignment="Center" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                <TextBlock Text="Exit App" FontSize="13" Foreground="#E06C75" VerticalAlignment="Center" Margin="10,0,0,0" FontFamily="{StaticResource AppFont}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DockPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ============================================================== -->
        <!-- MAIN CONTENT AREA                                              -->
        <!-- ============================================================== -->
        <Grid Grid.Column="1" Margin="18">

            <!-- ========================================================== -->
            <!-- 1. GAMES LIBRARY VIEW                                      -->
            <!-- ========================================================== -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLibraryView}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="Auto"/> <!-- Category Tabs & Actions -->
                    <RowDefinition Height="Auto"/> <!-- Search, Sort & View Mode Bar -->
                    <RowDefinition Height="*"/>    <!-- Games Grid & Undo Toast -->
                    <RowDefinition Height="Auto"/> <!-- Status Bar -->
                </Grid.RowDefinitions>

                <!-- 1. Header -->
                <DockPanel Grid.Row="0" Margin="0,0,0,14">
                    <!-- Right: Live Game Count Status (matching Settings & System) -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="12" 
                                   Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="{Binding TotalGameCountDisplay, Mode=OneWay}" FontSize="11.5" Foreground="{StaticResource BrushTextMuted}" 
                                   FontFamily="{StaticResource AppFont}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Left: Title & Subtitle matching Settings & System -->
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Games Library" FontSize="20" Foreground="{StaticResource BrushTextPrimary}" 
                                   FontFamily="{StaticResource AppFont}" FontWeight="Normal"/>
                        <TextBlock Text="Manage, organize, and launch your installed PC and Steam games" 
                                   FontSize="12" Foreground="{StaticResource BrushTextSecondary}" 
                                   FontFamily="{StaticResource AppFont}" Margin="0,4,0,0"/>
                    </StackPanel>
                </DockPanel>

                <!-- 2. Category Tabs & Action Buttons -->
                <DockPanel Grid.Row="1" Margin="0,0,0,16">
                    <!-- Right: Action Buttons (+ Add Game, Add Folder, Import Steam) -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="+ Add Game" Command="{Binding AddGameCommand}" 
                                Style="{StaticResource ModernAccentButton}" Margin="0,0,8,0"/>
                        <Button Content="📁 Add Folder" Command="{Binding AddFolderCommand}" 
                                Style="{StaticResource ModernOutlineButton}" Margin="0,0,8,0"/>
                        <Button Content="Import Steam" Command="{Binding OpenSteamImportCommand}"
                                Style="{StaticResource ModernOutlineButton}" Margin="0,0,8,0"/>
                        <Button Content="Refresh Posters" Command="{Binding RefreshAllPostersCommand}"
                                IsEnabled="{Binding CanRefreshAllPosters}"
                                Style="{StaticResource ModernOutlineButton}"
                                ToolTip="Re-checks poster art for every game in your library, including ones that already have a cover."/>
                    </StackPanel>

                    <!-- Left: Segmented Category Tabs -->
                    <Border Background="#181820" BorderBrush="{StaticResource BrushBorderDark}" 
                            BorderThickness="1" CornerRadius="6" Padding="3" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
                            <ItemsControl ItemsSource="{Binding CategoryTabs}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding SelectCommand}"
                                                Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsSelected}"
                                                Margin="0,0,2,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#x2605;" FontFamily="Segoe UI Symbol, Segoe UI"
                                                           FontSize="13" Foreground="#FFD700" Margin="0,0,5,0" VerticalAlignment="Center"
                                                           Visibility="{Binding IsFavoritesTab, Converter={StaticResource BoolToVis}}"/>
                                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </DockPanel>

                <!-- 3. Search, Sort & View Mode Bar -->
                <Grid Grid.Row="2" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource ModernTextBox}" Margin="0,0,10,0"
                             Tag="Search games by title, category, or path..."/>

                    <ComboBox Grid.Column="1" 
                              ItemsSource="{Binding SortOptions}" 
                              SelectedItem="{Binding SelectedSortOption, Mode=TwoWay}"
                              Style="{StaticResource ModernComboBox}" Margin="0,0,10,0"/>

                    <!-- View Mode Switcher (Grid, Icons, List) -->
                    <Border Grid.Column="2" Background="#181820" BorderBrush="{StaticResource BrushBorderDark}" 
                            BorderThickness="1" CornerRadius="6" Padding="3">
                        <StackPanel Orientation="Horizontal">
                            <Button ToolTip="Poster Grid View" Command="{Binding SettingsVM.SetViewModeCommand}" CommandParameter="Poster Grid"
                                    Width="32" Height="30" Padding="0" Cursor="Hand"
                                    Style="{StaticResource SegmentedTabButton}" Tag="{Binding SettingsVM.IsGridView}">
                                <TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="13"
                                           Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                            <Button ToolTip="Compact Icons View" Command="{Binding SettingsVM.SetViewModeCommand}" CommandParameter="Compact Icons"
                                    Width="32" Height="30" Padding="0" Cursor="Hand" Margin="2,0,0,0"
                                    Style="{StaticResource SegmentedTabButton}" Tag="{Binding SettingsVM.IsIconsView}">
                                <TextBlock Text="&#xE80A;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="13"
                                           Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                            <Button ToolTip="Details List View" Command="{Binding SettingsVM.SetViewModeCommand}" CommandParameter="Details List"
                                    Width="32" Height="30" Padding="0" Cursor="Hand" Margin="2,0,0,0"
                                    Style="{StaticResource SegmentedTabButton}" Tag="{Binding SettingsVM.IsListView}">
                                <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="13"
                                           Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 4. Game Cards View -->
                <Grid Grid.Row="3">
                    <!-- Empty State (also the drop target - dragging a file/folder anywhere
                         on the window already works, but this gives it a visible highlight) -->
                    <Border x:Name="DropZoneBorder" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            Margin="0,20,0,20" CornerRadius="10"
                            BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1.5"
                            Background="#161619"
                            AllowDrop="True" Drop="DropZone_Drop" DragOver="DropZone_DragOver"
                            DragEnter="DropZone_DragEnter" DragLeave="DropZone_DragLeave">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FilteredGames.IsEmpty}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedCategory}" Value="Favorites">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="🎮" FontSize="42" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="No games found in your library"
                                       FontSize="16" Foreground="{StaticResource BrushTextPrimary}"
                                       FontFamily="{StaticResource AppFont}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Drop a game file (.exe / .lnk) or install folder anywhere on this window to add it instantly."
                                       FontSize="13" Foreground="{StaticResource BrushTextSecondary}"
                                       FontFamily="{StaticResource AppFont}" HorizontalAlignment="Center" Margin="0,6,0,18"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="+ Add Game" Command="{Binding AddGameCommand}" Style="{StaticResource ModernAccentButton}" Margin="0,0,10,0"/>
                                <Button Content="📁 Add Folder" Command="{Binding AddFolderCommand}" Style="{StaticResource ModernOutlineButton}" Margin="0,0,10,0"/>
                                <Button Content="Import Steam" Command="{Binding OpenSteamImportCommand}" Style="{StaticResource ModernOutlineButton}"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedCategory}" Value="Favorites">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="&#x2606;" FontFamily="Segoe UI Symbol, Segoe UI" FontSize="42"
                                       Foreground="#FFFFFFFF" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="No favorites yet"
                                       FontSize="16" Foreground="{StaticResource BrushTextPrimary}"
                                       FontFamily="{StaticResource AppFont}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Click the star on any game to add it to your Favorites."
                                       FontSize="13" Foreground="{StaticResource BrushTextSecondary}"
                                       FontFamily="{StaticResource AppFont}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ScrollViewer for WrapPanel Views (View 1: Poster Cards & View 2: Compact Icons) -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding SettingsVM.IsListView}" Value="False"/>
                                            <Condition Binding="{Binding FilteredGames.IsEmpty}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <Grid>

                            <!-- ============================================================== -->
                            <!-- VIEW 1: POSTER CARDS GRID VIEW                                 -->
                            <!-- ============================================================== -->
                            <ItemsControl ItemsSource="{Binding FilteredGames}">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SettingsVM.IsGridView}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>

                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:GameCardViewModel}">
                                        <Border x:Name="CardBorder" CornerRadius="8" 
                                                Background="{StaticResource BrushSurfaceDark}" 
                                                BorderBrush="{StaticResource BrushBorderDark}" 
                                                BorderThickness="1"
                                                Width="184" Height="276" Margin="7"
                                                Cursor="Hand"
                                                ContextMenu="{StaticResource GameItemContextMenu}">

                                            <Border.InputBindings>
                                                <MouseBinding Gesture="LeftClick" Command="{Binding ViewDetailsCommand}"/>
                                            </Border.InputBindings>

                                            <Grid>
                                                <!-- 1. Full Bleed Poster View (Active when ShowPosterArt = True) -->
                                                <Grid x:Name="PosterArtView" Visibility="Collapsed">
                                                    <!-- Ambient Blurred Background Fill (Fills entire card with game colors, zero black voids) -->
                                                    <Border CornerRadius="7" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                        <Border.Clip>
                                                            <RectangleGeometry Rect="0,0,182,274" RadiusX="7" RadiusY="7"/>
                                                        </Border.Clip>
                                                        <Grid>
                                                            <Image Source="{Binding CoverImage}" Stretch="UniformToFill"
                                                                   Opacity="0.45"
                                                                   RenderOptions.BitmapScalingMode="LowQuality"/>
                                                            <Border Background="#550D0D12"/>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Crisp Artwork Layer (Fits cleanly without cropping letters, logos, or characters) -->
                                                    <Border CornerRadius="7" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                        <Border.Clip>
                                                            <RectangleGeometry Rect="0,0,182,274" RadiusX="7" RadiusY="7"/>
                                                        </Border.Clip>
                                                        <Image Source="{Binding CoverImage}" Stretch="Uniform"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    </Border>

                                                    <!-- Top Dark Vignette for badge readability -->
                                                    <Border VerticalAlignment="Top" Height="48" CornerRadius="7,7,0,0">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Color="#990D0D12" Offset="0.0"/>
                                                                <GradientStop Color="#000D0D12" Offset="1.0"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>

                                                    <!-- Bottom Gradient Overlay with Game Title & Playtime -->
                                                    <Border VerticalAlignment="Bottom" CornerRadius="0,0,7,7">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Color="#00111114" Offset="0.0"/>
                                                                <GradientStop Color="#88111114" Offset="0.25"/>
                                                                <GradientStop Color="#E6111114" Offset="0.65"/>
                                                                <GradientStop Color="#F8111114" Offset="1.0"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                        <StackPanel Margin="11,18,11,9">
                                                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource BrushTextPrimary}" 
                                                                       FontFamily="{StaticResource AppFont}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding Name}"/>
                                                            <Grid Margin="0,3,0,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" MaxWidth="80"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding PlaytimeDisplay}" FontSize="10.5" 
                                                                           Foreground="{StaticResource BrushTextSecondary}" 
                                                                           FontFamily="{StaticResource AppFont}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding LastPlayedDisplay}" FontSize="10" 
                                                                           Foreground="{StaticResource BrushTextMuted}" 
                                                                           HorizontalAlignment="Right"
                                                                           TextAlignment="Right"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Margin="4,0,0,0"
                                                                           FontFamily="{StaticResource AppFont}"/>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>

                                                <!-- 2. Standard Icon Fallback View (Active when ShowPosterArt = False) -->
                                                <Grid x:Name="IconFallbackView" Margin="12">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- Center Icon & Name -->
                                                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,4">
                                                        <Border CornerRadius="8" Width="64" Height="64" Margin="0,0,0,12" 
                                                                Background="#222228" HorizontalAlignment="Center">
                                                            <Image Source="{Binding IconImage}" Width="56" Height="56" 
                                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>

                                                        <TextBlock Text="{Binding Name}" FontSize="13" 
                                                                   Foreground="{StaticResource BrushTextPrimary}" 
                                                                   FontFamily="{StaticResource AppFont}" FontWeight="SemiBold"
                                                                   TextAlignment="Center" TextTrimming="CharacterEllipsis" 
                                                                   MaxWidth="160" HorizontalAlignment="Center"
                                                                   ToolTip="{Binding Name}"/>
                                                    </StackPanel>

                                                    <!-- Footer Playtime -->
                                                    <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" MaxWidth="80"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding PlaytimeDisplay}" FontSize="11" 
                                                                       Foreground="{StaticResource BrushTextSecondary}" 
                                                                       FontFamily="{StaticResource AppFont}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding LastPlayedDisplay}" FontSize="10.5" 
                                                                       Foreground="{StaticResource BrushTextMuted}" 
                                                                       HorizontalAlignment="Right"
                                                                       TextAlignment="Right"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Margin="4,0,0,0"
                                                                       FontFamily="{StaticResource AppFont}"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- 3. Top Badges (Category, Steam Overlay, Missing, Hotkey) -->
                                                <DockPanel VerticalAlignment="Top" Margin="10,10,10,0">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" DockPanel.Dock="Left">
                                                        <Button Style="{StaticResource FavoriteToggleButton}" Command="{Binding ToggleFavoriteCommand}" Margin="0,0,4,0"/>

                                                        <!-- Category Pill (Hidden if category is Steam to prevent duplicate badges) -->
                                                        <Border Background="#D91D1D24" BorderBrush="#33FFFFFF" BorderThickness="1" 
                                                                CornerRadius="4" Padding="6,2">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding ShowCategoryBadge}" Value="False">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding Category}" FontSize="10" 
                                                                       Foreground="{StaticResource BrushTextSecondary}" 
                                                                       FontFamily="{StaticResource AppFont}"/>
                                                        </Border>

                                                        <!-- Steam Game Indicator Badge Overlay -->
                                                        <Border Background="#E60D1A29" BorderBrush="#2A82E4" BorderThickness="1" 
                                                                CornerRadius="4" Padding="5,2" ToolTip="Steam Game">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasSteamOverlay}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding HasSteamOverlay}" Value="True"/>
                                                                                <Condition Binding="{Binding ShowCategoryBadge}" Value="True"/>
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Margin" Value="5,0,0,0"/>
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Viewbox Width="10" Height="10" Margin="0,0,3,0">
                                                                    <Path Fill="#389BFF" Stretch="Uniform"
                                                                          Data="M12,2A10,10 0 0,0 2,12C2,16.4 4.9,20.1 8.9,21.5L11.7,17.7C11.5,17.2 11.4,16.6 11.4,16A4,4 0 0,1 15.4,12C15.5,12 15.6,12 15.7,12L18.6,7.8C16.8,6.7 14.5,6 12,6A6,6 0 0,0 6,12C6,12.3 6,12.7 6.1,13L2.4,14.5C2.1,13.7 2,12.9 2,12A10,10 0 0,1 12,2M15.4,13.5A2.5,2.5 0 0,0 12.9,16A2.5,2.5 0 0,0 15.4,18.5A2.5,2.5 0 0,0 17.9,16A2.5,2.5 0 0,0 15.4,13.5Z"/>
                                                                </Viewbox>
                                                                <TextBlock Text="STEAM" FontSize="8.5" FontWeight="SemiBold" 
                                                                           Foreground="#389BFF" FontFamily="{StaticResource AppFont}"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>

                                                    <Border Background="#E64A1E14" BorderBrush="#E65100" BorderThickness="1" 
                                                            CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="⚠️ MISSING" FontSize="9.5" FontWeight="SemiBold" 
                                                                   Foreground="#FFA040" FontFamily="{StaticResource AppFont}"/>
                                                    </Border>

                                                    <Border Background="#E61F2A38" BorderBrush="{StaticResource BrushAccent}" BorderThickness="1" 
                                                            CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding HasHotkey}" Value="True"/>
                                                                            <Condition Binding="{Binding IsMissing}" Value="False"/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding Hotkey}" FontSize="10" 
                                                                   Foreground="{StaticResource BrushAccentHover}" 
                                                                   FontFamily="{StaticResource AppFont}"/>
                                                    </Border>
                                                </DockPanel>

                                            </Grid>
                                        </Border>

                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding ShowPosterArt}" Value="True">
                                                <Setter TargetName="PosterArtView" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="IconFallbackView" Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                <Setter TargetName="CardBorder" Property="Opacity" Value="0.65"/>
                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#805030"/>
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- ============================================================== -->
                            <!-- VIEW 2: COMPACT ICONS VIEW                                     -->
                            <!-- ============================================================== -->
                            <ItemsControl ItemsSource="{Binding FilteredGames}">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SettingsVM.IsIconsView}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>

                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:GameCardViewModel}">
                                        <Border x:Name="IconCardBorder" CornerRadius="8" 
                                                Background="{StaticResource BrushSurfaceDark}" 
                                                BorderBrush="{StaticResource BrushBorderDark}" 
                                                BorderThickness="1"
                                                Width="116" Height="124" Margin="6"
                                                Cursor="Hand"
                                                ContextMenu="{StaticResource GameItemContextMenu}">
                                            <Border.InputBindings>
                                                <MouseBinding Gesture="LeftClick" Command="{Binding ViewDetailsCommand}"/>
                                            </Border.InputBindings>

                                            <Grid Margin="8,8,8,8">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Top Badges -->
                                                <DockPanel Grid.Row="0" Height="14">
                                                    <Button DockPanel.Dock="Left" Command="{Binding ToggleFavoriteCommand}"
                                                            Width="14" Height="14" Padding="0" Margin="0,0,3,0"
                                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                            ToolTip="Toggle Favorite" VerticalAlignment="Center">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <TextBlock x:Name="StarGlyph" Text="&#x2606;" FontFamily="Segoe UI Symbol, Segoe UI"
                                                                           FontSize="12" Foreground="#FFFFFFFF"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                <ControlTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                        <Setter TargetName="StarGlyph" Property="Text" Value="&#x2605;"/>
                                                                        <Setter TargetName="StarGlyph" Property="Foreground" Value="#FFD700"/>
                                                                    </DataTrigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="StarGlyph" Property="Foreground" Value="#FFD700"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>

                                                    <Border Background="#1C2E3D" CornerRadius="3" Padding="4,0" HorizontalAlignment="Left">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasSteamOverlay}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Viewbox Width="8" Height="8" Margin="0,0,2,0">
                                                                <Path Fill="{StaticResource BrushAccentHover}" Stretch="Uniform"
                                                                      Data="M12,2A10,10 0 0,0 2,12C2,16.4 4.9,20.1 8.9,21.5L11.7,17.7C11.5,17.2 11.4,16.6 11.4,16A4,4 0 0,1 15.4,12C15.5,12 15.6,12 15.7,12L18.6,7.8C16.8,6.7 14.5,6 12,6A6,6 0 0,0 6,12C6,12.3 6,12.7 6.1,13L2.4,14.5C2.1,13.7 2,12.9 2,12A10,10 0 0,1 12,2M15.4,13.5A2.5,2.5 0 0,0 12.9,16A2.5,2.5 0 0,0 15.4,18.5A2.5,2.5 0 0,0 17.9,16A2.5,2.5 0 0,0 15.4,13.5Z"/>
                                                            </Viewbox>
                                                            <TextBlock Text="STEAM" FontSize="8" Foreground="{StaticResource BrushAccentHover}" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Background="#E64A1E14" BorderBrush="#E65100" BorderThickness="1" 
                                                            CornerRadius="3" Padding="4,0" HorizontalAlignment="Right">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="⚠️ MISSING" FontSize="7.5" FontWeight="SemiBold" Foreground="#FFA040"/>
                                                    </Border>
                                                </DockPanel>

                                                <!-- Icon -->
                                                <Border Grid.Row="1" Width="48" Height="48" CornerRadius="6" 
                                                        Background="#222228" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Image Source="{Binding IconImage}" Width="42" Height="42" 
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- Title -->
                                                <TextBlock Grid.Row="2" Text="{Binding Name}" FontSize="11" 
                                                           Foreground="{StaticResource BrushTextPrimary}" 
                                                           FontFamily="{StaticResource AppFont}" FontWeight="SemiBold"
                                                           TextAlignment="Center" TextTrimming="CharacterEllipsis" 
                                                           HorizontalAlignment="Center" Margin="0,5,0,0"
                                                           ToolTip="{Binding Name}"/>

                                                <!-- Playtime / Category Subtext -->
                                                <TextBlock Grid.Row="3" Text="{Binding Category}" FontSize="9.5" 
                                                           Foreground="{StaticResource BrushTextMuted}" 
                                                           FontFamily="{StaticResource AppFont}"
                                                           TextAlignment="Center" TextTrimming="CharacterEllipsis" 
                                                           HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </Grid>
                                        </Border>

                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                <Setter TargetName="IconCardBorder" Property="Opacity" Value="0.65"/>
                                                <Setter TargetName="IconCardBorder" Property="BorderBrush" Value="#805030"/>
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="IconCardBorder" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                                <Setter TargetName="IconCardBorder" Property="Background" Value="#25252E"/>
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>

                    <!-- ============================================================== -->
                    <!-- VIEW 3: DETAILS LIST VIEW (VIRTUALIZED & PINNED HEADER)        -->
                    <!-- ============================================================== -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding SettingsVM.IsListView}" Value="True"/>
                                            <Condition Binding="{Binding FilteredGames.IsEmpty}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Pinned Header Bar -->
                            <RowDefinition Height="*"/>    <!-- Virtualized Game Rows -->
                        </Grid.RowDefinitions>

                        <!-- Header Bar (Fixed, never scrolls out of view) -->
                        <Border Grid.Row="0" Background="#16161C" BorderBrush="{StaticResource BrushBorderDark}" 
                                BorderThickness="0,0,0,1" Padding="12,8" Margin="0,0,16,6" CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42"/> <!-- Icon -->
                                    <ColumnDefinition Width="*"/>  <!-- Title -->
                                    <ColumnDefinition Width="135"/> <!-- Category -->
                                    <ColumnDefinition Width="110"/> <!-- Playtime -->
                                    <ColumnDefinition Width="125"/> <!-- Last Played -->
                                    <ColumnDefinition Width="90"/>  <!-- Actions -->
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="GAME TITLE" FontSize="10.5" FontWeight="SemiBold" 
                                           Foreground="{StaticResource BrushTextMuted}" FontFamily="{StaticResource AppFont}"/>
                                <TextBlock Grid.Column="2" Text="CATEGORY" FontSize="10.5" FontWeight="SemiBold" 
                                           Foreground="{StaticResource BrushTextMuted}" FontFamily="{StaticResource AppFont}"/>
                                <TextBlock Grid.Column="3" Text="PLAYTIME" FontSize="10.5" FontWeight="SemiBold" 
                                           Foreground="{StaticResource BrushTextMuted}" FontFamily="{StaticResource AppFont}"/>
                                <TextBlock Grid.Column="4" Text="LAST PLAYED" FontSize="10.5" FontWeight="SemiBold" 
                                           Foreground="{StaticResource BrushTextMuted}" FontFamily="{StaticResource AppFont}"/>
                                <TextBlock Grid.Column="5" Text="ACTIONS" FontSize="10.5" FontWeight="SemiBold" 
                                           Foreground="{StaticResource BrushTextMuted}" FontFamily="{StaticResource AppFont}" 
                                           HorizontalAlignment="Right" Margin="0,0,6,0"/>
                            </Grid>
                        </Border>

                        <!-- Virtualized List Rows -->
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding FilteredGames}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:GameCardViewModel}">
                                    <Border x:Name="ListRowBorder" CornerRadius="6" 
                                            Background="{StaticResource BrushSurfaceDark}" 
                                            BorderBrush="{StaticResource BrushBorderDark}" 
                                            BorderThickness="1"
                                            Height="46" Margin="0,2,0,3" Padding="10,0"
                                            Cursor="Hand"
                                            ContextMenu="{StaticResource GameItemContextMenu}">
                                        <Border.InputBindings>
                                            <MouseBinding Gesture="LeftClick" Command="{Binding ViewDetailsCommand}"/>
                                        </Border.InputBindings>
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="135"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="125"/>
                                                <ColumnDefinition Width="90"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Icon -->
                                            <Border Grid.Column="0" Width="30" Height="30" CornerRadius="4" 
                                                    Background="#222228" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Image Source="{Binding IconImage}" Width="24" Height="24" 
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Title & Badges -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource FavoriteToggleButton}" Command="{Binding ToggleFavoriteCommand}" Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource BrushTextPrimary}" 
                                                           FontFamily="{StaticResource AppFont}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           ToolTip="{Binding Name}"/>
                                                <Border Background="#E64A1E14" BorderBrush="#E65100" BorderThickness="1" 
                                                        CornerRadius="3" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="⚠️ MISSING" FontSize="8.5" FontWeight="SemiBold" 
                                                               Foreground="#FFA040" FontFamily="{StaticResource AppFont}"/>
                                                </Border>
                                                <Border Background="#1C2E3D" CornerRadius="3" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasSteamOverlay}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Viewbox Width="8.5" Height="8.5" Margin="0,0,3,0">
                                                            <Path Fill="{StaticResource BrushAccentHover}" Stretch="Uniform"
                                                                  Data="M12,2A10,10 0 0,0 2,12C2,16.4 4.9,20.1 8.9,21.5L11.7,17.7C11.5,17.2 11.4,16.6 11.4,16A4,4 0 0,1 15.4,12C15.5,12 15.6,12 15.7,12L18.6,7.8C16.8,6.7 14.5,6 12,6A6,6 0 0,0 6,12C6,12.3 6,12.7 6.1,13L2.4,14.5C2.1,13.7 2,12.9 2,12A10,10 0 0,1 12,2M15.4,13.5A2.5,2.5 0 0,0 12.9,16A2.5,2.5 0 0,0 15.4,18.5A2.5,2.5 0 0,0 17.9,16A2.5,2.5 0 0,0 15.4,13.5Z"/>
                                                        </Viewbox>
                                                        <TextBlock Text="STEAM" FontSize="8.5" Foreground="{StaticResource BrushAccentHover}" 
                                                                   FontFamily="{StaticResource AppFont}" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>

                                            <!-- Category Pill -->
                                            <Border Grid.Column="2" Background="#1D1D24" BorderBrush="#33FFFFFF" BorderThickness="1" 
                                                    CornerRadius="4" Padding="7,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Category}" FontSize="10" 
                                                           Foreground="{StaticResource BrushTextSecondary}" 
                                                           FontFamily="{StaticResource AppFont}"/>
                                            </Border>

                                            <!-- Playtime -->
                                            <TextBlock Grid.Column="3" Text="{Binding ListPlaytimeDisplay}" FontSize="11" 
                                                       Foreground="{StaticResource BrushTextSecondary}" 
                                                       FontFamily="{StaticResource AppFont}" VerticalAlignment="Center"/>

                                            <!-- Last Played -->
                                            <TextBlock Grid.Column="4" Text="{Binding LastPlayedDisplay}" FontSize="11" 
                                                       Foreground="{StaticResource BrushTextMuted}" 
                                                       FontFamily="{StaticResource AppFont}" VerticalAlignment="Center"/>

                                            <!-- Action Buttons -->
                                            <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Button Command="{Binding LaunchCommand}" ToolTip="Play Game"
                                                        Style="{StaticResource ModernAccentButton}" Height="26" Width="42" Padding="0" Margin="0,0,6,0">
                                                    <TextBlock Text="▶" FontSize="9.5" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Button>
                                                <Button Command="{Binding ViewDetailsCommand}" ToolTip="Game Details &amp; Info"
                                                        Style="{StaticResource ModernOutlineButton}" Height="26" Width="28" Padding="0">
                                                    <TextBlock Text="ℹ" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                            <Setter TargetName="ListRowBorder" Property="Opacity" Value="0.65"/>
                                            <Setter TargetName="ListRowBorder" Property="BorderBrush" Value="#805030"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ListRowBorder" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                            <Setter TargetName="ListRowBorder" Property="Background" Value="#25252E"/>
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- Floating Non-Blocking Undo Toast -->
                    <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18"
                            Background="#24242E" BorderBrush="{StaticResource BrushAccent}" BorderThickness="1.5"
                            CornerRadius="8" Padding="16,10" Panel.ZIndex="100">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.5" Color="#000000"/>
                        </Border.Effect>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsUndoToastVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🗑" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding UndoToastMessage}" Foreground="{StaticResource BrushTextPrimary}" 
                                       FontSize="13" FontFamily="{StaticResource AppFont}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <Button Content="UNDO" Command="{Binding UndoDeleteCommand}" 
                                    Style="{StaticResource ModernAccentButton}" Padding="12,4" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <Button Content="✕" Command="{Binding DismissUndoToastCommand}" 
                                    Style="{StaticResource ModernGhostButton}" Padding="6,4" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 5. Status Bar -->
                <DockPanel Grid.Row="4" Margin="0,14,0,0">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" 
                               Foreground="{StaticResource BrushTextSecondary}" 
                               FontFamily="{StaticResource AppFont}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="Hotkey: Ctrl+Alt+G to toggle" FontSize="11" 
                                   Foreground="{StaticResource BrushTextMuted}" 
                                   FontFamily="{StaticResource AppFont}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalGameCountDisplay}" FontSize="11" 
                                   Foreground="{StaticResource BrushTextMuted}" 
                                   FontFamily="{StaticResource AppFont}" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>

            </Grid>

            <!-- ========================================================== -->
            <!-- 2. IN-WINDOW SETTINGS VIEW                                 -->
            <!-- ========================================================== -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSettingsView}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid DataContext="{Binding SettingsVM}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="Auto"/> <!-- Category Segmented Tabs -->
                        <RowDefinition Height="*"/>    <!-- Settings ScrollViewer -->
                    </Grid.RowDefinitions>

                <!-- Header -->
                <DockPanel Grid.Row="0" Margin="0,0,0,14">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="12" 
                                   Foreground="#4EC9B0" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="Saved in real time" FontSize="11.5" Foreground="{StaticResource BrushTextMuted}" 
                                   FontFamily="{StaticResource AppFont}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Application Settings" FontSize="20" Foreground="{StaticResource BrushTextPrimary}" 
                                   FontFamily="{StaticResource AppFont}" FontWeight="Normal"/>
                        <TextBlock Text="Configure startup, appearance, tray shortcuts, and diagnostic logging" 
                                   FontSize="12" Foreground="{StaticResource BrushTextSecondary}" 
                                   FontFamily="{StaticResource AppFont}" Margin="0,4,0,0"/>
                    </StackPanel>
                </DockPanel>

                <!-- Category Segmented Tabs -->
                <Border Grid.Row="1" Background="#181820" BorderBrush="{StaticResource BrushBorderDark}" 
                        BorderThickness="1" CornerRadius="6" Padding="3" HorizontalAlignment="Left" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="All Settings" Command="{Binding SelectAllTabCommand}"
                                Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsAllTab}"/>
                        <Button Content="General" Command="{Binding SelectGeneralTabCommand}" Margin="2,0,0,0"
                                Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsGeneralTab}"/>
                        <Button Content="Library &amp; Art" Command="{Binding SelectLibraryTabCommand}" Margin="2,0,0,0"
                                Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsLibraryTab}"/>
                        <Button Content="Tray Menu" Command="{Binding SelectTrayMenuTabCommand}" Margin="2,0,0,0"
                                Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsTrayMenuTab}"/>
                        <Button Content="Diagnostics &amp; Storage" Command="{Binding SelectDiagnosticsTabCommand}" Margin="2,0,0,0"
                                Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsDiagnosticsTab}"/>
                    </StackPanel>
                </Border>

                <!-- Settings Cards ScrollViewer -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14">
                    <StackPanel HorizontalAlignment="Stretch" Margin="0,0,12,0">

                        <!-- ============================================== -->
                        <!-- CATEGORY 1: GENERAL & SYSTEM INTEGRATION       -->
                        <!-- ============================================== -->
                        <StackPanel Visibility="{Binding ShowGeneralSection, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                            <!-- Section Header (shown in All Settings view) -->
                            <Border Margin="0,2,0,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAllTab}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="12.5" 
                                               Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="GENERAL &amp; SYSTEM INTEGRATION" FontSize="11.5" FontWeight="SemiBold" 
                                               Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- 1.1 Windows Startup & System Tray Integration -->
                            <Border CornerRadius="8" Background="{StaticResource BrushSurfaceDark}" 
                                    BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" 
                                    Padding="14,12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Windows Startup &amp; System Tray" FontSize="13.5" FontWeight="SemiBold" 
                                               Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,8"/>

                                    <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows}" 
                                              Style="{StaticResource ModernCheckBox}" FontSize="13"/>
                                    <TextBlock Text="Launches TrayTrigger automatically when you log in to Windows." 
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11" 
                                               Margin="24,3,0,0" TextWrapping="Wrap"/>

                                    <!-- Nested Sub-Toggle: Start Minimized -->
                                    <StackPanel Margin="24,8,0,10">
                                        <CheckBox Content="Start minimized to tray" 
                                                  IsChecked="{Binding StartMinimizedToTray}" 
                                                  IsEnabled="{Binding CanConfigureMinimized}" 
                                                  Style="{StaticResource ModernCheckBox}" FontSize="12.5"/>
                                        <TextBlock Text="When enabled, runs tray-only with no window opened on system boot." 
                                                   Foreground="{StaticResource BrushTextMuted}" FontSize="10.5" 
                                                   Margin="24,2,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <DockPanel LastChildFill="False">
                                        <CheckBox Content="Always show icon in tray (prevent collapsing into overflow)" 
                                                  IsChecked="{Binding AlwaysShowTrayIcon}" 
                                                  Style="{StaticResource ModernCheckBox}" FontSize="12.5" 
                                                  VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                        <Button Content="Taskbar Settings..." Command="{Binding OpenTaskbarSettingsCommand}" 
                                                Style="{StaticResource ModernOutlineButton}" DockPanel.Dock="Right" 
                                                VerticalAlignment="Center" Padding="10,5"/>
                                    </DockPanel>
                                    <TextBlock Text="Requests Windows to keep the TrayTrigger icon pinned to the taskbar outside the hidden overflow chevron." 
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11" 
                                               Margin="24,3,0,6" TextWrapping="Wrap"/>

                                    <Border Background="#1A1A22" CornerRadius="6" Padding="8" Margin="24,4,0,0">
                                        <TextBlock Text="💡 Tip: You can also drag the TrayTrigger icon from the taskbar ^ overflow chevron directly onto your taskbar to pin it permanently." 
                                                   Foreground="#CCA84E" FontSize="10.5" TextWrapping="Wrap"/>
                                    </Border>

                                    <CheckBox Content="Minimize to system tray when launching a game" 
                                              IsChecked="{Binding MinimizeOnGameLaunch}" 
                                              Style="{StaticResource ModernCheckBox}" FontSize="12.5" Margin="0,12,0,0"/>
                                    <TextBlock Text="Automatically hides the TrayTrigger window to the system tray whenever a game starts so it never covers your game." 
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11" 
                                               Margin="24,3,0,4" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- 1.2 Global Manage Hotkey -->
                            <Border CornerRadius="8" Background="{StaticResource BrushSurfaceDark}" 
                                    BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" 
                                    Padding="14,12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Global Manage Window Hotkey" FontSize="13.5" FontWeight="SemiBold" 
                                                Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding GlobalManageHotkey, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource ModernTextBox}" Margin="0,0,0,6" Width="150" HorizontalAlignment="Left"/>
                                    <TextBlock Text="Press this key combination anywhere in Windows to toggle the Manage Games window (default: Ctrl+Alt+G)." 
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- 1.3 Updates & GitHub Releases -->
                            <Border CornerRadius="8" Background="{StaticResource BrushSurfaceDark}" 
                                    BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" 
                                    Padding="14,12" Margin="0,0,0,10">
                                <StackPanel>
                                    <DockPanel LastChildFill="False" Margin="0,0,0,8">
                                        <TextBlock Text="Updates &amp; Version Control" FontSize="13.5" FontWeight="SemiBold" 
                                                   Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                        <Button Content="Check for Updates Now" Command="{Binding CheckUpdatesInSettingsCommand}" 
                                                Style="{StaticResource ModernOutlineButton}" DockPanel.Dock="Right" 
                                                VerticalAlignment="Center" Padding="10,4"/>
                                    </DockPanel>

                                    <CheckBox Content="Automatically check for updates on startup" 
                                              IsChecked="{Binding AutoCheckForUpdates}" 
                                              Style="{StaticResource ModernCheckBox}" FontSize="12.5"/>
                                    <TextBlock Text="Periodically checks GitHub Releases in the background and notifies you when an update is available." 
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11" 
                                               Margin="24,3,0,10" TextWrapping="Wrap"/>

                                    <TextBlock Text="GitHub Repository (owner/repo):" FontSize="12" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding GitHubRepository, UpdateSourceTrigger=PropertyChanged}" 
                                             Style="{StaticResource ModernTextBox}" Width="240" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                                    <TextBlock Text="The public GitHub repository where TrayTrigger release packages and tags are published (default: stephenh678/TrayTrigger)."
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11" TextWrapping="Wrap"/>

                                    <TextBlock Text="{Binding UpdateStatusText}" FontSize="11.5" Foreground="{StaticResource BrushAccentHover}" 
                                               Margin="0,8,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ============================================== -->
                        <!-- CATEGORY 2: LIBRARY & ARTWORK                  -->
                        <!-- ============================================== -->
                        <StackPanel Visibility="{Binding ShowLibrarySection, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                            <!-- Section Header (shown in All Settings view) -->
                            <Border Margin="0,2,0,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAllTab}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="12.5" 
                                               Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="LIBRARY &amp; ARTWORK" FontSize="11.5" FontWeight="SemiBold" 
                                               Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- 2.1 Library Box Art & Visuals -->
                            <Border CornerRadius="8" Background="{StaticResource BrushSurfaceDark}" 
                                    BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" 
                                    Padding="14,12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Library Box Art &amp; Visuals" FontSize="13.5" FontWeight="SemiBold" 
                                               Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Customize poster covers and presentation styles on library game cards." 
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,0,0,12" TextWrapping="Wrap"/>

                                    <DockPanel Margin="0,0,0,12" LastChildFill="False">
                                        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                            <TextBlock Text="Default library view mode:" Foreground="{StaticResource BrushTextPrimary}" FontSize="12.5"/>
                                            <TextBlock Text="Choose the default presentation style when opening the game library." Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ComboBox ItemsSource="{Binding ViewModeOptions}" 
                                                  SelectedItem="{Binding LibraryViewMode, Mode=TwoWay}" 
                                                  Style="{StaticResource ModernComboBox}" Width="140" HorizontalAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                    </DockPanel>

                                    <CheckBox Content="Display vertical poster art on game cards (Steam 600×900)"
                                              IsChecked="{Binding UseVerticalPosterArt}"
                                              Style="{StaticResource ModernCheckBox}" FontSize="12.5"/>
                                    <TextBlock Text="Shows official high-resolution vertical box artwork on library game cards instead of square icons when available."
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11"
                                               Margin="24,3,0,10" TextWrapping="Wrap"/>

                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Refresh All Game Posters" Command="{Binding RefreshAllPostersCommand}"
                                                IsEnabled="{Binding CanRefreshAllPosters}"
                                                Style="{StaticResource ModernOutlineButton}" Padding="10,5"
                                                HorizontalAlignment="Left" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding PosterRefreshStatus}" Foreground="{StaticResource BrushAccentHover}"
                                                   FontSize="11.5" VerticalAlignment="Center" Margin="10,0,0,4"/>
                                    </StackPanel>
                                    <TextBlock Text="Re-checks poster art for every game in your library, even ones that already have a cover. Picks up Steam's official artwork once it's published (e.g. a game you added before release has since launched) as well as any newly added/changed art sources like SteamGridDB below."
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11"
                                               Margin="0,4,0,12" TextWrapping="Wrap"/>

                                    <CheckBox Content="Use SteamGridDB for fallback poster art (optional)"
                                              IsChecked="{Binding UseSteamGridDbArt}" 
                                              Style="{StaticResource ModernCheckBox}" FontSize="12.5"/>
                                    <TextBlock Text="Uses community-submitted vertical box art from SteamGridDB.com as a fallback when official Steam artwork is not available yet (e.g. new, indie, or upcoming games). Requires a free API key." 
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11" 
                                               Margin="24,3,0,8" TextWrapping="Wrap"/>

                                    <Grid Margin="24,0,0,0" IsEnabled="{Binding UseSteamGridDbArt}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding SteamGridDbApiKey, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{StaticResource ModernTextBox}" Margin="0,0,8,0" 
                                                 Tag="Paste your SteamGridDB API key here..."/>
                                        <Button Grid.Column="1" Content="Get API Key..." Command="{Binding OpenSteamGridDbSiteCommand}"
                                                Style="{StaticResource ModernOutlineButton}" Padding="10,5"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 2.2 Game Titles & Metadata Detection -->
                            <Border CornerRadius="8" Background="{StaticResource BrushSurfaceDark}" 
                                    BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" 
                                    Padding="14,12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Game Titles &amp; Metadata Detection" FontSize="13.5" FontWeight="SemiBold" 
                                               Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Configure how game titles and categories are determined when importing files or scanning folders." 
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap"/>

                                    <CheckBox Content="Search official game titles online (Steam Database)" 
                                              IsChecked="{Binding SearchOfficialTitleOnline}" 
                                              Style="{StaticResource ModernCheckBox}" FontSize="12.5"/>
                                    <TextBlock Text="Queries the Steam Store database to match official commercial titles, correct capitalization, and store IDs (e.g. 'The Blood of Dawnwalker' instead of raw binary stems)." 
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11" 
                                               Margin="24,3,0,8" TextWrapping="Wrap"/>

                                    <DockPanel Margin="24,0,0,10" LastChildFill="False" IsEnabled="{Binding SearchOfficialTitleOnline}">
                                        <TextBlock Text="Matching sensitivity:" Foreground="{StaticResource BrushTextSecondary}" 
                                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <ComboBox ItemsSource="{Binding ConfidenceThresholdOptions}" 
                                                  SelectedItem="{Binding OnlineMatchSensitivity, Mode=TwoWay}" 
                                                  Style="{StaticResource ModernComboBox}" Width="190" HorizontalAlignment="Left"/>
                                    </DockPanel>

                                    <CheckBox Content="Local title fallback: Prefer executable (.exe) over folder name" 
                                              IsChecked="{Binding PreferExeForGameName}" 
                                              Style="{StaticResource ModernCheckBox}" FontSize="12.5"/>
                                    <TextBlock Text="When querying online (or as fallback when offline / unmatched), derives the base title from the executable's metadata and file name rather than the parent folder." 
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11" 
                                               Margin="24,3,0,10" TextWrapping="Wrap"/>

                                    <CheckBox Content="Automatically categorize games from store genres" 
                                              IsChecked="{Binding AutoCategorizeFromSteam}" 
                                              Style="{StaticResource ModernCheckBox}" FontSize="12.5"/>
                                    <TextBlock Text="Assigns primary official genres (e.g. Action, RPG, Strategy) to newly added games instead of leaving them Uncategorized." 
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11" 
                                               Margin="24,3,0,2" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- 2.3 Steam Library Scanner -->
                            <Border CornerRadius="8" Background="{StaticResource BrushSurfaceDark}" 
                                    BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" 
                                    Padding="14,12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Steam Library Scanner" FontSize="13.5" FontWeight="SemiBold" 
                                               Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Discover and launch games installed through your local Steam client." 
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap"/>

                                    <DockPanel LastChildFill="False">
                                        <CheckBox Content="Enable Steam Library Integration" 
                                                  IsChecked="{Binding SteamIntegrationEnabled}" 
                                                  Style="{StaticResource ModernCheckBox}" FontSize="13" 
                                                  VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                        <Button Content="Import Games..." Command="{Binding OpenSteamImportCommand}" 
                                                Style="{StaticResource ModernOutlineButton}" DockPanel.Dock="Right" 
                                                VerticalAlignment="Center" Padding="10,5"/>
                                    </DockPanel>
                                    <TextBlock Text="Automatically scan installed Steam games, VDF library manifests, and official Steam artwork caches." 
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11" 
                                               Margin="24,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ============================================== -->
                        <!-- CATEGORY 3: SYSTEM TRAY MENU                   -->
                        <!-- ============================================== -->
                        <StackPanel Visibility="{Binding ShowTrayMenuSection, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                            <!-- Section Header (shown in All Settings view) -->
                            <Border Margin="0,2,0,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAllTab}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74C;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="12.5" 
                                               Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="SYSTEM TRAY MENU" FontSize="11.5" FontWeight="SemiBold" 
                                               Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- 3.1 System Tray Context Menu Preferences -->
                            <Border CornerRadius="8" Background="{StaticResource BrushSurfaceDark}" 
                                    BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" 
                                    Padding="14,12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Tray Context Menu Preferences" FontSize="13.5" FontWeight="SemiBold" 
                                               Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,8"/>

                                    <CheckBox Content="Include 'Recent' category in tray menu" 
                                              IsChecked="{Binding ShowRecentInTray}" 
                                              Style="{StaticResource ModernCheckBox}" FontSize="12.5"/>
                                    <TextBlock Text="Adds a persistent 'Recent' category submenu to the tray menu for quick access to recently played games, whether category grouping is enabled or not." 
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11" 
                                               Margin="24,3,0,6" TextWrapping="Wrap"/>

                                    <DockPanel Margin="24,0,0,6" LastChildFill="False" IsEnabled="{Binding ShowRecentInTray}">
                                        <TextBlock Text="Max recent games to show:" Foreground="{StaticResource BrushTextSecondary}"
                                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <ComboBox ItemsSource="{Binding MaxRecentOptions}"
                                                  SelectedItem="{Binding MaxRecentInTray, Mode=TwoWay}"
                                                  Style="{StaticResource ModernComboBox}" Width="80" HorizontalAlignment="Left"/>
                                    </DockPanel>

                                    <DockPanel Margin="24,0,0,12" LastChildFill="False" IsEnabled="{Binding ShowRecentInTray}">
                                        <TextBlock Text="Recent sort order:" Foreground="{StaticResource BrushTextSecondary}"
                                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <ComboBox ItemsSource="{Binding TraySortOptions}"
                                                  SelectedItem="{Binding RecentTraySortOption, Mode=TwoWay}"
                                                  Style="{StaticResource ModernComboBox}" Width="180" HorizontalAlignment="Left"/>
                                    </DockPanel>

                                    <CheckBox Content="Include 'Favorites' category in tray menu"
                                              IsChecked="{Binding ShowFavoritesInTray}"
                                              Style="{StaticResource ModernCheckBox}" FontSize="12.5"/>
                                    <TextBlock Text="Adds a persistent 'Favorites' category submenu to the tray menu for quick access to your starred games, whether category grouping is enabled or not."
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11"
                                               Margin="24,3,0,6" TextWrapping="Wrap"/>

                                    <DockPanel Margin="24,0,0,6" LastChildFill="False" IsEnabled="{Binding ShowFavoritesInTray}">
                                        <TextBlock Text="Max favorites to show:" Foreground="{StaticResource BrushTextSecondary}"
                                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <ComboBox ItemsSource="{Binding MaxFavoritesOptions}"
                                                  SelectedItem="{Binding MaxFavoritesInTray, Mode=TwoWay}"
                                                  Style="{StaticResource ModernComboBox}" Width="80" HorizontalAlignment="Left"/>
                                    </DockPanel>

                                    <DockPanel Margin="24,0,0,12" LastChildFill="False" IsEnabled="{Binding ShowFavoritesInTray}">
                                        <TextBlock Text="Favorites sort order:" Foreground="{StaticResource BrushTextSecondary}"
                                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <ComboBox ItemsSource="{Binding TraySortOptions}"
                                                  SelectedItem="{Binding FavoritesTraySortOption, Mode=TwoWay}"
                                                  Style="{StaticResource ModernComboBox}" Width="180" HorizontalAlignment="Left"/>
                                    </DockPanel>

                                    <CheckBox Content="Group tray context menu by category"
                                              IsChecked="{Binding GroupTrayMenuByCategory}" 
                                              Style="{StaticResource ModernCheckBox}" FontSize="12.5"/>
                                    <TextBlock Text="When enabled, games are shown under category submenus in the right-click tray menu. When disabled, shows a flat list sorted by your preference." 
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11" 
                                               Margin="24,3,0,10" TextWrapping="Wrap"/>

                                    <DockPanel Margin="24,0,0,4" LastChildFill="False">
                                        <TextBlock Text="Tray menu sort order:" Foreground="{StaticResource BrushTextSecondary}" 
                                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <ComboBox ItemsSource="{Binding TraySortOptions}" 
                                                  SelectedItem="{Binding TrayMenuSortOption, Mode=TwoWay}" 
                                                  Style="{StaticResource ModernComboBox}" Width="180" HorizontalAlignment="Left"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ============================================== -->
                        <!-- CATEGORY 4: STORAGE & DIAGNOSTICS              -->
                        <!-- ============================================== -->
                        <StackPanel Visibility="{Binding ShowDiagnosticsSection, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                            <!-- Section Header (shown in All Settings view) -->
                            <Border Margin="0,2,0,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAllTab}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="12.5" 
                                               Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="STORAGE &amp; DIAGNOSTICS" FontSize="11.5" FontWeight="SemiBold" 
                                               Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- 4.1 Troubleshooting & Diagnostics -->
                            <Border CornerRadius="8" Background="{StaticResource BrushSurfaceDark}" 
                                    BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" 
                                    Padding="14,12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Diagnostic Logging &amp; Traces" FontSize="13.5" FontWeight="SemiBold" 
                                               Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Configure diagnostic logging to catch errors and trace execution while troubleshooting issues." 
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap"/>

                                    <CheckBox Content="Enable Verbose Logging" 
                                              IsChecked="{Binding VerboseLoggingEnabled}" 
                                              Style="{StaticResource ModernCheckBox}" FontSize="12.5"/>
                                    <TextBlock Text="When enabled, logs comprehensive traces including process launch parameters, heuristic scoring breakdown, icon extractions, and registry checks." 
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11" 
                                               Margin="24,3,0,12" TextWrapping="Wrap"/>

                                    <!-- Active Debug Log Info Box -->
                                    <Border Background="#16161B" CornerRadius="6" BorderBrush="#252530" BorderThickness="1" Padding="12,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="Active Debug Log File" FontSize="10.5" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,2"/>
                                                <TextBlock Text="{Binding LogFilePathDisplay}" FontSize="11.5" FontFamily="{StaticResource AppFont}" 
                                                           Foreground="{StaticResource BrushAccentHover}" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding LogFilePathDisplay}"/>
                                                <TextBlock Text="{Binding LogFileSizeDisplay, StringFormat='Current File Size: {0}'}" 
                                                           FontSize="10.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="Open Log" Command="{Binding OpenLogFileCommand}" 
                                                        Style="{StaticResource ModernOutlineButton}" Margin="0,0,6,0" Padding="10,5"/>
                                                <Button Content="Clear Log" Command="{Binding ClearLogCommand}" 
                                                        Style="{StaticResource ModernOutlineButton}" Margin="0,0,6,0" Padding="10,5"/>
                                                <Button Content="Open Folder" Command="{Binding OpenLogFolderCommand}" 
                                                        Style="{StaticResource ModernOutlineButton}" Padding="10,5"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- 4.2 Storage & Asset Caches -->
                            <Border CornerRadius="8" Background="{StaticResource BrushSurfaceDark}" 
                                    BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" 
                                    Padding="14,12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Data Storage &amp; Asset Cache" FontSize="13.5" FontWeight="SemiBold" 
                                               Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Local application databases, configurations, and downloaded artwork caches." 
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap"/>

                                    <!-- Roaming: Database & Settings -->
                                    <DockPanel LastChildFill="True" Margin="0,0,0,10">
                                        <Button DockPanel.Dock="Right" Content="Open Data Folder" Command="{Binding OpenStorageFolderCommand}" 
                                                Style="{StaticResource ModernOutlineButton}" VerticalAlignment="Center" Padding="10,5"/>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="User Data &amp; Settings (%AppData%)" FontSize="12" FontWeight="SemiBold" 
                                                       Foreground="{StaticResource BrushTextSecondary}"/>
                                            <TextBlock Text="{Binding StorageDirectoryDisplay}" Foreground="{StaticResource BrushAccentHover}" 
                                                       FontSize="11" FontFamily="{StaticResource AppFont}" Margin="0,2,0,2"
                                                       ToolTip="{Binding StorageDirectoryDisplay}"/>
                                            <TextBlock Text="Contains games.json, settings.json, and atomic .bak recovery backups." 
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="10.5" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <Separator Background="#252530" Margin="0,2,0,10"/>

                                    <!-- Local: Artwork & Media Caches -->
                                    <DockPanel LastChildFill="True">
                                        <Button DockPanel.Dock="Right" Content="Open Cache Folder" Command="{Binding OpenCacheFolderCommand}" 
                                                Style="{StaticResource ModernOutlineButton}" VerticalAlignment="Center" Padding="10,5"/>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="Artwork &amp; Icons Cache (%LocalAppData%)" FontSize="12" FontWeight="SemiBold" 
                                                       Foreground="{StaticResource BrushTextSecondary}"/>
                                            <TextBlock Text="{Binding CacheDirectoryDisplay}" Foreground="{StaticResource BrushAccentHover}" 
                                                       FontSize="11" FontFamily="{StaticResource AppFont}" Margin="0,2,0,2"
                                                       ToolTip="{Binding CacheDirectoryDisplay}"/>
                                            <TextBlock Text="Contains extracted game icons (.png) and downloaded poster artwork (.jpg)." 
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="10.5" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <!-- 4.3 Reset Settings to Defaults -->
                            <Border CornerRadius="8" Background="{StaticResource BrushSurfaceDark}" 
                                    BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" 
                                    Padding="14,12" Margin="0,0,0,10">
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Right" Content="Restore Defaults" Command="{Binding ResetSettingsCommand}" 
                                            Style="{StaticResource ModernOutlineButton}" VerticalAlignment="Center" Padding="12,6"/>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="Reset Settings to Defaults" FontSize="13.5" FontWeight="SemiBold" 
                                                   Foreground="{StaticResource BrushTextPrimary}"/>
                                        <TextBlock Text="Restores startup, system tray context menu, scanning heuristics, and display preferences back to recommended defaults. Your game library and custom artwork are preserved." 
                                                   Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
                </Grid>
            </Grid>

            <!-- ========================================================== -->
            <!-- 3. IN-WINDOW ABOUT VIEW                                    -->
            <!-- ========================================================== -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAboutView}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="Auto"/> <!-- Category Segmented Tabs -->
                    <RowDefinition Height="*"/>    <!-- About Content ScrollViewer -->
                </Grid.RowDefinitions>

                <!-- 1. Header matching Settings, System, Library -->
                <DockPanel Grid.Row="0" Margin="0,0,0,14">
                    <!-- Right: Version & Status Indicator Badge -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding UpdateStatusIcon}" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="12" 
                                   Foreground="{Binding UpdateStatusBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="{Binding UpdateStatusBadgeText}" FontSize="11.5" Foreground="{StaticResource BrushTextMuted}" 
                                   FontFamily="{StaticResource AppFont}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Left: Title & Subtitle matching Settings -->
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="About TrayTrigger" FontSize="20" Foreground="{StaticResource BrushTextPrimary}" 
                                   FontFamily="{StaticResource AppFont}" FontWeight="Normal"/>
                        <TextBlock Text="Application overview, keyboard shortcuts, verified features, and diagnostics" 
                                   FontSize="12" Foreground="{StaticResource BrushTextSecondary}" 
                                   FontFamily="{StaticResource AppFont}" Margin="0,4,0,0"/>
                    </StackPanel>
                </DockPanel>

                <!-- 2. Category Segmented Tabs -->
                <Border Grid.Row="1" Background="#181820" BorderBrush="{StaticResource BrushBorderDark}" 
                        BorderThickness="1" CornerRadius="6" Padding="3" HorizontalAlignment="Left" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="All" Command="{Binding SelectAboutAllTabCommand}"
                                Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsAboutAllTab}"/>
                        <Button Content="Overview" Command="{Binding SelectAboutOverviewTabCommand}" Margin="2,0,0,0"
                                Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsAboutOverviewTab}"/>
                        <Button Content="Key Features" Command="{Binding SelectAboutFeaturesTabCommand}" Margin="2,0,0,0"
                                Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsAboutFeaturesTab}"/>
                        <Button Content="Shortcuts" Command="{Binding SelectAboutShortcutsTabCommand}" Margin="2,0,0,0"
                                Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsAboutShortcutsTab}"/>
                        <Button Content="Support &amp; Links" Command="{Binding SelectAboutSupportTabCommand}" Margin="2,0,0,0"
                                Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsAboutSupportTab}"/>
                    </StackPanel>
                </Border>

                <!-- 3. About Content ScrollViewer -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14">
                    <StackPanel HorizontalAlignment="Stretch" Margin="0,0,12,0">

                        <!-- ============================================== -->
                        <!-- CATEGORY 1: APPLICATION OVERVIEW               -->
                        <!-- ============================================== -->
                        <StackPanel Visibility="{Binding ShowAboutOverviewSection, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                            <!-- Section Header (shown in All view) -->
                            <Border Margin="0,2,0,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAboutAllTab}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="12.5" 
                                               Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="APPLICATION OVERVIEW" FontSize="11.5" FontWeight="SemiBold" 
                                               Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Hero Identity Card -->
                            <Border CornerRadius="8" Background="{StaticResource BrushSurfaceDark}" 
                                    BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" 
                                    Padding="18,16" Margin="0,0,0,10">
                                <DockPanel LastChildFill="True">
                                    <Image Source="/Assets/app_icon.png" Width="52" Height="52"
                                           Margin="0,0,18,0" DockPanel.Dock="Left" VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>

                                    <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0">
                                        <Button Content="Check for Updates" Command="{Binding CheckForUpdatesCommand}" 
                                                Style="{StaticResource ModernAccentButton}" Padding="12,5" Margin="0,0,0,6"/>
                                        <Button Content="GitHub Project" Command="{Binding OpenGitHubCommand}" 
                                                Style="{StaticResource ModernOutlineButton}" Padding="12,5"/>
                                    </StackPanel>

                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="TrayTrigger" FontSize="19" FontWeight="SemiBold" 
                                                       Foreground="{StaticResource BrushTextPrimary}" FontFamily="{StaticResource AppFont}"/>
                                            <Border Background="#1C2E3D" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding AppVersionDisplay}" FontSize="11" Foreground="{StaticResource BrushAccentHover}" FontWeight="SemiBold"/>
                                            </Border>
                                            <Border Background="#1E2028" CornerRadius="4" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text=".NET 10.0" FontSize="10.5" Foreground="#85929E" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="A modern, distraction-free Windows tray launcher designed for zero friction, fast access, and clean game organization." 
                                                   Foreground="{StaticResource BrushTextSecondary}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Environment & Runtime Specs Card -->
                            <Border CornerRadius="8" Background="{StaticResource BrushSurfaceDark}" 
                                    BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" 
                                    Padding="14,12" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Col 0: Platform -->
                                    <Border Grid.Column="0" Background="#17171C" CornerRadius="6" Padding="12,10" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="PLATFORM" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,3"/>
                                            <TextBlock Text="Windows 10 / 11" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                            <TextBlock Text="x64 Architecture" FontSize="10.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Col 1: Runtime -->
                                    <Border Grid.Column="1" Background="#17171C" CornerRadius="6" Padding="12,10" Margin="3,0,3,0">
                                        <StackPanel>
                                            <TextBlock Text="RUNTIME" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,3"/>
                                            <TextBlock Text=".NET 10.0 WPF" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                            <TextBlock Text="Hardware Accelerated" FontSize="10.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Col 2: Storage -->
                                    <Border Grid.Column="2" Background="#17171C" CornerRadius="6" Padding="12,10" Margin="3,0,3,0">
                                        <StackPanel>
                                            <TextBlock Text="STORAGE ENGINE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,3"/>
                                            <TextBlock Text="Atomic JSON &amp; .bak" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                            <TextBlock Text="Crash-Resilient DB" FontSize="10.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Col 3: Tray Integration -->
                                    <Border Grid.Column="3" Background="#17171C" CornerRadius="6" Padding="12,10" Margin="6,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="TRAY INTEGRATION" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,3"/>
                                            <TextBlock Text="Win32 Shell Notify" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                            <TextBlock Text="Global Win32 Hotkeys" FontSize="10.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- ============================================== -->
                        <!-- CATEGORY 2: KEY FEATURES                       -->
                        <!-- ============================================== -->
                        <StackPanel Visibility="{Binding ShowAboutFeaturesSection, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                            <!-- Section Header (shown in All view) -->
                            <Border Margin="0,2,0,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAboutAllTab}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="12.5" 
                                               Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="KEY FEATURES &amp; CAPABILITIES" FontSize="11.5" FontWeight="SemiBold" 
                                               Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Feature Grid (2 columns x 3 rows) -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Feature 1: One-Click Launch -->
                                <Border Grid.Row="0" Grid.Column="0" CornerRadius="8" Background="{StaticResource BrushSurfaceDark}" 
                                        BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" 
                                        Padding="14,12" Margin="0,0,5,10">
                                    <DockPanel LastChildFill="True">
                                        <Border Width="34" Height="34" CornerRadius="6" Background="#20202A" Margin="0,0,12,0" VerticalAlignment="Top">
                                            <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="14" 
                                                       Foreground="{StaticResource BrushAccentHover}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="One-Click Launch &amp; Focus" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                            <TextBlock Text="Instantly launch games or focus running instances without spawning duplicate processes." 
                                                       FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- Feature 2: Smart Folder Detection -->
                                <Border Grid.Row="0" Grid.Column="1" CornerRadius="8" Background="{StaticResource BrushSurfaceDark}" 
                                        BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" 
                                        Padding="14,12" Margin="5,0,0,10">
                                    <DockPanel LastChildFill="True">
                                        <Border Width="34" Height="34" CornerRadius="6" Background="#20202A" Margin="0,0,12,0" VerticalAlignment="Top">
                                            <TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="14" 
                                                       Foreground="{StaticResource BrushAccentHover}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Smart Folder Detection" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                            <TextBlock Text="Drag and drop install folders to auto-filter uninstallers and extract high-resolution icons." 
                                                       FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- Feature 3: Categories & Sorting -->
                                <Border Grid.Row="1" Grid.Column="0" CornerRadius="8" Background="{StaticResource BrushSurfaceDark}" 
                                        BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" 
                                        Padding="14,12" Margin="0,0,5,10">
                                    <DockPanel LastChildFill="True">
                                        <Border Width="34" Height="34" CornerRadius="6" Background="#20202A" Margin="0,0,12,0" VerticalAlignment="Top">
                                            <TextBlock Text="&#xE8EC;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="14" 
                                                       Foreground="{StaticResource BrushAccentHover}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Categories &amp; Multi-Criteria Sorting" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                            <TextBlock Text="Organize games by genres and platforms with instant sorting by A-Z, Playtime, or Last Played." 
                                                       FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- Feature 4: Resilient Storage -->
                                <Border Grid.Row="1" Grid.Column="1" CornerRadius="8" Background="{StaticResource BrushSurfaceDark}" 
                                        BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" 
                                        Padding="14,12" Margin="5,0,0,10">
                                    <DockPanel LastChildFill="True">
                                        <Border Width="34" Height="34" CornerRadius="6" Background="#20202A" Margin="0,0,12,0" VerticalAlignment="Top">
                                            <TextBlock Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="14" 
                                                       Foreground="{StaticResource BrushAccentHover}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Resilient Atomic Storage" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                            <TextBlock Text="Game metadata and settings write atomically with rolling backup files to prevent file corruption." 
                                                       FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- Feature 5: Live Hardware Telemetry -->
                                <Border Grid.Row="2" Grid.Column="0" CornerRadius="8" Background="{StaticResource BrushSurfaceDark}" 
                                        BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" 
                                        Padding="14,12" Margin="0,0,5,0">
                                    <DockPanel LastChildFill="True">
                                        <Border Width="34" Height="34" CornerRadius="6" Background="#20202A" Margin="0,0,12,0" VerticalAlignment="Top">
                                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="14" 
                                                       Foreground="{StaticResource BrushAccentHover}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Hardware Telemetry &amp; Tweaks" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                            <TextBlock Text="Monitor CPU/RAM/VRAM telemetry and configure verified Windows gaming optimizations." 
                                                       FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- Feature 6: Tray & Quick Launch -->
                                <Border Grid.Row="2" Grid.Column="1" CornerRadius="8" Background="{StaticResource BrushSurfaceDark}" 
                                        BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" 
                                        Padding="14,12" Margin="5,0,0,0">
                                    <DockPanel LastChildFill="True">
                                        <Border Width="34" Height="34" CornerRadius="6" Background="#20202A" Margin="0,0,12,0" VerticalAlignment="Top">
                                            <TextBlock Text="&#xE704;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="14" 
                                                       Foreground="{StaticResource BrushAccentHover}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Distraction-Free Tray Launcher" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                            <TextBlock Text="Minimal memory footprint (~35MB), global hotkey toggle, and instant access via tray menus." 
                                                       FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <!-- ============================================== -->
                        <!-- CATEGORY 3: QUICK REFERENCE & SHORTCUTS        -->
                        <!-- ============================================== -->
                        <StackPanel Visibility="{Binding ShowAboutShortcutsSection, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                            <!-- Section Header (shown in All view) -->
                            <Border Margin="0,2,0,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAboutAllTab}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="12.5" 
                                               Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="QUICK REFERENCE &amp; SHORTCUTS" FontSize="11.5" FontWeight="SemiBold" 
                                               Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border CornerRadius="8" Background="{StaticResource BrushSurfaceDark}" 
                                    BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" 
                                    Padding="14,12" Margin="0,0,0,10">
                                <StackPanel>
                                    <DockPanel LastChildFill="True" Margin="0,0,0,12">
                                        <Button DockPanel.Dock="Right" Content="Configure Hotkey..." 
                                                Command="{Binding NavigateToGeneralSettingsCommand}" 
                                                Style="{StaticResource ModernOutlineButton}" 
                                                VerticalAlignment="Center" Padding="11,5"/>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="Keyboard &amp; Mouse Controls" FontSize="13.5" FontWeight="SemiBold" 
                                                       Foreground="{StaticResource BrushTextPrimary}"/>
                                            <TextBlock Text="Convenient hotkeys and mouse actions for lightning-fast library and tray management." 
                                                       Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <!-- Table Container -->
                                    <Border Background="#17171C" CornerRadius="6" Padding="14,10">
                                        <StackPanel>
                                            <!-- Row 1: Global Hotkey -->
                                            <DockPanel Margin="0,0,0,9">
                                                <StackPanel Orientation="Horizontal" Width="200" VerticalAlignment="Center">
                                                    <Border Background="#252532" BorderBrush="#353545" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,3,0">
                                                        <TextBlock Text="Ctrl" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                                    </Border>
                                                    <TextBlock Text="+" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                                    <Border Background="#252532" BorderBrush="#353545" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,3,0">
                                                        <TextBlock Text="Alt" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                                    </Border>
                                                    <TextBlock Text="+" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                                    <Border Background="#252532" BorderBrush="#353545" BorderThickness="1" CornerRadius="4" Padding="7,2">
                                                        <TextBlock Text="G" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushAccentHover}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="Toggle Manage Games window from anywhere in Windows (customizable)" 
                                                           Foreground="{StaticResource BrushTextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                                            </DockPanel>

                                            <!-- Row 2: Tray Left-Click -->
                                            <DockPanel Margin="0,0,0,9">
                                                <StackPanel Orientation="Horizontal" Width="200" VerticalAlignment="Center">
                                                    <Border Background="#252532" BorderBrush="#353545" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="Left-Click" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                                    </Border>
                                                    <TextBlock Text=" Tray Icon" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="Show or restore the Manage Games window" 
                                                           Foreground="{StaticResource BrushTextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                                            </DockPanel>

                                            <!-- Row 3: Tray Right-Click -->
                                            <DockPanel Margin="0,0,0,9">
                                                <StackPanel Orientation="Horizontal" Width="200" VerticalAlignment="Center">
                                                    <Border Background="#252532" BorderBrush="#353545" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="Right-Click" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                                    </Border>
                                                    <TextBlock Text=" Tray Icon" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="Open quick-launch menu (grouped by category or flat list)" 
                                                           Foreground="{StaticResource BrushTextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                                            </DockPanel>

                                            <!-- Row 4: Game Card Left-Click -->
                                            <DockPanel Margin="0,0,0,9">
                                                <StackPanel Orientation="Horizontal" Width="200" VerticalAlignment="Center">
                                                    <Border Background="#252532" BorderBrush="#353545" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="Left-Click" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                                    </Border>
                                                    <TextBlock Text=" Game Card" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="Launch game immediately or bring running window to front" 
                                                           Foreground="{StaticResource BrushTextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                                            </DockPanel>

                                            <!-- Row 5: Game Card Right-Click -->
                                            <DockPanel Margin="0,0,0,9">
                                                <StackPanel Orientation="Horizontal" Width="200" VerticalAlignment="Center">
                                                    <Border Background="#252532" BorderBrush="#353545" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="Right-Click" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                                    </Border>
                                                    <TextBlock Text=" Game Card" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="Open contextual options (rename, move category, relocate exe, edit box art)" 
                                                           Foreground="{StaticResource BrushTextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                                            </DockPanel>

                                            <!-- Row 6: Quick Search -->
                                            <DockPanel Margin="0,0,0,9">
                                                <StackPanel Orientation="Horizontal" Width="200" VerticalAlignment="Center">
                                                    <Border Background="#252532" BorderBrush="#353545" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,3,0">
                                                        <TextBlock Text="Ctrl" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                                    </Border>
                                                    <TextBlock Text="+" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                                    <Border Background="#252532" BorderBrush="#353545" BorderThickness="1" CornerRadius="4" Padding="7,2">
                                                        <TextBlock Text="F" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushAccentHover}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="Focus the search input bar in the Games Library" 
                                                           Foreground="{StaticResource BrushTextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                                            </DockPanel>

                                            <!-- Row 7: Escape -->
                                            <DockPanel>
                                                <StackPanel Orientation="Horizontal" Width="200" VerticalAlignment="Center">
                                                    <Border Background="#252532" BorderBrush="#353545" BorderThickness="1" CornerRadius="4" Padding="8,2">
                                                        <TextBlock Text="Esc" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="Clear active search filter and restore all games" 
                                                           Foreground="{StaticResource BrushTextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ============================================== -->
                        <!-- CATEGORY 4: SUPPORT & DIAGNOSTICS              -->
                        <!-- ============================================== -->
                        <StackPanel Visibility="{Binding ShowAboutSupportSection, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                            <!-- Section Header (shown in All view) -->
                            <Border Margin="0,2,0,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAboutAllTab}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="12.5" 
                                               Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="SUPPORT &amp; DIAGNOSTICS" FontSize="11.5" FontWeight="SemiBold" 
                                               Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 1: Centralized Diagnostics Link -->
                            <Border CornerRadius="8" Background="{StaticResource BrushSurfaceDark}" 
                                    BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" 
                                    Padding="14,12" Margin="0,0,0,10">
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Right" Content="Open Storage &amp; Logs in Settings →" 
                                            Command="{Binding OpenDiagnosticsSettingsCommand}" 
                                            Style="{StaticResource ModernAccentButton}" 
                                            VerticalAlignment="Center" Padding="12,5"/>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Application Storage, Logs &amp; Reset" FontSize="13.5" FontWeight="SemiBold" 
                                                   Foreground="{StaticResource BrushTextPrimary}"/>
                                        <TextBlock Text="To keep operational maintenance centralized, all active debug logs, storage directories, box art cache files, and factory restore tools are managed in Application Settings." 
                                                   Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Card 2: Copy System Info for Bug Reports -->
                            <Border CornerRadius="8" Background="{StaticResource BrushSurfaceDark}" 
                                    BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" 
                                    Padding="14,12" Margin="0,0,0,10">
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Right" Content="Copy Diagnostic Info" 
                                            Command="{Binding CopySystemInfoCommand}" 
                                            Style="{StaticResource ModernOutlineButton}" 
                                            VerticalAlignment="Center" Padding="12,5"/>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="System Environment Report" FontSize="13.5" FontWeight="SemiBold" 
                                                   Foreground="{StaticResource BrushTextPrimary}"/>
                                        <TextBlock Text="Quickly copy OS build, .NET runtime, architecture, and game library metrics to your clipboard for troubleshooting or bug reporting." 
                                                   Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Card 3: Community & Issues -->
                            <Border CornerRadius="8" Background="{StaticResource BrushSurfaceDark}" 
                                    BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" 
                                    Padding="14,12" Margin="0,0,0,10">
                                <DockPanel LastChildFill="True">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Report an Issue" Command="{Binding OpenGitHubIssuesCommand}" 
                                                Style="{StaticResource ModernOutlineButton}" VerticalAlignment="Center" Padding="11,5" Margin="0,0,6,0"/>
                                        <Button Content="GitHub Repository" Command="{Binding OpenGitHubCommand}" 
                                                Style="{StaticResource ModernOutlineButton}" VerticalAlignment="Center" Padding="11,5"/>
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Community &amp; Open Source" FontSize="13.5" FontWeight="SemiBold" 
                                                   Foreground="{StaticResource BrushTextPrimary}"/>
                                        <TextBlock Text="TrayTrigger is open source software. Submit bug reports, suggest features, or explore the documentation on GitHub." 
                                                   Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ========================================================== -->
            <!-- 4. SYSTEM & PERFORMANCE VIEW                               -->
            <!-- ========================================================== -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSystemView}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <views:SystemView DataContext="{Binding SystemVM}"/>
            </Grid>

        </Grid>
    </Grid>
</Window>
