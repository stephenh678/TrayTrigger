                                                   Foreground="{StaticResource BrushTextSecondary}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Environment & Runtime Specs Card -->
                            <Border CornerRadius="8" Background="{StaticResource BrushSurfaceDark}" 
                                    BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" 
                                    Padding="14,12" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Col 0: Platform -->
                                    <Border Grid.Column="0" Background="#17171C" CornerRadius="6" Padding="12,10" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="PLATFORM" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,3"/>
                                            <TextBlock Text="Windows 10 / 11" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                            <TextBlock Text="x64 Architecture" FontSize="10.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Col 1: Runtime -->
                                    <Border Grid.Column="1" Background="#17171C" CornerRadius="6" Padding="12,10" Margin="3,0,3,0">
                                        <StackPanel>
                                            <TextBlock Text="RUNTIME" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,3"/>
                                            <TextBlock Text=".NET 10.0 WPF" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                            <TextBlock Text="Hardware Accelerated" FontSize="10.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0"/>
                                        </StackPanel>
