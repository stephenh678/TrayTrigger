                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Viewbox Width="8.5" Height="8.5" Margin="0,0,3,0">
                                                            <Path Fill="#FFC107" Stretch="Uniform"
                                                                  Data="M23.561 11.988C23.301-.304 6.954-4.89.656 6.634c.282.206.661.477.943.672a11.747 11.747 0 00-.976 3.067 11.885 11.885 0 00-.184 2.071C.439 18.818 5.621 24 12.005 24c6.385 0 11.556-5.17 11.556-11.556v-.455zm-20.27 2.06c-.152 1.246-.054 1.636-.054 1.788l-.282.098c-.108-.206-.37-.932-.488-1.908C2.163 10.308 4.7 6.96 8.57 6.33c3.544-.52 6.937 1.68 7.728 4.758l-.282.098c-.087-.087-.228-.336-.77-.878-4.281-4.281-11.002-2.32-11.956 3.74zm11.002 2.081a3.145 3.145 0 01-2.59 1.355 3.15 3.15 0 01-3.155-3.155 3.159 3.159 0 012.927-3.144c1.018-.043 1.972.51 2.416 1.398a2.58 2.58 0 01-.455 2.95c.293.205.575.4.856.595zm6.58.12c-1.669 3.782-5.106 5.766-8.77 5.712-7.034-.347-9.083-8.466-4.38-11.393l.207.206c-.076.108-.358.325-.791 1.182-.51 1.041-.672 2.081-.607 2.732.369 5.67 8.314 6.83 11.045 1.214C21.057 8.217 11.822.401 3.626 6.374l-.184-.184C5.599 2.808 9.816 1.3 13.837 2.309c6.147 1.55 9.453 7.956 7.035 13.94z"/>
                                                        </Viewbox>
                                                        <TextBlock Text="UBI" FontSize="8.5" Foreground="#FFC107"
                                                                   FontFamily="{StaticResource AppFont}" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Background="#2A2A3A" CornerRadius="3" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="HIDDEN" FontSize="8.5" FontWeight="Bold"
                                                               Foreground="#9A9AB0" FontFamily="{StaticResource AppFont}"/>
                                                </Border>
                                            </StackPanel>

                                            <!-- Category Pill -->
                                            <Border Grid.Column="2" Background="#1D1D24" BorderBrush="#33FFFFFF" BorderThickness="1"
                                                    CornerRadius="4" Padding="7,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Category}" FontSize="10" 
                                                           Foreground="{StaticResource BrushTextSecondary}" 
                                                           FontFamily="{StaticResource AppFont}"/>
                                            </Border>

                                            <!-- Playtime -->
                                            <TextBlock Grid.Column="3" Text="{Binding ListPlaytimeDisplay}" FontSize="11" 
                                                       Foreground="{StaticResource BrushTextSecondary}" 
                                                       FontFamily="{StaticResource AppFont}" VerticalAlignment="Center"/>

                                            <!-- Last Played -->
                                            <TextBlock Grid.Column="4" Text="{Binding LastPlayedDisplay}" FontSize="11" 
                                                       Foreground="{StaticResource BrushTextMuted}" 
                                                       FontFamily="{StaticResource AppFont}" VerticalAlignment="Center"/>

                                            <!-- Action Buttons -->
                                            <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Button Command="{Binding LaunchCommand}" ToolTip="Play Game"
                                                        Height="34" Width="34" Margin="0,0,6,0">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource CirclePlayButton}">
                                                            <Setter Property="FontSize" Value="12"/>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Command="{Binding ViewDetailsCommand}" ToolTip="Game Details &amp; Info"
                                                        Style="{StaticResource ModernOutlineButton}" Height="26" Width="28" Padding="0">
                                                    <TextBlock Text="ℹ" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                            <Setter TargetName="ListRowBorder" Property="Opacity" Value="0.65"/>
                                            <Setter TargetName="ListRowBorder" Property="BorderBrush" Value="#805030"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ListRowBorder" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                            <Setter TargetName="ListRowBorder" Property="Background" Value="#25252E"/>
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- Floating Non-Blocking Undo Toast -->
                    <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18"
                            Background="#24242E" BorderBrush="{StaticResource BrushAccent}" BorderThickness="1.5"
                            CornerRadius="8" Padding="16,10" Panel.ZIndex="100">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.5" Color="#000000"/>
                        </Border.Effect>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsUndoToastVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🗑" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding UndoToastMessage}" Foreground="{StaticResource BrushTextPrimary}" 
                                       FontSize="13" FontFamily="{StaticResource AppFont}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <Button Content="UNDO" Command="{Binding UndoDeleteCommand}" 
                                    Style="{StaticResource ModernAccentButton}" Padding="12,4" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <Button Content="✕" Command="{Binding DismissUndoToastCommand}"
                                    Style="{StaticResource ModernGhostButton}" Padding="6,4" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Floating Non-Blocking Launch Toast (offset above the undo toast's anchor point
                         so the two don't overlap if both happen to be visible at once) -->
                    <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,70"
                            Background="#24242E" BorderBrush="{StaticResource BrushAccent}" BorderThickness="1.5"
                            CornerRadius="8" Padding="16,10" Panel.ZIndex="100">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.5" Color="#000000"/>
                        </Border.Effect>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLaunchToastVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="▶" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource BrushAccent}"/>
                            <TextBlock Text="{Binding LaunchToastMessage}" Foreground="{StaticResource BrushTextPrimary}"
                                       FontSize="13" FontFamily="{StaticResource AppFont}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <Button Content="✕" Command="{Binding DismissLaunchToastCommand}"
                                    Style="{StaticResource ModernGhostButton}" Padding="6,4" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 5. Status Bar -->
                <DockPanel Grid.Row="4" Margin="0,14,0,0">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" 
                               Foreground="{StaticResource BrushTextSecondary}" 
                               FontFamily="{StaticResource AppFont}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="Hotkey: Ctrl+Alt+G to toggle" FontSize="11"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   FontFamily="{StaticResource AppFont}" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>

            </Grid>

            <!-- ========================================================== -->
            <!-- 2. IN-WINDOW SETTINGS VIEW                                 -->
            <!-- ========================================================== -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSettingsView}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid DataContext="{Binding SettingsVM}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="Auto"/> <!-- Category Segmented Tabs -->
                        <RowDefinition Height="*"/>    <!-- Settings ScrollViewer -->
                    </Grid.RowDefinitions>

                <!-- Header -->
                <DockPanel Grid.Row="0" Margin="0,0,0,14">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="12" 
                                   Foreground="#4EC9B0" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="Saved in real time" FontSize="11.5" Foreground="{StaticResource BrushTextMuted}" 
                                   FontFamily="{StaticResource AppFont}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Application Settings" FontSize="20" Foreground="{StaticResource BrushTextPrimary}" 
                                   FontFamily="{StaticResource AppFont}" FontWeight="Normal"/>
                        <TextBlock Text="Configure startup, appearance, tray shortcuts, and diagnostic logging" 
                                   FontSize="12" Foreground="{StaticResource BrushTextSecondary}" 
                                   FontFamily="{StaticResource AppFont}" Margin="0,4,0,0"/>
                    </StackPanel>
                </DockPanel>

                <!-- Category Segmented Tabs -->
                <Border Grid.Row="1" Background="#181820" BorderBrush="{StaticResource BrushBorderDark}" 
                        BorderThickness="1" CornerRadius="6" Padding="3" HorizontalAlignment="Left" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="All Settings" Command="{Binding SelectAllTabCommand}"
                                Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsAllTab}"/>
                        <Button Content="General" Command="{Binding SelectGeneralTabCommand}" Margin="2,0,0,0"
                                Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsGeneralTab}"/>
                        <Button Content="Library &amp; Art" Command="{Binding SelectLibraryTabCommand}" Margin="2,0,0,0"
                                Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsLibraryTab}"/>
                        <Button Content="Tray Menu" Command="{Binding SelectTrayMenuTabCommand}" Margin="2,0,0,0"
                                Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsTrayMenuTab}"/>
                        <Button Content="Performance Tweaks" Command="{Binding SelectPerformanceTweaksTabCommand}" Margin="2,0,0,0"
                                Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsPerformanceTweaksTab}"/>
                        <Button Content="Diagnostics &amp; Storage" Command="{Binding SelectDiagnosticsTabCommand}" Margin="2,0,0,0"
                                Style="{StaticResource SegmentedTabButton}" Tag="{Binding IsDiagnosticsTab}"/>
                    </StackPanel>
                </Border>

                <!-- Settings Cards ScrollViewer -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14">
                    <StackPanel HorizontalAlignment="Stretch" Margin="0,0,12,0">

                        <!-- ============================================== -->
                        <!-- CATEGORY 1: GENERAL & SYSTEM INTEGRATION       -->
                        <!-- ============================================== -->
                        <StackPanel Visibility="{Binding ShowGeneralSection, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                            <!-- Section Header (shown in All Settings view) -->
                            <Border Margin="0,2,0,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAllTab}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="12.5" 
                                               Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="GENERAL &amp; SYSTEM INTEGRATION" FontSize="11.5" FontWeight="SemiBold" 
                                               Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- 1.1 Windows Startup & System Tray Integration -->
                            <Border CornerRadius="8" Background="{StaticResource BrushSurfaceDark}" 
                                    BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" 
                                    Padding="14,12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Windows Startup &amp; System Tray" FontSize="13.5" FontWeight="SemiBold" 
                                               Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,8"/>

                                    <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows}" 
                                              Style="{StaticResource ModernCheckBox}" FontSize="13"/>
                                    <TextBlock Text="Launches TrayTrigger automatically when you log in to Windows." 
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11" 
                                               Margin="24,3,0,0" TextWrapping="Wrap"/>

                                    <!-- Nested Sub-Toggle: Start Minimized -->
                                    <StackPanel Margin="24,8,0,10">
                                        <CheckBox Content="Start minimized to tray" 
                                                  IsChecked="{Binding StartMinimizedToTray}" 
                                                  IsEnabled="{Binding CanConfigureMinimized}" 
                                                  Style="{StaticResource ModernCheckBox}" FontSize="12.5"/>
                                        <TextBlock Text="When enabled, runs tray-only with no window opened on system boot." 
                                                   Foreground="{StaticResource BrushTextMuted}" FontSize="10.5" 
                                                   Margin="24,2,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <DockPanel LastChildFill="False">
                                        <CheckBox Content="Always show icon in tray (prevent collapsing into overflow)" 
                                                  IsChecked="{Binding AlwaysShowTrayIcon}" 
                                                  Style="{StaticResource ModernCheckBox}" FontSize="12.5" 
                                                  VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                        <Button Content="Taskbar Settings..." Command="{Binding OpenTaskbarSettingsCommand}" 
                                                Style="{StaticResource ModernOutlineButton}" DockPanel.Dock="Right" 
                                                VerticalAlignment="Center" Padding="10,5"/>
                                    </DockPanel>
                                    <TextBlock Text="Requests Windows to keep the TrayTrigger icon pinned to the taskbar outside the hidden overflow chevron." 
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11" 
                                               Margin="24,3,0,6" TextWrapping="Wrap"/>

                                    <Border Background="#1A1A22" CornerRadius="6" Padding="8" Margin="24,4,0,0">
                                        <TextBlock Text="💡 Tip: You can also drag the TrayTrigger icon from the taskbar ^ overflow chevron directly onto your taskbar to pin it permanently." 
                                                   Foreground="#CCA84E" FontSize="10.5" TextWrapping="Wrap"/>
                                    </Border>

                                    <CheckBox Content="Minimize to system tray when launching a game" 
                                              IsChecked="{Binding MinimizeOnGameLaunch}" 
                                              Style="{StaticResource ModernCheckBox}" FontSize="12.5" Margin="0,12,0,0"/>
                                    <TextBlock Text="Automatically hides the TrayTrigger window to the system tray whenever a game starts so it never covers your game." 
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11" 
                                               Margin="24,3,0,4" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- 1.2 Global Manage Hotkey -->
                            <Border CornerRadius="8" Background="{StaticResource BrushSurfaceDark}" 
                                    BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" 
                                    Padding="14,12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Global Manage Window Hotkey" FontSize="13.5" FontWeight="SemiBold" 
                                                Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding GlobalManageHotkey, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource ModernTextBox}" Margin="0,0,0,6" Width="150" HorizontalAlignment="Left"/>
                                    <TextBlock Text="Press this key combination anywhere in Windows to toggle the Manage Games window (default: Ctrl+Alt+G)."
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- 1.2b Advanced: per-game launch scripts (off by default; gates the Edit Game card) -->
                            <Border CornerRadius="8" Background="{StaticResource BrushSurfaceDark}"
                                    BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1"
                                    Padding="14,12" Margin="0,0,0,10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="Game Launch Scripts" FontSize="13.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                        <Border Background="#2A2A3A" CornerRadius="3" Padding="6,1.5" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="ADVANCED" FontSize="9" FontWeight="Bold" Foreground="#9A9AB0"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Run your own script or program before a game starts and after it exits."
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap"/>

                                    <CheckBox Content="Show Pre-Launch &amp; Post-Exit Scripts in Edit Game"
                                              IsChecked="{Binding EnableGameScripts}"
                                              Style="{StaticResource ModernCheckBox}" FontSize="12.5"/>
                                    <TextBlock Text="Off by default to keep Edit Game simple. Games that already have a script keep it either way."
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11"
                                               Margin="24,3,0,2" TextWrapping="Wrap"/>
                                    <Button Style="{StaticResource HelpLinkButton}" Content="Script guide &amp; examples" Margin="24,0,0,2"
                                            Command="{x:Static services:HelpCommands.ShowTopic}" CommandParameter="scripts/overview"/>
                                </StackPanel>
                            </Border>

                            <!-- 1.3 Updates & GitHub Releases -->
                            <Border CornerRadius="8" Background="{StaticResource BrushSurfaceDark}" 
                                    BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" 
                                    Padding="14,12" Margin="0,0,0,10">
                                <StackPanel>
                                    <DockPanel LastChildFill="False" Margin="0,0,0,8">
                                        <TextBlock Text="Updates &amp; Version Control" FontSize="13.5" FontWeight="SemiBold" 
                                                   Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                        <Button Content="Check for Updates Now" Command="{Binding CheckUpdatesInSettingsCommand}" 
                                                Style="{StaticResource ModernOutlineButton}" DockPanel.Dock="Right" 
                                                VerticalAlignment="Center" Padding="10,4"/>
                                    </DockPanel>

                                    <CheckBox Content="Automatically check for updates on startup" 
                                              IsChecked="{Binding AutoCheckForUpdates}" 
                                              Style="{StaticResource ModernCheckBox}" FontSize="12.5"/>
                                    <TextBlock Text="Periodically checks GitHub Releases in the background and notifies you when an update is available."
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11"
                                               Margin="24,3,0,10" TextWrapping="Wrap"/>

                                    <CheckBox Content="Receive pre-release (beta) updates"
                                              IsChecked="{Binding IncludePrereleaseUpdates}"
                                              Style="{StaticResource ModernCheckBox}" FontSize="12.5"/>
                                    <TextBlock Text="Also offer beta builds. New features first, but they may be less stable."
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11"
                                               Margin="24,3,0,2" TextWrapping="Wrap"/>
                                    <Button Style="{StaticResource HelpLinkButton}" Content="About the beta channel" Margin="24,0,0,10"
                                            Command="{x:Static services:HelpCommands.ShowTopic}" CommandParameter="updates/prerelease"/>

                                    <TextBlock Text="GitHub Repository (owner/repo):" FontSize="12" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding GitHubRepository, UpdateSourceTrigger=PropertyChanged}" 
                                             Style="{StaticResource ModernTextBox}" Width="240" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                                    <TextBlock Text="The public GitHub repository where TrayTrigger release packages and tags are published (default: stephenh678/TrayTrigger)."
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11" TextWrapping="Wrap"/>

                                    <TextBlock Text="{Binding UpdateStatusText}" FontSize="11.5" Foreground="{StaticResource BrushAccentHover}" 
                                               Margin="0,8,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ============================================== -->
                        <!-- CATEGORY 2: LIBRARY & ARTWORK                  -->
                        <!-- ============================================== -->
                        <StackPanel Visibility="{Binding ShowLibrarySection, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                            <!-- Section Header (shown in All Settings view) -->
                            <Border Margin="0,2,0,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAllTab}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="12.5" 
                                               Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="LIBRARY &amp; ARTWORK" FontSize="11.5" FontWeight="SemiBold" 
                                               Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- 2.1 Library Box Art & Visuals -->
                            <Border CornerRadius="8" Background="{StaticResource BrushSurfaceDark}" 
                                    BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" 
                                    Padding="14,12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Library Box Art &amp; Visuals" FontSize="13.5" FontWeight="SemiBold" 
                                               Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Customize poster covers and presentation styles on library game cards." 
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,0,0,12" TextWrapping="Wrap"/>

                                    <DockPanel Margin="0,0,0,12" LastChildFill="False">
                                        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                            <TextBlock Text="Default library view mode:" Foreground="{StaticResource BrushTextPrimary}" FontSize="12.5"/>
                                            <TextBlock Text="Choose the default presentation style when opening the game library." Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ComboBox ItemsSource="{Binding ViewModeOptions}" 
                                                  SelectedItem="{Binding LibraryViewMode, Mode=TwoWay}" 
                                                  Style="{StaticResource ModernComboBox}" Width="140" HorizontalAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                    </DockPanel>

                                    <CheckBox Content="Display vertical poster art on game cards (Steam 600×900)"
                                              IsChecked="{Binding UseVerticalPosterArt}"
                                              Style="{StaticResource ModernCheckBox}" FontSize="12.5"/>
                                    <TextBlock Text="Shows official high-resolution vertical box artwork on library game cards instead of square icons when available."
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11"
                                               Margin="24,3,0,10" TextWrapping="Wrap"/>

                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Refresh All Game Posters" Command="{Binding RefreshAllPostersCommand}"
                                                IsEnabled="{Binding CanRefreshAllPosters}"
                                                Style="{StaticResource ModernOutlineButton}" Padding="10,5"
                                                HorizontalAlignment="Left" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding PosterRefreshStatus}" Foreground="{StaticResource BrushAccentHover}"
                                                   FontSize="11.5" VerticalAlignment="Center" Margin="10,0,0,4"/>
                                    </StackPanel>
                                    <TextBlock Text="Re-checks every game for better art, including ones that already have a cover."
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11"
                                               Margin="0,4,0,2" TextWrapping="Wrap"/>
                                    <Button Style="{StaticResource HelpLinkButton}" Content="How artwork is found" Margin="0,0,0,12"
                                            Command="{x:Static services:HelpCommands.ShowTopic}" CommandParameter="library/artwork"/>

                                    <CheckBox Content="Use SteamGridDB for fallback poster art (optional)"
                                              IsChecked="{Binding UseSteamGridDbArt}" 
                                              Style="{StaticResource ModernCheckBox}" FontSize="12.5"/>
                                    <TextBlock Text="Community box art for games Steam has no poster for yet. Needs a free API key."
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11" 
                                               Margin="24,3,0,8" TextWrapping="Wrap"/>

                                    <Grid Margin="24,0,0,0" IsEnabled="{Binding UseSteamGridDbArt}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding SteamGridDbApiKey, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{StaticResource ModernTextBox}" Margin="0,0,8,0" 
                                                 Tag="Paste your SteamGridDB API key here..."/>
                                        <Button Grid.Column="1" Content="Get API Key..." Command="{Binding OpenSteamGridDbSiteCommand}"
                                                Style="{StaticResource ModernOutlineButton}" Padding="10,5"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 2.2 Game Titles & Metadata Detection -->
                            <Border CornerRadius="8" Background="{StaticResource BrushSurfaceDark}" 
                                    BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" 
                                    Padding="14,12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Game Titles &amp; Metadata Detection" FontSize="13.5" FontWeight="SemiBold" 
                                               Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4"/>
                                    <TextBlock Text="How game titles and categories are determined when importing files or scanning folders."
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,0,0,2" TextWrapping="Wrap"/>
                                    <Button Style="{StaticResource HelpLinkButton}" Content="How titles are detected" Margin="0,0,0,10"
                                            Command="{x:Static services:HelpCommands.ShowTopic}" CommandParameter="library/titles"/>

                                    <CheckBox Content="Search official game titles online (Steam Database)"
                                              IsChecked="{Binding SearchOfficialTitleOnline}" 
                                              Style="{StaticResource ModernCheckBox}" FontSize="12.5"/>
                                    <TextBlock Text="Looks up the official title and Steam App ID instead of using the file name."
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11" 
                                               Margin="24,3,0,8" TextWrapping="Wrap"/>

                                    <DockPanel Margin="24,0,0,10" LastChildFill="False" IsEnabled="{Binding SearchOfficialTitleOnline}">
                                        <TextBlock Text="Matching sensitivity:" Foreground="{StaticResource BrushTextSecondary}" 
                                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <ComboBox ItemsSource="{Binding ConfidenceThresholdOptions}" 
                                                  SelectedItem="{Binding OnlineMatchSensitivity, Mode=TwoWay}" 
                                                  Style="{StaticResource ModernComboBox}" Width="190" HorizontalAlignment="Left"/>
                                    </DockPanel>

                                    <CheckBox Content="Local title fallback: Prefer executable (.exe) over folder name" 
                                              IsChecked="{Binding PreferExeForGameName}" 
                                              Style="{StaticResource ModernCheckBox}" FontSize="12.5"/>
                                    <TextBlock Text="Builds the title from the exe's name and metadata rather than its parent folder."
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11" 
                                               Margin="24,3,0,10" TextWrapping="Wrap"/>

                                    <CheckBox Content="Automatically categorize games from store genres" 
                                              IsChecked="{Binding AutoCategorizeFromSteam}" 
                                              Style="{StaticResource ModernCheckBox}" FontSize="12.5"/>
                                    <TextBlock Text="New games get their store genre (Action, RPG, Strategy) as a category instead of Uncategorized."
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11" 
                                               Margin="24,3,0,2" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- 2.3 Game Scanner -->
                            <Border CornerRadius="8" Background="{StaticResource BrushSurfaceDark}"
                                    BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1"
                                    Padding="14,12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Game Scanner" FontSize="13.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Discover games installed through Steam and any folders you add as scan locations."
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,0,0,4" TextWrapping="Wrap"/>
                                    <Button Style="{StaticResource HelpLinkButton}" Content="How the Game Scanner works" Margin="0,0,0,10"
                                            Command="{x:Static services:HelpCommands.ShowTopic}" CommandParameter="scanner/overview"/>

                                    <DockPanel LastChildFill="False">
                                        <CheckBox Content="Enable Steam Library Integration"
                                                  IsChecked="{Binding SteamIntegrationEnabled}"
                                                  Style="{StaticResource ModernCheckBox}" FontSize="13"
                                                  VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                        <Button Content="Scan for Games..." Command="{Binding OpenScanForGamesCommand}"
                                                Style="{StaticResource ModernOutlineButton}" DockPanel.Dock="Right"
                                                VerticalAlignment="Center" Padding="10,5"/>
                                    </DockPanel>
                                    <TextBlock Text="When enabled, Steam library folders are automatically kept in your scan locations - VDF manifests and official Steam artwork caches are used to identify and enrich installed games."
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11"
                                               Margin="24,3,0,10" TextWrapping="Wrap"/>

                                    <CheckBox Content="Enable GOG Library Integration"
                                              IsChecked="{Binding GogIntegrationEnabled}"
                                              Style="{StaticResource ModernCheckBox}" FontSize="13"
                                              Margin="0,0,0,4"/>
                                    <TextBlock Text="When enabled, installed GOG games are found automatically - no scan location needed, since GOG already records each game's install path itself. Launches through GOG Galaxy when it's installed (preserving cloud saves and achievement sync), or the game's own executable otherwise."
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11"
                                               Margin="24,3,0,10" TextWrapping="Wrap"/>

                                    <CheckBox Content="Enable EA Library Integration"
                                              IsChecked="{Binding EaIntegrationEnabled}"
                                              Style="{StaticResource ModernCheckBox}" FontSize="13"
                                              Margin="0,0,0,4"/>
                                    <TextBlock Text="When enabled, installed EA games are found automatically and launched through EA App when it's installed (preserving cloud saves and achievement sync), falling back to the game's own executable otherwise. Note: EA games installed to a custom folder (not the default EA Games/Origin Games location) won't be found - EA doesn't record install paths the same reliable way Steam and GOG do."
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11"
                                               Margin="24,3,0,10" TextWrapping="Wrap"/>

                                    <CheckBox Content="Enable Epic Games Library Integration"
                                              IsChecked="{Binding EpicIntegrationEnabled}"
                                              Style="{StaticResource ModernCheckBox}" FontSize="13"
                                              Margin="0,0,0,4"/>
                                    <TextBlock Text="When enabled, installed Epic Games Store titles are found automatically - no scan location needed, since Epic Games Launcher records each game's install path directly. Launches through Epic Games Launcher when it's installed (preserving cloud saves and achievement sync), or the game's own executable otherwise."
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11"
                                               Margin="24,3,0,10" TextWrapping="Wrap"/>

                                    <CheckBox Content="Enable Ubisoft Connect Library Integration"
                                              IsChecked="{Binding UbisoftIntegrationEnabled}"
                                              Style="{StaticResource ModernCheckBox}" FontSize="13"
                                              Margin="0,0,0,4"/>
                                    <TextBlock Text="When enabled, installed Ubisoft Connect games are found automatically (any install location - Ubisoft's own registry records each game's folder directly) and launched through Ubisoft Connect when it's installed, falling back to the game's own executable otherwise. Note: Ubisoft doesn't record a game's title or exe the way other platforms do, so the name and executable are detected from the install folder - very reliable in practice, but occasionally imperfect for a game with multiple executables."
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11"
                                               Margin="24,3,0,10" TextWrapping="Wrap"/>

                                    <CheckBox Content="Automatically scan for new games on startup"
                                              IsChecked="{Binding AutoScanForGamesOnStartup}"
                                              Style="{StaticResource ModernCheckBox}" FontSize="13" Margin="0,0,0,4"/>
                                    <TextBlock Text="Runs Scan for Games quietly each time TrayTrigger opens - only interrupts you with the install prompt if it actually finds a new game."
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11"
                                               Margin="24,3,0,10" TextWrapping="Wrap"/>

                                    <!-- Scan Locations manager -->
                                    <Border Background="#16161B" BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1"
                                            CornerRadius="6" Padding="12,10" Margin="0,4,0,0">
                                        <StackPanel>
                                            <DockPanel LastChildFill="False" Margin="0,0,0,8">
                                                <TextBlock Text="Scan Locations" FontSize="12.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                                <Button Content="Refresh Steam Locations" Command="{Binding RefreshSteamScanLocationsCommand}"
                                                        Style="{StaticResource ModernGhostButton}" DockPanel.Dock="Right" Padding="8,3" FontSize="11"
                                                        Visibility="{Binding SteamIntegrationEnabled, Converter={StaticResource BoolToVis}}"/>
                                            </DockPanel>

                                            <TextBlock Text="No scan locations yet. Add one below, or turn on Steam integration above."
                                                       FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,8" TextWrapping="Wrap"
                                                       Visibility="{Binding HasNoScanLocations, Converter={StaticResource BoolToVis}}"/>

                                            <ItemsControl ItemsSource="{Binding ScanLocations}" ItemTemplate="{StaticResource ScanLocationRowTemplate}" Margin="0,0,0,4"/>

                                            <Button Content="+ Add a Scan Location" Command="{Binding AddScanLocationCommand}"
                                                    Style="{StaticResource ModernOutlineButton}" HorizontalAlignment="Left" Padding="10,5" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Ignored Games manager -->
                                    <Border Background="#16161B" BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1"
                                            CornerRadius="6" Padding="12,10" Margin="0,10,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasNoIgnoredGamePaths}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="Ignored Games" FontSize="12.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4"/>
                                            <TextBlock Text="Never suggested by Add Folder or Scan for Games. Remove one to let it be detected again."
                                                       FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                            <ItemsControl ItemsSource="{Binding IgnoredGamePaths}" ItemTemplate="{StaticResource IgnoredGamePathRowTemplate}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ============================================== -->
                        <!-- CATEGORY 3: SYSTEM TRAY MENU                   -->
                        <!-- ============================================== -->
                        <StackPanel Visibility="{Binding ShowTrayMenuSection, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                            <!-- Section Header (shown in All Settings view) -->
                            <Border Margin="0,2,0,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAllTab}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74C;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="12.5" 
                                               Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="SYSTEM TRAY MENU" FontSize="11.5" FontWeight="SemiBold" 
                                               Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- 3.1 System Tray Context Menu Preferences -->
                            <Border CornerRadius="8" Background="{StaticResource BrushSurfaceDark}" 
                                    BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" 
                                    Padding="14,12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Tray Context Menu Preferences" FontSize="13.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4"/>
                                    <Button Style="{StaticResource HelpLinkButton}" Content="How the tray menu works" Margin="0,0,0,8"
                                            Command="{x:Static services:HelpCommands.ShowTopic}" CommandParameter="traymenu/overview"/>

                                    <CheckBox Content="Include 'Recent' category in tray menu"
                                              IsChecked="{Binding ShowRecentInTray}" 
                                              Style="{StaticResource ModernCheckBox}" FontSize="12.5"/>
                                    <TextBlock Text="Adds a persistent 'Recent' category submenu to the tray menu for quick access to recently played games, whether category grouping is enabled or not." 
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11" 
                                               Margin="24,3,0,6" TextWrapping="Wrap"/>

                                    <DockPanel Margin="24,0,0,6" LastChildFill="False" IsEnabled="{Binding ShowRecentInTray}">
                                        <TextBlock Text="Max recent games to show (0 = disabled):" Foreground="{StaticResource BrushTextSecondary}"
                                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBox Text="{Binding MaxRecentInTray, UpdateSourceTrigger=LostFocus}"
                                                 Style="{StaticResource ModernTextBox}" Width="50" HorizontalAlignment="Left"
                                                 PreviewTextInput="NumericTextBox_PreviewTextInput"
                                                 DataObject.Pasting="NumericTextBox_Pasting"/>
                                    </DockPanel>

                                    <DockPanel Margin="24,0,0,12" LastChildFill="False" IsEnabled="{Binding ShowRecentInTray}">
                                        <TextBlock Text="Recent sort order:" Foreground="{StaticResource BrushTextSecondary}"
                                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <ComboBox ItemsSource="{Binding TraySortOptions}"
                                                  SelectedItem="{Binding RecentTraySortOption, Mode=TwoWay}"
                                                  Style="{StaticResource ModernComboBox}" Width="180" HorizontalAlignment="Left"/>
                                    </DockPanel>

                                    <CheckBox Content="Include 'Favorites' category in tray menu"
                                              IsChecked="{Binding ShowFavoritesInTray}"
                                              Style="{StaticResource ModernCheckBox}" FontSize="12.5"/>
                                    <TextBlock Text="Adds a persistent 'Favorites' category submenu to the tray menu for quick access to your starred games, whether category grouping is enabled or not."
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11"
                                               Margin="24,3,0,6" TextWrapping="Wrap"/>

                                    <DockPanel Margin="24,0,0,6" LastChildFill="False" IsEnabled="{Binding ShowFavoritesInTray}">
                                        <TextBlock Text="Max favorites to show (0 = disabled):" Foreground="{StaticResource BrushTextSecondary}"
                                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBox Text="{Binding MaxFavoritesInTray, UpdateSourceTrigger=LostFocus}"
                                                 Style="{StaticResource ModernTextBox}" Width="50" HorizontalAlignment="Left"
                                                 PreviewTextInput="NumericTextBox_PreviewTextInput"
                                                 DataObject.Pasting="NumericTextBox_Pasting"/>
                                    </DockPanel>

                                    <DockPanel Margin="24,0,0,12" LastChildFill="False" IsEnabled="{Binding ShowFavoritesInTray}">
                                        <TextBlock Text="Favorites sort order:" Foreground="{StaticResource BrushTextSecondary}"
                                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <ComboBox ItemsSource="{Binding TraySortOptions}"
                                                  SelectedItem="{Binding FavoritesTraySortOption, Mode=TwoWay}"
                                                  Style="{StaticResource ModernComboBox}" Width="180" HorizontalAlignment="Left"/>
                                    </DockPanel>

                                    <CheckBox Content="Group tray context menu by category"
                                              IsChecked="{Binding GroupTrayMenuByCategory}" 
                                              Style="{StaticResource ModernCheckBox}" FontSize="12.5"/>
                                    <TextBlock Text="When enabled, games are shown under category submenus in the right-click tray menu. When disabled, shows a flat list sorted by your preference." 
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11" 
                                               Margin="24,3,0,10" TextWrapping="Wrap"/>

                                    <DockPanel Margin="24,0,0,4" LastChildFill="False">
                                        <TextBlock Text="Tray menu sort order:" Foreground="{StaticResource BrushTextSecondary}" 
                                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <ComboBox ItemsSource="{Binding TraySortOptions}" 
                                                  SelectedItem="{Binding TrayMenuSortOption, Mode=TwoWay}" 
                                                  Style="{StaticResource ModernComboBox}" Width="180" HorizontalAlignment="Left"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ============================================== -->
                        <!-- CATEGORY 4: PERFORMANCE TWEAKS                 -->
                        <!-- ============================================== -->
                        <StackPanel Visibility="{Binding ShowPerformanceTweaksSection, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                            <!-- Section Header (shown in All Settings view) -->
                            <Border Margin="0,2,0,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAllTab}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="12.5"
                                               Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="PERFORMANCE TWEAKS" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- 4.1 Preset & Reset Options -->
                            <Border CornerRadius="8" Background="{StaticResource BrushSurfaceDark}"
                                    BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1"
                                    Padding="14,12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Performance Tweak Preferences" FontSize="13.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Controls applied when using the System &amp; Performance page's Performance Tweaks tab."
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap"/>

                                    <CheckBox Content="Create a System Restore Point before applying a preset or reset"
                                              IsChecked="{Binding CreateRestorePointBeforeTweaks}"
                                              Style="{StaticResource ModernCheckBox}" FontSize="12.5"/>
                                    <TextBlock Text="A Windows rollback point in case a bulk change causes problems. Recommended on."
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11"
                                               Margin="24,3,0,2" TextWrapping="Wrap"/>
                                    <Button Style="{StaticResource HelpLinkButton}" Content="About restore points" Margin="24,0,0,2"
                                            Command="{x:Static services:HelpCommands.ShowTopic}" CommandParameter="tweaks/restore_point"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ============================================== -->
                        <!-- CATEGORY 5: STORAGE & DIAGNOSTICS              -->
                        <!-- ============================================== -->
                        <StackPanel Visibility="{Binding ShowDiagnosticsSection, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                            <!-- Section Header (shown in All Settings view) -->
                            <Border Margin="0,2,0,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAllTab}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="12.5" 
                                               Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="STORAGE &amp; DIAGNOSTICS" FontSize="11.5" FontWeight="SemiBold" 
                                               Foreground="{StaticResource BrushAccentHover}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- 4.1 Troubleshooting & Diagnostics -->
                            <Border CornerRadius="8" Background="{StaticResource BrushSurfaceDark}" 
                                    BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" 
                                    Padding="14,12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Diagnostic Logging &amp; Traces" FontSize="13.5" FontWeight="SemiBold" 
                                               Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Configure diagnostic logging to catch errors and trace execution while troubleshooting issues." 
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap"/>

                                    <CheckBox Content="Enable Verbose Logging" 
                                              IsChecked="{Binding VerboseLoggingEnabled}" 
                                              Style="{StaticResource ModernCheckBox}" FontSize="12.5"/>
                                    <TextBlock Text="Adds detailed traces (launch parameters, scoring, registry checks) to the log. Turn on when reproducing a problem."
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11"
                                               Margin="24,3,0,2" TextWrapping="Wrap"/>
                                    <Button Style="{StaticResource HelpLinkButton}" Content="Reading the log &amp; reporting a problem" Margin="24,0,0,12"
                                            Command="{x:Static services:HelpCommands.ShowTopic}" CommandParameter="troubleshooting/logs"/>

                                    <!-- Active Debug Log Info Box -->
                                    <Border Background="#16161B" CornerRadius="6" BorderBrush="#252530" BorderThickness="1" Padding="12,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="Active Debug Log File" FontSize="10.5" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,2"/>
                                                <TextBlock Text="{Binding LogFilePathDisplay}" FontSize="11.5" FontFamily="{StaticResource AppFont}" 
                                                           Foreground="{StaticResource BrushAccentHover}" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding LogFilePathDisplay}"/>
                                                <TextBlock Text="{Binding LogFileSizeDisplay, StringFormat='Current File Size: {0}'}" 
                                                           FontSize="10.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="Open Log" Command="{Binding OpenLogFileCommand}" 
                                                        Style="{StaticResource ModernOutlineButton}" Margin="0,0,6,0" Padding="10,5"/>
                                                <Button Content="Clear Log" Command="{Binding ClearLogCommand}" 
                                                        Style="{StaticResource ModernOutlineButton}" Margin="0,0,6,0" Padding="10,5"/>
                                                <Button Content="Open Folder" Command="{Binding OpenLogFolderCommand}" 
                                                        Style="{StaticResource ModernOutlineButton}" Padding="10,5"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- 4.2 Storage & Asset Caches -->
                            <Border CornerRadius="8" Background="{StaticResource BrushSurfaceDark}" 
                                    BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" 
                                    Padding="14,12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Data Storage &amp; Asset Cache" FontSize="13.5" FontWeight="SemiBold" 
                                               Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Local application databases, configurations, and downloaded artwork caches." 
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap"/>

                                    <!-- Roaming: Database & Settings -->
                                    <DockPanel LastChildFill="True" Margin="0,0,0,10">
                                        <Button DockPanel.Dock="Right" Content="Open Data Folder" Command="{Binding OpenStorageFolderCommand}" 
                                                Style="{StaticResource ModernOutlineButton}" VerticalAlignment="Center" Padding="10,5"/>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="User Data &amp; Settings (%AppData%)" FontSize="12" FontWeight="SemiBold" 
                                                       Foreground="{StaticResource BrushTextSecondary}"/>
                                            <TextBlock Text="{Binding StorageDirectoryDisplay}" Foreground="{StaticResource BrushAccentHover}" 
                                                       FontSize="11" FontFamily="{StaticResource AppFont}" Margin="0,2,0,2"
                                                       ToolTip="{Binding StorageDirectoryDisplay}"/>
                                            <TextBlock Text="Contains games.json, settings.json, and atomic .bak recovery backups." 
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="10.5" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <Separator Background="#252530" Margin="0,2,0,10"/>

                                    <!-- Local: Artwork & Media Caches -->
                                    <DockPanel LastChildFill="True">
                                        <Button DockPanel.Dock="Right" Content="Open Cache Folder" Command="{Binding OpenCacheFolderCommand}" 
                                                Style="{StaticResource ModernOutlineButton}" VerticalAlignment="Center" Padding="10,5"/>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="Artwork &amp; Icons Cache (%LocalAppData%)" FontSize="12" FontWeight="SemiBold" 
                                                       Foreground="{StaticResource BrushTextSecondary}"/>
                                            <TextBlock Text="{Binding CacheDirectoryDisplay}" Foreground="{StaticResource BrushAccentHover}" 
                                                       FontSize="11" FontFamily="{StaticResource AppFont}" Margin="0,2,0,2"
                                                       ToolTip="{Binding CacheDirectoryDisplay}"/>
                                            <TextBlock Text="Contains extracted game icons (.png) and downloaded poster artwork (.jpg)." 
                                               Foreground="{StaticResource BrushTextMuted}" FontSize="10.5" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <!-- 4.3 Reset Settings to Defaults -->
                            <Border CornerRadius="8" Background="{StaticResource BrushSurfaceDark}" 
                                    BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" 
                                    Padding="14,12" Margin="0,0,0,10">
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Right" Content="Restore Defaults" Command="{Binding ResetSettingsCommand}" 
                                            Style="{StaticResource ModernOutlineButton}" VerticalAlignment="Center" Padding="12,6"/>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="Reset Settings to Defaults" FontSize="13.5" FontWeight="SemiBold" 
                                                   Foreground="{StaticResource BrushTextPrimary}"/>
                                        <TextBlock Text="Restores startup, system tray context menu, scanning heuristics, and display preferences back to recommended defaults. Your game library and custom artwork are preserved." 
                                                   Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
                </Grid>
            </Grid>

            <!-- ========================================================== -->
            <!-- 3. IN-WINDOW ABOUT VIEW                                    -->
            <!-- ========================================================== -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAboutView}" Value="True">
